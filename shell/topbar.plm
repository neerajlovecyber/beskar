// iNiR / iRiS Morphing Glass Top Bar with Fully Covered Content Notches
import "common/palette.plm"

scene MacTopBar {
    surface {
        size: full, 68
        anchor: top
        reserve: 42
        screens: each
    }

    permissions {
        services: "clock", "audio", "network", "battery", "window", "tray", "tray.*", "say:control_center", "say:spotlight", "say:apple_menu", "say:widgets"
    }

    service clock as now { time: text = "--:--"; date: text }
    service audio as sound { volume: number; muted: bool }
    service network as net { online: bool; name: text }
    service battery as bat { percent: number; charging: bool }
    service window as win { title: text }

    model icons max 8 { icon: image 18, 18 }
    service tray { list: icons }

    fact dark_mode = true
    fact skin = 0

    // iNiR facts updated by topbar.luau
    fact focused_ws = 1
    text focused_app = "Terminal"
    text weather_temp = "16°"
    text weather_icon = "󰖐"

    let bar_color = if(dark_mode, if(skin == 2, #181a20, if(skin == 1, #161820, #14161d)), if(skin == 2, #f2f3f7, if(skin == 1, #eaecf2, #f6f7fb)))
    let bar_glass = if(skin == 2, 0%, if(skin == 1, 55%, 75%))
    let bar_tint = if(skin == 2, 0%, if(dark_mode, 40%, 25%))
    let bar_rim = if(skin == 2, 0%, 14%)
    let stroke_c = if(dark_mode, #b4a8ff, #7f52ff)
    let stroke_op = if(dark_mode, 25%, 15%)
    let ink_c = if(dark_mode, #f5f7f5, #1d1d1f)
    let ink_sub = if(dark_mode, #9a9ea7, #6e6e73)
    let accent_c = #e8a048
    let pill_bg = if(dark_mode, #ffffff, #000000)
    let pill_op = if(dark_mode, 12%, 8%)

    event open_apple_menu ->
    event open_control_center ->
    event open_spotlight ->
    event open_widgets ->
    event tray_activate ->

    // Dynamic content-fitted notch dimensions:
    // Left: Profile orb (24) + ws pill (44) + window title (145) + gaps & generous padding = 280
    let left_w = 280

    // Center: Avatar (22) + Date & Time (118) + Weather (40) + Sound (18) + gaps & padding = 260
    let center_w = 260

    // Right: Tray icons (icons.total * 26) + status icons (Steam, Music, Net, Battery, CC, Bell = 186) + padding = 230
    let right_w = icons.total * 26 + 230

    // ── Safe Background Zone ───────────────────────────────────────────
    zone box topbar_bg { from: 0, 0; size: screen.width, 68 }
    on press right topbar_bg { }

    // ── Continuous Liquid Glass Body Morphing From Top & Side Screen Edges ─
    body {
        color: bar_color
        glass: bar_glass
        lens: false
        frost: 100%
        tint: bar_tint
        rim: bar_rim
        shine: pointer
        refraction: 80%
        dispersion: 40%
        shadow: 0, 4, 16, 25%

        // 1. Continuous Top Ceiling Wire: runs along top edge across full display
        box top_wire {
            from: 0, -12
            size: screen.width, 16
        }

        // 2. Left side ear: curves downwards along the left screen border
        box left_ear {
            from: -12, 0
            size: 16, 56
            corner: 8
            blend: 18
        }

        // 3. Left Notch: touches and sprouts directly from the left screen edge
        box left_notch {
            from: -12, -12
            size: left_w + 12, 50
            corner: 20
            blend: 18
        }

        // 4. Center Notch: floating middle dynamic island
        box center_notch {
            at: screen.width / 2, 16
            size: center_w, 40
            corner: 16
            blend: 16
        }

        // 5. Right side ear: curves downwards along the right screen border
        box right_ear {
            from: screen.width - 4, 0
            size: 16, 56
            corner: 8
            blend: 18
        }

        // 6. Right Notch: touches and sprouts directly from the right screen edge
        box right_notch {
            from: screen.width - right_w, -12
            size: right_w + 12, 50
            corner: 20
            blend: 18
        }
    }

    // ==============================================================
    // LEFT NOTCH CONTENTS: Logo + Workspace Pill + Active Window
    // ==============================================================
    row left_row {
        at: 16, 18
        anchor: left center
        gap: 8
        align: center

        // Profile / Menu Orb
        group {
            size: 24, 24
            ellipse { at: 12, 12; radius: 11; stroke: 1.2; color: stroke_c; opacity: 60% }
            text "󰑄" { at: 12, 12; anchor: center; size: 13.5; color: stroke_c; opacity: 90% }
            zone box logo_hit { from: -2, -2; size: 28, 28; cursor: pointer }
            on press logo_hit { emit open_apple_menu }
        }

        // Workspace Pill Indicator
        group {
            size: 44, 20
            box { from: 0, 0; size: 44, 20; corner: 10; color: pill_bg; opacity: pill_op }
            text "󰊯" { at: 7, 10; anchor: left center; size: 10; color: stroke_c }
            text "{focused_ws}" { at: 26, 10; anchor: center; size: 11.5; weight: 700; color: ink_c }
        }

        // Active Application Title / Window Indicator
        row {
            gap: 6
            align: center
            text "󰘔" { size: 11.5; color: ink_sub }
            text "{win.title}" {
                size: 11.5
                weight: 600
                color: ink_c
                width: 145
                lines: 1
            }
        }
    }

    // ==============================================================
    // CENTER NOTCH CONTENTS: Avatar + Date + Time + Weather + Sound
    // ==============================================================
    row center_row {
        at: screen.width / 2, 18
        anchor: center
        gap: 10
        align: center

        // Mini Avatar Orb
        group {
            size: 22, 22
            ellipse { at: 11, 11; radius: 10; stroke: 1.2; color: stroke_c; opacity: 70% }
            text "󰺠" { at: 11, 11; anchor: center; size: 12; color: #a9b1d6 }
            zone box avatar_hit { from: 0, 0; size: 22, 22; cursor: pointer }
            on press avatar_hit { emit open_apple_menu }
        }

        // Date & Time clickable group
        group {
            size: 118, 24
            row {
                at: 59, 12
                anchor: center
                gap: 5
                align: center
                text now.date { size: 11; weight: 600; color: ink_sub }
                text now.time { size: 12.5; weight: 700; color: ink_c }
            }
            zone box clock_hit { from: 0, 0; size: 118, 24; cursor: pointer }
            on press clock_hit { emit open_widgets }
        }

        // Weather
        row {
            gap: 4
            align: center
            text weather_icon { size: 12; color: accent_c }
            text weather_temp { size: 11; weight: 600; color: ink_c }
        }

        // Mini Audio Indicator
        group {
            size: 18, 18
            text if(sound.muted, "󱄟", "󱕞") {
                at: 9, 9
                anchor: center
                size: 11; color: ink_sub; opacity: 85%
            }
            zone box vol_hit { from: 0, 0; size: 18, 18; cursor: pointer }
            on press vol_hit { emit open_control_center }
        }
    }

    // ==============================================================
    // RIGHT NOTCH CONTENTS: Tray Icons + Battery + Status + CC + Bell
    // ==============================================================
    row right_row {
        at: screen.width - 16, 18
        anchor: right center
        gap: 10
        align: center

        // System Tray
        row {
            gap: 6
            align: center
            for i in icons {
                group {
                    size: 20, 20
                    image i.icon { at: 1, 1; size: 18, 18 }
                    zone box tray_hit { from: 0, 0; size: 20, 20; cursor: pointer }
                    on press tray_hit { emit tray_activate(i.index) }
                }
            }
        }

        // Steam Icon
        text "󱓓" { size: 13; color: ink_sub; opacity: 75% }

        // Music note
        text "󰾆" { size: 12; color: #ff757f; opacity: 80% }

        // Network Status
        text if(net.online, "󰤨", "󰤭") { size: 12.5; color: if(net.online, ink_c, ink_sub); opacity: 85% }

        // Battery Percent Badge
        row {
            gap: 3
            align: center
            text if(bat.charging, "󰂄", "󰁹") { size: 12.5; color: if(bat.charging, mint, ink_c) }
            text "{bat.percent}" { size: 11; weight: 700; color: accent_c }
        }

        // Sliders / Control Center Quick Button
        group {
            size: 22, 22
            text "󱒓" { at: 11, 11; anchor: center; size: 12.5; color: ink_c; opacity: 85% }
            zone box cc_hit { from: 0, 0; size: 22, 22; cursor: pointer }
            on press cc_hit { emit open_control_center }
        }

        // Notification Bell Button
        group {
            size: 22, 22
            text "󰂚" { at: 11, 11; anchor: center; size: 12.5; color: ink_c; opacity: 85% }
            zone box notif_hit { from: 0, 0; size: 22, 22; cursor: pointer }
            on press notif_hit { emit open_widgets }
        }
    }
}
