// macOS Top Menu Bar for Wayland Compositors
import "common/palette.plm"

scene MacTopBar {
    surface {
        size: full, 30
        anchor: top
        reserve: 30
        screens: each
    }

    permissions {
        services: "clock", "audio", "network", "battery", "window", "say:control_center", "say:spotlight", "say:apple_menu", "say:widgets"
    }

    service clock as now { time: text = "--:--"; date: text }
    service audio as sound { volume: number; muted: bool }
    service network as net { online: bool; name: text }
    service battery as bat { percent: number; charging: bool }
    service window as win { title: text }

    fact dark_mode = true
    fact skin = 0

    let bar_color = if(dark_mode, if(skin == 2, #181a20, if(skin == 1, #161820, #14161c)), if(skin == 2, #f2f3f7, if(skin == 1, #eaecf2, #f6f7fb)))
    let bar_glass = if(skin == 2, 0%, if(skin == 1, 55%, 85%))
    let bar_tint = if(skin == 2, 0%, if(dark_mode, 40%, 25%))
    let bar_stroke = if(dark_mode, #ffffff, #000000)
    let bar_stroke_op = if(dark_mode, 12%, 8%)
    let ink_c = if(dark_mode, #f5f7f5, #1d1d1f)
    let ink_sub = if(dark_mode, #8e8e93, #6e6e73)

    event open_apple_menu ->
    event open_control_center ->
    event open_spotlight ->
    event open_widgets ->

    // ── Safe Background Zone to Catch Right Clicks and Background ──
    zone box topbar_bg { from: 0, 0; size: screen.width, 30 }
    on press right topbar_bg { }

    // ── Bar Background ──────────────────────────────────────────
    body {
        color: bar_color
        glass: bar_glass
        frost: 100%
        dispersion: 0
        refraction: 0
        tint: bar_tint
        shadow: 0, 2, 8, 20%
        box { from: 0, 0; size: screen.width, 30 }
    }
    box { from: 0, 29; size: screen.width, 1; color: bar_stroke; opacity: bar_stroke_op }

    // ── Left: Apple Menu & App Title ────────────────────────────
    row {
        at: 14, 5
        gap: 16
        align: center

        // Apple Icon with Click Zone
        group {
            size: 18, 20
            text "" { at: 0, 0; size: 15; weight: 700; color: ink_c }
            zone box apple_hit { from: -4, -4; size: 26, 28; cursor: pointer }
        }

        // Active App Title or Fallback
        text win.title { size: 13; weight: 600; color: ink_c; width: 180; lines: 1 }

        // Standard Menus
        text "File" { size: 13; color: ink_c; opacity: 75% }
        text "Edit" { size: 13; color: ink_c; opacity: 75% }
        text "View" { size: 13; color: ink_c; opacity: 75% }
        text "Window" { size: 13; color: ink_c; opacity: 75% }
        text "Help" { size: 13; color: ink_c; opacity: 75% }
    }

    // ── Right: Status Indicators & Clock ────────────────────────
    row {
        at: screen.width - 14, 5
        anchor: right
        gap: 14
        align: center

        // Battery with icon
        row {
            gap: 5; align: center
            text if(bat.charging, "󰂄", "󰁹") { size: 14; color: if(bat.charging, mint, ink_c); opacity: 90% }
            text "{bat.percent}%" { size: 12; color: ink_c; opacity: 80% }
        }

        // Wi-Fi (Nerd Font icon)
        text if(net.online, "󰤨", "󰤭") { size: 14; color: if(net.online, ink_c, ink_sub); opacity: 85% }

        // Volume (Nerd Font icon)
        text if(sound.muted, "󰝟", "󰕾") { size: 14; color: ink_c; opacity: 85% }

        // Spotlight Search Icon (Clickable)
        group {
            size: 16, 16
            text "󰍉" { at: 0, 0; size: 14; color: ink_c; opacity: 85% }
            zone box spot_hit { from: -4, -4; size: 24, 24; cursor: pointer }
        }

        // Control Center Toggle Icon (Clickable)
        group {
            size: 20, 16
            text "󰍜" { at: 2, 0; size: 15; color: ink_c; opacity: 85% }
            zone box cc_hit { from: -4, -4; size: 28, 24; cursor: pointer }
        }

        // Date & Time (Clickable for Notification Center & Widgets)
        group {
            row {
                gap: 8; align: center
                text now.date { size: 12.5; color: ink_c; opacity: 75% }
                text now.time { size: 13; weight: 600; color: ink_c }
            }
            zone box clock_hit { from: -4, -4; size: 140, 24; cursor: pointer }
        }
    }

    on press apple_hit { emit open_apple_menu }
    on press spot_hit { emit open_spotlight }
    on press cc_hit { emit open_control_center }
    on press clock_hit { emit open_widgets }
}
