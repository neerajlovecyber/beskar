// iNiR / iRiS 3-Island Top Bar with True Continuous Morphing Fillets
import "common/palette.plm"

scene MacTopBar {
    surface {
        size: full, 48
        anchor: top
        reserve: 40
        screens: each
    }

    permissions {
        services: "clock", "audio", "network", "battery", "window", "tray", "tray.*", "say:control_center", "say:spotlight", "say:apple_menu", "say:widgets"
    }

    service clock as now { time: text = "--:--"; date: text }
    service audio as sound { volume: number; muted: bool }
    service network as net { online: bool; name: text }
    service battery as bat { percent: number; charging: bool }
    service window as win { title: text }

    model icons max 8 { icon: image 18, 18 }
    service tray { list: icons }

    fact dark_mode = true
    fact skin = 0

    // iNiR facts updated by topbar.luau
    fact focused_ws = 1
    text focused_app = "Terminal"
    text weather_temp = "16°"
    text weather_icon = "󰖐"

    let bar_color = if(dark_mode, if(skin == 2, #181a20, if(skin == 1, #161820, #14161c)), if(skin == 2, #f2f3f7, if(skin == 1, #eaecf2, #f6f7fb)))
    let bar_glass = if(skin == 2, 0%, if(skin == 1, 55%, 75%))
    let bar_tint = if(skin == 2, 0%, if(dark_mode, 40%, 25%))
    let bar_rim = if(skin == 2, 0%, 14%)
    let stroke_c = if(dark_mode, #b4a8ff, #7f52ff)
    let stroke_op = if(dark_mode, 25%, 15%)
    let ink_c = if(dark_mode, #f5f7f5, #1d1d1f)
    let ink_sub = if(dark_mode, #9a9ea7, #6e6e73)
    let accent_c = #e8a048
    let pill_bg = if(dark_mode, #ffffff, #000000)
    let pill_op = if(dark_mode, 12%, 8%)

    event open_apple_menu ->
    event open_control_center ->
    event open_spotlight ->
    event open_widgets ->
    event tray_activate ->

    // Precise island dimensions
    let left_w = 260
    let center_w = 250
    let right_w = 270

    // ── Safe Background Zone ──────────────────────────────────────
    zone box topbar_bg { from: 0, 0; size: screen.width, 48 }
    on press right topbar_bg { }

    // ── Unified Liquid Glass Body with Smooth Morphing Fillets ────
    body {
        color: bar_color
        glass: bar_glass
        lens: false
        frost: 100%
        tint: bar_tint
        rim: bar_rim
        shadow: 0, 4, 16, 25%

        // 1. Continuous Top Wire: runs along top edge across full width
        box top_wire {
            from: 0, -10
            size: screen.width, 14
        }

        // 2. Left Island: Workspace & Active App
        box left_island {
            from: 20, -4
            size: left_w, 42
            corner: 16
            blend: 12
        }

        // 3. Center Notch Island: Clock, Date, Weather & Sound
        box center_island {
            at: screen.width / 2, 17
            size: center_w, 42
            corner: 16
            blend: 14
        }

        // 4. Right Island: Tray, Battery & Control Center
        box right_island {
            from: screen.width - right_w - 20, -4
            size: right_w, 42
            corner: 16
            blend: 12
        }
    }

    // Top Perimeter Wire Highlight
    line {
        from: 0, 4
        to: screen.width, 4
        width: 1.0
        color: stroke_c
        opacity: stroke_op
    }

    // ==============================================================
    // LEFT ISLAND CONTENTS: Logo + Workspace Pill + Active App Title
    // ==============================================================
    row left_row {
        at: 32, 17
        anchor: left center
        gap: 10
        align: center

        // Profile / Menu Orb
        group {
            size: 24, 24
            ellipse { at: 12, 12; radius: 11; stroke: 1.2; color: stroke_c; opacity: 60% }
            text "󱡄" { at: 12, 12; anchor: center; size: 13.5; color: stroke_c; opacity: 90% }
            zone box logo_hit { from: -2, -2; size: 28, 28; cursor: pointer }
            on press logo_hit { emit open_apple_menu }
        }

        // Workspace Pill Indicator
        group {
            size: 46, 20
            box { from: 0, 0; size: 46, 20; corner: 10; color: pill_bg; opacity: pill_op }
            text "󰮯" { at: 8, 10; anchor: left center; size: 10; color: stroke_c }
            text "{focused_ws}" { at: 28, 10; anchor: center; size: 11.5; weight: 700; color: ink_c }
        }

        // Active Application Title / Window Indicator
        row {
            gap: 6
            align: center
            text "󰘔" { size: 12; color: ink_sub }
            text "{win.title}" {
                size: 11.5
                weight: 600
                color: ink_c
                width: 135
                lines: 1
            }
        }
    }

    // ==============================================================
    // CENTER ISLAND CONTENTS: Avatar + Date + Time + Weather + Sound
    // ==============================================================
    row center_row {
        at: screen.width / 2, 17
        anchor: center
        gap: 10
        align: center

        // Mini Avatar Orb
        group {
            size: 22, 22
            ellipse { at: 11, 11; radius: 10; stroke: 1.2; color: stroke_c; opacity: 70% }
            text "󰊠" { at: 11, 11; anchor: center; size: 12; color: #a9b1d6 }
            zone box avatar_hit { from: 0, 0; size: 22, 22; cursor: pointer }
            on press avatar_hit { emit open_apple_menu }
        }

        // Date ("Fri 06 Nov") & Time ("15:40")
        group {
            size: 110, 22
            row {
                at: 0, 2
                gap: 5
                align: center
                text now.date { size: 11; weight: 600; color: ink_sub }
                text now.time { size: 12.5; weight: 700; color: ink_c }
            }
            zone box clock_hit { from: 0, 0; size: 110, 22; cursor: pointer }
            on press clock_hit { emit open_widgets }
        }

        // Weather Pill (Condition Icon + Temperature)
        row {
            gap: 4
            align: center
            text weather_icon { size: 12.5; color: accent_c }
            text weather_temp { size: 11; weight: 600; color: ink_c }
        }

        // Mini Audio Indicator
        group {
            size: 18, 18
            text if(sound.muted, "󰝟", "󰕾") {
                at: 9, 9
                anchor: center
                size: 11.5
                color: ink_sub
                opacity: 85%
            }
            zone box vol_hit { from: 0, 0; size: 18, 18; cursor: pointer }
            on press vol_hit { emit open_control_center }
        }
    }

    // ==============================================================
    // RIGHT ISLAND CONTENTS: Tray Icons + Battery + Status + CC + Bell
    // ==============================================================
    row right_row {
        at: screen.width - 32, 17
        anchor: right center
        gap: 12
        align: center

        // System Tray
        row {
            gap: 6
            align: center
            for i in icons {
                group {
                    size: 20, 20
                    image i.icon { at: 1, 1; size: 18, 18 }
                    zone box tray_hit { from: 0, 0; size: 20, 20; cursor: pointer }
                    on press tray_hit { emit tray_activate(i.index) }
                }
            }
        }

        // Steam Icon
        text "󰓓" { size: 13.5; color: ink_sub; opacity: 75% }

        // Music note
        text "󰎆" { size: 12.5; color: #ff757f; opacity: 80% }

        // Network Status
        text if(net.online, "󰤨", "󰤭") { size: 13; color: if(net.online, ink_c, ink_sub); opacity: 85% }

        // Battery Percent Badge
        row {
            gap: 3
            align: center
            text if(bat.charging, "󰂄", "󰁹") { size: 13; color: if(bat.charging, mint, ink_c) }
            text "{bat.percent}" { size: 11; weight: 700; color: accent_c }
        }

        // Sliders / Control Center Quick Button
        group {
            size: 22, 22
            text "󰒓" { at: 11, 11; anchor: center; size: 13; color: ink_c; opacity: 85% }
            zone box cc_hit { from: 0, 0; size: 22, 22; cursor: pointer }
            on press cc_hit { emit open_control_center }
        }

        // Notification Bell Button
        group {
            size: 22, 22
            text "󰂚" { at: 11, 11; anchor: center; size: 13; color: ink_c; opacity: 85% }
            zone box notif_hit { from: 0, 0; size: 22, 22; cursor: pointer }
            on press notif_hit { emit open_widgets }
        }
    }
}
