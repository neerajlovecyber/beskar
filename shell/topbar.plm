// iNiR / iRiS style shell frame: ONE glass silhouette that runs all the way round the screen.
//
//   · a thin padded ring along the four edges, its inner corners curved
//   · three islands (left / centre / right) hanging from the top of the ring
//   · the dock, an island rising from the bottom of the ring
//
// They are one body, so every junction melts into the next one instead of being drawn twice.
// Islands are as wide as the row they hold (`left_row.width`, `dock_row.width`, …) and chase
// that with a spring: when the window title, the tray or the dock change, the glass morphs.
//
// The surface is the whole monitor, but only the zones catch the mouse: everywhere else the
// click goes through to the windows.
import "common/palette.plm"

scene MacTopBar {
    include "common/theme.plm"
    surface {
        size: full, full
        anchor: top
        reserve: 42          // windows leave the top strip; the ring only overlaps their edges
        screens: each
    }

    //  What topbar.luau may touch. `run` is only what it needs: niri for the workspace, curl for
    //  the weather, and the dock's apps. Undeclared is nothing.
    permissions {
        services: "clock", "network", "battery", "window", "tray", "tray.*", "apps", "apps.launch", "audio", "audio.*", "brightness", "brightness.*", "media", "media.*", "say:music", "say:capture", "say:control_center", "say:spotlight", "say:notifications", "say:dashboard", "say:settings", "say:session", "say:appswitcher", "say:lock", "say:clipboard", "say:wallpapers"
        run: "niri msg", "curl", "sh", "systemctl"
    }

    service clock as now { time: text = "--:--"; date: text }
    service network as net { online: bool; name: text; strength: number; wifi: bool }
    service battery as bat { present: bool; percent: number; charging: bool }
    service window as win { title: text }

    //  The tray list is filled by topbar.luau (`sys.watch("tray")` → `model.icons = list`). It must
    //  not also be a `service tray` here: the tray has one listener, and two would fight over it.
    model icons max 8 { icon: image 18, 18 }

    fact bt_connected = false   // set by control_center.luau: a Bluetooth device is connected
    fact dnd = false            // Do Not Disturb, from the Control Center
    fact notif_count = 0       // set by notifications.luau: how many are waiting

    //  Reported by topbar.luau
    //  The dock is data: topbar.luau fills this from the apps you pinned plus the ones that are running.
    //  One record per workspace (all monitors): which monitor, its number, whether it is the one shown and how
    //  many windows it has. Filled by topbar.luau from niri.
    model ws_list max 12 { out: number; idx: number; active: bool; wins: number }
    //  The apps open in the workspace each monitor shows (left to right), the focused one with its name.
    model cur_apps max 20 { out: number; icon: image 20, 20; name: text; wid: number; focused: bool }
    model dock_items max 12 { icon: image 38, 38; name: text; running: bool; pinned: bool; canpin: bool }
    //  The power menu (the gem button): `open` is what shell/exclusive.luau closes, `open_screen` which monitor shows it.
    fact open = false
    fact open_screen = -1
    //  The glass of a panel that grows out of an island is drawn here, one shape per island, driven by facts:
    //  `lp_` left (the power menu, below), `cp_` centre, `rp_` right. on = open, screen = which monitor, w / h = size.
    //  panel scenes report through topbar.luau (events `panel_open`, `panel_height`, `panel_close`).
    fact cp_on = false
    fact cp_screen = -1
    fact cp_w = 360
    fact cp_h = 496
    fact rec_on = false       // a screen recording runs (capture.luau): a red dot and the time show in the pill
    text rec_time = "0:00"
    fact m_on = false         // something is playing: its cover and a few bars show in the clock pill
    fact m_playing = false
    fact m_has_art = false
    text m_art = ""
    image m_cover = from m_art, 22, 22
    fact cp_kind = 0          // what owns the centre island: 0 the dashboard · 1 a notification banner (the clock gives way)
    fact bp_on = false        // bottom: the dock island grows UP into Spotlight / the wallpaper strip
    fact bp_screen = -1
    fact bp_w = 680
    fact bp_h = 300           // total height from the bottom edge of the screen
    fact rp_on = false
    fact rp_screen = -1
    fact rp_w = 372
    fact rp_h = 434
    //  The volume / brightness feedback inside the centre pill (osd_*): set by topbar.luau
    fact osd_kind = 0         // 0 volume · 1 brightness
    fact osd_level = 0.5
    fact osd_muted = false
    fact last_screen = -1     // the monitor of the last click on one of the bar's buttons
    fact menu_i = -1          // which dock item has its right-click menu open (-1 none)
    //  One record per monitor, in niri's output order: the workspace each one shows.
    model mon max 4 { active: number = 1; busy: number = 0; nws: number = 1 }
    text weather_temp = "--°"
    text weather_icon = "󰖐"

    event pm_item ->
    event osd_vol_up ->
    event osd_vol_down ->
    event osd_vol_mute ->
    event osd_br_up ->
    event osd_br_down ->
    event osd_popup ->
    event panel_open ->
    event panel_height ->
    event panel_close ->
    event open_control_center ->
    event open_panel ->      // a number: which separate panel to toggle on the focused monitor (see topbar.luau)
    event open_notifications ->
    event open_dashboard ->
    event open_music ->
    event rec_stop ->
    event open_cc_wifi ->
    event open_cc_bt ->
    event tray_activate ->
    event tray_secondary ->
    event tray_context ->
    event ws_go ->
    event ws_focus ->
    event dock_click ->
    event dock_pin ->
    event dock_quit ->
    event reveal ->        // pointer reached the bottom edge
    event keep_dock ->     // pointer is on the dock

    // ── look ─────────────────────────────────────────────────────
    let bar_color = if(dark_mode, if(skin == 2, #181a20, if(skin == 1, #161820, #14161d)), if(skin == 2, #f2f3f7, if(skin == 1, #eaecf2, #f6f7fb)))
    let bar_glass = if(skin == 2, 0%, if(skin == 1, 45%, 55%))
    let bar_tint  = if(skin == 2, 0%, if(dark_mode, 60%, 45%))
    let bar_rim   = if(skin == 2, 0%, 16%)
    //  Smoke (dark) / milk (light) keep words readable over any wallpaper.
    let bar_smoke = if(dark_mode, 75%, 0%)
    let bar_milk  = if(dark_mode, 0%, 70%)
    let stroke_c  = if(dark_mode, #b4a8ff, #7f52ff)
    let hint_c    = #e8a048   // the little numbers (percentage); a deliberate warm note
    let dot_color = ink_c
    let pill_fill = if(dark_mode, #2a2c35, #dcdde6)

    // ── geometry ─────────────────────────────────────────────────
    let ring        = 6       // thickness of the border that goes all the way round
    let curve       = 30      // how round the ring's inner corners are (how much its sides melt)
    let ext         = 28      // how far the glass reaches past the screen edge (never seen)
    let pad         = 16      // room between a top island's edge and its content
    let cy          = 19      // vertical centre of the top islands' content
    let notch_h     = 54      // top islands start 14 px above the screen and end 40 px down
    let fillet      = 14      // how much a top island melts into the ring
    let dock_h      = 64      // how tall the dock stands above the bottom edge
    let dock_pad    = 18      // room between the dock's sides and its icons
    let dock_fillet = 26      // how far the dock flares into the ring


    // ── one small round button: glyph + hover halo ───────────────
    component Glyph(g: text, tap: event, tone: color = ink_c, sz: number = 12.5) {
        size: 24, 24
        prop hot = 0 ~quick
        box halo { from: 0, 0; size: 24, 24; corner: 8; color: ink_c; opacity: hot * 14% }
        text "{g}" { at: 12, 12; anchor: center; size: sz + hot * 1; color: tone; opacity: 85% + hot * 15% }
        zone box hit { from: 0, 0; size: 24, 24; cursor: pointer }
        on enter hit { hot: 1 }
        on leave hit { hot: 0 }
        on press hit { emit tap }
    }


    //  The status icons of the right island. All drawn, none a font glyph, so they sit exactly in the
    //  middle of their 24 px box and of their hover halo.
    component WifiIcon(tap: event) {
        size: 24, 24
        prop hot = 0 ~quick
        box { from: 0, 0; size: 24, 24; corner: 8; color: ink_c; opacity: hot * 14% }
        //  three arcs that fill with the signal; dim and slashed when there is no connection
        arc { at: 12, 17; radius: 4.2; span: 90deg; width: 1.9; color: ink_c; opacity: if(net.online, 100%, 30%) }
        arc { at: 12, 17; radius: 8; span: 90deg; width: 1.9; color: ink_c; opacity: if(net.online and net.strength > 30, 100%, 30%) }
        arc { at: 12, 17; radius: 11.8; span: 90deg; width: 1.9; color: ink_c; opacity: if(net.online and net.strength > 60, 100%, 30%) }
        ellipse { at: 12, 17.4; radius: 1.5; color: ink_c; opacity: if(net.online, 100%, 30%) }
        line { from: 5, 5; to: 19, 19; width: 1.8; color: ink_c; opacity: if(net.online, 0%, 100%) }
        zone box hit { from: 0, 0; size: 24, 24; corner: 8; cursor: pointer }
        on enter hit { hot: 1 }
        on leave hit { hot: 0 }
        on press hit { last_screen = screen.index; emit tap }
        on press right hit { }
    }

    component BluetoothIcon(tap: event) {
        size: 24, 24
        prop hot = 0 ~quick
        box { from: 0, 0; size: 24, 24; corner: 8; color: ink_c; opacity: hot * 14% }
        path { at: 7.5, 5; color: ink_c; stroke: 1.7; move 0, 5.5; line 9, 13.5; line 4.5, 17.5; line 4.5, 0; line 9, 4; line 0, 12 }
        zone box hit { from: 0, 0; size: 24, 24; corner: 8; cursor: pointer }
        on enter hit { hot: 1 }
        on leave hit { hot: 0 }
        on press hit { last_screen = screen.index; emit tap }
        on press right hit { }
    }

    //  Battery: the cell fills with the charge, goes red when low, green with a bolt while charging.
    component BatteryIcon(tap: event) {
        size: 54, 24
        prop hot = 0 ~quick
        box { from: 0, 0; size: 54, 24; corner: 8; color: ink_c; opacity: hot * 14% }
        box { from: 6, 6.5; size: 24, 11; corner: 3.2; stroke: 1.3; color: ink_c; opacity: 80% }
        box { from: 31, 10; size: 2, 4; corner: 1; color: ink_c; opacity: 80% }
        box { from: 8, 8.5; size: max(2, 20 * clamp(bat.percent / 100, 0, 1)), 7; corner: 1.6; color: if(bat.charging, ok_c, if(bat.percent <= 20, danger_c, ink_c)) }
        path { at: 16.5, 7; color: if(bat.charging, #0c1410, ink_c); opacity: if(bat.charging, 100%, 0%); move 2.5, 0; line 0, 5.5; line 2.4, 5.5; line 1.5, 10; line 5, 4; line 2.6, 4; close }
        text "{bat.percent}" { at: 36, 12; anchor: left center; size: 11; weight: 700; color: hint_c }
        zone box hit { from: 0, 0; size: 54, 24; corner: 8; cursor: pointer }
        on enter hit { hot: 1 }
        on leave hit { hot: 0 }
        on press hit { last_screen = screen.index; emit tap }
        on press right hit { }
    }

    //  Control Center: two little switches, as on a Mac.
    component SwitchesIcon(tap: event) {
        size: 24, 24
        prop hot = 0 ~quick
        box { from: 0, 0; size: 24, 24; corner: 8; color: ink_c; opacity: hot * 14% }
        box { from: 4, 5.5; size: 16, 6; corner: 3; stroke: 1.4; color: ink_c }
        ellipse { at: 16.5, 8.5; radius: 1.9; color: ink_c }
        box { from: 4, 12.5; size: 16, 6; corner: 3; stroke: 1.4; color: ink_c }
        ellipse { at: 7.5, 15.5; radius: 1.9; color: ink_c }
        zone box hit { from: 0, 0; size: 24, 24; corner: 8; cursor: pointer }
        on enter hit { hot: 1 }
        on leave hit { hot: 0 }
        on press hit { last_screen = screen.index; emit tap }
        on press right hit { }
    }

    //  The bell: a red count while notifications wait, a slash while Do Not Disturb is on.
    component BellIcon(tap: event) {
        size: 24, 24
        prop hot = 0 ~quick
        box { from: 0, 0; size: 24, 24; corner: 8; color: ink_c; opacity: hot * 14% }
        path { at: 5, 4; color: ink_c; move 0, 13; line 2, 13; line 2.5, 6.5; line 4.5, 2.5; line 9.5, 2.5; line 11.5, 6.5; line 12, 13; line 14, 13; line 14, 15; line 0, 15; close }
        ellipse { at: 12, 19.2; radius: 1.7; color: ink_c }
        line { from: 5, 5; to: 19, 19; width: 1.8; color: ink_c; opacity: if(dnd, 100%, 0%) }
        ellipse { at: 19, 5; radius: 5.5; color: danger_c; opacity: if(notif_count > 0, 100%, 0%) }
        text "{notif_count}" { at: 19, 5; anchor: center; size: 7.5; weight: 700; color: #ffffff; opacity: if(notif_count > 0, 100%, 0%) }
        zone box hit { from: 0, 0; size: 24, 24; corner: 8; cursor: pointer }
        on enter hit { hot: 1 }
        on leave hit { hot: 0 }
        on press hit { emit tap }
        on press right hit { }
    }

    // ── workspaces ───────────────────────────────────────────────
    //  A capsule per workspace: the one shown is wide and in the accent colour, the ones with windows are
    //  filled, the empty ones are a ring. Press to go there.
    component WsDot(w: record) {
        size: 24, 24
        prop wd = 8 ~quick
        follow wd = if(w.active, 22, 8)
        prop hot = 0 ~quick
        box { from: 12 - wd / 2, 8; size: wd, 8; corner: 4; color: if(w.active, accent_c, ink_c); opacity: if(w.active, 100%, if(w.wins > 0, 62%, 26%) + hot * 38%) }
        zone box hit { from: 0, 0; size: 24, 24; corner: 8; cursor: pointer }
        on enter hit { hot: 1 }
        on leave hit { hot: 0 }
        on press hit { emit ws_go(w.out * 100 + w.idx) }
        on press right hit { }
    }

    //  One app of the current workspace: just its icon; the focused one sits in a pill.
    component CurApp(it: record) {
        prop hot = 0 ~quick
        //  the focused one: in a pill
        row {
            show: it.focused
            padding: 3
            gap: 6
            align: center
            fill: item_solid
            corner: 9
            image it.icon { size: 20, 20 }
        }
        //  the others: just the icon, a little dimmer until the pointer is on it
        row {
            show: not it.focused
            padding: 3
            align: center
            image it.icon { size: 20, 20; opacity: 65% + hot * 35% }
        }
        zone box hit { from: 0, 0; size: 26, 26; corner: 8; cursor: pointer }
        on enter hit { hot: 1 }
        on leave hit { hot: 0 }
        on press hit { emit ws_focus(it.wid) }
        on press right hit { }
    }

    //  One line of the power menu.
    component PowerItem(label: text, n: number, danger: bool = false) {
        size: pm_w - 28, 36
        prop hot = 0 ~quick
        box { from: 0, 0; size: pm_w - 28, 36; corner: 10; color: if(danger, danger_c, accent_c); opacity: hot * if(danger, 90%, 85%) }
        text label { at: 14, 18; anchor: left center; size: 13; weight: 500; color: if(hot > 0.5, #ffffff, if(danger, danger_c, ink_c)) }
        zone box hit { from: 0, 0; size: pm_w - 28, 36; corner: 10; cursor: pointer }
        on enter hit { hot: 1 }
        on leave hit { hot: 0 }
        on press hit { open = false; emit pm_item(n) }
        on press right hit { }
    }

    // ── one dock app: the icon lifts and grows under the pointer ─
    // ── one dock app: the icon lifts under the pointer, a dot says it is running, right-click opens a menu ─
    component DockItem(it: record) {
        size: 40, 44
        prop hot = 0 ~quick
        prop pin_hot = 0 ~quick
        prop quit_hot = 0 ~quick
        let rows = if(it.canpin, 1, 0) + if(it.running, 1, 0)
        group {
            pivot: 20, 38
            scale: 1 + hot * 0.22
            move: 0, hot * -6
            image it.icon { at: 1, 0; size: 38, 38 }
        }
        ellipse { at: 20, 42; radius: 1.8; color: dot_color; opacity: if(it.running, 85%, 0%) }

        //  its name, while the pointer rests on it
        row {
            at: 20, -12
            anchor: center bottom
            padding: 6
            fill: item_solid
            corner: 9
            opacity: if(menu_i == it.index, 0, hot)
            text it.name { size: 11; weight: 600; color: ink_c; tight: true }
        }

        zone box hit { from: 0, 0; size: 40, 44; cursor: pointer }
        on enter hit { hot: 1; emit keep_dock }
        on leave hit { hot: 0 }
        on press hit { menu_i = -1; emit dock_click(it.index) }
        on press right hit { menu_i = it.index; emit keep_dock }

        //  the menu: Keep in Dock / Remove from Dock, and Quit while it has windows
        group {
            show: menu_i == it.index and rows > 0
            box { from: -55, -16 - rows * 34; size: 150, rows * 34 + 8; corner: 13; color: item_solid }
            box { from: -55, -16 - rows * 34; size: 150, rows * 34 + 8; corner: 13; stroke: 1; color: ink_c; opacity: 14% }
            group {
                show: it.canpin
                move: -49, -12 - rows * 34
                box { from: 0, 0; size: 138, 30; corner: 9; color: ink_c; opacity: pin_hot * 12% }
                text if(it.pinned, "Remove from Dock", "Keep in Dock") { at: 69, 15; anchor: center; size: 12; weight: 500; color: ink_c }
                zone box pin_hit { from: 0, 0; size: 138, 30; corner: 9; cursor: pointer }
                on enter pin_hit { pin_hot: 1; emit keep_dock }
                on leave pin_hit { pin_hot: 0 }
                on press pin_hit { menu_i = -1; emit dock_pin(it.index) }
                on press right pin_hit { }
            }
            group {
                show: it.running
                move: -49, -12 - rows * 34 + if(it.canpin, 34, 0)
                box { from: 0, 0; size: 138, 30; corner: 9; color: danger_c; opacity: quit_hot * 22% }
                text "Quit" { at: 69, 15; anchor: center; size: 12; weight: 500; color: danger_c }
                zone box quit_hit { from: 0, 0; size: 138, 30; corner: 9; cursor: pointer }
                on enter quit_hit { quit_hot: 1; emit keep_dock }
                on leave quit_hit { quit_hot: 0 }
                on press quit_hit { menu_i = -1; emit dock_quit(it.index) }
                on press right quit_hit { }
            }
            on away hit, pin_hit, quit_hit for 900ms { menu_i = -1 }
        }
    }

    //  Everything that is drawn lives in a component. With `screens: each` a surface's loose
    //  props are shared by every monitor's copy, so a spring that follows `left_row.width`
    //  would read 0 (the width of a row only exists in the copy that draws it). A
    //  component's props are its own, so each monitor sizes its own islands.
    component Shell() {
        //  Each island's width: what its row measures, chased by a spring.
        prop lw = 0 ~calm
        prop cw = 0 ~calm
        prop rw = 0 ~calm
        prop dw = 0 ~calm
        follow lw = left_row.width + pad * 2
        follow cw = center_row.width + pad * 2
        follow rw = right_row.width + pad * 2
        follow dw = dock_row.width + dock_pad * 2

        //  the little bars beside the cover: three sines at different speeds, flat while paused
        prop mb1 = 0
        prop mb2 = 0
        prop mb3 = 0
        wave mb1 = 1 at 5.3
        wave mb2 = 1 at 7.1
        wave mb3 = 1 at 6.2
        prop rdot = 0
        wave rdot = 0.5 at 4.5
        prop mplay = 0 ~calm
        follow mplay = if(m_playing, 1, 0)

        //  Auto-hide: while a window is on this monitor's workspace the dock sinks into the ring.
        //  It comes back when the pointer reaches the bottom edge (or is on the dock) and goes
        //  again 2.5 s after the pointer stops asking for it. With an empty workspace it stays up.
        prop vis = 1 ~calm
        layer dockshow ~calm {
            empty  while mon.$screen.busy == 0 { vis: 1 }
            panel  while bp_on and bp_screen == screen.index { vis: 1 }
            peek   for 2500ms after reveal, keep_dock { vis: 1 }
            away   { vis: 0 }
        }

        //  Panels that grow out of the islands. Per island: `v` how open it is on THIS monitor, and its size, all
        //  springs, so the glass morphs when a panel opens, closes or changes height (or another takes the island).
        let pm_w = 236
        let pm_h = 312
        prop pv = 0 ~calm                                   // left: the power menu
        follow pv = if(open and open_screen == screen.index, 1, 0)
        prop cv = 0 ~calm                                   // centre
        follow cv = if(cp_on and cp_screen == screen.index, 1, 0)
        prop bnv = 0 ~calm                                  // the banner: the clock fades while it shows
        follow bnv = if(cp_on and cp_kind == 1 and cp_screen == screen.index, 1, 0)
        prop ov = 0 ~calm                                   // the volume / brightness feedback
        follow ov = if(cp_on and cp_kind == 2 and cp_screen == screen.index, 1, 0)
        prop cpw = 360 ~calm
        follow cpw = cp_w
        prop cph = 496 ~calm
        follow cph = cp_h
        prop bv = 0 ~calm                                   // bottom: the dock island
        follow bv = if(bp_on and bp_screen == screen.index, 1, 0)
        prop bpw = 680 ~calm
        follow bpw = bp_w
        prop bph = 300 ~calm
        follow bph = bp_h
        prop rv = 0 ~calm                                   // right
        follow rv = if(rp_on and rp_screen == screen.index, 1, 0)
        prop rpw = 372 ~calm
        follow rpw = rp_w
        prop rph = 434 ~calm
        follow rph = rp_h

        // ── the glass: ring + top islands + dock, one silhouette ──
        body {
            color: bar_color
            glass: bar_glass
            lens: false
            frost: 100%
            tint: bar_tint
            smoke: bar_smoke
            milk: bar_milk
            rim: bar_rim
            refraction: 80%
            dispersion: 40%

            //  The ring. The sides and the floor melt into what came before, which is what
            //  rounds the inner corners.
            box ceiling { from: -ext, -ext; size: screen.width + ext * 2, ext + ring }
            box rail_l  { from: -ext, 0; size: ext + ring, screen.height; blend: curve }
            box rail_r  { from: screen.width - ring, 0; size: ext + ring, screen.height; blend: curve }
            box floor   { from: -ext, screen.height - ring; size: screen.width + ext * 2, ext + ring; blend: curve }

            //  The three top islands ARE the panel shapes below (at rest they are just the island): drawing the island
            //  twice made the smooth union inflate it and left bumps along the bottom edge when a panel was open.
            //  The panels' glass: each island grows downward (and wider if the panel is), melted into itself.
            box power_m { from: -ext, -14; size: lw + max(0, pm_w - lw) * pv + ext, notch_h + pm_h * pv; corner: 18; blend: fillet }
            box right_m { from: screen.width - (rw + max(0, rpw - rw) * rv), -14; size: rw + max(0, rpw - rw) * rv + ext, notch_h + rph * rv; corner: 18; blend: fillet }
            box center_m { from: screen.width / 2 - (cw + max(0, cpw - cw) * cv) / 2, -14; size: cw + max(0, cpw - cw) * cv, notch_h + cph * cv; corner: 18; blend: fillet }

            //  The dock, rising from the floor.
            //  The dock island. Hidden it is zero wide as well as sunk (no bump of its fillet is left on the floor);
            //  with a bottom panel open (Spotlight, wallpapers) it grows up and out into the panel's glass.
            box dock_island { from: screen.width / 2 - (dw * clamp(vis * 1.25 - 0.05, 0, 1) + max(0, bpw - dw) * bv) / 2, screen.height - dock_h * vis - max(0, bph - dock_h) * bv; size: dw * clamp(vis * 1.25 - 0.05, 0, 1) + max(0, bpw - dw) * bv, dock_h + ext + max(0, bph - dock_h) * bv; corner: 24; blend: dock_fillet }
        }

        // ── left island: menu orb · workspace · window ───────────
        row left_row {
            at: pad, cy
            anchor: left middle
            gap: 10
            align: center

            //  The menu button: a small gem in the accent colours (the mark of the shell)
            group {
                size: 24, 24
                prop hot = 0 ~quick
                group {
                    pivot: 12, 12
                    scale: 1 + hot * 0.08
                    body {
                        gradient: 0, 0 to 24, 24, accent_c, focus_c
                        box { from: 1, 1; size: 22, 22; corner: 7 }
                    }
                    path { at: 5.5, 5.5; color: #ffffff; stroke: 1.7; move 6.5, 0; line 13, 6.5; line 6.5, 13; line 0, 6.5; close }
                    path { at: 9, 9; color: #ffffff; move 3, 0; line 6, 3; line 3, 6; line 0, 3; close }
                }
                zone box logo_hit { from: 0, 0; size: 24, 24; corner: 7; cursor: pointer }
                on enter logo_hit { hot: 1 }
                on leave logo_hit { hot: 0 }
                on press logo_hit while open and open_screen == screen.index { open = false }
                on press logo_hit while not (open and open_screen == screen.index) { open_screen = screen.index; open = true }
                on press right logo_hit { }
            }

            //  the workspaces of THIS monitor
            row {
                gap: 0
                align: center
                for w in ws_list { WsDot(w) { show: w.out == screen.index } }
            }

            //  the apps open here, the focused one named
            row {
                gap: 2
                align: center
                for it in cur_apps { CurApp(it) { show: it.out == screen.index } }
            }
        }

        // ── the volume / brightness feedback, inside the centre pill (the clock gives way) ──
        group {
            show: ov > 0.02
            opacity: clamp(ov * 1.6 - 0.5, 0, 1)
            move: screen.width / 2 - 125, 0
            //  the icon: a speaker with waves (or crossed out when muted), or a sun for brightness
            group {
                show: osd_kind == 0
                path { at: 0, cy - 7; color: ink_c; move 0, 4; line 4, 4; line 9, 0; line 9, 14; line 4, 10; line 0, 10; close }
                path { at: 11, cy; color: ink_c; stroke: 1.8; opacity: if(osd_muted, 0%, if(osd_level > 0.05, 100%, 25%)); move 0, -3.5; line 2.5, -1.5; line 2.5, 1.5; line 0, 3.5 }
                path { at: 14, cy; color: ink_c; stroke: 1.8; opacity: if(osd_muted, 0%, if(osd_level > 0.5, 100%, 25%)); move 0, -6.5; line 3, -3; line 3, 3; line 0, 6.5 }
                line { from: 13, cy - 7; to: 23, cy + 7; width: 2; color: danger_c; opacity: if(osd_muted, 100%, 0%) }
            }
            group {
                show: osd_kind == 1
                ellipse { at: 8, cy; radius: 3.6; color: ink_c }
                repeat k in 0..8 { line { from: 8 + 6 * cos(k * 45), cy + 6 * sin(k * 45); to: 8 + 8.4 * cos(k * 45), cy + 8.4 * sin(k * 45); width: 1.5; color: ink_c } }
            }
            //  the track and its fill, and the number
            box { from: 36, cy - 3; size: 160, 6; corner: 3; color: ink_c; opacity: 22% }
            box { from: 36, cy - 3; size: max(6, 160 * clamp(if(osd_muted and osd_kind == 0, 0, osd_level), 0, 1)), 6; corner: 3; color: ink_c }
            text if(osd_muted and osd_kind == 0, "0", "{osd_level * 100, 0}") { at: 244, cy; anchor: right center; size: 12; weight: 700; color: ink_c }
        }

        // ── centre island: clock · weather · sound ───────────────
        row center_row {
            at: screen.width / 2, cy
            anchor: center middle
            opacity: 1 - max(bnv, ov)
            gap: 12
            align: center

            row rec_chip {
                show: rec_on
                gap: 6
                align: center
                cursor: pointer
                ellipse { at: 4.5, 4.5; radius: 4.5; color: danger_c; opacity: 0.55 + 0.45 * (0.5 + 0.5 * rdot) }
                text rec_time { size: 12; weight: 700; color: ink_c }
            }
            row music_chip {
                show: m_on
                gap: 7
                align: center
                cursor: pointer
                group {
                    size: 22, 22
                    ellipse { at: 11, 11; radius: 11; color: accent_c }
                    group {
                        clip box { from: 0, 0; size: 22, 22; corner: 11 }
                        image m_cover { at: 0, 0; size: 22, 22; show: m_has_art }
                    }
                }
                group {
                    size: 14, 16
                    box { from: 0, 8 - (2.5 + mplay * (3 + 3 * mb1)); size: 3, (2.5 + mplay * (3 + 3 * mb1)) * 2; corner: 1.5; color: ink_c }
                    box { from: 5, 8 - (2.5 + mplay * (3 + 3 * mb2)); size: 3, (2.5 + mplay * (3 + 3 * mb2)) * 2; corner: 1.5; color: ink_c }
                    box { from: 10, 8 - (2.5 + mplay * (3 + 3 * mb3)); size: 3, (2.5 + mplay * (3 + 3 * mb3)) * 2; corner: 1.5; color: ink_c }
                }
            }
            row clock {
                gap: 6
                align: center
                cursor: pointer
                text now.date { size: 11; weight: 600; color: ink_sub }
                text now.time { size: 12.5; weight: 700; color: ink_c }
            }

            row {
                gap: 4
                align: center
                text weather_icon { size: 12; color: hint_c }
                text weather_temp { size: 11; weight: 600; color: ink_c }
            }

        }
        on press clock { last_screen = screen.index; emit open_dashboard }
        on press rec_chip { emit rec_stop }
        on press right rec_chip { }
        on press music_chip { last_screen = screen.index; emit open_music }
        on press right music_chip { }
        //  Right button is ours (see the tray): a right click on anything here does nothing
        //  instead of quitting the shell.
        on press right clock { }

        // ── right island: tray · network · battery · control centre · notifications ──
        row right_row {
            at: screen.width - pad, cy
            anchor: right middle
            gap: 10
            align: center

            row {
                gap: 6
                align: center
                for i in icons {
                    group {
                        size: 20, 20
                        image i.icon { at: 1, 1; size: 18, 18 }
                        zone box tray_hit { from: 0, 0; size: 20, 20; cursor: pointer }
                        on press tray_hit { emit tray_activate(i.index) }
                        on press middle tray_hit { emit tray_secondary(i.index) }
                        //  Right click: the application shows its own menu. This rule is also what
                        //  tells pleamar the right button is in use: without any `on press right`
                        //  in a scene, a right click ANYWHERE on it quits the whole process.
                        on press right tray_hit { emit tray_context(i.index) }
                    }
                }
            }

            WifiIcon(open_cc_wifi)
            //  Bluetooth only while something is connected.
            group {
                show: bt_connected
                BluetoothIcon(open_cc_bt)
            }
            group {
                show: bat.present
                BatteryIcon(open_dashboard)
            }
            SwitchesIcon(open_control_center)
            BellIcon(open_notifications)
        }

        //  A thin strip along the bottom edge brings a hidden dock back.
        zone box dock_edge { from: screen.width / 2 - 300, screen.height - 4; size: 600, 4; active: vis < 0.5 }
        on enter dock_edge { emit reveal }
        on press right dock_edge { }

        // ── the power menu's items ───────────────────────────────
        group {
            show: pv > 0.02
            opacity: clamp(pv * 1.6 - 0.45, 0, 1)
            move: 14, 48 + (1 - pv) * -10
            zone box pm_panel { from: -14, -4; size: pm_w, pm_h; corner: 18 }
            on press right pm_panel { }
            on away pm_panel for 1300ms { open = false }
            column {
                at: 0, 0
                gap: 2
                PowerItem("About This PC", 1)
                PowerItem("System Settings…", 2)
                box { from: 6, 0; size: pm_w - 40, 1; color: ink_c; opacity: 14% }
                PowerItem("Lock Screen", 3)
                PowerItem("Sleep", 4)
                box { from: 6, 0; size: pm_w - 40, 1; color: ink_c; opacity: 14% }
                PowerItem("Log Out…", 5)
                PowerItem("Restart…", 6)
                PowerItem("Shut Down…", 7, true)
            }
        }

        // ── the dock ─────────────────────────────────────────────
        row dock_row {
            at: screen.width / 2, screen.height - dock_h / 2 - 1 + (1 - vis) * (dock_h + 20)
            anchor: center middle
            opacity: vis * (1 - bv)
            gap: 10
            align: center

            for it in dock_items { DockItem(it) }
        }
    }

    Shell()
}
