// macOS Bezel On-Screen Display (OSD) for Volume & Brightness
import "common/palette.plm"

scene MacOsd {
    surface {
        size: 260, 260
        anchor: center
        level: overlay
    }

    permissions {
        services: "audio", "audio.*", "brightness", "brightness.*"
    }

    service audio as sound { volume: number; muted: bool }
    service brightness as display { present: bool; level: number }

    fact open = false
    fact dark_mode = true
    fact skin = 0
    fact kind = 0   // 0 = Volume, 1 = Brightness
    fact level = 0.5
    fact muted = false

    let bg_color = if(dark_mode, if(skin == 2, #1e2026, if(skin == 1, #1c1e28, #161820)), if(skin == 2, #f2f3f7, if(skin == 1, #eaecf2, #f8f9fc)))
    let glass_amt = if(skin == 2, 0%, if(skin == 1, 55%, 85%))
    let tint_amt = if(skin == 2, 0%, if(dark_mode, 40%, 25%))
    let rim_amt = if(skin == 2, 0%, 14%)
    let shadow_amt = if(dark_mode, 40%, 20%)
    let ink_c = if(dark_mode, #f5f7f5, #1d1d1f)
    let ink_sub = if(dark_mode, #8e8e93, #6e6e73)
    let track_bg = if(dark_mode, #343740, #dcdfe6)
    let bar_fill = if(dark_mode, #ffffff, #007aff)

    event popup
    event volume_up ->
    event volume_down ->
    event volume_mute ->
    event brightness_up ->
    event brightness_down ->

    prop seen = 0 ~quick
    prop scale = 0.9 ~lively

    layer panel ~quick {
        shown while open { seen: 1 ~quick; scale: 1 ~lively }
        gone             { seen: 0 ~quick; scale: 0.92 ~quick }
    }

    group {
        move: 30, 30
        pivot: 100, 100
        scale: scale
        opacity: seen

        // Square Bezel Frame
        body {
            color: bg_color
            glass: glass_amt
            lens: false
            frost: 100%
            dispersion: 0
            refraction: 0
            tint: tint_amt
            rim: rim_amt
            shadow: 0, 16, 32, shadow_amt
            box { from: 0, 0; size: 200, 200; corner: 26 }
        }

        // ── Volume Mode (kind == 0) ───────────────────────────────
        group {
            show: kind == 0
            text "󰝟" { at: 100, 80; anchor: center; size: 54; color: ink_c; show: muted }
            text "󰕾" { at: 100, 80; anchor: center; size: 54; color: ink_c; show: not muted and level > 0.6 }
            text "󰖀" { at: 100, 80; anchor: center; size: 54; color: ink_c; show: not muted and level <= 0.6 and level > 0.2 }
            text "󰕿" { at: 100, 80; anchor: center; size: 54; color: ink_c; show: not muted and level <= 0.2 }
            
            text "Mute" { at: 100, 130; anchor: center; size: 13; weight: 600; color: ink_sub; show: muted }
            text "Volume" { at: 100, 130; anchor: center; size: 13; weight: 600; color: ink_sub; show: not muted }
        }

        // ── Brightness Mode (kind == 1) ───────────────────────────
        group {
            show: kind == 1
            text "󰃠" {
                at: 100, 80
                anchor: center
                size: 54
                color: ink_c
            }
            text "Brightness" {
                at: 100, 130
                anchor: center
                size: 13
                weight: 600
                color: ink_sub
            }
        }

        // ── Level Bar ─────────────────────────────────────────────
        group {
            move: 24, 154
            size: 152, 12
            box { from: 0, 0; size: 152, 12; corner: 6; color: track_bg }
            box { from: 0, 0; size: if(muted and kind == 0, 0, max(152 * level, 8)), 12; corner: 6; color: bar_fill }
        }
    }
}
