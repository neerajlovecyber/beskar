// macOS Session Shutdown / Restart Confirmation Dialog
import "common/palette.plm"

scene MacSession {
    include "common/theme.plm"
    include "common/here.plm"
    surface sheet {
        size: 520, 360
        anchor: center
        level: overlay
        keyboard: exclusive while open
        screens: each
        open: (open or seen > 0.02) and open_screen == screen.index

    zone box dismiss_scrim { from: 0, 0; size: 520, 360; active: open }

    group {
        move: 40, 40
        pivot: 220, 140
        scale: scale
        opacity: seen

        // Dialog Glass Surface
        body {
            color: bg_color
            glass: glass_amt
            lens: false
            frost: 100%
            dispersion: 0
            refraction: 0
            tint: tint_amt
            rim: rim_amt
            box { from: 0, 0; size: 440, 280; corner: 18 }
        }
        box { from: 0, 0; size: 440, 280; corner: 18; stroke: 1; color: stroke_c; opacity: stroke_op }

        // Top Big Icon
        group {
            move: 220, 52
            ellipse { at: 0, 0; radius: 26; color: pick(kind, danger_c, warn_c, focus_c) }
            text pick(kind, "󰐥", "󰑐", "󰍃") { family: "JetBrainsMono Nerd Font Mono"; at: 0, 0; anchor: center; size: 26; color: on_accent }
        }

        // Title text
        text pick(kind, "Are you sure you want to shut down your computer?", "Are you sure you want to restart your computer?", "Are you sure you want to log out?") {
            at: 220, 102
            anchor: center
            size: 15
            weight: 700
            color: ink_c
            width: 400
            lines: 1
        }

        // Subtitle with live countdown
        text pick(kind, "Your computer will shut down automatically in {countdown} seconds.", "Your computer will restart automatically in {countdown} seconds.", "You will be logged out automatically in {countdown} seconds.") {
            at: 220, 128
            anchor: center
            size: 12
            color: ink_sub
            width: 380
            lines: 1
        }

        // Reopen checkbox card
        group {
            move: 50, 160
            box hit_reopen { from: 0, 0; size: 340, 30; corner: 6; color: scrim_c; opacity: 0%; cursor: pointer }
            box { from: 10, 7; size: 16, 16; corner: 4; color: if(reopen, accent_c, item_solid) }
            text "󰄲" { family: "JetBrainsMono Nerd Font Mono"; at: 18, 15; anchor: center; size: 12; color: on_accent; show: reopen }
            text "Reopen windows when logging back in" { at: 36, 15; anchor: left center; size: 12; color: ink_c }
            on press hit_reopen { toggle reopen }
        }

        // Action Buttons Row (macOS standard: Cancel on left, Primary on right)
        row {
            at: 220, 226
            gap: 16
            anchor: center

            // Cancel Button
            group {
                size: 120, 32
                box { from: 0, 0; size: 120, 32; corner: 8; color: if(dark_mode, item_solid, item_solid) }
                text "Cancel" { at: 60, 16; anchor: center; size: 13; weight: 500; color: ink_c }
                zone box btn_cancel { from: 0, 0; size: 120, 32; cursor: pointer }
                on press btn_cancel { emit dismiss }
            }

            // Primary Action Button (Shut Down / Restart / Log Out)
            group {
                size: 130, 32
                box { from: 0, 0; size: 130, 32; corner: 8; color: pick(kind, danger_c, warn_c, accent_c) }
                text pick(kind, "Shut Down", "Restart", "Log Out") { at: 65, 16; anchor: center; size: 13; weight: 600; color: on_accent }
                zone box btn_confirm { from: 0, 0; size: 130, 32; cursor: pointer }
                on press btn_confirm { emit confirm_action }
            }
        }
    }
        on press dismiss_scrim { open = false }
    on press right dismiss_scrim { }
    }

    permissions {
        services: "say:topbar"
        run: "systemctl", "niri msg"
    }

    fact open = false
    fact kind = 0            // 0: Shut Down, 1: Restart, 2: Log Out
    fact countdown = 60      // 60-second automatic timer
    fact reopen = true       // Reopen windows when logging back in

    prop seen = 0 ~quick
    prop scale = 0.96 ~lively

    layer modal ~quick {
        shown while open { seen: 1 ~quick; scale: 1 ~lively }
        gone             { seen: 0 ~quick; scale: 0.96 ~quick }
    }

    let stroke_c = card_stroke
    let stroke_op = card_stroke_op

    event toggle
    event confirm_action ->
    event dismiss

    // Dismiss zone
    // A scene that never uses the right button is closed by pleamar on any right click
    // (its prototype emergency exit). This empty rule says the right button is ours: nothing happens.


    on toggle     { toggle open }
    on dismiss    { open = false }
    on key Escape { open = false }
}
