// Clipboard history (Super+V). It grows out of the dock, like Spotlight: the frame draws the glass (the dock island
// rises into it, topbar.plm), this scene draws only the content on the monitor with the focus.
//
//   · type to search the history (up to 100 entries, kept across restarts by cliphist)
//   · the pin on a row keeps that text for good: pinned entries stay at the top and are never removed
//   · Enter or a click copies the entry back; Up / Down move; the wheel scrolls
import "common/palette.plm"

scene MacClipboard {
    let mp_sw = 600
    let mp_sh = 560
    include "common/theme.plm"
    include "common/ui.plm"
    include "common/morph_core.plm"

    surface sheet {
        size: 600, 560
        anchor: bottom
        margin: 0, 0, 0, 0
        level: overlay
        keyboard: exclusive while open
        screens: each
        open: (open or seen > 0.02) and open_screen == screen.index

        zone box dismiss { from: 0, 0; size: 600, 560; active: open }
        on press dismiss { open = false }
        on press right dismiss { }

        PanelBody(20, 560, 1) {

            //  clicks on the panel itself do not close it; the wheel scrolls the list
            zone box inside { from: 0, 0; size: 560, 520 }
            on press right inside { }
            on scroll inside { emit clip_scroll(wheel) }

            // Header: title, count, Clear All
            PanelHeader("󰅌", "Clipboard History")
            text clip_count { at: 430, 30; anchor: right center; size: t_cap; color: ink_sub }
            group { move: 450, 17; Pill("Clear All", 80, clear_all, 0, 26, true) }

            // Search field: at the bottom, like every dock panel
            PanelSearch(560, ph)
            input clip_q {
                at: 68, ph - 50
                width: 450
                size: 19
                color: ink_c
                placeholder: "Search clipboard history"
                selection: accent_c
            }

            // Entries: pinned first, then the most recent
            column clip_list {
                at: 20, 58
                gap: 4
                for c in clips { ClipRow(c) }
            }

            group { show: clips.count < 1; EmptyState(280, 92, "󰅌", "Nothing copied yet", "Copy something and it shows up here") }
        }
    }

    permissions {
        services: "say:topbar", "say:music", "say:weather", "say:spotlight", "say:control_center", "say:notifications", "say:dashboard", "say:settings", "say:wallpapers", "say:widget_bar", "files", "files.write"
        run: "cliphist", "wl-copy", "notify-send", "sh"
    }

    fact sel = 0

    //  Painted by clipboard.luau. `src` is where it came from in the logic's lists; `pinned` shows the pin.
    model clips max 8 { src: number; preview: text; pinned: bool; pinnable: bool; is_img: bool; ready: bool; thumb: image 56, 34 }
    text clip_q = ""
    text clip_count = ""
    text clip_empty = "Nothing copied yet"

    let stroke_c = card_stroke
    let stroke_op = card_stroke_op

    event toggle
    event copy_clip ->
    event pin_clip ->
    event clear_all ->
    event clip_scroll ->

    component ClipRow(c: record) {
        size: 520, 42
        prop on = 0 ~quick
        follow on = if(sel == c.index, 1, 0)
        prop pin_hot = 0 ~quick

        // Pill background
        RowFrame(480, 42, on)
        zone box hit { from: 0, 0; size: 480, 42; corner: r_m; cursor: pointer }

        //  An image: its thumbnail (or a faint box until it is made) in place of the text icon
        group {
            show: c.is_img
            box { from: 10, 4; size: 56, 34; corner: 6; color: item_solid }
            image c.thumb { at: 10, 4; size: 56, 34; show: c.ready }
        }

        // Clip text preview
        row {
            at: if(c.is_img, 76, 14), 12
            gap: 10
            align: center

            text "󰈙" { family: "JetBrainsMono Nerd Font Mono"; size: 14; color: if(on > 0.5, accent_c, ink_sub); show: not c.is_img }
            text c.preview {
                size: 13
                weight: if(on > 0.5, 600, 400)
                color: ink_c
                width: 420
                lines: 1
            }
        }

        //  The pin: a pushpin, filled and in the accent colour when pinned, a faint outline otherwise (shown on the
        //  row under the pointer or the cursor, and always when pinned)
        group {
            show: c.pinnable
            opacity: if(c.pinned, 100%, on * 70%)
            move: 488, 9
            ellipse { at: 12, 8.5; radius: 5; color: if(c.pinned, accent_c, ink_sub) }
            ellipse { at: 12, 8.5; radius: 5; stroke: 1.5; color: if(c.pinned, accent_c, ink_sub); opacity: if(c.pinned, 0%, 100%) }
            line { from: 12, 13.5; to: 12, 22; width: 1.8; color: if(c.pinned, accent_c, ink_sub) }
            line { from: 7, 14; to: 17, 14; width: 1.8; color: if(c.pinned, accent_c, ink_sub) }
            zone box pin_hit { at: 12, 12; size: 28, 28; corner: 8; cursor: pointer }
            on press pin_hit { emit pin_clip(c.index) }
            on press right pin_hit { }
        }

        on enter hit { sel = c.index }
        on press hit { emit copy_clip(c.index) }
        on press right hit { }
    }

    on toggle     { toggle open; focus clip_q }
    on key Down   { sel = min(sel + 1, max(clips.count - 1, 0)) }
    on key Up     { sel = max(sel - 1, 0) }
    on key Return { emit copy_clip(sel) }
    on key Tab    { sel = min(sel + 1, max(clips.count - 1, 0)) }
    on key Escape { open = false }
    on blur       { open = false }
}
