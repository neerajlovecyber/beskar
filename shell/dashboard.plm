// Dashboard ("Today"): drops from the centre island (click the clock). A greeting, the weather (a click opens the
// weather panel), a month calendar, how busy the machine is, and the battery. Logic: dashboard.luau.
import "common/palette.plm"

scene MacDashboard {
    let mp_sw = 380
    let mp_sh = 640
    include "common/theme.plm"
    include "common/icons.plm"
    include "common/ui.plm"
    include "common/morph.plm"
    surface {
        size: 380, 640
        anchor: top
        margin: 0, 0, 0, 0
        level: overlay
        screens: each
    }

    permissions {
        services: "clock", "battery", "say:spotlight", "say:clipboard", "say:music", "say:weather", "say:updates", "say:control_center", "say:notifications", "say:settings", "say:wallpapers", "say:widget_bar", "say:topbar"
        run: "sh", "curl"
    }

    service battery as bat { present: bool; percent: number; charging: bool }

    fact cpu_pct = 0
    fact mem_pct = 0
    fact disk_pct = 0
    fact bat_ac = false
    fact cal_shift = 0               // months away from this one (0 = now)
    text greeting = "Hello"
    text today_text = ""
    text uptime_text = ""
    text bat_state = ""
    text bat_sub = ""
    text cal_title = ""
    text weather_temp = "--°"
    text weather_cond = ""
    text weather_city = "…"
    text weather_icon = "󰅟"
    text weather_range = ""
    text weather_feels = ""
    text weather_extra = ""

    //  the month grid: Monday first; `dim` = a day of the month before / after; `today` = this very day
    model cells max 42 { d: text; dim: bool; today: bool }

    let bar_track = item_solid
    prop hot = 0 ~quick

    event toggle
    event refresh_stats ->
    event weather_reload ->
    event open_weather ->
    event cal_prev ->
    event cal_next ->
    event cal_now ->

    on press dismiss { open = false }

    //  The glass behind this is drawn by the frame (topbar.plm), melting out of the centre island.
    PanelBody(16, -2) {

        //  clicks on the card itself do not close it
        zone box inside { from: 0, 0; size: 348, 620 }
        on press right inside { }

        // ── greeting ──────────────────────────────────────────────
        text greeting { at: 20, 24; anchor: left center; size: t_title; weight: 700; color: ink_c }
        text today_text { at: 20, 46; anchor: left center; size: t_sub; color: ink_sub }

        // ── weather: a wide card, a click opens the weather panel ─
        group {
            move: 14, 62
            CardBg(320, 92, r_l, true)
            box { from: 0, 0; size: 320, 92; corner: r_l; color: ink_c; opacity: hot * 6% }
            text weather_city { at: 16, 20; anchor: left center; size: t_body; weight: 700; color: ink_c; width: 190; lines: 1 }
            text weather_cond { at: 16, 40; anchor: left center; size: t_sub; color: ink_sub; width: 190; lines: 1 }
            text weather_temp { at: 16, 70; anchor: left center; size: 32; weight: 700; color: ink_c }
            Sym(weather_icon, 290, 28, 30, warn_c)
            text weather_range { at: 304, 56; anchor: right center; size: t_sub; weight: 600; color: ink_c }
            text weather_feels { at: 304, 74; anchor: right center; size: t_cap; color: ink_sub }
            zone box weather_hit { from: 0, 0; size: 320, 92; corner: r_l; cursor: pointer; label: "Open the weather" }
            on enter weather_hit { hot: 1 }
            on leave weather_hit { hot: 0 }
            on press weather_hit { emit open_weather }
            on press right weather_hit { }
        }

        // ── month calendar ────────────────────────────────────────
        group {
            move: 14, 166
            CardBg(320, 232, r_l, true)
            //  title and the month buttons; a click on the title comes back to this month
            text cal_title { at: 16, 22; anchor: left center; size: t_body; weight: 700; color: ink_c }
            zone box cal_title_hit { from: 8, 8; size: 170, 30; corner: r_s; cursor: pointer; label: "This month" }
            on press cal_title_hit { emit cal_now }
            on press right cal_title_hit { }
            group {
                move: 248, 8
                box { from: 0, 0; size: 28, 28; corner: r_s; color: item_bg; opacity: item_bg_op }
                Sym("󰅁", 14, 14, 15, ink_c)
                zone box prev_hit { from: 0, 0; size: 28, 28; corner: r_s; cursor: pointer; label: "Previous month" }
                on press prev_hit { emit cal_prev }
                on press right prev_hit { }
            }
            group {
                move: 282, 8
                box { from: 0, 0; size: 28, 28; corner: r_s; color: item_bg; opacity: item_bg_op }
                Sym("󰅂", 14, 14, 15, ink_c)
                zone box next_hit { from: 0, 0; size: 28, 28; corner: r_s; cursor: pointer; label: "Next month" }
                on press next_hit { emit cal_next }
                on press right next_hit { }
            }
            //  weekdays
            repeat i in 0..7 {
                text pick(i, "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun") { at: 16 + i * 41.3 + 20, 52; anchor: center center; size: t_micro; weight: 600; color: if(i >= 5, accent_c, ink_sub) }
            }
            //  days
            grid {
                at: 16, 66
                columns: 7
                gap: 0
                width: 289
                row: 27
                for c in cells {
                    group {
                        size: 41.3, 27
                        ellipse { at: 20.6, 13.5; radius: 12.5; color: accent_c; show: c.today }
                        text c.d { at: 20.6, 13.5; anchor: center center; size: t_sub; weight: if(c.today, 700, 500); color: if(c.today, on_accent, ink_c); opacity: if(c.dim, 35%, 100%) }
                    }
                }
            }
        }

        // ── how busy the machine is ───────────────────────────────
        group {
            move: 14, 410
            CardBg(320, 124, r_l, true)
            Sym("󰍹", 24, 20, 14, accent_c)
            text "Activity" { at: 40, 20; anchor: left center; size: t_sub; weight: 600; color: ink_c }
            text uptime_text { at: 304, 20; anchor: right center; size: t_cap; color: ink_sub }
            Meter(34, "CPU", cpu_pct, accent_c)
            Meter(62, "Memory", mem_pct, mint)
            Meter(90, "Disk", disk_pct, purple)
        }

        // ── battery (laptops) ─────────────────────────────────────
        group {
            show: bat.present
            move: 14, 546
            CardBg(320, 66, r_l, true)
            //  the cell: green with a bolt while on the charger
            box { from: 16, 21; size: 34, 17; corner: 5; stroke: 1.8; color: ink_c }
            box { from: 51, 26; size: 3, 6; corner: 1.5; color: ink_c }
            box { from: 19, 24; size: max(3, 28 * clamp(bat.percent / 100, 0, 1)), 11; corner: 2.5; color: if(bat.charging or bat_ac, ok_c, if(bat.percent <= 20, danger_c, ink_c)) }
            text bat_state { at: 70, 23; anchor: left center; size: t_sub; weight: 600; color: ink_c }
            text bat_sub { at: 70, 43; anchor: left center; size: t_micro; color: ink_sub; width: 190; lines: 1 }
            text "{bat.percent}%" { at: 304, 33; anchor: right center; size: 22; weight: 700; color: ink_c }
        }
    }

    //  one labelled meter of the activity card (y = its row)
    component Meter(y: number, label: text, pct: number, tone: color) {
        text label { at: 16, y + 9; anchor: left center; size: t_cap; weight: 600; color: ink_c }
        text "{pct}%" { at: 304, y + 9; anchor: right center; size: t_cap; weight: 600; color: tone }
        box { from: 70, y + 6; size: 180, 6; corner: 3; color: bar_track }
        box { from: 70, y + 6; size: max(6, 180 * clamp(pct / 100, 0, 1)), 6; corner: 3; color: tone }
    }

    on toggle     { toggle open }
    on key Escape { open = false }
    on blur       { open = false }
}
