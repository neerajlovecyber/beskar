// KEYS: the one surface that takes the keyboard while a panel is open, on the open panel's monitor.
// pleamar delivers keys and typing only to the FIRST copy of a `screens: each` surface, so the frame (topbar.plm, one copy per monitor)
// cannot receive them on a second monitor. This scene's single surface follows the panel's monitor by name (like the Settings window),
// is click-through except its fields, and:
//   · forwards every key the panels use to the frame as an event (`on key Down` -> `Topbar.k_down`), focus loss as `Topbar.k_blur`;
//   · owns the panels' text fields, drawn where the frame draws the panels (`reserve: -1`: it starts at the top of the screen like the
//     frame); a field's Enter is `Topbar.sub_<field>`; the frame's logic reads the texts as `Keys.<field>` (keys_text.luau) and writes
//     them through `Keys.set_text`;
//   · focuses the field the frame asks for (`Topbar.fld_req`, bumped by `Topbar.fld_seq`).
import "common/palette.plm"
uses scene "settings.plm" as Settings
uses scene "panels.plm" as Panels
uses scene "topbar.plm" as Topbar
uses scene "personal.plm" as Personal
uses scene "activities.plm" as Activities

scene Keys {
    include "common/theme_owner.plm"
    include "common/theme.plm"

    permissions {
        services: "say:topbar"
    }

    text wq = ""
    text pe_draft = ""
    text pe_new_task = ""
    text tm_duration = "25"
    text query = ""
    text clip_q = ""
    text wb_name = ""
    text password = ""
    text wifi_pw = ""
    //  the Settings window's fields (common/settings_panel.plm draws the boxes; the Settings scene reads and writes the texts)
    text side_q = ""
    text bind_q = ""
    text look_name = ""
    text look_document = ""
    text quiet_from = "22:00"
    text quiet_to = "07:00"
    text shortcut_key = ""
    text custom_accent_edit = ""
    text frame_output_edit = ""
    event set_text ->           // { name, value } from the frame's logic

    prop fld_b = 0 ~calm
    follow fld_b = if(Panels.open and (Panels.cur == 4 or Panels.cur == 6 or (Panels.cur == 10 and Topbar.wb_page == 1)), 1, 0)
    prop fld_v = 0 ~calm
    follow fld_v = if(Panels.open and ((Panels.cur == 15 and Topbar.wx_view == 1) or Panels.cur == 25 or Panels.cur == 26 or Panels.cur == 12 or (Panels.cur == 1 and Topbar.asking)), 1, 0)

    prop fld_g = 0 ~calm
    follow fld_g = if(Panels.open and Panels.cur == 30, 1, 0)

    surface field {
        size: full, full
        anchor: top
        reserve: -1
        level: overlay
        screens: Panels.panel_mon
        open: Panels.open
        keyboard: exclusive while Panels.open

        group {
            show: Panels.cur == 4 and fld_b > 0.5
            move: screen.width / 2 - 320, screen.height - Panels.panel_h
            input query { at: panel_search_text_x, Panels.panel_h - panel_search_text_y; width: 530; size: panel_search_font; color: ink_c; placeholder: "Search · / files · @ windows · ? settings"; selection: accent_c }
        }
        group {
            show: Panels.cur == 6 and fld_b > 0.5
            move: screen.width / 2 - 280, screen.height - Panels.panel_h
            input clip_q { at: panel_search_text_x, Panels.panel_h - panel_search_text_y; width: 450; size: panel_search_font; color: ink_c; placeholder: "Search clipboard history"; selection: accent_c }
        }
        group {
            show: Panels.cur == 10 and Topbar.wb_page == 1 and fld_b > 0.5
            move: screen.width / 2 - 400, screen.height - Panels.panel_h
            input wb_name { at: 36, 58; width: 316; size: font_secondary; color: ink_c; placeholder: "Name this desktop"; selection: accent_c }
        }
        group {
            show: Panels.cur == 12 and fld_v > 0.5
            move: screen.width / 2 - 240 + Topbar.shake, screen.height - Panels.panel_h
            input password { at: 42, 181; width: 396; size: 14; color: ink_c; placeholder: "Password"; secret: true; agent: no }
        }
        group {
            show: Panels.cur == 15 and Topbar.wx_view == 1 and fld_v > 0.5
            move: screen.width / 2 - 194, 40
            input wq { at: 44, 104; width: 330; size: font_title; color: ink_c; placeholder: "Search a city"; selection: accent_c }
        }
        group {
            show: Panels.cur == 25 and Topbar.pe_tab == 0 and Topbar.pe_selected > 0 and Personal.ready and fld_v > 0.5
            move: screen.width / 2 - 300, 40
            input pe_draft { at: 216, 80; width: 346; height: 324; size: t_body; color: ink_c; selection: accent_c; placeholder: "Write a note…" }
        }
        group {
            show: Panels.cur == 25 and Topbar.pe_tab == 1 and Personal.ready and fld_v > 0.5
            move: screen.width / 2 - 300, 40
            input pe_new_task { at: 36, 119; width: 418; size: t_body; color: ink_c; selection: accent_c; placeholder: "Add a to-do…" }
        }
        group {
            show: Panels.cur == 26 and (Activities.timer_state == 0 or Activities.timer_state == 3) and fld_v > 0.5
            move: screen.width / 2 - 194, 40
            input tm_duration { at: 32, 226; width: 324; size: t_body; color: ink_c; selection: accent_c; placeholder: "Minutes or 1h30m"; label: "Timer duration" }
        }
        group {
            show: Panels.cur == 1 and Topbar.asking and fld_v > 0.5
            move: screen.width - 366, 40
            input wifi_pw { at: 46, 136; width: 270; size: font_body; color: ink_c; secret: true; placeholder: "Password"; selection: accent_c }
        }

        //  ── the Settings window (840 x 580, centred; common/settings_panel.plm). The window's origin: ──
        group {
            show: Panels.cur == 30 and fld_g > 0.5
            move: screen.width / 2 - 420, screen.height / 2 - 290
            //  the sidebar search
            input side_q { at: 46, 114; width: 160; size: font_secondary; color: ink_c; placeholder: "Search"; selection: accent_c }
            group {
                show: Settings.tab == 5 and not Settings.shortcut_open
                input bind_q { at: 288, 68; width: 440; size: font_body; color: ink_c; placeholder: "Search shortcuts"; selection: accent_c }
            }
            group {
                show: Settings.tab == 5 and Settings.shortcut_open
                input shortcut_key { at: 266, 268; width: 532; size: font_body; color: ink_c; selection: accent_c; placeholder: "For example Mod+Shift+K" }
            }
            group {
                show: Settings.tab == 0 and Settings.look_open
                input look_name { at: 266, 106; width: 276; size: font_secondary; color: ink_c; selection: accent_c; placeholder: "Name this appearance" }
                input look_document { at: 266, 420; width: 532; size: font_secondary; color: ink_c; selection: accent_c; placeholder: "Paste an appearance document to review" }
            }
            group {
                show: Settings.tab == 3 and Settings.quiet_edit
                input quiet_from { at: 310, 242; width: 76; size: font_secondary; color: ink_c; selection: accent_c }
                input quiet_to { at: 458, 242; width: 76; size: font_secondary; color: ink_c; selection: accent_c }
            }
            //  the two fields inside a scrolling list follow the list (`stg_sc0` / `stg_sc4`: y of the card in the list, from settings_catalog.luau, + the field's own offset)
            group {
                show: Settings.tab == 0 and not Settings.look_open
                clip box { from: 254, 60; size: 560, 500 }
                input custom_accent_edit { at: 282, 712 - Topbar.stg_sc0; width: 124; size: font_secondary; color: ink_c; selection: accent_c; placeholder: "#RRGGBB" }
            }
            group {
                show: Settings.tab == 4 and not Settings.pin_edit
                clip box { from: 254, 60; size: 560, 500 }
                input frame_output_edit { at: 282, 920 - Topbar.stg_sc4; width: 276; size: font_secondary; color: ink_c; selection: accent_c; placeholder: "HDMI-A-1 · empty follows focus" }
            }
        }
    }

    //  the frame's keys, forwarded
    on key a { emit Topbar.k_a }
    on key Alt+Delete { emit Topbar.k_alt_delete }
    on key Alt+Down { emit Topbar.k_alt_down }
    on key Alt+Left { emit Topbar.k_alt_left }
    on key Alt+Right { emit Topbar.k_alt_right }
    on key Alt+Up { emit Topbar.k_alt_up }
    on key BackSpace { emit Topbar.k_backspace }
    on key c { emit Topbar.k_c }
    on key Ctrl+d { emit Topbar.k_ctrl_d }
    on key Ctrl+Down { emit Topbar.k_ctrl_down }
    on key Ctrl+F1 { emit Topbar.k_ctrl_f1 }
    on key Ctrl+F2 { emit Topbar.k_ctrl_f2 }
    on key Ctrl+F3 { emit Topbar.k_ctrl_f3 }
    on key Ctrl+KP_Enter { emit Topbar.k_ctrl_kp_enter }
    on key Ctrl+Left { emit Topbar.k_ctrl_left }
    on key Ctrl+n { emit Topbar.k_ctrl_n }
    on key Ctrl+p { emit Topbar.k_ctrl_p }
    on key Ctrl+Return { emit Topbar.k_ctrl_return }
    on key Ctrl+Right { emit Topbar.k_ctrl_right }
    on key Ctrl+Shift+Tab { emit Topbar.k_ctrl_shift_tab }
    on key Ctrl+Tab { emit Topbar.k_ctrl_tab }
    on key Ctrl+u { emit Topbar.k_ctrl_u }
    on key Ctrl+Up { emit Topbar.k_ctrl_up }
    on key Ctrl+z { emit Topbar.k_ctrl_z }
    on key d { emit Topbar.k_d }
    on key Delete { emit Topbar.k_delete }
    on key Down { emit Topbar.k_down }
    on key End { emit Topbar.k_end }
    on key Escape { emit Topbar.k_escape }
    on key f { emit Topbar.k_f }
    on key F2 { emit Topbar.k_f2 }
    on key F3 { emit Topbar.k_f3 }
    on key F4 { emit Topbar.k_f4 }
    on key F8 { emit Topbar.k_f8 }
    on key Home { emit Topbar.k_home }
    on key KP_Enter { emit Topbar.k_kp_enter }
    on key l { emit Topbar.k_l }
    on key Left { emit Topbar.k_left }
    on key Next { emit Topbar.k_next }
    on key Page_Down { emit Topbar.k_page_down }
    on key Page_Up { emit Topbar.k_page_up }
    on key Prior { emit Topbar.k_prior }
    on key Return { emit Topbar.k_return }
    on key Right { emit Topbar.k_right }
    on key Shift+Left { emit Topbar.k_shift_left }
    on key Shift+Right { emit Topbar.k_shift_right }
    on key Shift+Tab { emit Topbar.k_shift_tab }
    on key space { emit Topbar.k_space }
    on key t { emit Topbar.k_t }
    on key Tab { emit Topbar.k_tab }
    on key Up { emit Topbar.k_up }
    on keyup KP_Enter { emit Topbar.ku_kp_enter }
    on keyup Return { emit Topbar.ku_return }
    on keyup space { emit Topbar.ku_space }
    on blur { emit Topbar.k_blur }

    //  a field's Enter, and the field the frame asks for
    on submit wq { emit Topbar.sub_wq }
    on submit pe_draft { emit Topbar.sub_pe_draft }
    on submit pe_new_task { emit Topbar.sub_pe_new_task }
    on submit tm_duration { emit Topbar.sub_tm_duration }
    on submit query { emit Topbar.sub_query }
    on submit clip_q { emit Topbar.sub_clip_q }
    on submit wb_name { emit Topbar.sub_wb_name }
    on submit password { emit Topbar.sub_password }
    on submit wifi_pw { emit Topbar.sub_wifi_pw }
    on submit side_q { emit Topbar.sub_side_q }
    on submit shortcut_key { emit Topbar.sub_shortcut_key }
    on submit look_name { emit Topbar.sub_look_name }
    on submit look_document { emit Topbar.sub_look_document }
    on submit quiet_from { emit Topbar.sub_quiet_from }
    on submit quiet_to { emit Topbar.sub_quiet_to }
    on submit custom_accent_edit { emit Topbar.sub_custom_accent_edit }
    on submit frame_output_edit { emit Topbar.sub_frame_output_edit }
    on change Topbar.fld_seq while Topbar.fld_req == 1 { focus wq }
    on change Topbar.fld_seq while Topbar.fld_req == 2 { focus pe_draft }
    on change Topbar.fld_seq while Topbar.fld_req == 3 { focus pe_new_task }
    on change Topbar.fld_seq while Topbar.fld_req == 4 { focus tm_duration }
    on change Topbar.fld_seq while Topbar.fld_req == 5 { focus query }
    on change Topbar.fld_seq while Topbar.fld_req == 6 { focus clip_q }
    on change Topbar.fld_seq while Topbar.fld_req == 7 { focus wb_name }
    on change Topbar.fld_seq while Topbar.fld_req == 8 { focus password }
    on change Topbar.fld_seq while Topbar.fld_req == 9 { focus wifi_pw }
    on change Topbar.fld_seq while Topbar.fld_req == 10 { focus side_q }
    on change Topbar.fld_seq while Topbar.fld_req == 11 { focus shortcut_key }
    on change Topbar.fld_seq while Topbar.fld_req == 12 { focus look_name }
    on change Topbar.fld_seq while Topbar.fld_req == 0 { blur }
}
