// Music panel: grows out of the centre island (click the cover / bars that appear in the clock pill while something
// plays). The frame draws the glass; this scene draws only the content: cover, title, artist, a seekable progress bar
// and the controls. Everything comes from the `media` service (MPRIS).
import "common/palette.plm"

scene MacMusic {
    let mp_sw = 380
    let mp_sh = 260
    include "common/theme.plm"
    include "common/ui.plm"
    include "common/morph.plm"

    surface {
        size: 380, 260
        anchor: top
        margin: 0, 0, 0, 0
        level: overlay
        screens: each
    }

    permissions {
        services: "media", "media.*", "say:topbar", "say:control_center", "say:notifications", "say:dashboard", "say:settings", "say:wallpapers", "say:widget_bar", "say:spotlight", "say:clipboard"
    }

    //  Reported by music.luau
    fact has_player = false
    fact is_playing = false
    fact has_art = false
    fact track_len = 0
    fact track_pos = 0
    text track_title = ""
    text track_artist = ""
    text cover_art = ""
    text time_pos = "0:00"
    text time_len = "0:00"
    image cover = from cover_art, 150, 84      // a wide cell: a 16:9 thumbnail fills it, a square cover sits in the middle; the tile shows the middle

    event toggle
    event play_pause ->
    event previous ->
    event next ->
    event seek ->

    on press dismiss { open = false }

    PanelBody(16, -2) {

        //  clicks on the card itself do not close it
        zone box inside { from: 0, 0; size: 348, 200 }
        on press right inside { }

        // ── nothing is playing ──
        group {
            show: not has_player
            ellipse { at: 174, 70; radius: 26; color: item_solid }
            path { at: 165, 56; color: ink_sub; move 0, 0; line 20, 14; line 0, 28; close }
            text "Nothing playing" { at: 174, 124; anchor: center; size: t_body; weight: 600; color: ink_sub }
            text "Start a song in any player" { at: 174, 144; anchor: center; size: t_cap; color: ink_sub; opacity: 70% }
        }

        // ── a player has something ──
        group {
            show: has_player

            //  cover: a gradient, and the real artwork over it
            body {
                gradient: 0, 0 to 84, 84, accent_c, focus_c
                box { from: 16, 14; size: 84, 84; corner: r_l }
            }
            group {
                clip box { from: 16, 14; size: 84, 84; corner: r_l }
                image cover { at: -18, 13; size: 152, 86; show: has_art }   // a pixel past the tile on every side: no seam
            }
            text track_title { at: 116, 36; anchor: left center; size: t_title; weight: 700; color: ink_c; width: 216; lines: 1 }
            text track_artist { at: 116, 58; anchor: left center; size: t_sub; color: ink_sub; width: 216; lines: 1 }

            //  progress: a click on the bar seeks
            box { from: 16, 118; size: 316, 4; corner: 2; color: slider_bg; opacity: slider_bg_op }
            box { from: 16, 118; size: max(4, 316 * clamp(track_pos / max(track_len, 1), 0, 1)), 4; corner: 2; color: ink_c; show: track_len > 0 }
            text time_pos { at: 16, 136; anchor: left center; size: t_micro; color: ink_sub }
            text time_len { at: 332, 136; anchor: right center; size: t_micro; color: ink_sub; show: track_len > 0 }
            zone box seek_hit { from: 16, 110; size: 316, 20; cursor: pointer; active: track_len > 0 }
            on press seek_hit { emit seek(clamp(local.x / 316, 0, 1)) }

            //  previous · play/pause · next
            path { at: 118, 158; color: ink_c; move 12, 0; line 0, 8; line 12, 16; close }
            box { from: 115, 158; size: 3, 16; corner: 1.5; color: ink_c }
            ellipse { at: 174, 166; radius: 20; color: item_solid }
            group {
                show: is_playing
                box { from: 167, 157; size: 4.5, 18; corner: 2.2; color: ink_c }
                box { from: 177, 157; size: 4.5, 18; corner: 2.2; color: ink_c }
            }
            path { at: 168, 156; color: ink_c; show: not is_playing; move 0, 0; line 16, 10; line 0, 20; close }
            path { at: 220, 158; color: ink_c; move 0, 0; line 12, 8; line 0, 16; close }
            box { from: 233, 158; size: 3, 16; corner: 1.5; color: ink_c }
            zone box prev_hit { at: 125, 166; size: 40, 36; corner: r_l; cursor: pointer }
            zone box play_hit { at: 174, 166; size: 44, 44; corner: r_l; cursor: pointer }
            zone box next_hit { at: 227, 166; size: 40, 36; corner: r_l; cursor: pointer }
            on press prev_hit { emit previous }
            on press play_hit { emit play_pause }
            on press next_hit { emit next }
            on press right prev_hit { }
            on press right play_hit { }
            on press right next_hit { }
            on press right seek_hit { }
        }
    }

    on toggle     { toggle open }
    on key Escape { open = false }
}
