// Modals: the app switcher (Super+Tab), the window overview and the capture picker (screenshot / recording) in ONE scene:
// three named surfaces that share one open / open_screen / cur state (only one is ever up). `cur`: 1 app switcher ·
// 2 overview · 3 capture. Logic: modals.luau (+ modalcore.luau).
import "common/palette.plm"

scene MacModals {
    include "common/theme.plm"
    include "common/ui.plm"
    include "common/icons.plm"
    include "common/here.plm"

    permissions {
        services: "clock", "apps", "window", "thumbnails", "thumbnails.*", "say:topbar", "say:spotlight", "say:control_center", "say:notifications", "say:panels", "say:dock", "say:settings"
        run: "niri msg", "grim", "slurp", "wf-recorder", "wl-copy", "magick", "pkill", "notify-send", "sh", "rm", "cp"
    }

    // ── shared state ────────────────────────────────────────────
    fact open = false
    fact cur = 1
    fact fresh = false           // a window has just taken over (modalcore.luau): its `on blur` is ignored for a moment
    prop seen = 0 ~quick
    prop scale = 0.95 ~lively
    layer modal ~quick {
        shown while open { seen: 1 ~quick; scale: 1 ~lively }
        gone             { seen: 0 ~quick; scale: 0.95 ~quick }
    }
    let stroke_c = card_stroke
    let stroke_op = card_stroke_op
    event mod_sync ->
    on change open { emit mod_sync }
    on change cur { emit mod_sync }
    event cap_toggle ->
    event show_dialog ->
    event toggle_dialog ->

    // ── app switcher ────────────────────────────────────────────
    fact sw_sel = 0
    text sel_title = ""
    prop bw = 260 ~calm
    follow bw = max(260, sw_wins.count * 152 + 32)

    model sw_wins max 7 { id: number; title: text; app_id: text; icon: image 48, 48; thumb: image 132, 78; has_thumb: bool }
    event next_app ->
    event prev_app ->
    event sw_switch_to ->

    component AppTile(w: record) {
        size: 140, 112
        prop on = 0 ~quick
        follow on = if(sw_sel == w.index, 1, 0)

        SelectCard(140, 112, sw_sel == w.index)
        zone box hit { from: 0, 0; size: 140, 112; corner: r_l; cursor: pointer }

        // Preview thumbnail area (clipped)
        group {
            move: 4, 4
            clip box { from: 0, 0; size: 132, 78; corner: r_s }
            box { from: 0, 0; size: 132, 78; corner: r_s; color: bg_color; opacity: 50% }
            image w.thumb { at: 0, 0; size: 132, 78; fit: cover; show: w.has_thumb }
            group {
                show: not w.has_thumb
                move: 66, 39
                image w.icon { at: -22, -22; size: 44, 44 }
            }
        }

        // App Icon Badge in corner of preview
        group {
            move: 8, 56
            box { from: 0, 0; size: 22, 22; corner: 6; color: bg_color; opacity: 90% }
            box { from: 0, 0; size: 22, 22; corner: 6; stroke: 1; color: stroke_c; opacity: stroke_op }
            image w.icon { at: 2, 2; size: 18, 18 }
        }

        // Window Title below preview
        text w.title {
            at: 70, 96
            anchor: center center
            size: 10.5
            weight: if(sw_sel == w.index, 600, 400)
            color: if(sw_sel == w.index, ink_c, ink_sub)
            width: 126
            align: center
            lines: 1
        }

        on press hit { emit sw_switch_to(w.index) }
    }
    on key Tab while cur == 1 { emit next_app }
    on key Left while cur == 1 { emit prev_app }
    on key Right while cur == 1 { emit next_app }
    on key Return while cur == 1 { emit sw_switch_to(sw_sel) }
    on key Escape while cur == 1 { open = false }
    on blur while cur == 1 and not fresh { open = false }

    // ── window overview ─────────────────────────────────────────
    fact ov_sel = 0
    text win_count_text = ""

    model ov_wins max 16 { id: number; title: text; app_id: text; ws: number; ws_label: text; icon: image 48, 48; thumb: image 264, 120; has_thumb: bool }

    // the sheet is as tall as its rows (a few windows no longer sit in a huge empty panel)
    let ov_rows = max(1, ceil(ov_wins.count / 4))
    let ov_w = max(560, 56 + min(4, max(1, ov_wins.count)) * 290)
    let ov_h = min(800, 80 + ov_rows * 181)
    event next_win ->
    event prev_win ->
    event up_win ->
    event down_win ->
    event ov_switch_to ->

    component OverviewTile(w: record) {
        size: 274, 165
        prop on = 0 ~quick
        follow on = if(ov_sel == w.index, 1, 0)

        SelectCard(274, 165, ov_sel == w.index)
        zone box hit { from: 0, 0; size: 274, 165; corner: r_l; cursor: pointer }

        // Preview thumbnail area (clipped)
        group {
            move: 5, 5
            clip box { from: 0, 0; size: 264, 120; corner: r_s }
            box { from: 0, 0; size: 264, 120; corner: r_s; color: bg_color; opacity: 50% }
            image w.thumb { at: 0, 0; size: 264, 120; fit: cover; show: w.has_thumb }
            group {
                show: not w.has_thumb
                move: 132, 60
                image w.icon { at: -24, -24; size: 48, 48 }
            }
        }

        // App Icon Badge in corner of preview
        group {
            move: 10, 10
            box { from: 0, 0; size: 24, 24; corner: 6; color: bg_color; opacity: 90% }
            box { from: 0, 0; size: 24, 24; corner: 6; stroke: 1; color: stroke_c; opacity: stroke_op }
            image w.icon { at: 3, 3; size: 18, 18 }
        }

        // Workspace Pill Badge in top-right of preview
        group {
            move: 206, 10
            show: w.ws > 0
            box { from: 0, 0; size: 58, 20; corner: 10; color: bg_color; opacity: 90% }
            box { from: 0, 0; size: 58, 20; corner: 10; stroke: 1; color: stroke_c; opacity: stroke_op }
            text w.ws_label { at: 29, 10; anchor: center center; size: t_micro; weight: 600; color: ink_sub }
        }

        // Window Title below preview
        text w.title {
            at: 137, 145
            anchor: center center
            size: 11
            weight: if(ov_sel == w.index, 600, 400)
            color: if(ov_sel == w.index, ink_c, ink_sub)
            width: 254
            align: center
            lines: 1
        }

        on press hit { emit ov_switch_to(w.index) }
    }
    on key Tab while cur == 2 { emit next_win }
    on key Left while cur == 2 { emit prev_win }
    on key Right while cur == 2 { emit next_win }
    on key Up while cur == 2 { emit up_win }
    on key Down while cur == 2 { emit down_win }
    on key Return while cur == 2 { emit ov_switch_to(ov_sel) }
    on key Escape while cur == 2 { open = false }
    on blur while cur == 2 and not fresh { open = false }

    // ── capture ─────────────────────────────────────────────────
    fact recording = false
    fact record_secs = 0
    fact mode = 0          // 0 region, 1 focused window, 2 whole screen
    fact kind = 0          // 0 photo, 1 video
    fact has_sel = false
    fact sel_x = 0
    fact sel_y = 0
    fact sel_w = 0
    fact sel_h = 0
    fact fx = 0
    fact fy = 0
    fact hx = 0
    fact hy = 0
    fact o_x = 0
    fact o_y = 0
    fact scr_w = 1920
    fact scr_h = 1080
    text shot_path = ""
    image shot = from shot_path, 0, 0
    event toggle_record ->
    event do_region ->
    event confirm ->
    event do_window ->
    event shot_now ->
    event do_screen ->

    component ModeChip(x: number, idx: number, icon_t: text, name_t: text) {
        group {
            move: x, 8
            box { from: 0, 0; size: 90, 36; corner: r_l; color: accent_c; opacity: if(mode == idx, 22%, 0%) }
            Sym(icon_t, 20, 18, 15, if(mode == idx, accent_c, ink_c))
            text name_t { at: 36, 18; anchor: left center; size: t_sub; weight: 600; color: if(mode == idx, accent_c, ink_c) }
            zone box chip_hit { from: 0, 0; size: 90, 36; corner: r_l; cursor: pointer; label: name_t }
            on press chip_hit { mode = idx; has_sel = false }
            on press right chip_hit { open = false }
        }
    }

    component KindChip(x: number, idx: number, icon_t: text, name_t: text) {
        group {
            move: x, 8
            box { from: 0, 0; size: 72, 36; corner: r_l; color: if(idx == 1, danger_c, accent_c); opacity: if(kind == idx, 24%, 0%) }
            Sym(icon_t, 18, 18, 15, if(kind == idx, if(idx == 1, danger_c, accent_c), ink_c))
            text name_t { at: 32, 18; anchor: left center; size: t_sub; weight: 600; color: if(kind == idx, if(idx == 1, danger_c, accent_c), ink_c) }
            zone box kind_hit { from: 0, 0; size: 72, 36; corner: r_l; cursor: pointer; label: name_t }
            on press kind_hit { kind = idx }
            on press right kind_hit { open = false }
        }
    }

    surface switcher {
        size: 1160, 220
        anchor: center
        level: overlay
        keyboard: exclusive while open and cur == 1
        screens: each
        open: (open or seen > 0.02) and cur == 1 and open_screen == screen.index

        zone box sw_dismiss { from: 0, 0; size: 1160, 220; active: open and cur == 1 }

        group {
            move: 0, 24
            pivot: 580, 86
            scale: scale
            opacity: seen

            // Floating Capsule
            body {
                color: bg_color
                glass: glass_amt
                lens: false
                frost: 100%
                dispersion: 0
                refraction: 0
                tint: tint_amt
                rim: rim_amt
                box { from: 580 - bw / 2, 0; size: bw, 172; corner: 24 }
            }
            box { from: 580 - bw / 2, 0; size: bw, 172; corner: 24; stroke: 1; color: stroke_c; opacity: stroke_op }

            // Horizontal Strip of Window Cards
            row app_strip {
                at: 580, 16
                gap: 12
                anchor: center top
                align: center

                for w in sw_wins {
                    AppTile(w)
                }
            }

            // Title of the selected window
            text sel_title {
                at: 580, 148
                anchor: center center
                size: 12
                weight: 600
                color: ink_c
                width: bw - 40
                align: center
                lines: 1
            }
        }
        on press sw_dismiss { open = false }
        on press right sw_dismiss { }
        }

    surface overview {
        size: 1280, 860
        anchor: center
        level: overlay
        keyboard: exclusive while open and cur == 2
        screens: each
        open: (open or seen > 0.02) and cur == 2 and open_screen == screen.index

        zone box ov_dismiss { from: 0, 0; size: 1280, 860; active: open and cur == 2 }

        group {
            move: (1200 - ov_w) / 2, (800 - ov_h) / 2
            pivot: 640, 430
            scale: scale
            opacity: seen

            // Floating Glass Modal Surface
            body {
                color: bg_color
                glass: glass_amt
                lens: false
                frost: 100%
                dispersion: 0
                refraction: 0
                tint: tint_amt
                rim: rim_amt
                box { from: 40, 30; size: ov_w, ov_h; corner: 28 }
            }
            box { from: 40, 30; size: ov_w, ov_h; corner: 28; stroke: 1; color: stroke_c; opacity: stroke_op }

            // Header Row
            group {
                move: 70, 56
                ellipse { at: 14, 14; radius: 14; color: accent_c; opacity: 20% }
                Sym("󰕰", 14, 14, 15, accent_c)
                text "Window Overview" { at: 38, 14; anchor: left center; size: 16; weight: 700; color: ink_c }
                text win_count_text { at: 200, 14; anchor: left center; size: t_sub; color: ink_sub }
                KeyHint(ov_w - 230, 14, "← →  select   ·   Enter  focus   ·   Esc  close")
            }

            // Grid of Window Previews
            grid {
                at: 68, 96
                columns: 4
                gap: 16
                width: 1144
                row: 165

                for w in ov_wins {
                    OverviewTile(w)
                }
            }

            // Empty state if no windows are open
            group {
                show: ov_wins.count < 1
                move: 640, 430
                EmptyState(0, 0, "󰕰", "No open windows")
            }
        }
        on press ov_dismiss { open = false }
        on press right ov_dismiss { }
        }

    surface picker {
        size: full, full
        anchor: top_left
        level: overlay
        reserve: -1
        keyboard: exclusive while open and cur == 3
        screens: each
        open: (open or seen > 0.02) and cur == 3 and open_screen == screen.index

        // the frozen screen
        image shot { at: 0, 0; size: picker.width, picker.height; fit: fill }
        // dim everything that is not selected
        box { from: 0, 0; size: picker.width, picker.height; color: scrim_c; opacity: if(has_sel and mode == 0, 0%, 38%) }
        group {
            show: has_sel and mode == 0
            box { from: 0, 0; size: picker.width, sel_y; color: scrim_c; opacity: 38% }
            box { from: 0, sel_y + sel_h; size: picker.width, picker.height - sel_y - sel_h; color: scrim_c; opacity: 38% }
            box { from: 0, sel_y; size: sel_x, sel_h; color: scrim_c; opacity: 38% }
            box { from: sel_x + sel_w, sel_y; size: picker.width - sel_x - sel_w, sel_h; color: scrim_c; opacity: 38% }
        }

        // ── what catches the mouse ───────────────────────────────────
        // region: drag anywhere for a new selection
        zone box catch { from: 0, 0; size: picker.width, picker.height; cursor: crosshair; label: "Select a region" }
        on press catch while mode == 0 { fx = local.x; fy = local.y; hx = local.x; hy = local.y; sel_x = local.x; sel_y = local.y; sel_w = 0; sel_h = 0; has_sel = false }
        on drag catch while mode == 0 {
            has_sel = true
            sel_x = min(fx, clamp(hx + drag.dx, 0, picker.width))
            sel_y = min(fy, clamp(hy + drag.dy, 0, picker.height))
            sel_w = abs(clamp(hx + drag.dx, 0, picker.width) - fx)
            sel_h = abs(clamp(hy + drag.dy, 0, picker.height) - fy)
        }
        on release catch while mode == 0 { has_sel = sel_w > 12 and sel_h > 12 }
        // window / screen: a click takes it
        on press catch while mode == 1 { emit do_window }
        on press catch while mode == 2 { emit do_screen }
        on press right catch { open = false }

        // move the selection by its inside
        zone box move_hit { from: sel_x, sel_y; size: sel_w, sel_h; cursor: move; active: has_sel and mode == 0; label: "Move the selection" }
        on press move_hit { o_x = sel_x; o_y = sel_y }
        on drag move_hit {
            sel_x = clamp(o_x + drag.dx, 0, picker.width - sel_w)
            sel_y = clamp(o_y + drag.dy, 0, picker.height - sel_h)
        }
        on press right move_hit { open = false }

        // four corners resize it: the opposite corner stays where it is
        zone box h_tl { from: sel_x - 10, sel_y - 10; size: 20, 20; cursor: nwse_resize; active: has_sel and mode == 0; label: "Resize top left" }
        zone box h_tr { from: sel_x + sel_w - 10, sel_y - 10; size: 20, 20; cursor: nesw_resize; active: has_sel and mode == 0; label: "Resize top right" }
        zone box h_bl { from: sel_x - 10, sel_y + sel_h - 10; size: 20, 20; cursor: nesw_resize; active: has_sel and mode == 0; label: "Resize bottom left" }
        zone box h_br { from: sel_x + sel_w - 10, sel_y + sel_h - 10; size: 20, 20; cursor: nwse_resize; active: has_sel and mode == 0; label: "Resize bottom right" }
        on press h_tl { fx = sel_x + sel_w; fy = sel_y + sel_h; hx = sel_x; hy = sel_y }
        on press h_tr { fx = sel_x; fy = sel_y + sel_h; hx = sel_x + sel_w; hy = sel_y }
        on press h_bl { fx = sel_x + sel_w; fy = sel_y; hx = sel_x; hy = sel_y + sel_h }
        on press h_br { fx = sel_x; fy = sel_y; hx = sel_x + sel_w; hy = sel_y + sel_h }
        on drag h_tl { sel_x = min(fx, clamp(hx + drag.dx, 0, picker.width)); sel_y = min(fy, clamp(hy + drag.dy, 0, picker.height)); sel_w = abs(clamp(hx + drag.dx, 0, picker.width) - fx); sel_h = abs(clamp(hy + drag.dy, 0, picker.height) - fy) }
        on drag h_tr { sel_x = min(fx, clamp(hx + drag.dx, 0, picker.width)); sel_y = min(fy, clamp(hy + drag.dy, 0, picker.height)); sel_w = abs(clamp(hx + drag.dx, 0, picker.width) - fx); sel_h = abs(clamp(hy + drag.dy, 0, picker.height) - fy) }
        on drag h_bl { sel_x = min(fx, clamp(hx + drag.dx, 0, picker.width)); sel_y = min(fy, clamp(hy + drag.dy, 0, picker.height)); sel_w = abs(clamp(hx + drag.dx, 0, picker.width) - fx); sel_h = abs(clamp(hy + drag.dy, 0, picker.height) - fy) }
        on drag h_br { sel_x = min(fx, clamp(hx + drag.dx, 0, picker.width)); sel_y = min(fy, clamp(hy + drag.dy, 0, picker.height)); sel_w = abs(clamp(hx + drag.dx, 0, picker.width) - fx); sel_h = abs(clamp(hy + drag.dy, 0, picker.height) - fy) }
        on press right h_tl { open = false }
        on press right h_tr { open = false }
        on press right h_bl { open = false }
        on press right h_br { open = false }

        // ── the selection: border, size, handles ─────────────────────
        group {
            show: has_sel and mode == 0
            opacity: seen
            box { from: sel_x, sel_y; size: sel_w, sel_h; stroke: 2; color: accent_c }
            // size label
            group {
                move: sel_x, max(sel_y - 30, 4)
                Plate(96, 22, 11)
                text "{sel_w} × {sel_h}" { at: 48, 11; anchor: center center; size: t_cap; weight: 600; color: ink_c }
            }
            ellipse { at: sel_x, sel_y; radius: 6; color: on_accent }
            ellipse { at: sel_x + sel_w, sel_y; radius: 6; color: on_accent }
            ellipse { at: sel_x, sel_y + sel_h; radius: 6; color: on_accent }
            ellipse { at: sel_x + sel_w, sel_y + sel_h; radius: 6; color: on_accent }
            ellipse { at: sel_x, sel_y; radius: 3.5; color: accent_c }
            ellipse { at: sel_x + sel_w, sel_y; radius: 3.5; color: accent_c }
            ellipse { at: sel_x, sel_y + sel_h; radius: 3.5; color: accent_c }
            ellipse { at: sel_x + sel_w, sel_y + sel_h; radius: 3.5; color: accent_c }
        }

        // the action under the selection
        group {
            show: has_sel and mode == 0
            opacity: seen
            move: clamp(sel_x + sel_w / 2 - 74, 8, picker.width - 156), min(sel_y + sel_h + 14, picker.height - 54)
            box { from: 0, 0; size: 148, 40; corner: r_m; color: accent_c }
            text if(kind == 1, "󰻂  Record  ⏎", "󰄀  Capture  ⏎") { family: "JetBrainsMono Nerd Font Mono"; at: 74, 20; anchor: center center; size: 13; weight: 700; color: on_accent }
            zone box go_hit { from: 0, 0; size: 148, 40; corner: r_m; cursor: pointer; label: "Take it" }
            on press go_hit { scr_w = picker.width; scr_h = picker.height; emit do_region }
            on press right go_hit { open = false }
        }

        // hint when nothing is selected yet
        group {
            show: not (has_sel and mode == 0)
            opacity: seen
            move: picker.width / 2, picker.height / 2
            group {
                move: -190, -20
                Plate(380, 40, 20)
            }
            text pick(mode, "Drag to select an area", "Click to capture the screen with the focused window", "Click to capture the whole screen") { at: 0, 0; anchor: center center; size: 14; weight: 600; color: ink_c }
        }

        // ── the toolbar ──────────────────────────────────────────────
        group {
            opacity: seen
            move: picker.width / 2 - 262, 62 - (1 - seen) * 14
            body {
                color: bg_color
                glass: glass_amt
                lens: false
                frost: 100%
                dispersion: 0
                refraction: 0
                tint: tint_amt
                rim: rim_amt
                box { from: 0, 0; size: 524, 52; corner: 26 }
            }
            box { from: 0, 0; size: 524, 52; corner: 26; stroke: 1; color: stroke_c; opacity: stroke_op }

            // close
            ellipse { at: 26, 26; radius: 14; color: item_solid }
            Sym("󰅖", 26, 26, 13, ink_c)
            zone box x_hit { from: 10, 10; size: 32, 32; corner: 16; cursor: pointer; label: "Close" }
            on press x_hit { open = false }
            on press right x_hit { open = false }

            box { from: 52, 12; size: 1, 28; color: stroke_c; opacity: stroke_op }

            // what to take
            ModeChip(66, 0, "󰩭", "Region")
            ModeChip(66 + 94, 1, "󰖲", "Window")
            ModeChip(66 + 188, 2, "󰍹", "Screen")

            box { from: 66 + 288, 12; size: 1, 28; color: stroke_c; opacity: stroke_op }

            // photo or video
            KindChip(66 + 304, 0, "󰄀", "Photo")
            KindChip(66 + 304 + 76, 1, "󰻂", "Video")
        }
        }


        on key Escape while cur == 3 { open = false }
        on key Return while cur == 3 { emit confirm }
        on key KP_Enter while cur == 3 { emit confirm }
        on key r while cur == 3 { kind = 1 }
        on key p while cur == 3 { kind = 0 }
}
