// macOS App Switcher (Cmd + Tab HUD)
import "common/palette.plm"

scene MacAppSwitcher {
    include "common/theme.plm"
    include "common/ui.plm"
    include "common/here.plm"
    surface sheet {
        size: 1160, 220
        anchor: center
        level: overlay
        keyboard: exclusive while open
        screens: each
        open: (open or seen > 0.02) and open_screen == screen.index

        zone box dismiss { from: 0, 0; size: 1160, 220; active: open }

        group {
            move: 0, 24
            pivot: 580, 86
            scale: scale
            opacity: seen

            // Floating Capsule
            body {
                color: bg_color
                glass: glass_amt
                lens: false
                frost: 100%
                dispersion: 0
                refraction: 0
                tint: tint_amt
                rim: rim_amt
                box { from: 580 - bw / 2, 0; size: bw, 172; corner: 24 }
            }
            box { from: 580 - bw / 2, 0; size: bw, 172; corner: 24; stroke: 1; color: stroke_c; opacity: stroke_op }

            // Horizontal Strip of Window Cards
            row app_strip {
                at: 580, 16
                gap: 12
                anchor: center top
                align: center

                for w in wins {
                    AppTile(w)
                }
            }

            // Title of the selected window
            text sel_title {
                at: 580, 148
                anchor: center center
                size: 12
                weight: 600
                color: ink_c
                width: bw - 40
                align: center
                lines: 1
            }
        }
        on press dismiss { open = false }
        on press right dismiss { }
    }

    permissions {
        services: "apps", "window", "thumbnails", "thumbnails.*", "say:topbar"
        run: "niri msg"
    }

    fact open = false
    fact sel = 0
    text sel_title = ""
    prop bw = 260 ~calm
    follow bw = max(260, wins.count * 152 + 32)

    model wins max 7 { id: number; title: text; app_id: text; icon: image 48, 48; thumb: image 132, 78; has_thumb: bool }

    prop seen = 0 ~quick
    prop scale = 0.95 ~lively

    layer switcher ~quick {
        shown while open { seen: 1 ~quick; scale: 1 ~lively }
        gone             { seen: 0 ~quick; scale: 0.95 ~quick }
    }

    let stroke_c = card_stroke
    let stroke_op = card_stroke_op

    event toggle
    event next_app ->
    event prev_app ->
    event switch_to ->

    component AppTile(w: record) {
        size: 140, 112
        prop on = 0 ~quick
        follow on = if(sel == w.index, 1, 0)

        SelectCard(140, 112, sel == w.index)
        zone box hit { from: 0, 0; size: 140, 112; corner: r_l; cursor: pointer }

        // Preview thumbnail area (clipped)
        group {
            move: 4, 4
            clip box { from: 0, 0; size: 132, 78; corner: r_s }
            box { from: 0, 0; size: 132, 78; corner: r_s; color: bg_color; opacity: 50% }
            image w.thumb { at: 0, 0; size: 132, 78; fit: cover; show: w.has_thumb }
            group {
                show: not w.has_thumb
                move: 66, 39
                image w.icon { at: -22, -22; size: 44, 44 }
            }
        }

        // App Icon Badge in corner of preview
        group {
            move: 8, 56
            box { from: 0, 0; size: 22, 22; corner: 6; color: bg_color; opacity: 90% }
            box { from: 0, 0; size: 22, 22; corner: 6; stroke: 1; color: stroke_c; opacity: stroke_op }
            image w.icon { at: 2, 2; size: 18, 18 }
        }

        // Window Title below preview
        text w.title {
            at: 70, 96
            anchor: center center
            size: 10.5
            weight: if(sel == w.index, 600, 400)
            color: if(sel == w.index, ink_c, ink_sub)
            width: 126
            align: center
            lines: 1
        }

        on press hit { emit switch_to(w.index) }
    }

    on toggle     { toggle open }
    on key Tab    { emit next_app }
    on key Left   { emit prev_app }
    on key Right  { emit next_app }
    on key Return { emit switch_to(sel) }
    on key Escape { open = false }
    on blur       { open = false }
}
