// macOS App Switcher (Cmd + Tab HUD)
import "common/palette.plm"

scene MacAppSwitcher {
    include "common/theme.plm"
    include "common/here.plm"
    surface sheet {
        size: 700, 160
        anchor: center
        level: overlay
        keyboard: exclusive while open
        screens: each
        open: (open or seen > 0.02) and open_screen == screen.index

    zone box dismiss { from: 0, 0; size: 700, 160; active: open }

    group {
        move: 40, 20
        pivot: 310, 60
        scale: scale
        opacity: seen

        // Floating Capsule
        body {
            color: bg_color
            glass: glass_amt
            lens: false
            frost: 100%
            dispersion: 0
            refraction: 0
            tint: tint_amt
            rim: rim_amt
            box { from: 310 - bw / 2, 0; size: bw, 132; corner: 26 }
        }
        box { from: 310 - bw / 2, 0; size: bw, 132; corner: 26; stroke: 1; color: stroke_c; opacity: stroke_op }

        //  the title of the window that is selected
        text sel_title {
            at: 310, 112
            anchor: center center
            size: 12
            weight: 600
            color: ink_c
            width: bw - 40
            align: center
            lines: 1
        }

        // Horizontal Icons Strip
        row app_strip {
            at: 310, 18
            gap: 12
            anchor: center top
            align: center

            for w in wins {
                AppTile(w)
            }
        }
    }
        on press dismiss { open = false }
    on press right dismiss { }
    }

    permissions {
        services: "apps", "window", "say:topbar"
        run: "niri msg"
    }

    fact open = false
    fact sel = 0
    text sel_title = ""
    prop bw = 200 ~calm
    follow bw = max(200, wins.count * 84 + 32)

    model wins max 7 { id: number; title: text; app_id: text; icon: image 48, 48 }

    prop seen = 0 ~quick
    prop scale = 0.95 ~lively

    layer switcher ~quick {
        shown while open { seen: 1 ~quick; scale: 1 ~lively }
        gone             { seen: 0 ~quick; scale: 0.95 ~quick }
    }

    let stroke_c = card_stroke
    let stroke_op = card_stroke_op

    event toggle
    event next_app ->
    event prev_app ->
    event switch_to ->

    // Outside dismiss
    // A scene that never uses the right button is closed by pleamar on any right click
    // (its prototype emergency exit). This empty rule says the right button is ours: nothing happens.


    component AppTile(w: record) {
        size: 72, 72
        prop on = 0 ~quick
        follow on = if(sel == w.index, 1, 0)

        // Blue highlight capsule
        box hit {
            from: 0, 0
            size: 72, 72
            corner: 14
            color: accent_c
            opacity: on * 28%
            cursor: pointer
        }
        box {
            from: 0, 0
            size: 72, 72
            corner: 14
            stroke: 1.5
            color: accent_c
            opacity: on * 90%
        }

        // App Icon or Fallback
        group {
            move: 36, 32
            image w.icon { at: -24, -24; size: 48, 48 }
            // Running indicator dot
            ellipse { at: 0, 30; radius: 2.5; color: ink_c; opacity: 75% }
        }

        on press hit { emit switch_to(w.index) }
    }

    on toggle     { toggle open }
    on key Tab    { emit next_app }
    on key Left   { emit prev_app }
    on key Right  { emit next_app }
    on key Return { emit switch_to(sel) }
    on key Escape { open = false }
}
