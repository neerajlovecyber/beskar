// Full-screen desktop perimeter border framing the display (iNiR aesthetic)
scene ScreenBorder {
    surface {
        size: full, full
        anchor: center
        level: overlay
        screens: each
    }

    fact dark_mode = true
    fact skin = 0

    let border_color = if(dark_mode, #b4a8ff, #7f52ff)
    let border_opacity = if(dark_mode, 28%, 20%)

    // Subtle 1.5px glowing accent border with rounded display corners
    box {
        from: 4, 4
        size: screen.width - 8, screen.height - 8
        corner: 18
        stroke: 1.5
        color: border_color
        opacity: border_opacity
    }
}
