// Full-screen desktop perimeter border framing the display (iNiR aesthetic)
scene ScreenBorder {
    surface {
        size: full, full
        anchor: center
        level: bottom
        screens: each
    }

    fact dark_mode = true
    fact skin = 0

    let border_color = if(dark_mode, #ffffff, #000000)
    let border_opacity = if(dark_mode, 14%, 10%)

    // Subtle 1.5px refined glass frame with rounded display corners
    box {
        from: 2, 2
        size: screen.width - 4, screen.height - 4
        corner: 14
        stroke: 1.5
        color: border_color
        opacity: border_opacity
    }
}
