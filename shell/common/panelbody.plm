// THE one way a panel shows its content, whichever island its glass grows out of. A LIBRARY (imported once, so any number of
// panel scenes in one process share it): everything it needs comes in as parameters, nothing from the scene.
//
//   PanelBody(x, y, up, w, gw, panel_h, ph, seen) { … }
//     up  0: the glass grows DOWN from a top island; the content sits at y and is revealed from the top (`w` = surface width)
//     up  1: it grows UP out of the dock; `y` is the surface height and the content is anchored to its FINAL bottom place
//     gw    the frame's target glass width for this island (`Topbar.cp_w` centre, `Topbar.rp_w` right, `Topbar.bp_w` dock):
//           the content shows only once the glass has ARRIVED (width and height), never while it is still growing or
//           widening (a switch from Spotlight to the wallpaper strip, say). 0 = do not wait.
//     panel_h  the panel's target height (`Panels.panel_h`), ph its animated glass height (a spring chasing it), seen 0..1 how
//           far the panel is open (a spring): the scene's morph_core.plm declares both.
//   The content never moves while the glass grows: only the clip reveals it (moving it left ghost copies).
library PanelBodyLib {
    component PanelBody(x: number, y: number, up: number = 0, w: number = 0, gw: number = 0, panel_h: number = 400, ph: number = 400, seen: number = 1) {
        prop gwl = 0 ~calm          // chases `gw` with the frame's own spring: when they meet, the glass has arrived
        follow gwl = gw
        let s = clamp(seen, 0, 1)
        let rh = ph * s + 4                     // seen down to where the glass has grown (top panels)
        let bh = 64 + max(0, ph - 64) * s       // the same for a panel that grows UP out of the dock (glass 64 tall, rising to ph)
        let fit = if(gw > 0, clamp(1 - max(abs(gw - gwl), abs(panel_h - ph)) / 24, 0, 1), 1)
        group {
            move: x, if(up > 0, y - panel_h, y)
            opacity: clamp(seen * 2.4 - 1.3, 0, 1) * fit
            clip box { from: -60, if(up > 0, panel_h - bh - 4, -20); size: if(up > 0, 1300, w) + 120, if(up > 0, bh + 90, rh + 20) }
            children
        }
    }
}
