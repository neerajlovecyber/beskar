// The shell's ONE colour system. Every panel imports this instead of defining its own colours.
//
//   facts   dark_mode · skin · accent · accent_auto     (Settings changes them; control_center / settings broadcast
//                                            them to every scene, so they all follow)
//   accent  accent_c                        (blue by default; Settings → Appearance picks it)
//   status  ok_c · warn_c · danger_c · focus_c
//   text    ink_c · ink_sub
//   glass   bg_color · glass_amt · tint_amt · rim_amt
//   cards   card_fill(+_op) · card_stroke(+_op) · item_bg(+_op) · item_solid
//   sliders slider_bg · slider_bar · slider_icon (+ _op)
//
// Used with `include "common/theme.plm"` as the first line of a scene: a part is the scene's own text, so
// the facts are the scene's facts (`say <scene> "fact dark_mode false"` keeps working).
// A scene may tread on a name by declaring its own `let` of the same name; do that only on purpose.
part Theme {
    fact dark_mode = true
    fact skin = 0            // 0 liquid glass · 1 light acrylic · 2 classic solid
    fact accent = 0          // 0 blue · 1 purple · 2 pink · 3 red · 4 orange · 5 green · 6 graphite
    fact hour12 = true       // clock format: true 2:05 PM · false 14:05 (Settings → Appearance)
    fact accent_auto = false // true: the colours come from the wallpaper (palette engine in settings.luau)
    //  The wallpaper palette (settings.luau runs matugen on the wallpaper and sends the colours for the current
    //  light / dark mode as 0..1 numbers; -1 until there is one): accent, a second colour, and the surface tint.
    fact pal_ar = -1
    fact pal_ag = 0
    fact pal_ab = 0
    fact pal_br = 0
    fact pal_bg = 0
    fact pal_bb = 0
    fact pal_sr = 0
    fact pal_sg = 0
    fact pal_sb = 0
    let pal_on = accent_auto and pal_ar >= 0

    // ── the accent, and what colours mean ────────────────────────
    let accent_c = if(pal_on, rgb(pal_ar, pal_ag, pal_ab), pick(accent, #007aff, #af52de, #ff2d55, #ff3b30, #ff9500, #34c759, #8e8e93))
    let ok_c     = #30d158     // connected, charging, healthy
    let warn_c   = #ff9f0a     // attention, light mode sun
    let danger_c = #ff453a     // errors, low battery, unread badge, disconnect
    let focus_c  = if(pal_on, rgb(pal_br, pal_bg, pal_bb), #5e5ce6)    // Do Not Disturb, dark mode

    // ── text ─────────────────────────────────────────────────────
    let ink_c   = if(dark_mode, #f5f7f5, #1d1d1f)
    let ink_sub = if(dark_mode, #9a9ea7, #6e6e73)

    // ── glass panels ─────────────────────────────────────────────
    let surf_c    = rgb(pal_sr, pal_sg, pal_sb)       // the wallpaper-tinted surface (only meaningful when pal_on)
    let bg_color  = if(pal_on, surf_c, if(dark_mode, if(skin == 2, #1e2026, if(skin == 1, #181a20, #14161d)), if(skin == 2, #f2f3f7, if(skin == 1, #f0f2f6, #f8f9fc))))
    let glass_amt = if(skin == 2, 0%, if(skin == 1, 45%, 70%))
    let tint_amt  = if(skin == 2, 0%, if(dark_mode, 35%, 20%))
    let rim_amt   = if(skin == 2, 0%, 12%)

    // ── cards and the discs inside them ──────────────────────────
    let card_fill      = if(skin == 2, if(dark_mode, #242732, #f0f2f7), #ffffff)
    let card_fill_op   = if(skin == 2, 100%, if(dark_mode, 10%, 65%))
    let card_stroke    = if(dark_mode, #ffffff, #000000)
    let card_stroke_op = if(skin == 2, if(dark_mode, 12%, 8%), if(dark_mode, 8%, 6%))
    let item_bg        = if(skin == 2, if(dark_mode, #343740, #e2e4ea), if(dark_mode, #ffffff, #000000))
    let item_bg_op     = if(skin == 2, 100%, if(dark_mode, 14%, 8%))
    let item_solid     = if(dark_mode, #3c3f4b, #dcdee6)

    // ── sliders ──────────────────────────────────────────────────
    let slider_bg     = #000000
    let slider_bg_op  = if(dark_mode, 25%, 8%)
    let slider_bar    = if(dark_mode, #ffffff, accent_c)
    let slider_bar_op = 92%
    let slider_icon   = if(dark_mode, #16181d, #ffffff)

    // ── fixed-purpose colours (use these, never a hex value in a scene) ──
    let on_accent  = #ffffff                                   // text and glyphs on an accent / danger fill, knobs, handles
    let scrim_c    = #000000                                   // dimming layers and shadows
    let btn_fill   = if(dark_mode, #2a2e38, #e5e7eb)           // a neutral button, segment or chip
    let switch_off = if(dark_mode, #3a3d46, #d1d5db)           // the track of a switch that is off

    // ── radii: small (chips, buttons) · medium (rows, cards) · large (panels, tiles) · xl (windows) ──
    let r_s  = 8
    let r_m  = 12
    let r_l  = 16
    let r_xl = 24

    // ── type scale: title · body · caption · micro ──
    let t_title = 15
    let t_body  = 13
    let t_sub   = 12
    let t_cap   = 11.5
    let t_micro = 10.5

    // ── the frame's glass colour (bar, ring, dock, widget cards) and form fields / selected rows ──
    let bar_color = if(pal_on, surf_c, if(dark_mode, if(skin == 2, #181a20, if(skin == 1, #161820, #14161d)), if(skin == 2, #f2f3f7, if(skin == 1, #eaecf2, #f6f7fb))))
    let field_bg = if(dark_mode, #1e2026, #f3f4f6)      // a text field or inset well
    let sel_bg   = if(dark_mode, #283040, #eef4ff)      // a chosen row
}
