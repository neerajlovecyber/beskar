// macOS Apple HIG Palette for Pleamar
library Palette {
    // Ink / Typography
    let ink         = #f5f7f5      // Primary text in dark mode
    let ink_dark    = #1d1d1f      // Primary text in light mode
    let ink_faint   = #8e8e93      // Secondary / dimmed text
    
    // Apple Accent Colors
    let blue        = #007aff      // macOS System Blue
    let mint        = #30d158      // macOS System Green
    let orange      = #ff9500      // macOS System Orange
    let red         = #ff3b30      // macOS System Red
    let purple      = #af52de      // macOS System Purple
    let graphite    = #1c1c1e      // System dark base
    
    // Glass Surface Tints
    let glass_dark  = #1e1e1e      // Smoked dark acrylic
    let glass_light = #ffffff      // Frosted light glass
    let card_bg     = #2c2c2e      // Card container fill
    let card_border = #3a3a3c      // Subtle inner border
}
