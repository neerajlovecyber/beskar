// The app switcher (21) and the window overview (22): their CONTENT is drawn inside the frame's own surface (topbar.plm, in `Shell`), over the
// glass the dock island grows. Merged from the old Windows scene; the logic is shell/window_panels.luau (loaded by topbar.luau).
part WindowPanels {

    let wn_stroke_c = card_stroke
    let wn_stroke_op = card_stroke_op

    // ── app switcher ────────────────────────────────────────────
    fact sw_sel = 0
    text sel_title = ""
    prop bw = 260 ~calm
    follow bw = max(260, sw_wins.count * 152 + 32)

    model sw_wins max 7 { id: number; title: text; app_id: text; icon: image 48, 48; thumb: image 132, 78; has_thumb: bool }
    event next_app ->
    event prev_app ->
    event sw_edge ->
    event sw_switch_to ->

    component AppTile(w: record) {
        size: 140, 112
        prop on = 0 ~quick
        follow on = if(sw_sel == w.index, 1, 0)

        SelectCard(140, 112, sw_sel == w.index, ui_accent_c: accent_c, ui_card_stroke: card_stroke, ui_item_solid: item_solid)
        zone box hit { from: 0, 0; size: 140, 112; corner: r_l; cursor: pointer }

        // Preview thumbnail area (clipped)
        group {
            move: 4, 4
            clip box { from: 0, 0; size: 132, 78; corner: r_s }
            box { from: 0, 0; size: 132, 78; corner: r_s; color: bg_color; opacity: 50% }
            image w.thumb { at: 0, 0; size: 132, 78; fit: cover; show: w.has_thumb }
            group {
                show: not w.has_thumb
                move: 66, 39
                image w.icon { at: -22, -22; size: 44, 44 }
            }
        }

        // App Icon Badge in corner of preview
        group {
            move: 8, 56
            box { from: 0, 0; size: 22, 22; corner: control_r; color: bg_color; opacity: 90% }
            box { from: 0, 0; size: 22, 22; corner: control_r; stroke: 1; color: wn_stroke_c; opacity: wn_stroke_op }
            image w.icon { at: 2, 2; size: 18, 18 }
        }

        // Window Title below preview
        text w.title {
            at: 70, 96
            anchor: center center
            size: font_micro
            weight: if(sw_sel == w.index, 600, 400)
            color: if(sw_sel == w.index, ink_c, ink_sub)
            width: 126
            align: center
            lines: 1
        }

        on press hit { emit sw_switch_to(w.index) }
    }
    on key Tab while Panels.cur == 21 and Panels.open_screen == screen.index { emit next_app }
    on key Shift+Tab while Panels.cur == 21 and Panels.open_screen == screen.index { emit prev_app }
    on key Home while Panels.cur == 21 and Panels.open_screen == screen.index { emit sw_edge(-1) }
    on key End while Panels.cur == 21 and Panels.open_screen == screen.index { emit sw_edge(1) }
    on key KP_Enter while Panels.cur == 21 and Panels.open_screen == screen.index { emit sw_switch_to(sw_sel) }
    on key Left while Panels.cur == 21 and Panels.open_screen == screen.index { emit prev_app }
    on key Right while Panels.cur == 21 and Panels.open_screen == screen.index { emit next_app }
    on key Return while Panels.cur == 21 and Panels.open_screen == screen.index { emit sw_switch_to(sw_sel) }
    on key Escape while Panels.cur == 21 and Panels.open_screen == screen.index { emit Panels.close }
    on blur while Panels.cur == 21 and not Panels.fresh and Panels.open_screen == screen.index { emit Panels.close }

    // ── window overview ─────────────────────────────────────────
    fact ov_sel = 0
    text win_count_text = ""

    model ov_wins max 16 { id: number; title: text; app_id: text; ws: number; ws_label: text; icon: image 48, 48; thumb: image 264, 120; has_thumb: bool }

    // the sheet is as tall as its rows (a few windows no longer sit in a huge empty panel)
    let ov_rows = max(1, ceil(ov_wins.count / 4))
    let ov_w = max(560, 56 + min(4, max(1, ov_wins.count)) * 290)
    let ov_h = min(800, 80 + ov_rows * 181)
    event next_win ->
    event prev_win ->
    event ov_edge ->
    event up_win ->
    event down_win ->
    event ov_switch_to ->

    component OverviewTile(w: record) {
        size: 274, 165
        prop on = 0 ~quick
        follow on = if(ov_sel == w.index, 1, 0)

        SelectCard(274, 165, ov_sel == w.index, ui_accent_c: accent_c, ui_card_stroke: card_stroke, ui_item_solid: item_solid)
        zone box hit { from: 0, 0; size: 274, 165; corner: r_l; cursor: pointer }

        // Preview thumbnail area (clipped)
        group {
            move: 5, 5
            clip box { from: 0, 0; size: 264, 120; corner: r_s }
            box { from: 0, 0; size: 264, 120; corner: r_s; color: bg_color; opacity: 50% }
            image w.thumb { at: 0, 0; size: 264, 120; fit: cover; show: w.has_thumb }
            group {
                show: not w.has_thumb
                move: 132, 60
                image w.icon { at: -24, -24; size: 48, 48 }
            }
        }

        // App Icon Badge in corner of preview
        group {
            move: 10, 10
            box { from: 0, 0; size: 24, 24; corner: control_r; color: bg_color; opacity: 90% }
            box { from: 0, 0; size: 24, 24; corner: control_r; stroke: 1; color: wn_stroke_c; opacity: wn_stroke_op }
            image w.icon { at: 3, 3; size: 18, 18 }
        }

        // Workspace Pill Badge in top-right of preview
        group {
            move: 206, 10
            show: w.ws > 0
            box { from: 0, 0; size: 58, 20; corner: radius_small; color: bg_color; opacity: 90% }
            box { from: 0, 0; size: 58, 20; corner: radius_small; stroke: 1; color: wn_stroke_c; opacity: wn_stroke_op }
            text w.ws_label { at: 29, 10; anchor: center center; size: ts_micro; weight: 600; color: ink_sub }
        }

        // Window Title below preview
        text w.title {
            at: 137, 145
            anchor: center center
            size: font_caption
            weight: if(ov_sel == w.index, 600, 400)
            color: if(ov_sel == w.index, ink_c, ink_sub)
            width: 254
            align: center
            lines: 1
        }

        on press hit { emit ov_switch_to(w.index) }
    }
    on key Tab while Panels.cur == 22 and Panels.open_screen == screen.index { emit next_win }
    on key Shift+Tab while Panels.cur == 22 and Panels.open_screen == screen.index { emit prev_win }
    on key Home while Panels.cur == 22 and Panels.open_screen == screen.index { emit ov_edge(-1) }
    on key End while Panels.cur == 22 and Panels.open_screen == screen.index { emit ov_edge(1) }
    on key KP_Enter while Panels.cur == 22 and Panels.open_screen == screen.index { emit ov_switch_to(ov_sel) }
    on key Left while Panels.cur == 22 and Panels.open_screen == screen.index { emit prev_win }
    on key Right while Panels.cur == 22 and Panels.open_screen == screen.index { emit next_win }
    on key Up while Panels.cur == 22 and Panels.open_screen == screen.index { emit up_win }
    on key Down while Panels.cur == 22 and Panels.open_screen == screen.index { emit down_win }
    on key Return while Panels.cur == 22 and Panels.open_screen == screen.index { emit ov_switch_to(ov_sel) }
    on key Escape while Panels.cur == 22 and Panels.open_screen == screen.index { emit Panels.close }
    on blur while Panels.cur == 22 and not Panels.fresh and Panels.open_screen == screen.index { emit Panels.close }

    //  The app switcher grows out of the dock like Spotlight: the frame draws the glass (width follows the number of windows,
    //  reported by the logic with panel.width), this surface draws the cards. Content is centred on the surface.
    component SwitcherContent() {
            //  Horizontal strip of window cards
            row app_strip {
                at: 560, 16
                gap: space_12
                anchor: center top
                align: center
                for w in sw_wins { AppTile(w) }
            }
            //  Title of the selected window
            text sel_title { at: 560, 148; anchor: center center; size: font_secondary; weight: 600; color: ink_c; width: bw - 40; align: center; lines: 1 }
    }

    component OverviewContent() {
            //  Header row
            group {
                move: 620 - ov_w / 2 + 30, 26
                ellipse { at: 14, 14; radius: 14; color: accent_c; opacity: 20% }
                Sym("󰕰", 14, 14, 15, accent_c)
                text "Window Overview" { at: 38, 14; anchor: left center; size: 16; weight: 700; color: ink_c }
                text win_count_text { at: 200, 14; anchor: left center; size: ts_sub; color: ink_sub }
                KeyHint(ov_w - 230, 14, "← → ↑ ↓  select   ·   Enter  focus   ·   Esc  close", ui_ink_sub: ink_sub)
            }

            //  Grid of window previews
            grid {
                at: 620 - ov_w / 2 + 28, 66
                columns: 4
                gap: space_16
                width: 1144
                row: 165
                for w in ov_wins { OverviewTile(w) }
            }

            //  Empty state if no windows are Panels.open
            group {
                show: ov_wins.count < 1
                move: 620, ov_h / 2
                EmptyState(0, 0, "󰕰", "No open windows", ui_ink_sub: ink_sub)
            }
    }
}
