// Weather (15), Music (9) and Today (3): their CONTENT is drawn inside the frame's own surface (topbar.plm, in `Shell`, over the glass it
// already draws for the centre island), so a panel and its glass can neither disagree on the monitor nor on timing. Merged from the old
// Infopanels scene; the timer and the Personal editor follow. The logic is shell/info_panels.luau (loaded by topbar.luau).
part InfoPanels {
    let ip_stroke_c = card_stroke
    let ip_stroke_op = card_stroke_op

    // ── weather ─────────────────────────────────────────────────
    fact wx_view = 0              // 0 the forecast · 1 choose a place
    fact wx_loaded = false
    fact wx_loading = false
    fact wx_searching = false
    fact wx_q_has = false         // the search field has text (set by weather.luau from its text)
    fact wx_lo = 0
    fact wx_hi = 1
    text wx_city = ""
    text w_cond = ""
    text w_temp = "--°"
    text w_feels = ""
    text w_range = ""
    text w_icon = "󰅟"
    text w_hum = "--"
    text w_wind = "--"
    text w_uv = "--"
    text w_press = "--"
    text w_sunrise = "--"
    text w_sunset = "--"
    text w_source = ""
    text w_rain = "Rain chance: --"
    text w_status = "Loading weather…"
    text wq = ""

    model hours max 8 { t: text; icon: text; temp: text; rain: text }
    model days max 5 { day: text; icon: text; lo: text; hi: text; lo_n: number; hi_n: number }
    model places max 5 { name: text; sub: text }

    event loc_change ->
    event loc_back ->
    event loc_ip ->
    event loc_pick ->

    event weather_reload ->

    // ── music ───────────────────────────────────────────────────
    //  Reported by music.luau
    //  what is playing is held ONCE by the System scene (system.luau); the player controls are its events
    image cover_big = from System.cover_art, 150, 84


    // ── today (dashboard) ───────────────────────────────────────

    fact cpu_pct = 0
    fact mem_pct = 0
    fact disk_pct = 0
    fact bat_ac = false
    fact cal_shift = 0               // months away from this one (0 = now)
    text greeting = "Hello"
    text today_text = ""
    text uptime_text = ""
    text bat_state = ""
    text bat_sub = ""
    text cal_title = ""

    //  the month grid: Monday first; `dim` = a day of the month before / after; `today` = this very day
    model pe_today_tasks max 2 { id: number; title: text }
    model cal_month max 1 { list cells max 42 { d: text; kind: number } }

    let bar_track = item_solid
    prop d_hot = 0 ~quick

    event d_toggle
    event refresh_stats ->
    event cal_prev ->
    event cal_next ->
    event cal_now ->



    //  one labelled number of the details card
    component Stat(x: number, label: text, value: text) {
        text label { at: x, 17; anchor: left center; size: ts_micro; color: ink_sub }
        text value { at: x, 38; anchor: left center; size: ts_body; weight: 700; color: ink_c }
    }

    //  one labelled meter of the activity card (y = its row)
    component Meter(y: number, label: text, pct: number, tone: color) {
        text label { at: 16, y + 9; anchor: left center; size: ts_cap; weight: 600; color: ink_c }
        text "{pct}%" { at: 304, y + 9; anchor: right center; size: t_cap; weight: 600; color: tone }
        box { from: 70, y + 6; size: 180, 6; corner: 3; color: bar_track }
        box { from: 70, y + 6; size: max(6, 180 * clamp(pct / 100, 0, 1)), 6; corner: 3; color: tone }
    }



    //  at the panel's own origin: x 0 = 16 px in from where its old surface (420 wide, centred) began, y 0 = just under the bar
    component WeatherContent() {

        //  clicks on the card itself do not close it
        zone box wx_inside { from: 0, 0; size: 388, 692 }
        on press right wx_inside { }

        // ═══ wx_view 0: the forecast ═══════════════════════════════════
        group {
            show: wx_view == 0

            //  place and its button
            Sym("󰍎", 10, 22, 15, accent_c)
            text wx_city { at: 26, 22; anchor: left center; size: ts_title; weight: 700; color: ink_c; width: 250; lines: 1 }
            group { move: 300, 9; Pill("Change", 88, loc_change, 0, control_h_compact, false, ui_accent_c: accent_c, ui_danger_c: danger_c, ui_ink_c: ink_c, ui_item_bg: item_bg, ui_on_accent: on_accent) }
            text w_cond { at: 4, 52; anchor: left center; size: ts_sub; color: ink_sub; width: 380; lines: 1 }

            //  now
            text w_temp { at: 4, 100; anchor: left center; size: 56; weight: 700; color: ink_c }
            Sym(w_icon, 340, 92, 54, accent_c)
            text w_feels { at: 4, 140; anchor: left center; size: ts_sub; color: ink_sub }
            text w_range { at: 384, 140; anchor: right center; size: ts_sub; weight: 600; color: ink_c }

            //  details
            group {
                move: 0, 160
                CardBg(388, 58, r_m, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
                Stat(14, "Humidity", w_hum)
                Stat(112, "Wind", w_wind)
                Stat(210, "UV index", w_uv)
                Stat(300, "Pressure", w_press)
            }
            group {
                move: 0, 226
                CardBg(388, 42, r_m, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
                Sym("󰖜", 22, 21, 16, warn_c)
                text "Sunrise" { at: 40, 21; anchor: left center; size: ts_cap; color: ink_sub }
                text w_sunrise { at: 92, 21; anchor: left center; size: ts_sub; weight: 600; color: ink_c }
                Sym("󰖛", 220, 21, 16, accent_c)
                text "Sunset" { at: 238, 21; anchor: left center; size: ts_cap; color: ink_sub }
                text w_sunset { at: 288, 21; anchor: left center; size: ts_sub; weight: 600; color: ink_c }
            }

            //  next hours
            SectionLabel(4, 288, "NEXT HOURS · °C", ui_ink_sub: ink_sub)
            group {
                move: 0, 300
                CardBg(388, 96, r_m, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
                row {
                    at: 2, 0
                    for h in hours {
                        group {
                            size: 48.5, 96
                            text h.t { at: 24, 16; anchor: center center; size: ts_micro; color: ink_sub }
                            Sym(h.icon, 24, 48, 20, accent_c)
                            text h.rain { at: 24, 65; anchor: center center; size: ts_micro; color: ink_sub }
                            text h.temp { at: 24, 84; anchor: center center; size: ts_sub; weight: 600; color: ink_c }
                        }
                    }
                }
            }

            //  next days
            SectionLabel(4, 414, "NEXT DAYS · °C", ui_ink_sub: ink_sub)
            group {
                move: 0, 426
                CardBg(388, 176, r_m, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
                column {
                    at: 0, 4
                    for d in days {
                        group {
                            size: 388, 34
                            text d.day { at: 16, 17; anchor: left center; size: ts_body; weight: 600; color: ink_c }
                            Sym(d.icon, 100, 17, 17, accent_c)
                            text d.lo { at: 146, 17; anchor: right center; size: ts_sub; color: ink_sub }
                            box { from: 158, 15; size: 168, 4; corner: 2; color: ink_c; opacity: 12% }
                            box { from: 158 + 168 * (d.lo_n - wx_lo) / max(1, wx_hi - wx_lo), 15; size: max(8, 168 * (d.hi_n - d.lo_n) / max(1, wx_hi - wx_lo)), 4; corner: 2; color: accent_c }
                            text d.hi { at: 372, 17; anchor: right center; size: ts_sub; weight: 600; color: ink_c }
                        }
                    }
                }
            }

            text w_rain { at: 4, 622; anchor: left center; size: ts_sub; color: ink_c }
            text w_status { at: 4, 644; width: 288; lines: 2; size: ts_cap; color: ink_sub }
            group { move: 300, 640; Pill("Refresh", 88, weather_reload, 0, control_h, false, not wx_loading, ui_accent_c: accent_c, ui_danger_c: danger_c, ui_ink_c: ink_c, ui_item_bg: item_bg, ui_on_accent: on_accent) }

            //  nothing yet
            group { show: not wx_loaded; EmptyState(194, 300, "󰅟", "No forecast yet", w_status, ui_ink_sub: ink_sub) }
        }

        // ═══ wx_view 1: choose a place ═════════════════════════════════
        group {
            show: wx_view == 1

            text "Choose a location" { at: 4, 22; anchor: left center; size: ts_title; weight: 700; color: ink_c }
            group { move: 300, 9; Pill("Back", 88, loc_back, 0, control_h_compact, false, ui_accent_c: accent_c, ui_danger_c: danger_c, ui_ink_c: ink_c, ui_item_bg: item_bg, ui_on_accent: on_accent) }

            //  your IP
            group { move: 0, 46; Pill("󰩟  Use my location (from my IP address)", 388, loc_ip, 1, control_h_large, false, ui_accent_c: accent_c, ui_danger_c: danger_c, ui_ink_c: ink_c, ui_item_bg: item_bg, ui_on_accent: on_accent) }

            //  search
            group {
                move: 0, 94
                CardBg(388, 40, r_m, true, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
                Sym("󰍉", 22, 20, 16, ink_sub)
                //  (the search field is declared in topbar.plm, at scene level: a field inside a component is scoped to it)
            }

            //  results
            column {
                at: 0, 146
                gap: space_4
                for p in places {
                    group {
                        size: 388, 44
                        prop on = 0 ~quick
                        RowFrame(388, 44, on, ui_accent_c: accent_c)
                        text p.name { at: 16, 15; anchor: left center; size: ts_body; weight: 600; color: ink_c; width: 350; lines: 1 }
                        text p.sub { at: 16, 32; anchor: left center; size: ts_cap; color: ink_sub; width: 350; lines: 1 }
                        zone box wx_pick_hit { from: 0, 0; size: 388, 44; corner: r_m; cursor: pointer }
                        on enter wx_pick_hit { on: 1 }
                        on leave wx_pick_hit { on: 0 }
                        on press wx_pick_hit { emit loc_pick(p.index) }
                        on press right wx_pick_hit { }
                    }
                }
            }
            group { show: places.count < 1 and not wx_q_has; text "Type a city name, or use your IP address" { at: 194, 190; anchor: center center; size: t_sub; color: ink_sub } }
            group { show: places.count < 1 and wx_q_has and not wx_searching; EmptyState(194, 200, "󰍉", "No place found", ui_ink_sub: ink_sub) }
            text w_source { at: 4, 360; anchor: left center; size: ts_cap; color: ink_sub; show: places.count < 1 }
        }
    }
    component MusicContent() {

        //  clicks on the card itself do not close it
        zone box mu_inside { from: 0, 0; size: 348, 200 }
        on press right mu_inside { }

        // ── nothing is playing ──
        group {
            show: not has_player
            ellipse { at: 174, 70; radius: 26; color: item_solid }
            path { at: 165, 56; color: ink_sub; move 0, 0; line 20, 14; line 0, 28; close }
            text "Nothing playing" { at: 174, 124; anchor: center; size: ts_body; weight: 600; color: ink_sub }
            text "Start a song in any player" { at: 174, 144; anchor: center; size: ts_cap; color: ink_sub; opacity: 70% }
        }

        // ── a player has something ──
        group {
            show: has_player

            //  cover_big: a gradient, and the real artwork over it
            body {
                gradient: 0, 0 to 84, 84, accent_c, focus_c
                box { from: 16, 14; size: 84, 84; corner: r_l }
            }
            group {
                clip box { from: 16, 14; size: 84, 84; corner: r_l }
                image cover_big { at: -18, 13; size: 152, 86; show: has_art }   // a pixel past the tile on every side: no seam
            }
            text System.track_title { at: 116, 36; anchor: left center; size: ts_title; weight: 700; color: ink_c; width: 216; lines: 1 }
            text System.track_artist { at: 116, 58; anchor: left center; size: ts_sub; color: ink_sub; width: 216; lines: 1 }

            //  progress: a click on the bar seeks
            box { from: 16, 118; size: 316, 4; corner: 2; color: slider_bg; opacity: slider_bg_op }
            box { from: 16, 118; size: max(4, 316 * clamp(track_pos / max(track_len, 1), 0, 1)), 4; corner: 2; color: ink_c; show: track_len > 0 }
            text System.time_pos { at: 16, 136; anchor: left center; size: ts_micro; color: ink_sub }
            text System.time_len { at: 332, 136; anchor: right center; size: ts_micro; color: ink_sub; show: track_len > 0 }
            zone box seek_hit { from: 16, 110; size: 316, 20; cursor: pointer; active: track_len > 0 }
            on press seek_hit { emit System.seek(clamp(local.x / 316, 0, 1)) }

            //  previous · play/pause · next: one axis (x 174, y 166), the play disc centred between its two neighbours
            ellipse { at: 174, 166; radius: 18; color: item_solid }
            group { move: 104, 148; IconButton("󰒮", "Previous track", System.previous, ink_c, item_solid, icon_button_large, icon_button_large, 24, control_r_large, 0) }
            group { move: 156, 148; IconButton(if(is_playing, "󰏤", "󰐊"), "Play or pause", System.play_pause, ink_c, item_solid, icon_button_large, icon_button_large, 26, control_r_large, 0) }
            group { move: 208, 148; IconButton("󰒭", "Next track", System.next, ink_c, item_solid, icon_button_large, icon_button_large, 24, control_r_large, 0) }
            on press right seek_hit { }
        }
    }
    component TodayContent() {

        //  clicks on the card itself do not close it
        zone box d_inside { from: 0, 0; size: 348, 780 }
        on press right d_inside { }

        // ── greeting ──────────────────────────────────────────────
        text greeting { at: 20, 24; anchor: left center; size: ts_title; weight: 700; color: ink_c }
        text today_text { at: 20, 46; anchor: left center; size: ts_sub; color: ink_sub }

        // ── weather: a wide card, a click opens the weather panel ─
        group {
            move: 14, 62
            CardBg(320, 92, r_l, true, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
            box { from: 0, 0; size: 320, 92; corner: r_l; color: ink_c; opacity: d_hot * 6% }
            text Weather.city { at: 16, 20; anchor: left center; size: ts_body; weight: 700; color: ink_c; width: 190; lines: 1 }
            text Weather.condition { at: 16, 40; anchor: left center; size: ts_sub; color: ink_sub; width: 190; lines: 1 }
            text Weather.temp { at: 16, 70; anchor: left center; size: 32; weight: 700; color: ink_c }
            Sym(Weather.icon, 290, 28, 30, warn_c)
            text Weather.range { at: 304, 56; anchor: right center; size: ts_sub; weight: 600; color: ink_c }
            text Weather.feels { at: 304, 74; anchor: right center; size: ts_cap; color: ink_sub }
            zone box dw_hit { from: 0, 0; size: 320, 92; corner: r_l; cursor: pointer; label: "Open the weather" }
            on enter dw_hit { d_hot: 1 }
            on leave dw_hit { d_hot: 0 }
            on press dw_hit { last_screen = screen.index; emit open_weather }
            on press right dw_hit { }
        }

        // ── month calendar ────────────────────────────────────────
        group {
            move: 14, 166
            CardBg(320, 232, r_l, true, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
            //  title and the month buttons; a click on the title comes back to this month
            text cal_title { at: 16, 22; anchor: left center; size: ts_body; weight: 700; color: ink_c }
            zone box d_title_hit { from: 8, 8; size: 170, 30; corner: r_s; cursor: pointer; label: "This month" }
            on press d_title_hit { emit cal_now }
            on press right d_title_hit { }
            group { move: 248, 8; IconButton("󰅁", "Previous month", cal_prev, ink_c, item_bg, fill_op: item_bg_op) }
            group { move: 282, 8; IconButton("󰅂", "Next month", cal_next, ink_c, item_bg, fill_op: item_bg_op) }
            group {
                move: 16, 44
                for month in cal_month { MonthGrid(month, 289, 27, ink_c, ink_sub, accent_c, on_accent, day_size: t_sub, heading_size: t_micro) }
            }
        }

        // Personal content: the same editor and store as desktop widgets.
        group {
            move: 14, 410
            CardBg(320, 144, r_l, true, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
            Sym("󰎞", 24, 22, 18, accent_c)
            text "Notes" { at: 44, 22; anchor: left center; size: ts_sub; weight: 600; color: ink_c }
            text Personal.note_preview { at: 16, 46; anchor: left center; size: ts_sub; color: ink_sub; width: 288; lines: 1 }
            zone box d_notes { from: 0, 0; size: 320, 68; cursor: pointer; label: "Open notes" }
            on press d_notes { emit pe_open(0) }
            on press right d_notes { }
            Sym("󰄱", 24, 90, 18, accent_c)
            text "To-dos" { at: 44, 90; anchor: left center; size: ts_sub; weight: 600; color: ink_c }
            text "All caught up" { at: 16, 118; anchor: left center; size: ts_cap; color: ink_sub; show: pe_today_tasks.count == 0 }
            zone box d_tasks { from: 0, 70; size: 320, 74; cursor: pointer; label: "Open to-dos" }
            on press d_tasks { emit pe_open(1) }
            on press right d_tasks { }
            for t in pe_today_tasks {
                Sym("󰄱", 24, 112 + t.index * 20, 16, ink_sub)
                text t.title { at: 42, 112 + t.index * 20; anchor: left center; size: ts_cap; color: ink_sub; width: 260; lines: 1 }
                zone box d_task_check { from: 8, 102 + t.index * 20; size: 30, 20; cursor: pointer; label: t.title }
                on press d_task_check { emit Personal.toggle_task(t.id) }
                on press right d_task_check { }
            }
        }

        // ── how busy the machine is ───────────────────────────────
        group {
            move: 14, 566
            CardBg(320, 124, r_l, true, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
            Sym("󰍹", 24, 20, 14, accent_c)
            text "Activity" { at: 40, 20; anchor: left center; size: ts_sub; weight: 600; color: ink_c }
            text uptime_text { at: 304, 20; anchor: right center; size: ts_cap; color: ink_sub }
            Meter(34, "CPU", cpu_pct, accent_c)
            Meter(62, "Memory", mem_pct, mint)
            Meter(90, "Disk", disk_pct, purple)
        }

        // ── battery (laptops) ─────────────────────────────────────
        group {
            show: System.bat.present
            move: 14, 702
            CardBg(320, 66, r_l, true, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
            //  the cell: green with a bolt while on the charger
            box { from: 16, 21; size: 34, 17; corner: control_r; stroke: 1.8; color: ink_c }
            box { from: 51, 26; size: 3, 6; corner: 1.5; color: ink_c }
            box { from: 19, 24; size: max(3, 28 * clamp(System.bat.percent / 100, 0, 1)), 11; corner: 2.5; color: if(System.bat.charging or bat_ac, ok_c, if(System.bat.percent <= 20, danger_c, ink_c)) }
            text bat_state { at: 70, 23; anchor: left center; size: ts_sub; weight: 600; color: ink_c }
            text bat_sub { at: 70, 43; anchor: left center; size: ts_micro; color: ink_sub; width: 190; lines: 1 }
            text "{System.bat.percent}%" { at: 304, 33; anchor: right center; size: 22; weight: 700; color: ink_c }
        }
    }

    on key Escape while Panels.cur == 15 or Panels.cur == 3 { emit Panels.close }
    on blur while Panels.cur == 3 and not Panels.fresh { emit Panels.close }     // today (dashboard) closes when it loses the focus
}
