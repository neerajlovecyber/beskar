// Shared UI parts: ONE look for the controls every scene uses. `include "common/ui.plm"` after theme.plm and use these
// instead of drawing a toggle, button, chip or glass plate by hand (and never a hard-coded colour: they read the theme).
//
//   Plate(w, h, r)                 a glass plate (the shell's own: glass / acrylic / solid, light or dark) with its edge
//   Switch(state, tap)             on / off switch, 44 x 24, emits `tap`
//   Btn(label, w, tap, primary)    a 28 px button; `primary` = accent
//   Seg(label, n, cur, pick, w)    one segment of a row of choices (`pick(n)` when pressed); highlighted when cur == n
//   Chip(label, on, pick, n, w)    a chip chosen from a list; highlighted when `on`
//   ToggleRow(title, sub, state, tap, w)   a card row with a title, a sub line and a Switch on its right
//   Pill(label, w, tap, tone, h, round, on_)  a button with a tone (0 neutral, 1 accent, 2 danger, 3 on a fill)
//   PanelHeader(glyph, title) / PanelSearch(w, ph)   the header and the bottom search field of a dock panel
//   EmptyState(x, y, glyph, title, hint)   what a list shows when it is empty (centred on x, y)
//   RowFrame(w, h, on)   the selected look of a list row (accent pill + left bar); the scene adds its zone and content
//   Slider(w, level, set, tone, thick, floor)   a draggable level (emits set(0..1))
//   Divider(len)                   a 1 px line
//   ScrollBar(sc, ct, h)           a thin scroll bar for a `view:` layout (list.scroll, list.content, the seen height)
part Ui {
    //  The shell's own glass plate.
    component Plate(w: number, h: number, r: number) {
        body {
            color: bg_color
            glass: glass_amt
            lens: false
            frost: 100%
            dispersion: 0
            refraction: 0
            tint: tint_amt
            rim: rim_amt
            box { from: 0, 0; size: w, h; corner: r }
        }
        box { from: 0, 0; size: w, h; corner: r; stroke: 1; color: card_stroke; opacity: card_stroke_op }
    }

    component Divider(len: number) {
        box { from: 0, 0; size: len, 1; color: card_stroke; opacity: card_stroke_op }
    }

    //  The switch (it carries its own click).
    component Switch(state: bool, tap: event) {
        size: 44, 24
        box { from: 0, 0; size: 44, 24; corner: 12; color: if(state, accent_c, switch_off) }
        ellipse { at: if(state, 32, 12), 12; radius: 9.5; color: on_accent }
        zone box hit { from: 0, 0; size: 44, 24; corner: 12; cursor: pointer }
        on press hit { emit tap }
        on press right hit { }
    }

    //  A button; `x, y` places it when it sits inside a Card.
    component Btn(label: text, w: number, tap: event, primary: bool = false, x: number = 0, y: number = 0) {
        size: w, 28
        prop hot = 0 ~quick
        group {
            move: x, y
            box { from: 0, 0; size: w, 28; corner: 8; color: if(primary, accent_c, btn_fill); opacity: 0.85 + hot * 0.15 }
            text label { at: w / 2, 14; anchor: center center; size: 12; weight: 600; color: if(primary, on_accent, ink_c) }
            zone box hit { from: 0, 0; size: w, 28; corner: 8; cursor: pointer }
            on enter hit { hot: 1 }
            on leave hit { hot: 0 }
            on press hit { emit tap }
            on press right hit { }
        }
    }

    //  A segment of a row of choices.
    component Seg(label: text, n: number, cur: number, pick: event, w: number = 52) {
        size: w, 28
        box { from: 0, 0; size: w, 28; corner: 8; color: if(cur == n, accent_c, btn_fill) }
        text label { at: w / 2, 14; anchor: center center; size: 11.5; weight: 600; color: if(cur == n, on_accent, ink_c) }
        zone box hit { from: 0, 0; size: w, 28; corner: 8; cursor: pointer }
        on press hit { emit pick(n) }
        on press right hit { }
    }

    //  A chip chosen from a list (resolution, refresh rate).
    component Chip(label: text, on: bool, pick: event, n: number, w: number = 80) {
        size: w, 28
        box { from: 0, 0; size: w, 28; corner: 8; color: if(on, accent_c, btn_fill) }
        text label { at: w / 2, 14; anchor: center center; size: 11.5; weight: 600; color: if(on, on_accent, ink_c) }
        zone box hit { from: 0, 0; size: w, 28; corner: 8; cursor: pointer }
        on press hit { emit pick(n) }
        on press right hit { }
    }


    //  A thin scroll bar for a layout with `view:` (draw it beside the list; `sc` = list.scroll, `ct` = list.content,
    //  `h` = the height that is seen). It only shows when there is more than fits.
    component ScrollBar(sc: number, ct: number, h: number) {
        group {
            show: ct > h + 1
            box { from: 0, 0; size: 4, h; corner: 2; color: ink_c; opacity: 7% }
            box { from: 0, clamp(sc / max(ct, 1), 0, 1) * h; size: 4, max(24, h * h / max(ct, h)); corner: 2; color: ink_c; opacity: 32% }
        }
    }

    component ToggleRow(title: text, sub: text, state: bool, tap: event, w: number = 556) {
        size: w, 56
        box { from: 0, 0; size: w, 56; corner: 14; color: card_fill; opacity: card_fill_op }
        box { from: 0, 0; size: w, 56; corner: 14; stroke: 1; color: card_stroke; opacity: card_stroke_op }
        text title { at: 18, 20; anchor: left center; size: 13; weight: 600; color: ink_c; width: w - 110; lines: 1 }
        text sub { at: 18, 38; anchor: left center; size: 10.5; color: ink_sub; width: w - 110; lines: 1 }
        group {
            move: w - 62, 16
            Switch(state, tap)
        }
    }


    //  A button with a tone: 0 neutral · 1 accent · 2 danger · 3 on a coloured fill (translucent white). `h` 34 and
    //  `round` make the pill of a toolbar; `on_` false greys it out and makes it inert.
    component Pill(label: text, w: number, tap: event, tone: number = 0, h: number = 28, round: bool = false, on_: bool = true) {
        size: w, h
        prop glow = 0 ~quick
        box { from: 0, 0; size: w, h; corner: if(round, h / 2, 9); color: pick(tone, item_bg, accent_c, danger_c, on_accent); opacity: pick(tone, item_bg_op, 100%, 20%, 24%) + glow * 8% }
        text label { at: w / 2, h / 2; anchor: center center; size: if(h > 30, 13, 11.5); weight: 600; color: pick(tone, ink_c, on_accent, danger_c, on_accent); opacity: if(on_, 100%, 40%) }
        zone box hit { from: 0, 0; size: w, h; corner: if(round, h / 2, 9); cursor: pointer; active: on_ }
        on enter hit { glow: 1 }
        on leave hit { glow: 0 }
        on press hit { emit tap }
        on press right hit { }
    }

    //  ── the design language of the panels that grow out of the dock (Spotlight, clipboard, wallpapers, …) ──
    //  Top: a header (accent glyph + title; the scene puts its own count / actions on the right of the same line, at y 30).
    //  Bottom: a divider and the search field, ALWAYS at the bottom (nearest the dock, where the panel grows from).
    //  The scene declares the `input` itself (its text is the scene's) at the standard place:
    //      input q { at: 68, ph - 50; width: <panel width> - 110; size: 19; color: ink_c; placeholder: "…"; selection: accent_c }
    component PanelHeader(g: text, title: text) {
        text g { at: 36, 30; anchor: center center; size: 16; family: "JetBrainsMono Nerd Font Mono"; color: accent_c }
        text title { at: 56, 30; anchor: left center; size: 15; weight: 700; color: ink_c }
    }

    //  The footer's decoration: the divider and the magnifier. `w` is the glass width, `ph` its height.
    component PanelSearch(w: number, ph: number) {
        box { from: 28, ph - 74; size: w - 56, 1; color: card_stroke; opacity: card_stroke_op }
        text "󰍉" { at: 46, ph - 38; anchor: center center; size: 19; family: "JetBrainsMono Nerd Font Mono"; color: ink_c; opacity: 60% }
    }

    //  Nothing to show: a quiet glyph, what is missing and (optionally) what to do about it. Centred on x, y; the caller
    //  hides it (`group { show: …; EmptyState(…) }`).
    component EmptyState(x: number, y: number, g: text, title: text, hint: text = "") {
        group {
            move: x, y
            text g { at: 0, -20; anchor: center center; size: 26; family: "JetBrainsMono Nerd Font Mono"; color: ink_sub; opacity: 45% }
            text title { at: 0, 8; anchor: center center; size: t_body; weight: 600; color: ink_sub }
            text hint { at: 0, 28; anchor: center center; size: t_cap; color: ink_sub; opacity: 75% }
        }
    }

    //  The look of a selectable list row: an accent pill that fades in with `on` (0..1) and a bar on its left edge. The
    //  scene adds its own zone over it (`zone box hit { from: 0, 0; size: w, h; corner: r_m; cursor: pointer }`) and its content.
    component RowFrame(w: number, h: number, on: number) {
        box { from: 0, 0; size: w, h; corner: r_m; color: accent_c; opacity: on * 22% }
        box { from: 0, h / 2 - 10; size: 3, 20; corner: 1.5; color: accent_c; opacity: on }
    }

    //  A slider you can press and drag: the track and its fill (`thick` px high, never narrower than its own height, or
    //  than `floor` of the width), emitting `set(0..1)`. Draw glyphs over it if you want; Settings and the Control Center use it.
    component Slider(w: number, level: number, set: event, tone: color = accent_c, thick: number = 10, floor: number = 0) {
        size: w, thick
        box { from: 0, 0; size: w, thick; corner: thick / 2; color: slider_bg; opacity: slider_bg_op }
        box { from: 0, 0; size: max(thick, w * clamp(level, 0, 1)), thick; corner: thick / 2; color: tone; opacity: 92% }
        zone box hit { from: 0, -6; size: w, thick + 12; cursor: pointer; label: "Slider" }
        on press hit { emit set(clamp(local.x / w, floor, 1)) }
        on drag hit { emit set(clamp(local.x / w, floor, 1)) }
        on press right hit { }
    }
}
