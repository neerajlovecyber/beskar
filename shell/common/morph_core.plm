// The shared core of a panel scene that grows out of an island or the dock: the shared state read by name from the `Panels`
// scene, and the two springs (`seen`, `ph`) that run the morph. The content wrapper is the library common/panelbody.plm.
part MorphCore {
    //  the shared state is OWNED by the `Panels` scene (panels.plm); a panel scene reads it by these names and changes it
    //  with events (`emit Panels.close`, `emit Panels.height`…): a scene writes only its own facts
    let open = Panels.open
    let open_screen = Panels.open_screen
    let cur = Panels.cur
    let fresh = Panels.fresh
    let panel_h = Panels.panel_h
    prop seen = 0 ~calm
    prop ph = 400 ~calm
    follow ph = panel_h
    layer panel ~quick {
        shown while open { seen: 1 ~calm }
        gone             { seen: 0 ~quick }
    }
}
