// The shared core of every panel that grows out of an island or the dock: the facts (`open`, `panel_h`…), the springs and
// THE one content wrapper, `PanelBody`. The scene includes this and each surface writes its own dismiss zone inside it.
part MorphCore {
    //  the shared state is OWNED by the `Panels` scene (panels.plm); a panel scene reads it by these names and changes it
    //  with events (`emit Panels.close`, `emit Panels.height`…): a scene writes only its own facts
    let open = Panels.open
    let open_screen = Panels.open_screen
    let cur = Panels.cur
    let fresh = Panels.fresh
    let panel_h = Panels.panel_h
    prop seen = 0 ~calm
    prop ph = 400 ~calm
    follow ph = panel_h
    layer panel ~quick {
        shown while open { seen: 1 ~calm }
        gone             { seen: 0 ~quick }
    }
    //  the content is only seen down to where the glass has grown (the glass is a spring, the content is not)
    let mp_rh = ph * clamp(seen, 0, 1) + 4
    //  the same for a panel that grows UP out of the dock: the glass is dock_h (64) tall and rises to ph
    let mp_bh = 64 + max(0, ph - 64) * clamp(seen, 0, 1)
    let mp_fade = clamp(seen * 2.4 - 1.3, 0, 1)

    //  THE ONE WAY a panel shows its content, whichever island its glass grows out of: wrap it in
    //  `PanelBody(x, y, up, w, gw) { … }` (every panel is ONE surface that follows its monitor, so nothing here tests the screen).
    //    up  0: the glass grows DOWN from a top island; the content sits at y and is revealed from the top (`w` = surface width)
    //    up  1: it grows UP out of the dock; `y` is the surface height and the content is anchored to its FINAL bottom place
    //    gw    the frame's target glass width for this island (`Topbar.cp_w` centre, `Topbar.rp_w` right, `Topbar.bp_w` dock):
    //          the content shows only once the glass has ARRIVED (width and height), never while it is still growing or
    //          widening (a switch from Spotlight to the wallpaper strip, say). 0 = do not wait.
    //  The content never moves while the glass grows: only the clip reveals it (moving it left ghost copies).
    component PanelBody(x: number, y: number, up: number = 0, w: number = 0, gw: number = 0) {
        prop gwl = 0 ~calm          // chases `gw` with the frame's own spring: when they meet, the glass has arrived
        follow gwl = gw
        let fit = if(gw > 0, clamp(1 - max(abs(gw - gwl), abs(panel_h - ph)) / 24, 0, 1), 1)
        group {
            move: x, if(up > 0, y - panel_h, y)
            opacity: mp_fade * fit
            clip box { from: -60, if(up > 0, panel_h - mp_bh - 4, -20); size: if(up > 0, mp_sw, w) + 120, if(up > 0, mp_bh + 90, mp_rh + 20) }
            children
        }
    }
}
