// The shared core of a panel that grows out of an island (see morph.plm for the full story): facts, springs, fade.
// Scenes whose surface is a NAMED one (so that its `open:` and keyboard are per monitor: Spotlight, the wallpaper
// strip) include this and write their own dismiss zone inside the surface.
part MorphCore {
    fact open = false
    fact open_screen = 0         // which monitor shows it (set by topbar.luau)
    fact panel_h = 400           // its height, reported by its logic through panel.height(h)
    prop seen = 0 ~calm
    prop ph = 400 ~calm
    follow ph = panel_h
    layer panel ~quick {
        shown while open { seen: 1 ~calm }
        gone             { seen: 0 ~quick }
    }
    //  Any change of `open` (a button, a `say`, or the logic setting it) is reported to panel.luau, which tells the frame:
    //  without this, a panel the logic closes itself (copy a clip, launch an app) left its glass open and empty.
    event panel_sync ->
    on change open { emit panel_sync }
    let mp_here = open_screen == screen.index
    //  the content is only seen down to where the glass has grown (the glass is a spring, the content is not)
    let mp_rh = ph * clamp(seen, 0, 1) + 4
    //  the same for a panel that grows UP out of the dock: the glass is dock_h (64) tall and rises to ph
    let mp_bh = 64 + max(0, ph - 64) * clamp(seen, 0, 1)
    let mp_fade = clamp(seen * 2.4 - 1.3, 0, 1)

    //  THE ONE WAY a panel shows its content: wrap it in `PanelBody(x, y, up) { … }`. It is shown only on the monitor
    //  that has the panel, only inside the glass as the glass grows (from the top island down, or from the dock up when
    //  `up` is 1: then y is the surface height and the content is anchored to the bottom), and fades in late.
    component PanelBody(x: number, y: number, up: number = 0) {
        group {
            show: up > 0 or mp_here    // a bottom panel is a named surface with its own per-monitor open: (screen.index reads 0 there)
            move: x, if(up > 0, y - ph, y)
            opacity: mp_fade
            clip box { from: -60, if(up > 0, ph - mp_bh - 4, -20); size: mp_sw + 120, if(up > 0, mp_bh + 90, mp_rh + 20) }
            children
        }
    }
}
