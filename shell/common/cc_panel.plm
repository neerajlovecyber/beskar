// The Control Center (panel 1, right island). Its CONTENT is drawn inside the frame's own surface (topbar.plm, in `Shell`, over the
// glass it already draws for the right island): there is no surface of its own, so glass and content cannot disagree on the
// monitor or on timing. Included by the frame's scene; its logic is shell/cc.luau (loaded by topbar.luau through panelclient).
part ControlCenterPanel {

    //  Reported by controlcenter.luau (its own watcher of `media`): what is playing
    //  what is playing is held ONCE by the System scene (system.luau); the player controls are its events
    let has_player  = System.has_player
    let is_playing  = System.is_playing
    let has_art     = System.has_art
    let track_len   = System.track_len
    let track_pos   = System.track_pos
    image cover = from System.cover_art, 82, 46

    // ── Built-in System Models ────────────────────────────────────
    //  One row per Bluetooth device, painted by control_center.luau. kind: 0 any · 1 headphones · 2 mouse ·
    //  3 keyboard · 4 phone · 5 computer · 6 gamepad · 7 speaker. state: 0 paired · 1 connected · 2 working · 3 new.
    model bt_rows max 8 { name: text; status: text; kind: number; state: number; battery: number = -1 }
    model outs max 6 { id: number; name: text; default: bool }
    //  Painted by control_center.luau. Wi-Fi rows: signal 0..1.  App volumes: one row per stream playing.
    model wifi_rows max 6 { name: text; signal: number; secure: bool; known: bool; active: bool; joining: bool }
    model app_rows max 4 { name: text; volume: number; muted: bool }

    // ── System Services & Lists ───────────────────────────────────
    //  (kept by cc.luau: plain watchers, not `service` lines, so the part also works brought into another scene)
    fact snd_volume = 0
    fact snd_muted = false
    fact disp_level = 1
    fact net_online = false
    text net_name = ""

    // ── Navigation & Theme Facts ──────────────────────────────────
    // Navigation: 0 = Main, 1 = Wi-Fi, 2 = Bluetooth, 3 = Sound
    fact cc_page = 0
    //  Keyboard focus: a slot number whose meaning depends on the page (cc.luau owns the navigation; the ring below draws it).
    //  page 0: 0 Wi-Fi · 1 Bluetooth · 2 player · 3 Do Not Disturb · 4 dark mode · 5 Settings · 6 display · 7 sound · 8-11 shortcuts
    //  page 1: 0 radio switch · 1 connection button · 2 look again · 3+ networks     page 2: 0 switch · 1 search · 2+ devices
    //  page 3: 0-5 outputs · 6-9 apps' own sliders
    fact cc_focus = 0
    event cc_key ->
    prop dm_k = 0 ~quick
    follow dm_k = if(dark_mode, 1, 0)

    //  Wi-Fi, from control_center.luau. state: 0 off · 1 not connected · 2 connected · 3 cable · 4 joining
    fact wifi_state = 1
    fact wifi_signal = 0
    fact asking = false          // the password sheet is open
    text wifi_title = ""
    text wifi_status = ""
    text ask_name = ""
    text ask_error = ""

    //  Reported by control_center.luau: Bluetooth, and what is playing
    fact bt_connected = false   // a Bluetooth device is connected (the frame's icon reads it as Controlcenter.bt_connected)
    fact bt_on = false
    fact bt_present = true
    fact bt_scanning = false
    text bt_sub = "Off"
    event toggle_dark ->
    event set_dark_mode ->
    event choose_skin ->

    event volume_set ->
    event brightness_set ->
    event pick_network ->
    event wifi_power ->
    event wifi_disconnect ->
    event wifi_rescan ->
    event wifi_join ->
    event wifi_join_click ->
    event wifi_cancel ->
    event app_volume ->
    event bt_action ->
    event bt_power ->
    event bt_scan ->
    event open_settings ->
    event toggle_dnd ->
    event set_page(n) ->
    event cc_back
    on cc_back { cc_page = 0 }
    event open_sound
    event open_nothing
    event sc_search ->
    event sc_clip ->
    event sc_shot ->
    event sc_session ->
    event pick_output ->
    event toggle_wifi ->
    event toggle_bt ->

    //  Closing the password sheet hands the keyboard back, which is a `blur`: this stays above zero
    //  for a moment after it so that blur does not close the whole panel.
    prop askhold = 0 ~calm
    follow askhold = if(asking, 1, 0)
    //  The card is shorter on the overview than on the pickers, and grows when one opens.

    //  A small button with a word.
    //  Four arcs that fill with the strength, 0..1
    component Bars(level: number, tone: color = ink_c) {
        size: 28, 24
        repeat a in 1..5 {
            arc { at: 14, 20; radius: 2 + a * 3.6; span: 110deg; width: 1.8; color: tone; opacity: 20% + 80% * if(level > (a - 1) * 0.25, 1, 0) }
        }
        ellipse { at: 14, 21; radius: 1.8; color: tone }
    }

    //  One slider card: the same for Display and Sound, only the icon (kind 0 sun, 1 speaker) and
    //  what it controls differ. The fill never gets narrower than the icon.
    component LevelSlider(title: text, level: number, pct: text, kind: number, set: event, more: event) {
        size: 328, 54
        CardBg(328, 54, r_l, true, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
        text title { at: inset_card, space_12; anchor: left center; size: ts_cap; weight: 600; color: ink_sub }
        text pct { at: 328 - inset_card, space_12; anchor: right center; size: ts_micro; color: ink_sub }
        zone box more_hit { from: 230, 2; size: 96, 24; corner: radius_small; cursor: pointer; active: kind == 1 }
        group {
            move: 14, 25
            size: 300, 20
            Slider(300, level, set, slider_bar, 20, 0.02, ui_slider_bg: slider_bg)
            //  sun
            group {
                show: kind == 0
                ellipse { at: 12, 10; radius: 3.4; color: slider_icon }
                repeat k in 0..8 { line { from: 12 + 5.6 * cos(k * 45), 10 + 5.6 * sin(k * 45); to: 12 + 7.6 * cos(k * 45), 10 + 7.6 * sin(k * 45); width: 1.4; color: slider_icon } }
            }
            // Match the frame's sound glyph, centred in the slider's leading cap.
            group {
                show: kind == 1
                text pick(if(snd_muted or level < 0.02, 0, if(level < 0.5, 1, 2)), "󰝟", "󰕿", "󰕾") {
                    family: "JetBrainsMono Nerd Font Mono"
                    at: space_12, space_20 / 2
                    anchor: center center
                    size: icon_size
                    color: slider_icon
                }
            }
        }
        on press more_hit { emit more }
    }

    //  Laid out at the panel's own origin: x 0 = 74 px in from where its old surface (440 wide, flush right) began, y 0 = just under the bar.
    component ControlCenterContent() {

        // ==========================================================
        // PAGE 0: MAIN CONTROL CENTER OVERVIEW
        // ==========================================================
        group {
            show: cc_page == 0

            // ── Wi-Fi: a wide pill. The disc toggles the radio, the rest opens the cc_page ──
            group {
                move: 16, 16
                size: 158, 60
                CardBg(158, 60, radius_card, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
                box { from: 0, 0; size: 158, 60; corner: radius_card; color: accent_c; opacity: if(net_online, 100%, 0%) }
                box { from: 0, 0; size: 158, 60; corner: radius_card; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                ellipse { at: 30, 30; radius: 20; color: if(net_online, on_accent, item_solid) }
                repeat a in 1..4 {
                    arc { at: 30, 37; radius: a * 4.8; span: 100deg; width: 2.2; color: if(net_online, accent_c, ink_c) }
                }
                ellipse { at: 30, 37.5; radius: 1.9; color: if(net_online, accent_c, ink_c) }
                text "Wi-Fi" { at: 58, 22; anchor: left center; size: ts_sub; weight: 600; color: if(net_online, on_accent, ink_c) }
                text if(net_online, net_name, "Off") { at: 58, 38; anchor: left center; size: ts_micro; color: if(net_online, on_accent, ink_sub); opacity: if(net_online, 80%, 100%); width: 80; lines: 1 }
                zone box wifi_chevron_hit { from: 52, 0; size: 106, 60; corner: radius_card; cursor: pointer }
                on press wifi_chevron_hit { cc_page = 1 }
                zone box wifi_icon_hit { at: 30, 30; size: 40, 40; corner: r_l; cursor: pointer }
            }

            // ── Bluetooth ──
            group {
                move: 16, 88
                size: 158, 60
                CardBg(158, 60, radius_card, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
                box { from: 0, 0; size: 158, 60; corner: radius_card; color: accent_c; opacity: if(bt_on, 100%, 0%) }
                box { from: 0, 0; size: 158, 60; corner: radius_card; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                ellipse { at: 30, 30; radius: 20; color: if(bt_on, on_accent, item_solid) }
                path { at: 25.5, 20; color: if(bt_on, accent_c, ink_c); stroke: 2; move 0, 6; line 9, 15; line 4.5, 20; line 4.5, 0; line 9, 5; line 0, 14 }
                text "Bluetooth" { at: 58, 22; anchor: left center; size: ts_sub; weight: 600; color: if(bt_on, on_accent, ink_c) }
                text bt_sub { at: 58, 38; anchor: left center; size: ts_micro; color: if(bt_on, on_accent, ink_sub); opacity: if(bt_on, 80%, 100%); width: 80; lines: 1 }
                zone box bt_chevron_hit { from: 52, 0; size: 106, 60; corner: radius_card; cursor: pointer }
                zone box bt_icon_hit { at: 30, 30; size: 40, 40; corner: r_l; cursor: pointer }
            }

            // ── Now Playing: a tile on the right, as tall as the two pills ──
            group {
                move: 186, 16
                size: 158, 132
                CardBg(158, 132, radius_card, true, ui_card_fill: card_fill, ui_card_stroke: card_stroke)

                group {
                    show: not has_player
                    ellipse { at: 79, 48; radius: 22; color: item_solid }
                    path { at: 71, 37; color: ink_sub; move 0, 0; line 17, 11; line 0, 22; close }
                    text "Not Playing" { at: 79, 96; anchor: center; size: ts_sub; weight: 600; color: ink_sub }
                }

                group {
                    show: has_player
                    body {
                        gradient: 0, 0 to 46, 46, #e8a048, #7f52ff
                        box { from: 14, 14; size: 46, 46; corner: radius_medium }
                    }
                    group {
                        clip box { from: 14, 14; size: 46, 46; corner: radius_medium }
                        image cover { at: -5, 13; size: 84, 48; show: has_art }
                    }
                    text System.track_title { at: 14, 74; anchor: left center; size: ts_sub; weight: 600; color: ink_c; width: 132; lines: 1 }
                    text System.track_artist { at: 14, 90; anchor: left center; size: ts_micro; color: ink_sub; width: 132; lines: 1 }

                    //  progress
                    box { from: 14, 102; size: 130, 3; corner: 1.5; color: slider_bg; opacity: slider_bg_op }
                    box { from: 14, 102; size: max(3, 130 * clamp(track_pos / max(track_len, 1), 0, 1)), 3; corner: 1.5; color: slider_bar; opacity: slider_bar_op; show: track_len > 0 }
                    zone box seek_hit { from: 14, 96; size: 130, 14; cursor: pointer; active: track_len > 0 }
                    on press seek_hit { emit System.seek(clamp(local.x / 130, 0, 1)) }

                    group { move: 30, 104; IconButton("󰒮", "Previous track", System.previous, ink_c, item_solid, icon_button_compact, icon_button_compact, icon_size, control_r, 0) }
                    group { move: 64, 104; IconButton(if(is_playing, "󰏤", "󰐊"), "Play or pause", System.play_pause, ink_c, item_solid, icon_button_compact, icon_button_compact, icon_size, control_r, 0) }
                    group { move: 104, 104; IconButton("󰒭", "Next track", System.next, ink_c, item_solid, icon_button_compact, icon_button_compact, icon_size, control_r, 0) }
                }
            }

            // ── Do Not Disturb: a wide pill with a moon ──
            group {
                move: 16, 160
                size: 158, 60
                CardBg(158, 60, radius_card, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
                box { from: 0, 0; size: 158, 60; corner: radius_card; color: focus_c; opacity: if(Notifications.quiet, 100%, 0%) }
                box { from: 0, 0; size: 158, 60; corner: radius_card; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                ellipse { at: 30, 30; radius: 20; color: if(Notifications.quiet, on_accent, item_solid) }
                //  the moon: a disc with a bite out of it, the bite in the disc's own colour
                ellipse { at: 29, 31; radius: 9; color: if(Notifications.quiet, focus_c, ink_c) }
                ellipse { at: 34, 27; radius: 8; color: if(Notifications.quiet, on_accent, item_solid) }
                text if(Notifications.dnd or not Notifications.quiet, "Do Not", "Quiet") { at: 58, 24; anchor: left center; size: ts_sub; weight: 600; color: if(Notifications.quiet, on_accent, ink_c) }
                text if(Notifications.dnd or not Notifications.quiet, "Disturb", Notifications.quiet_short) { at: 58, 38; anchor: left center; size: ts_sub; weight: 600; color: if(Notifications.quiet, on_accent, ink_c) }
                zone box dnd_hit { from: 0, 0; size: 158, 60; corner: radius_card; cursor: pointer; label: if(Notifications.dnd, "Turn off manual Do Not Disturb", "Turn on manual Do Not Disturb") }
                on press dnd_hit { emit toggle_dnd }
            }

            // ── Dark Mode: a square that is a sun or a moon ──
            group {
                move: 186, 160
                size: 73, 60
                CardBg(73, 60, r_l, true, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
                ellipse { at: 36.5, 30; radius: 19; color: if(dark_mode, focus_c, warn_c) }
                group {
                    show: dark_mode
                    ellipse { at: 35.5, 31; radius: 9; color: on_accent }
                    ellipse { at: 40, 27; radius: 8; color: focus_c }
                }
                group {
                    show: not dark_mode
                    ellipse { at: 36.5, 30; radius: 5.5; color: on_accent }
                    repeat k in 0..8 { line { from: 36.5 + 9 * cos(k * 45), 30 + 9 * sin(k * 45); to: 36.5 + 12 * cos(k * 45), 30 + 12 * sin(k * 45); width: 2; color: on_accent } }
                }
                zone box dm_tile_hit { from: 0, 0; size: 73, 60; corner: r_l; cursor: pointer }
            }

            // ── Settings: a square with three sliders ──
            group {
                move: 271, 160
                size: 73, 60
                CardBg(73, 60, r_l, true, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
                ellipse { at: 36.5, 30; radius: 19; color: item_solid }
                line { from: 26, 23; to: 47, 23; width: 1.8; color: ink_c }
                line { from: 26, 30; to: 47, 30; width: 1.8; color: ink_c }
                line { from: 26, 37; to: 47, 37; width: 1.8; color: ink_c }
                ellipse { at: 32, 23; radius: 3; color: ink_c }
                ellipse { at: 42, 30; radius: 3; color: ink_c }
                ellipse { at: 35, 37; radius: 3; color: ink_c }
                zone box settings_tile_hit { from: 0, 0; size: 73, 60; corner: r_l; cursor: pointer }
                on press settings_tile_hit { emit open_settings; emit Panels.close; cc_page = 0 }
            }

            // Sliders Section
            column {
                at: 16, 232
                gap: space_12
                LevelSlider("Display", disp_level, "{disp_level * 100, 0}%", 0, brightness_set, open_nothing)
                LevelSlider("Sound", snd_volume, "{snd_volume * 100, 0}% ›", 1, volume_set, open_sound)
            }

            // ── four round shortcuts ──
            group {
                move: 16, 362
                //  Search
                ellipse { at: 28, 28; radius: 28; color: card_fill; opacity: card_fill_op }
                ellipse { at: 28, 28; radius: 28; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                ellipse { at: 26, 26; radius: 8; stroke: 2.2; color: ink_c }
                line { from: 32, 32; to: 38, 38; width: 2.4; color: ink_c }
                zone box sc_search_hit { at: 28, 28; size: 56, 56; corner: radius_window; cursor: pointer }
                on press sc_search_hit { emit sc_search; emit Panels.close; cc_page = 0 }

                //  Clipboard
                ellipse { at: 118.7, 28; radius: 28; color: card_fill; opacity: card_fill_op }
                ellipse { at: 118.7, 28; radius: 28; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                box { from: 108.7, 18; size: 20, 24; corner: 4; stroke: 2.2; color: ink_c }
                box { from: 113.7, 15; size: 10, 6; corner: 2; color: ink_c }
                zone box sc_clip_hit { at: 118.7, 28; size: 56, 56; corner: radius_window; cursor: pointer }

                //  Screenshot: a viewfinder
                ellipse { at: 209.3, 28; radius: 28; color: card_fill; opacity: card_fill_op }
                ellipse { at: 209.3, 28; radius: 28; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                path { at: 198.3, 17; color: ink_c; stroke: 2.2; move 0, 6; line 0, 0; line 6, 0 }
                path { at: 214.3, 17; color: ink_c; stroke: 2.2; move 0, 0; line 6, 0; line 6, 6 }
                path { at: 198.3, 33; color: ink_c; stroke: 2.2; move 0, 0; line 0, 6; line 6, 6 }
                path { at: 214.3, 33; color: ink_c; stroke: 2.2; move 6, 0; line 6, 6; line 0, 6 }
                ellipse { at: 209.3, 28; radius: 3; color: ink_c }
                zone box sc_shot_hit { at: 209.3, 28; size: 56, 56; corner: radius_window; cursor: pointer }

                //  Session menu
                ellipse { at: 300, 28; radius: 28; color: card_fill; opacity: card_fill_op }
                ellipse { at: 300, 28; radius: 28; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                Sym("󰐥", 300, 28, icon_button_size, ink_c)
                zone box sc_session_hit { at: 300, 28; size: 56, 56; corner: radius_window; cursor: pointer; label: "Session menu" }
            }
        }

        // ==========================================================
        // PAGE 1: WI-FI
        // ==========================================================
        group {
            show: cc_page == 1

            group { move: 16, 20; IconTextButton("󰅁", "Wi-Fi", cc_back, 0, ink_c, ink_c, item_bg, 100, control_h_large, 0, font_size: 16, icon_size: 18) }
            //  Radio switch
            group { move: 300, 24; Switch(wifi_state != 0, toggle_wifi, ui_accent_c: ok_c, ui_on_accent: on_accent, ui_switch_off: switch_off) }

            // ── the connection in use, or why there is none ──
            group {
                show: not asking
                move: 16, 62
                CardBg(328, 64, r_m, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
                box { from: 0, 0; size: 328, 64; corner: r_m; color: accent_c; opacity: if(wifi_state == 2 or wifi_state == 3, 100%, 0%) }
                box { from: 0, 0; size: 328, 64; corner: r_m; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                group {
                    move: 12, 20
                    opacity: if(wifi_state == 0, 35%, 100%)
                    Bars(if(wifi_state >= 2, wifi_signal, 0), if(wifi_state >= 2, on_accent, ink_c))
                }
                text wifi_title { at: 52, 24; anchor: left center; size: ts_body; weight: 600; color: if(wifi_state == 2 or wifi_state == 3, on_accent, ink_c); width: 150; lines: 1 }
                text wifi_status { at: 52, 42; anchor: left center; size: ts_micro; color: if(wifi_state == 2 or wifi_state == 3, on_accent, ink_sub); opacity: if(wifi_state == 2 or wifi_state == 3, 80%, 100%); width: 150; lines: 1 }
                row {
                    at: 316, 32
                    anchor: right middle
                    show: wifi_state == 2
                    Pill("Disconnect", 104, wifi_disconnect, 3, ui_accent_c: accent_c, ui_danger_c: danger_c, ui_ink_c: ink_c, ui_item_bg: item_bg, ui_on_accent: on_accent)
                }
                row {
                    at: 316, 32
                    anchor: right middle
                    show: wifi_state == 0
                    Pill("Turn On", 84, wifi_power, 1, ui_accent_c: accent_c, ui_danger_c: danger_c, ui_ink_c: ink_c, ui_item_bg: item_bg, ui_on_accent: on_accent)
                }
                row {
                    at: 316, 32
                    anchor: right middle
                    show: wifi_state == 4
                    Pill("Cancel", 76, wifi_disconnect, ui_accent_c: accent_c, ui_danger_c: danger_c, ui_ink_c: ink_c, ui_item_bg: item_bg, ui_on_accent: on_accent)
                }
            }

            // ── networks in range ──
            group {
                show: wifi_state != 0 and not asking
                SectionLabel(20, 144, "NEARBY", ui_ink_sub: ink_sub)
                text "Look again" { at: 344, 144; anchor: right center; size: ts_micro; color: ink_sub }
                zone box wifi_rescan_hit { from: 270, 134; size: 74, 20; corner: radius_small; cursor: pointer }
                column {
                    at: 16, 158
                    gap: space_4
                    for n in wifi_rows {
                        group {
                            size: 328, 36
                            CardBg(328, 36, r_s, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
                            box { from: 0, 0; size: 328, 36; corner: r_s; color: accent_c; opacity: if(n.active, 100%, 0%) }
                            box { from: 0, 0; size: 328, 36; corner: r_s; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                            group {
                                move: 10, 6
                                Bars(n.signal, if(n.active, on_accent, ink_c))
                            }
                            text n.name { at: 46, 18; anchor: left center; size: ts_sub; weight: if(n.active, 600, 400); color: if(n.active, on_accent, ink_c); width: 190; lines: 1 }
                            text "Joining…" { at: 300, 18; anchor: right center; size: ts_micro; color: ink_sub; show: n.joining }
                            text "Connected" { at: 300, 18; anchor: right center; size: ts_micro; color: on_accent; opacity: 85%; show: n.active and not n.joining }
                            text "Saved" { at: 300, 18; anchor: right center; size: ts_micro; color: ink_sub; show: n.known and not n.active and not n.joining }
                            group {
                                show: n.secure and not n.known and not n.active
                                box { from: 310, 20; size: 9, 7; corner: 2; color: ink_sub }
                                arc { at: 314.5, 20; radius: 3; span: 180deg; width: 1.4; color: ink_sub }
                            }
                            zone box wifi_row_hit { from: 0, 0; size: 328, 36; corner: r_s; cursor: pointer }
                            on press wifi_row_hit { emit pick_network(n.index) }
                        }
                    }
                }
                text "Looking for networks…" { at: 180, 230; anchor: center; size: ts_sub; color: ink_sub; show: wifi_rows.count < 1 }
            }
            text "Turn Wi-Fi on to see the networks around you." { at: 180, 200; anchor: center; size: ts_sub; color: ink_sub; show: wifi_state == 0 and not asking }

            // ── its password, asked for in the list's place ──
            group {
                show: asking
                move: 16, 62
                CardBg(328, 150, r_m, true, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
                text "Join" { at: 164, 24; anchor: center; size: ts_micro; color: ink_sub }
                text ask_name { at: 164, 44; anchor: center; size: ts_title; weight: 600; color: ink_c; width: 290; lines: 1; tight: true }
                box { from: 18, 66; size: 292, 34; corner: control_r; color: slider_bg; opacity: slider_bg_op }
                //  the password field itself is `Keys.wifi_pw` (keys.plm): only the Keys surface receives typing on every monitor
                text ask_error { at: 164, 114; anchor: center; size: ts_micro; color: danger_c }
                row {
                    at: 164, 132
                    anchor: center middle
                    gap: space_12
                    Pill("Cancel", 90, wifi_cancel, ui_accent_c: accent_c, ui_danger_c: danger_c, ui_ink_c: ink_c, ui_item_bg: item_bg, ui_on_accent: on_accent)
                    Pill("Join", 90, wifi_join_click, 1, ui_accent_c: accent_c, ui_danger_c: danger_c, ui_ink_c: ink_c, ui_item_bg: item_bg, ui_on_accent: on_accent)
                }
            }
        }

        // ==========================================================
        // PAGE 2: BLUETOOTH DEVICES SUB-PAGE
        // ==========================================================
        group {
            show: cc_page == 2

            group { move: 16, 20; IconTextButton("󰅁", "Bluetooth", cc_back, 0, ink_c, ink_c, item_bg, 130, control_h_large, 0, font_size: 16, icon_size: 18) }

            //  Power switch, and the search button beside it
            group { move: 300, 24; Switch(bt_on, bt_power, ui_accent_c: ok_c, ui_on_accent: on_accent, ui_switch_off: switch_off, enabled: bt_present) }
            text if(bt_scanning, "Searching…", "Search") { at: 292, 36; anchor: right center; size: ts_cap; weight: 500; color: if(bt_scanning, accent_c, ink_sub); show: bt_on }
            zone box bt_scan_hit { from: 200, 24; size: 94, 24; corner: radius_medium; cursor: pointer; active: bt_on }

            column {
                at: 16, 62
                gap: space_6
                for g in bt_rows {
                    group {
                        size: 328, 46
                        CardBg(328, 46, r_m, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
                        box { from: 0, 0; size: 328, 46; corner: r_m; color: accent_c; opacity: if(g.state == 1, 100%, 0%) }
                        box { from: 0, 0; size: 328, 46; corner: r_m; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                        ellipse { at: 24, 23; radius: 15; color: if(g.state == 1, on_accent, item_bg); opacity: if(g.state == 1, 100%, item_bg_op) }
                        text pick(g.kind, "󰂯", "󰋋", "󰍽", "󰌌", "󰏲", "󰟀", "󰊴", "󰓃") { family: "JetBrainsMono Nerd Font Mono"; at: 24, 23; anchor: center; size: 14; color: if(g.state == 1, accent_c, ink_c) }
                        text g.name { at: 48, 17; anchor: left center; size: ts_body; weight: if(g.state == 1, 600, 500); color: if(g.state == 1, on_accent, ink_c); width: 150; lines: 1 }
                        text g.status { at: 48, 32; anchor: left center; size: ts_micro; color: if(g.state == 1, on_accent, ink_sub); opacity: if(g.state == 1, 85%, 100%); width: 150; lines: 1 }
                        text if(g.battery >= 0, "{g.battery * 100, 0}%", "") { at: 208, 23; anchor: right center; size: t_micro; color: if(g.state == 1, on_accent, ink_sub) }
                        box { from: 246, 9; size: 72, 28; corner: control_r; color: if(g.state == 0 or g.state == 3, accent_c, if(g.state == 1, on_accent, item_bg)); opacity: if(g.state == 0 or g.state == 3, 100%, if(g.state == 1, 24%, item_bg_op)) }
                        text pick(g.state, "Connect", "Disconnect", "…", "Pair") { at: 282, 23; anchor: center; size: ts_micro; weight: 600; color: if(g.state == 0 or g.state == 3 or g.state == 1, on_accent, ink_c) }
                        zone box bt_row_hit { from: 246, 9; size: 72, 28; corner: control_r; cursor: pointer }
                        on press bt_row_hit { emit bt_action(g.index) }
                    }
                }
            }
            group {
                show: bt_rows.count < 1
                text "Looking around…" { at: 180, 200; anchor: center; size: ts_sub; color: ink_sub; show: bt_on and bt_scanning }
                text "No paired devices. Press Search." { at: 180, 200; anchor: center; size: ts_sub; color: ink_sub; show: bt_on and not bt_scanning }
                text "Bluetooth is off. Use the switch to turn it on." { at: 180, 200; anchor: center; size: ts_sub; color: ink_sub; show: bt_present and not bt_on }
                group { show: not bt_present; EmptyState(180, 200, "󰂯", "No Bluetooth adapter found", ui_ink_sub: ink_sub) }
            }
        }

        // ==========================================================
        // PAGE 3: SOUND  (output, then each app's own volume)
        // ==========================================================
        group {
            show: cc_page == 3

            group { move: 16, 20; IconTextButton("󰅁", "Sound", cc_back, 0, ink_c, ink_c, item_bg, 150, control_h_large, 0, font_size: 16, icon_size: 18) }

            SectionLabel(20, 62, "OUTPUT", ui_ink_sub: ink_sub)
            column outs_list {
                at: 16, 74
                gap: space_4
                for o in outs {
                    group {
                        size: 328, 36
                        CardBg(328, 36, r_s, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
                        box { from: 0, 0; size: 328, 36; corner: r_s; color: accent_c; opacity: if(o.default, 100%, 0%) }
                        box { from: 0, 0; size: 328, 36; corner: r_s; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                        ellipse { at: 22, 18; radius: 12; color: if(o.default, on_accent, item_bg); opacity: if(o.default, 100%, item_bg_op) }
                        path { at: 16.5, 12.5; color: if(o.default, accent_c, ink_c); move 0, 3.5; line 3, 3.5; line 7, 0; line 7, 11; line 3, 7.5; line 0, 7.5; close }
                        text o.name { at: 44, 18; anchor: left center; size: ts_sub; weight: if(o.default, 600, 400); color: if(o.default, on_accent, ink_c); width: 250; lines: 1 }
                        text if(o.default, "✓", "") { at: 310, 18; anchor: center; size: 14; color: on_accent }
                        zone box out_row_hit { from: 0, 0; size: 328, 36; corner: r_s; cursor: pointer }
                        on press out_row_hit { emit pick_output(o.id) }
                    }
                }
            }

            //  Below the outputs: what is making sound, each with its own slider.
            group {
                move: 0, 74 + outs_list.height + 12
                group { show: app_rows.count > 0; SectionLabel(20, 0, "APPS", ui_ink_sub: ink_sub) }
                column {
                    at: 16, 12
                    gap: space_6
                    for a in app_rows {
                        group {
                            size: 328, 50
                            CardBg(328, 50, r_m, true, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
                            text a.name { at: 14, 14; anchor: left center; size: ts_cap; weight: 600; color: ink_c; width: 220; lines: 1 }
                            text "{a.volume * 100, 0}%" { at: 314, 14; anchor: right center; size: t_micro; color: ink_sub }
                            group {
                                move: 14, 28
                                box { from: 0, 0; size: 300, 14; corner: control_r; color: slider_bg; opacity: slider_bg_op }
                                box { from: 0, 0; size: max(14, 300 * a.volume), 14; corner: control_r; color: slider_bar; opacity: if(a.muted, 35%, slider_bar_op) }
                                zone box app_vol_hit { from: 0, 0; size: 300, 14; cursor: pointer }
                                on press app_vol_hit { emit app_volume(a.index + clamp(local.x / 300, 0, 0.999)) }
                                on drag app_vol_hit { emit app_volume(a.index + clamp(local.x / 300, 0, 0.999)) }
                            }
                        }
                    }
                }
                group { show: app_rows.count < 1; EmptyState(180, 46, "󰝚", "Nothing is playing right now", ui_ink_sub: ink_sub) }
            }
        }


        // ==========================================================
        // KEYBOARD FOCUS RING (drawn over every page; cc.luau moves `cc_focus`)
        // ==========================================================
        let cc_x = pick(cc_page,
            pick(cc_focus, 16, 16, 186, 16, 186, 271, 16, 16, 16, 106.7, 197.3, 288),
            pick(cc_focus, 300, 316 - pick(wifi_state, 84, 84, 104, 104, 76), 270, 16, 16, 16, 16, 16, 16, 16, 16, 16),
            pick(cc_focus, 300, 214, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16),
            16)
        let cc_y = pick(cc_page,
            pick(cc_focus, 16, 88, 16, 160, 160, 160, 232, 298, 362, 362, 362, 362),
            pick(cc_focus, 24, 18, 134, 158, 198, 238, 278, 318, 358, 398, 438, 478),
            pick(cc_focus, 24, 24, 62, 114, 166, 218, 270, 322, 374, 426, 478, 530),
            pick(cc_focus, 74, 114, 154, 194, 234, 274, 98 + outs_list.height, 98 + outs_list.height + 56, 98 + outs_list.height + 112, 98 + outs_list.height + 168, 0, 0))
        let cc_w = pick(cc_page,
            pick(cc_focus, 158, 158, 158, 158, 73, 73, 328, 328, 56, 56, 56, 56),
            pick(cc_focus, switch_w, pick(wifi_state, 84, 84, 104, 104, 76), 74, 328, 328, 328, 328, 328, 328, 328, 328, 328),
            pick(cc_focus, switch_w, 82, 328, 328, 328, 328, 328, 328, 328, 328, 328, 328),
            328)
        let cc_h = pick(cc_page,
            pick(cc_focus, 60, 60, 132, 60, 60, 60, 54, 54, 56, 56, 56, 56),
            pick(cc_focus, switch_h, control_h, 20, 36, 36, 36, 36, 36, 36, 36, 36, 36),
            pick(cc_focus, switch_h, 24, 46, 46, 46, 46, 46, 46, 46, 46, 46, 46),
            pick(cc_focus, 36, 36, 36, 36, 36, 36, 50, 50, 50, 50, 50, 50))
        let cc_r = pick(cc_page,
            pick(cc_focus, 16, 16, 16, 16, 16, 16, 16, 16, 28, 28, 28, 28),
            pick(cc_focus, 10, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8),
            pick(cc_focus, 10, 12, 12, 12, 12, 12, 12, 12, 12, 12, 12, 12),
            pick(cc_focus, 8, 8, 8, 8, 8, 8, 12, 12, 12, 12, 12, 12))
        prop ring_x = 16 ~quick
        prop ring_y = 16 ~quick
        prop ring_w = 158 ~quick
        prop ring_h = 60 ~quick
        prop ring_r = 16 ~quick
        follow ring_x = cc_x
        follow ring_y = cc_y
        follow ring_w = cc_w
        follow ring_h = cc_h
        follow ring_r = cc_r
        group {
            show: cc_focus >= 0 and not asking
            move: ring_x, ring_y
            box { from: -3, -3; size: ring_w + 6, ring_h + 6; corner: ring_r + 3; stroke: focus_stroke; color: ring_c }
        }

        // Sliders & Media Actions, navigation and theme: the rules name zones drawn above, so they live in the component
    on press sc_clip_hit   { emit sc_clip; emit Panels.close; cc_page = 0 }
    on press sc_shot_hit   { emit sc_shot; emit Panels.close; cc_page = 0 }
    on press sc_session_hit   { emit sc_session; emit Panels.close; cc_page = 0 }
    on press bt_scan_hit  { emit bt_scan }
    on press wifi_icon_hit    { emit toggle_wifi }
    on press wifi_rescan_hit  { emit wifi_rescan }
    on sub_wifi_pw while screen.index == 0 { emit wifi_join }
    on wifi_join_click        { emit wifi_join }
    on change asking while asking and screen.index == 0 { fld_req = 9; fld_seq = fld_seq + 1 }
    on press bt_chevron_hit   { cc_page = 2 }
    on press bt_icon_hit      { emit toggle_bt }
    on press dm_tile_hit   { emit toggle_dark }
    }

    on open_sound { cc_page = 3 }

    // Window lifecycle: Esc and losing the keyboard (only while the password sheet has it) close the panel

    //  Keyboard: every rule is guarded by the monitor (the frame is compiled once per monitor copy) and by this panel.
    //  cc.luau moves the focus and activates: 1 up · 2 down · 3 left · 4 right · 5 tab · 6 shift+tab · 9 escape ·
    //  10 / 11 Enter / space pressed (they arm the release) · 20 / 21 Enter / space released.
    on k_up while Panels.cur == 1 and screen.index == 0 { emit cc_key(1) }
    on k_down while Panels.cur == 1 and screen.index == 0 { emit cc_key(2) }
    on k_left while Panels.cur == 1 and screen.index == 0 { emit cc_key(3) }
    on k_right while Panels.cur == 1 and screen.index == 0 { emit cc_key(4) }
    on k_tab while Panels.cur == 1 and screen.index == 0 { emit cc_key(5) }
    on k_shift_tab while Panels.cur == 1 and screen.index == 0 { emit cc_key(6) }
    on k_escape while Panels.cur == 1 and screen.index == 0 { emit cc_key(9) }
    on k_return while Panels.cur == 1 and screen.index == 0 { emit cc_key(10) }
    on k_kp_enter while Panels.cur == 1 and screen.index == 0 { emit cc_key(10) }
    on k_space while Panels.cur == 1 and screen.index == 0 { emit cc_key(11) }
    on ku_return while Panels.cur == 1 and screen.index == 0 { emit cc_key(20) }
    on ku_kp_enter while Panels.cur == 1 and screen.index == 0 { emit cc_key(20) }
    on ku_space while Panels.cur == 1 and screen.index == 0 { emit cc_key(21) }
    on k_blur while Panels.cur == 1 and not Panels.fresh and askhold < 0.2 and screen.index == 0 { emit Panels.close; cc_page = 0 }
}
