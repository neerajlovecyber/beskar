// The notification centre (panel id 2, right island) and the BANNER card that drops in the centre pill: a scene of its own. It
// owns `dnd`, `banners`, `banner_ms`, `group_apps`, `banner_on`… (Settings and the Control Center ask it with `say`, the frame
// too), and it is THE notification server (org.freedesktop.Notifications). Logic: notifications.luau (+ notif.luau, the body).
import "common/palette.plm"
uses scene "settings.plm" as Settings      // owns the look (dark mode, skin, accent, palette, clock format): read by name
import "common/icons.plm"
import "common/ui.plm"
uses scene "panels.plm" as Panels
uses scene "activities.plm" as Activities   // explicit temporary quiet modes (focus / presentation / game) are read from it

scene Notifications {
    include "common/theme_owner.plm"
    include "common/theme.plm"

    //  `notifications` makes this the receiver of the desktop's notifications; `files` / `files.write` keep the history of
    //  dismissed ones across restarts; `say:topbar` / `say:lock` tell the bell and the lock screen how many are waiting.
    permissions {
        services: "notifications", "notifications.*", "files", "files.write", "say:topbar", "say:lock", "say:panels", "say:settings"
    }

    //  Both are painted by notifications.luau. `icon` is the application's own icon (a name or a path).
    //  `notices` are the ones waiting; `past` the ones already dealt with, newest first.
    model notices max 6 { id: number; app: text; title: text; body: text; icon: image 40, 40; has_icon: bool; age: text }
    //  `rows` is what the centre lists: notifications grouped by app. kind 0 a card · 1 a stack (the newest of an app
    //  with several, `extra` more behind it) · 2 the header of an app that is open. `key` names the group, `h` is the row's height.
    model rows max 16 { kind: number; key: number; id: number; app: text; title: text; body: text; icon: image 40, 40; has_icon: bool; age: text; h: number; y: number }
    //  The newest notification whose app may show a banner (a per-app rule can keep one out): the banner card draws this.
    model toast max 1 { id: number; app: text; title: text; body: text; icon: image 40, 40; has_icon: bool; age: text }
    //  For Settings: the apps with a quiet rule (mode 1 no banner · 2 muted; `rule` true) then recent senders without one (mode 0).
    model quiet_apps max 32 { app: text; mode: number; rule: bool }
    model past max 5 { title: text; body: text; icon: image 28, 28; age: text }

    fact banner_on = false      // a notification is shown inside the centre pill (the frame draws the glass)
    fact banner_hover = false   // the pointer is on it: it stays
    fact toast_screen = 0       // the monitor with the focus (kept up to date by topbar.luau): the banner drops there
    fact nc_height = 190        // bounded glass height; only the list below the header scrolls
    let nc_view_h = nc_height - 78
    fact live_h = 0             // how tall the waiting rows are together
    let group_apps = Settings.group_apps    // Settings → Notifications: stack several from one app (default: a plain list)
    let banners = Settings.banners          // Settings → Notifications: show banners at all
    fact banner_ms = 5500       // …and for how long
    fact dnd = false            // the MANUAL Do Not Disturb choice: only the user's own controls change it (never a policy)
    //  EFFECTIVE quiet = manual `dnd` OR an Activities mode OR quiet hours: no banners (everything still lands in the centre).
    fact quiet = false
    fact held_count = 0         // banners kept back by quiet state or an app rule since the centre was last opened
    fact rules_n = 0            // how many per-app rules are saved
    text quiet_label = ""       // "Do Not Disturb · Focus" (empty when not quiet)
    text quiet_short = ""       // "Focus +1": short enough for the centre header
    text quiet_status = ""      // the label plus "3 held"
    text rules_status = ""      // why a rule could not be read, saved or changed
    fact notif_count = 0        // how many are waiting (the bell in the frame reads it as Notifications.notif_count)
    //  asked by the other scenes (a scene writes only its own facts): Settings, the Control Center, the frame
    event set_dnd(on) ->
    event set_banner_ms(ms) ->
    event set_toast_screen(i) ->
    event hide_banner ->
    //  Per-app delivery rules (saved in quiet.json by this scene). `set_app_rule({ app, mode })` with mode "normal" | "no_banner" |
    //  "muted" (or 0 | 1 | 2); the others take the app name. `app` is the notification's app_name, exactly.
    event set_app_rule ->
    event clear_app_rule ->
    event cycle_app_rule ->
    event clear_app_rules ->

    event list_scrolled ->      // scalar offset; named event fields arrive as a table
    event clear_notices ->
    event card_click ->
    event clear_past ->
    event dismiss_notice ->
    event group_toggle ->       // a stack opens, an open group closes: the group's key
    event dismiss_group ->      // × on a stack: all of that app's notifications
    event set_banner_hover ->   // 1 / 0: the pointer is on a card the frame draws (the banner stays while it is)

    // ── look ─────────────────────────────────────────────────────

}
