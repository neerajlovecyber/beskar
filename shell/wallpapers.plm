// Wallpaper strip (Super+W): it rises out of the dock. Scans your pictures, plus wallpapers that ship with Beskar and the system's,
// shows them as thumbnails, and applies the one you click with a transition. As in Marea, the picture is
// painted by the wallpaper scene (wallpaper.plm, pleamar itself).
import "common/palette.plm"

scene MacWallpapers {
    let mp_sw = 1000
    let mp_sh = 300
    include "common/theme.plm"
    include "common/morph_core.plm"

    surface sheet {
        size: 1000, 300
        anchor: bottom
        margin: 0, 0, 0, 0
        level: overlay
        keyboard: exclusive while open
        screens: each
        open: (open or seen > 0.02) and open_screen == screen.index

    zone box dismiss { from: 0, 0; size: 1000, 300; active: open }

    group {
        move: 10, 300 - ph
        opacity: mp_fade

        //  clicks on the strip itself do not close it
        zone box inside { from: 0, 0; size: 980, 250 }
        on press right inside { }

        text "Wallpapers" { at: 28, 30; anchor: left center; size: 17; weight: 700; color: ink_c }
        text wall_hint { at: 150, 32; anchor: left center; size: 11.5; color: ink_sub }
        row {
            at: 950, 30
            anchor: right middle
            gap: 8
            TabPill("All", 0, 60)
            TabPill("Mine", 1, 66)
            TabPill("Built-in", 2, 84)
        }

        //  The wheel goes BEFORE the cards: the last declared zone is the one on top.
        zone box wall_wheel { from: 20, 56; size: 940, 140 }
        on scroll wall_wheel { emit wall_scroll(wheel) }

        row {
            at: 34, 62
            gap: 8
            for w in walls { WallCard(w, wall_pick) }
        }
        //  the arrow buttons, on both sides of the cards
        group {
            move: 1, 96
            ArrowBtn(-1)
        }
        group {
            move: 947, 96
            ArrowBtn(1)
        }

        //  Nothing found
        text "No pictures found. Put some in ~/Pictures/wallpapers." { at: 490, 120; anchor: center; size: 13; color: ink_sub; show: wall_total < 1 }

        //  Where you are in a long list: a thin bar under the cards
        box { from: 28, 196; size: 924, 3; corner: 1.5; color: ink_c; opacity: if(wall_rows > 1, 10%, 0%) }
        box { from: 28 + 924 * wall_row / max(1, wall_total), 196; size: max(30, 924 * 5 / max(1, wall_total)), 3; corner: 1.5; color: ink_c; opacity: if(wall_rows > 1, 45%, 0%) }

        text "← →  to browse   ·   Enter or click to apply   ·   Esc to close" { at: 490, 222; anchor: center; size: 10.5; color: ink_sub; opacity: 80% }
    }
        on press dismiss { open = false }
    }

    permissions {
        services: "say:spotlight", "say:clipboard", "say:music", "say:control_center", "say:notifications", "say:dashboard", "say:settings", "say:widget_bar", "say:wallpaper", "say:topbar"
        run: "sh", "magick", "fd"
    }

    //  Painted by wallpapers.luau: the five on screen, in one row.
    model walls max 6 { name: text; thumb: image 176, 99; current: bool; ready: bool; builtin: bool; sel: bool }

    fact wall_tab = 0            // 0 all · 1 mine · 2 built in
    fact wall_total = 0          // how many match the tab
    fact wall_row = 0            // the first picture on screen (0-based)
    fact wall_rows = 1           // how far it can scroll + 1
    text wall_hint = ""

    event toggle
    event wall_pick ->
    event wall_scroll ->
    event wall_tab_set ->
    event wall_move ->
    event wall_page ->
    event wall_enter ->
    event accent_now ->

    //  One wallpaper: the picture, its name, a ring if it is the one on now, a small lift on hover.
    component WallCard(w: record, pick: event) {
        size: 176, 120
        prop lift = 0 ~lively
        zone box touch { from: 0, 0; size: 176, 99; corner: 14; cursor: pointer }
        group {
            move: 0, -lift * 2
            pivot: 88, 50
            scale: 1 + 0.035 * lift
            box { from: 0, 0; size: 176, 99; corner: 14; color: item_solid }
            group {
                clip box { from: 0, 0; size: 176, 99; corner: 14 }
                image w.thumb { at: 0, 0; size: 176, 99; show: w.ready }
            }
            box { from: 0, 0; size: 176, 99; corner: 14; stroke: 3; color: accent_c; opacity: if(w.current, 100%, 0%) }
            box { from: 0, 0; size: 176, 99; corner: 14; stroke: 1.2; color: ink_c; opacity: max(lift * 35%, if(w.sel, 60%, 0%)) * if(w.current, 0, 1) }
            //  a small tick on the one in use
            group {
                show: w.current
                ellipse { at: 156, 80; radius: 10; color: accent_c }
                path { at: 150.5, 76; color: #ffffff; stroke: 2; move 0, 4.5; line 4, 8; line 11, 0 }
            }
        }
        text w.name { at: 88, 111; anchor: center; size: 10.5; weight: if(w.current, 600, 400); color: if(w.current, ink_c, ink_sub); width: 168; lines: 1 }
        on enter touch { lift: 1 }
        on leave touch { lift: 0 }
        on press touch { emit pick(w.index) }
        on press right touch { }
    }

    //  An arrow (just the chevron, no circle) at one end of the strip; `dir` -1 left, 1 right. Dim when there is nowhere to go.
    component ArrowBtn(dir: number) {
        size: 32, 32
        prop hot = 0 ~quick
        let can = if(dir < 0, wall_row > 0, wall_row < wall_rows - 1)
        path { at: 12 + dir * 0.5, 7; color: if(can and hot > 0.5, accent_c, ink_c); stroke: 2.6; opacity: if(can, 80% + hot * 20%, 25%); move 4 - dir * 4, 0; line 4 + dir * 4, 9; line 4 - dir * 4, 18 }
        zone box hit { from: 0, 0; size: 32, 32; corner: 16; cursor: pointer; active: can }
        on enter hit { hot: 1 }
        on leave hit { hot: 0 }
        on press hit { emit wall_page(dir) }
        on press right hit { }
    }

    component TabPill(label: text, n: number, w: number = 76) {
        size: w, 28
        box { from: 0, 0; size: w, 28; corner: 14; color: if(wall_tab == n, accent_c, item_bg); opacity: if(wall_tab == n, 100%, item_bg_op) }
        text label { at: w / 2, 14; anchor: center; size: 11.5; weight: 600; color: if(wall_tab == n, #ffffff, ink_c) }
        zone box hit { from: 0, 0; size: w, 28; corner: 14; cursor: pointer }
        on press hit { emit wall_tab_set(n) }
        on press right hit { }
    }


    //  The glass is drawn by the frame: the dock island grows up and out into the strip (topbar.plm).

    on toggle     { toggle open }
    on key Left   { emit wall_move(-1) }
    on key Right  { emit wall_move(1) }
    on key Return { emit wall_enter }
    on key Escape { open = false }
    on blur       { open = false }
}
