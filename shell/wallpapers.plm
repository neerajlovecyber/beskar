// Wallpaper picker (Super+W). Scans your pictures, plus wallpapers that ship with Beskar and the system's,
// shows them as thumbnails, and applies the one you click with a transition. As in Marea, the picture is
// painted by a separate daemon (awww), so the wallpaper stays when the shell is not running.
import "common/palette.plm"

scene MacWallpapers {
    include "common/theme.plm"

    surface {
        size: 840, 600
        anchor: center
        level: overlay
        keyboard: on_demand
    }

    permissions {
        services: "say:spotlight", "say:clipboard", "say:control_center", "say:notifications", "say:dashboard", "say:settings", "say:topbar"
        run: "sh", "awww", "magick", "fd"
    }

    //  Painted by wallpapers.luau: the twelve on screen, 4 across.
    model walls max 12 { name: text; thumb: image 176, 99; current: bool; ready: bool; builtin: bool }

    fact open = false
    fact wall_tab = 0            // 0 all · 1 mine · 2 built in
    fact wall_total = 0          // how many match the tab
    fact wall_row = 0            // first row on screen
    fact wall_rows = 1           // rows in all
    text wall_hint = ""

    event toggle
    event wall_pick ->
    event wall_scroll ->
    event wall_tab_set ->
    event accent_now ->

    prop seen = 0 ~quick
    prop scale = 0.96 ~quick
    layer panel ~quick {
        shown while open { seen: 1 ~quick; scale: 1 ~quick }
        gone             { seen: 0 ~quick; scale: 0.96 ~quick }
    }

    //  One wallpaper: the picture, its name, a ring if it is the one on now, a small lift on hover.
    component WallCard(w: record, pick: event) {
        size: 176, 120
        prop lift = 0 ~lively
        zone box touch { from: 0, 0; size: 176, 99; corner: 14; cursor: pointer }
        group {
            move: 0, -lift * 2
            pivot: 88, 50
            scale: 1 + 0.035 * lift
            box { from: 0, 0; size: 176, 99; corner: 14; color: item_solid }
            group {
                clip box { from: 0, 0; size: 176, 99; corner: 14 }
                image w.thumb { at: 0, 0; size: 176, 99; show: w.ready }
            }
            box { from: 0, 0; size: 176, 99; corner: 14; stroke: 3; color: accent_c; opacity: if(w.current, 100%, 0%) }
            box { from: 0, 0; size: 176, 99; corner: 14; stroke: 1.2; color: ink_c; opacity: lift * 35% * if(w.current, 0, 1) }
            //  a small tick on the one in use
            group {
                show: w.current
                ellipse { at: 156, 80; radius: 10; color: accent_c }
                path { at: 150.5, 76; color: #ffffff; stroke: 2; move 0, 4.5; line 4, 8; line 11, 0 }
            }
        }
        text w.name { at: 88, 111; anchor: center; size: 10.5; weight: if(w.current, 600, 400); color: if(w.current, ink_c, ink_sub); width: 168; lines: 1 }
        on enter touch { lift: 1 }
        on leave touch { lift: 0 }
        on press touch { emit pick(w.index) }
        on press right touch { }
    }

    component TabPill(label: text, n: number, w: number = 76) {
        size: w, 28
        box { from: 0, 0; size: w, 28; corner: 14; color: if(wall_tab == n, accent_c, item_bg); opacity: if(wall_tab == n, 100%, item_bg_op) }
        text label { at: w / 2, 14; anchor: center; size: 11.5; weight: 600; color: if(wall_tab == n, #ffffff, ink_c) }
        zone box hit { from: 0, 0; size: w, 28; corner: 14; cursor: pointer }
        on press hit { emit wall_tab_set(n) }
        on press right hit { }
    }

    zone box dismiss { from: 0, 0; size: 840, 600; active: open }
    on press dismiss { open = false }
    on press right dismiss { }

    group {
        move: 20, 20
        pivot: 400, 270
        scale: scale
        opacity: seen

        body {
            color: bg_color
            glass: glass_amt
            lens: false
            frost: 100%
            dispersion: 35%
            refraction: 75%
            tint: tint_amt
            rim: rim_amt
            box { from: 0, 0; size: 800, 560; corner: 30 }
        }

        //  A zone that eats clicks on the panel itself, so they do not close it
        zone box inside { from: 0, 0; size: 800, 560 }
        on press right inside { }

        text "Wallpapers" { at: 30, 38; anchor: left center; size: 18; weight: 700; color: ink_c }
        text wall_hint { at: 140, 40; anchor: left center; size: 11.5; color: ink_sub }
        row {
            at: 770, 38
            anchor: right middle
            gap: 8
            TabPill("All", 0, 60)
            TabPill("Mine", 1, 66)
            TabPill("Built-in", 2, 84)
        }

        //  The wheel goes BEFORE the cards: the last declared zone is the one on top.
        zone box wall_wheel { from: 20, 72; size: 760, 420 }
        on scroll wall_wheel { emit wall_scroll(wheel) }

        grid {
            at: 30, 80
            columns: 4
            gap: 14
            width: 740
            row: 128
            for w in walls { WallCard(w, wall_pick) }
        }

        //  Nothing found
        text "No pictures found. Put some in ~/Pictures/wallpapers." { at: 400, 270; anchor: center; size: 13; color: ink_sub; show: wall_total < 1 }

        //  Where you are in a long list
        box { from: 786, 82 + 400 * wall_row / max(1, wall_rows); size: 3, max(24, 400 / max(1, wall_rows)); corner: 1.5; color: ink_c; opacity: if(wall_rows > 3, 28%, 0%) }

        text "Scroll for more  ·  Click to apply  ·  Esc to close" { at: 400, 530; anchor: center; size: 10.5; color: ink_sub; opacity: 80% }
    }

    on toggle     { toggle open }
    on key Escape { open = false }
    on blur       { open = false }
}
