// The authentication dialog: when a program needs administrator rights (an installer, a disk tool, a settings
// helper), polkit asks the session's authentication agent for the password. This scene IS that agent (pleamar's
// `polkit` service, watched in polkit.luau). A modal sheet on the monitor with the focus, like the session dialog:
// what is being asked and by whom, the password, Cancel / Authenticate (Enter / Esc).
import "common/palette.plm"

scene MacPolkit {
    include "common/theme.plm"
    include "common/icons.plm"
    include "common/here.plm"

    permissions {
        services: "polkit", "polkit.*", "say:topbar", "say:spotlight", "say:clipboard", "say:control_center", "say:notifications", "say:dashboard", "say:settings", "say:wallpapers", "say:music", "say:weather", "say:widget_bar", "say:overview"
    }

    surface sheet {
        size: 520, 380
        anchor: center
        level: overlay
        keyboard: exclusive while open
        screens: each
        open: (open or seen > 0.02) and open_screen == screen.index

        zone box scrim { from: 0, 0; size: 520, 380; active: open }

        group {
            pivot: 220, 150
            scale: scale
            opacity: seen
            move: 40 + shake, 40

            body {
                color: bg_color
                glass: glass_amt
                lens: false
                frost: 100%
                dispersion: 0
                refraction: 0
                tint: tint_amt
                rim: rim_amt
                box { from: 0, 0; size: 440, 300; corner: r_l }
            }
            box { from: 0, 0; size: 440, 300; corner: r_l; stroke: 1; color: card_stroke; opacity: card_stroke_op }

            //  the icon
            ellipse { at: 220, 50; radius: 26; color: accent_c }
            Sym("󰌾", 220, 50, 26, on_accent)

            text "Authentication required" { at: 220, 98; anchor: center center; size: t_title; weight: 700; color: ink_c; width: 400; lines: 1; align: center }
            //  what the program wants, as polkit words it
            text pk_message { at: 220, 124; anchor: center center; size: t_sub; color: ink_sub; width: 390; lines: 2; align: center }

            //  the password
            text pk_prompt { at: 50, 172; anchor: left center; size: t_cap; weight: 600; color: ink_c; width: 340; lines: 1 }
            box { from: 50, 186; size: 340, 38; corner: r_s; color: item_bg; opacity: item_bg_op }
            box { from: 50, 186; size: 340, 38; corner: r_s; stroke: 1.5; color: if(pk_wrong, danger_c, accent_c); opacity: if(pk_wrong, 90%, 55%) }
            input password {
                at: 62, 195
                width: 316
                size: 14
                color: ink_c
                placeholder: "Password"
                secret: true
                agent: no
            }
            text pick(if(pk_wrong, 1, 0), pk_info, "Wrong password, try again") { at: 220, 242; anchor: center center; size: t_cap; color: if(pk_wrong, danger_c, ink_sub); width: 390; lines: 1 }

            //  Cancel / Authenticate
            group {
                move: 130, 262
                box { from: 0, 0; size: 90, 30; corner: 8; color: item_solid }
                text "Cancel" { at: 45, 15; anchor: center center; size: t_body; weight: 500; color: ink_c }
                zone box btn_cancel { from: 0, 0; size: 90, 30; corner: 8; cursor: pointer }
                on press btn_cancel { emit pk_cancel }
                on press right btn_cancel { }
            }
            group {
                move: 230, 262
                box { from: 0, 0; size: 110, 30; corner: 8; color: accent_c; opacity: if(pk_asking, 100%, 45%) }
                text "Authenticate" { at: 55, 15; anchor: center center; size: t_body; weight: 600; color: on_accent }
                zone box btn_ok { from: 0, 0; size: 110, 30; corner: 8; cursor: pointer; active: pk_asking }
                on press btn_ok { emit pk_answer }
                on press right btn_ok { }
            }
        }
        on press scrim { }
        on press right scrim { }
    }

    fact open = false
    fact pk_secret = true
    fact pk_asking = false
    fact pk_wrong = false
    text pk_message = ""
    text pk_prompt = "Password"
    text pk_info = ""
    text password = ""

    prop seen = 0 ~quick
    prop scale = 0.96 ~lively
    prop shake = 0 ~quick
    layer modal ~quick {
        shown while open { seen: 1 ~quick; scale: 1 ~lively }
        gone             { seen: 0 ~quick; scale: 0.96 ~quick }
    }

    event toggle
    event pk_cancel ->
    event pk_answer ->
    event pk_shake

    on toggle { toggle open }
    on submit password { emit pk_answer }
    on key Escape { emit pk_cancel }
    on pk_shake { impulse shake 18 }
    on change open while open { focus password }
}
