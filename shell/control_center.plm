// macOS Control Center for Wayland Compositors
import "common/palette.plm"

scene MacControlCenter {
    surface {
        size: 440, 560
        anchor: top_right
        margin: 32, 4, 0, 0
        level: overlay
    }

    permissions {
        services: "audio", "audio.*", "brightness", "brightness.*", "media", "media.*", "network", "network.*", "bluetooth", "bluetooth.*"
    }

    // ── Built-in System Models ────────────────────────────────────
    model nets max 8 { ssid: text; strength: number; secure: bool; known: bool; active: bool }
    model gadgets max 8 { name: text; address: text; connected: bool; battery: number = -1 }
    model outs max 6 { id: number; name: text; default: bool }

    // ── System Services & Lists ───────────────────────────────────
    service audio as sound { volume: number; muted: bool; outputs: outs }
    service brightness as display { present: bool; level: number }
    service network as net { online: bool; name: text; networks: nets }
    service bluetooth as bt { powered: bool; devices: gadgets }
    service media as song { playing: bool; title: text; artist: text }

    // ── Navigation State: 0 = Main, 1 = Wi-Fi, 2 = Bluetooth, 3 = Sound
    fact page = 0
    fact open = false

    event toggle
    event go_main
    event go_wifi
    event go_bt
    event go_sound

    event volume_set ->
    event brightness_set ->
    event play_pause ->
    event pick_network ->
    event pick_device ->
    event pick_output ->
    event toggle_wifi ->
    event toggle_bt ->

    prop seen = 0 ~quick
    prop scale = 0.96 ~quick

    layer panel ~quick {
        shown while open { seen: 1 ~quick; scale: 1 ~quick }
        gone             { seen: 0 ~quick; scale: 0.96 ~quick }
    }

    // Dismiss click zone for outside
    zone box dismiss { from: 0, 0; size: 440, 560; active: open }
    on press dismiss { open = false; page = 0 }
    on press right dismiss { }

    group {
        move: 40, 16
        pivot: 320, 20
        scale: scale
        opacity: seen

        // ── Frosted Glass Main Window Frame ───────────────────────
        body {
            color: #1a1c22
            glass: 94%
            frost: auto
            rim: 14%
            shadow: 0, 14, 28, 35%
            box { from: 0, 0; size: 360, 480; corner: 22 }
        }

        // ==========================================================
        // PAGE 0: MAIN CONTROL CENTER OVERVIEW
        // ==========================================================
        group {
            show: page == 0

            // ── Top Row: Connectivity & Focus ─────────────────────
            row {
                at: 16, 16
                gap: 12

                // Connectivity 2x2 Card
                group {
                    size: 158, 134
                    body {
                        color: #24262d
                        glass: 80%
                        rim: 8%
                        box { from: 0, 0; size: 158, 134; corner: 16 }
                    }

                    // Wi-Fi Row
                    group {
                        size: 34, 34
                        move: 12, 14
                        ellipse { at: 17, 17; radius: 17; color: if(net.online, #007aff, #343740) }
                        text "󰤨" { at: 17, 17; anchor: center; size: 15; color: ink }
                        zone box wifi_icon_hit { from: 0, 0; size: 34, 34; cursor: pointer }
                    }
                    text "Wi-Fi" { at: 54, 22; anchor: left center; size: 12.5; weight: 600; color: ink }
                    text if(net.online, net.name, "Off") { at: 54, 36; anchor: left center; size: 10.5; color: ink; opacity: 60%; width: 80; lines: 1 }
                    text "󰅂" { at: 142, 28; anchor: center; size: 14; color: ink; opacity: 40% }
                    zone box wifi_chevron_hit { at: 142, 28; size: 24, 24; corner: 12; cursor: pointer }

                    // Bluetooth Row
                    group {
                        size: 34, 34
                        move: 12, 72
                        ellipse { at: 17, 17; radius: 17; color: if(bt.powered, #007aff, #343740) }
                        text "󰂯" { at: 17, 17; anchor: center; size: 15; color: ink }
                        zone box bt_icon_hit { from: 0, 0; size: 34, 34; cursor: pointer }
                    }
                    text "Bluetooth" { at: 54, 80; anchor: left center; size: 12.5; weight: 600; color: ink }
                    text if(bt.powered, "On", "Off") { at: 54, 94; anchor: left center; size: 10.5; color: ink; opacity: 60% }
                    text "󰅂" { at: 142, 86; anchor: center; size: 14; color: ink; opacity: 40% }
                    zone box bt_chevron_hit { at: 142, 86; size: 24, 24; corner: 12; cursor: pointer }
                }

                // Focus & Controls Right Column
                column {
                    gap: 12

                    // Do Not Disturb Card
                    group {
                        size: 158, 61
                        body {
                            color: #24262d
                            glass: 80%
                            rim: 8%
                            box { from: 0, 0; size: 158, 61; corner: 16 }
                        }
                        ellipse { at: 24, 30; radius: 15; color: #343740 }
                        text "󰔎" { at: 24, 30; anchor: center; size: 15; color: ink }
                        text "Focus" { at: 48, 30; anchor: left center; size: 12.5; weight: 600; color: ink }
                    }

                    // AirDrop / Hotspot Card
                    group {
                        size: 158, 61
                        body {
                            color: #24262d
                            glass: 80%
                            rim: 8%
                            box { from: 0, 0; size: 158, 61; corner: 16 }
                        }
                        ellipse { at: 24, 30; radius: 15; color: #343740 }
                        text "󰀝" { at: 24, 30; anchor: center; size: 15; color: ink }
                        text "AirDrop" { at: 48, 30; anchor: left center; size: 12.5; weight: 600; color: ink }
                    }
                }
            }

            // ── Sliders Section ───────────────────────────────────
            column {
                at: 16, 162
                gap: 12

                // Display Brightness Card
                group {
                    size: 328, 56
                    body {
                        color: #24262d
                        glass: 80%
                        rim: 8%
                        box { from: 0, 0; size: 328, 56; corner: 16 }
                    }
                    text "Display" { at: 14, 16; anchor: left center; size: 11; weight: 600; color: ink; opacity: 70% }
                    group {
                        move: 14, 27
                        size: 300, 19
                        box { from: 0, 0; size: 300, 19; corner: 9.5; color: #343740 }
                        box { from: 0, 0; size: 300 * max(display.level, 0.15), 19; corner: 9.5; color: #ffffff }
                        text "󰃠" { at: 13, 9.5; anchor: center; size: 12; color: #16181d }
                        zone box br_hit { from: 0, 0; size: 300, 19; cursor: pointer }
                    }
                }

                // Sound Volume Card (With Chevron to audio outputs)
                group {
                    size: 328, 56
                    body {
                        color: #24262d
                        glass: 80%
                        rim: 8%
                        box { from: 0, 0; size: 328, 56; corner: 16 }
                    }
                    text "Sound" { at: 14, 16; anchor: left center; size: 11; weight: 600; color: ink; opacity: 70% }
                    text "󰅂" { at: 310, 16; anchor: center; size: 14; color: ink; opacity: 40% }
                    zone box snd_chevron_hit { at: 310, 16; size: 24, 20; corner: 10; cursor: pointer }

                    group {
                        move: 14, 27
                        size: 300, 19
                        box { from: 0, 0; size: 300, 19; corner: 9.5; color: #343740 }
                        box { from: 0, 0; size: 300 * sound.volume, 19; corner: 9.5; color: #ffffff }
                        text "󰕾" { at: 13, 9.5; anchor: center; size: 12; color: #16181d }
                        zone box vol_hit { from: 0, 0; size: 300, 19; cursor: pointer }
                    }
                }
            }

            // ── Now Playing / Media Card ──────────────────────────
            group {
                move: 16, 302
                size: 328, 120
                body {
                    color: #24262d
                    glass: 80%
                    rim: 8%
                    box { from: 0, 0; size: 328, 120; corner: 16 }
                }

                box { from: 14, 14; size: 54, 54; corner: 8; color: #007aff; opacity: 25% }
                text "󰎆" { at: 41, 41; anchor: center; size: 24; color: #007aff }

                text song.title {
                    at: 80, 30
                    anchor: left center
                    size: 13.5
                    weight: 600
                    color: ink
                    width: 230
                    lines: 1
                }
                text song.artist {
                    at: 80, 50
                    anchor: left center
                    size: 11.5
                    color: ink
                    opacity: 60%
                    width: 230
                    lines: 1
                }

                row {
                    at: 164, 94
                    anchor: center
                    gap: 30
                    align: center

                    text "󰒮" { size: 16; color: ink; opacity: 70% }
                    group {
                        size: 28, 28
                        ellipse { at: 14, 14; radius: 14; color: ink; opacity: 15% }
                        text if(song.playing, "󰏤", "󰐊") { at: 14, 14; anchor: center; size: 14; color: ink }
                        zone box play_hit { from: 0, 0; size: 28, 28; cursor: pointer }
                    }
                    text "󰒭" { size: 16; color: ink; opacity: 70% }
                }
            }
        }

        // ==========================================================
        // PAGE 1: WI-FI NETWORK PICKER SUB-PAGE
        // ==========================================================
        group {
            show: page == 1

            // Header with Back button
            group {
                move: 16, 20
                size: 100, 32
                row {
                    gap: 8
                    align: center
                    text "󰅁" { size: 18; color: ink; opacity: 70% }
                    text "Wi-Fi" { size: 16; weight: 600; color: ink }
                }
                zone box wifi_back_hit { from: 0, 0; size: 100, 32; cursor: pointer }
            }

            // Available Networks List
            column {
                at: 16, 62
                gap: 6
                for n in nets {
                    group {
                        size: 328, 38
                        box { from: 0, 0; size: 328, 38; corner: 10; color: #24262d; opacity: if(n.active, 95%, 70%) }
                        text "󰤨" { at: 20, 19; anchor: center; size: 14; color: if(n.active, #007aff, ink) }
                        text n.ssid { at: 42, 19; anchor: left center; size: 13; weight: if(n.active, 600, 400); color: ink; width: 220; lines: 1 }
                        text if(n.secure, "󰌾", "") { at: 290, 19; anchor: center; size: 12; color: ink; opacity: 50% }
                        text if(n.active, "✓", "") { at: 312, 19; anchor: center; size: 14; color: #007aff }
                        zone box net_row_hit { from: 0, 0; size: 328, 38; cursor: pointer }
                        on press net_row_hit { emit pick_network(n.index) }
                    }
                }
            }
            text "Searching for networks…" {
                at: 180, 200
                anchor: center
                size: 13
                color: ink
                opacity: 50%
                show: nets.count < 1
            }
        }

        // ==========================================================
        // PAGE 2: BLUETOOTH DEVICES SUB-PAGE
        // ==========================================================
        group {
            show: page == 2

            // Header with Back button
            group {
                move: 16, 20
                size: 130, 32
                row {
                    gap: 8
                    align: center
                    text "󰅁" { size: 18; color: ink; opacity: 70% }
                    text "Bluetooth" { size: 16; weight: 600; color: ink }
                }
                zone box bt_back_hit { from: 0, 0; size: 130, 32; cursor: pointer }
            }

            // Available Devices List
            column {
                at: 16, 62
                gap: 6
                for g in gadgets {
                    group {
                        size: 328, 42
                        box { from: 0, 0; size: 328, 42; corner: 10; color: #24262d; opacity: if(g.connected, 95%, 70%) }
                        text "󰂯" { at: 20, 21; anchor: center; size: 15; color: if(g.connected, #007aff, ink) }
                        text g.name { at: 42, 16; anchor: left center; size: 13; weight: if(g.connected, 600, 400); color: ink; width: 220; lines: 1 }
                        text if(g.connected, "Connected", "Not Connected") { at: 42, 29; anchor: left center; size: 10.5; color: if(g.connected, mint, ink); opacity: 70% }
                        text if(g.battery >= 0, "{g.battery}%", "") { at: 300, 21; anchor: right center; size: 11; color: ink; opacity: 60% }
                        zone box bt_row_hit { from: 0, 0; size: 328, 42; cursor: pointer }
                        on press bt_row_hit { emit pick_device(g.index) }
                    }
                }
            }
            text "No devices found" {
                at: 180, 200
                anchor: center
                size: 13
                color: ink
                opacity: 50%
                show: gadgets.count < 1
            }
        }

        // ==========================================================
        // PAGE 3: SOUND OUTPUT SELECTOR SUB-PAGE
        // ==========================================================
        group {
            show: page == 3

            // Header with Back button
            group {
                move: 16, 20
                size: 150, 32
                row {
                    gap: 8
                    align: center
                    text "󰅁" { size: 18; color: ink; opacity: 70% }
                    text "Sound Output" { size: 16; weight: 600; color: ink }
                }
                zone box snd_back_hit { from: 0, 0; size: 150, 32; cursor: pointer }
            }

            // Audio Sinks List
            column {
                at: 16, 62
                gap: 6
                for o in outs {
                    group {
                        size: 328, 38
                        box { from: 0, 0; size: 328, 38; corner: 10; color: #24262d; opacity: if(o.default, 95%, 70%) }
                        text "󰕾" { at: 20, 19; anchor: center; size: 14; color: if(o.default, #007aff, ink) }
                        text o.name { at: 42, 19; anchor: left center; size: 12.5; weight: if(o.default, 600, 400); color: ink; width: 250; lines: 1 }
                        text if(o.default, "✓", "") { at: 310, 19; anchor: center; size: 14; color: #007aff }
                        zone box out_row_hit { from: 0, 0; size: 328, 38; cursor: pointer }
                        on press out_row_hit { emit pick_output(o.id) }
                    }
                }
            }
        }
    }

    // ── Sliders & Media Actions ───────────────────────────────────
    on press br_hit   { emit brightness_set(clamp(local.x / 300, 0.1, 1)) }
    on drag br_hit    { emit brightness_set(clamp(local.x / 300, 0.1, 1)) }
    on press vol_hit  { emit volume_set(clamp(local.x / 300, 0, 1)) }
    on drag vol_hit   { emit volume_set(clamp(local.x / 300, 0, 1)) }
    on press play_hit { emit play_pause }

    // ── Navigation Transitions ────────────────────────────────────
    on press wifi_chevron_hit { page = 1 }
    on press wifi_back_hit    { page = 0 }
    on press wifi_icon_hit    { emit toggle_wifi }

    on press bt_chevron_hit   { page = 2 }
    on press bt_back_hit      { page = 0 }
    on press bt_icon_hit      { emit toggle_bt }

    on press snd_chevron_hit  { page = 3 }
    on press snd_back_hit     { page = 0 }

    // ── Window Lifecycle ──────────────────────────────────────────
    on toggle     { toggle open; page = 0 }
    on key Escape { open = false; page = 0 }
    on blur       { open = false; page = 0 }
}
