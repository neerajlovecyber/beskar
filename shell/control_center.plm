// macOS Control Center for Wayland Compositors
import "common/palette.plm"

scene MacControlCenter {
    let mp_sw = 440
    let mp_sh = 520
    include "common/theme.plm"
    include "common/morph.plm"
    surface {
        size: 440, 520
        anchor: top_right
        margin: 0, 0, 0, 0
        level: overlay
        screens: each
        keyboard: exclusive while asking
    }

    permissions {
        services: "audio", "audio.*", "brightness", "brightness.*", "media", "media.*", "network", "network.*", "bluetooth", "bluetooth.*", "say:topbar", "say:dock", "say:settings", "say:clipboard", "say:music", "say:capture", "say:lock", "say:spotlight", "say:notifications", "say:dashboard", "say:wallpapers", "say:widget_bar"
    }

    // ── Built-in System Models ────────────────────────────────────
    model nets max 8 { ssid: text; strength: number; secure: bool; known: bool; active: bool }
    //  One row per Bluetooth device, painted by control_center.luau. kind: 0 any · 1 headphones · 2 mouse ·
    //  3 keyboard · 4 phone · 5 computer · 6 gamepad · 7 speaker. state: 0 paired · 1 connected · 2 working · 3 new.
    model bt_rows max 8 { name: text; status: text; kind: number; state: number; battery: number = -1 }
    model outs max 6 { id: number; name: text; default: bool }
    //  Painted by control_center.luau. Wi-Fi rows: signal 0..1.  App volumes: one row per stream playing.
    model wifi_rows max 6 { name: text; signal: number; secure: bool; known: bool; active: bool; joining: bool }
    model app_rows max 4 { name: text; volume: number; muted: bool }

    // ── System Services & Lists ───────────────────────────────────
    service audio as sound { volume: number; muted: bool; outputs: outs }
    service brightness as display { present: bool; level: number }
    service network as net { online: bool; name: text; networks: nets }

    // ── Navigation & Theme Facts ──────────────────────────────────
    // Navigation: 0 = Main, 1 = Wi-Fi, 2 = Bluetooth, 3 = Sound
    fact page = 0
    fact dnd = false
    prop dm_k = 0 ~quick
    follow dm_k = if(dark_mode, 1, 0)

    //  Wi-Fi, from control_center.luau. state: 0 off · 1 not connected · 2 connected · 3 cable · 4 joining
    fact wifi_state = 1
    fact wifi_signal = 0
    fact asking = false          // the password sheet is open
    text wifi_title = ""
    text wifi_status = ""
    text ask_name = ""
    text ask_error = ""
    text wifi_pw = ""

    //  Reported by control_center.luau: Bluetooth, and what is playing
    fact bt_on = false
    fact bt_present = true
    fact bt_scanning = false
    text bt_sub = "Off"
    fact has_player = false
    fact is_playing = false
    fact has_art = false
    fact track_len = 0
    fact track_pos = 0
    text track_title = ""
    text track_artist = ""
    text cover_art = ""
    text time_pos = "0:00"
    text time_len = "0:00"
    image cover = from cover_art, 52, 52


    event toggle
    event toggle_dark ->
    event set_dark_mode ->
    event choose_skin ->

    event volume_set ->
    event brightness_set ->
    event play_pause ->
    event pick_network ->
    event wifi_power ->
    event wifi_disconnect ->
    event wifi_rescan ->
    event wifi_join ->
    event wifi_cancel ->
    event app_volume ->
    event bt_action ->
    event bt_power ->
    event bt_scan ->
    event open_settings ->
    event toggle_dnd ->
    event open_sound
    event open_nothing
    event sc_search ->
    event sc_clip ->
    event sc_shot ->
    event sc_lock ->
    event previous ->
    event next ->
    event seek ->
    event pick_output ->
    event toggle_wifi ->
    event toggle_bt ->

    //  Closing the password sheet hands the keyboard back, which is a `blur`: this stays above zero
    //  for a moment after it so that blur does not close the whole panel.
    prop askhold = 0 ~calm
    follow askhold = if(asking, 1, 0)
    //  The card is shorter on the overview than on the pickers, and grows when one opens.

    //  A small button with a word.
    component Pill(label: text, press: event, w: number = 96, strong: bool = false, warn: bool = false, onfill: bool = false) {
        size: w, 28
        prop glow = 0 ~quick
        box { from: 0, 0; size: w, 28; corner: 9; color: if(onfill, #ffffff, if(strong, accent_c, if(warn, danger_c, item_bg))); opacity: if(onfill, 24%, if(strong, 100%, if(warn, 20%, item_bg_op))) + glow * 12% }
        text label { at: w / 2, 14; anchor: center; size: 11; weight: 600; color: if(onfill or strong, #ffffff, if(warn, danger_c, ink_c)) }
        zone box hit { from: 0, 0; size: w, 28; corner: 9; cursor: pointer }
        on enter hit { glow: 1 }
        on leave hit { glow: 0 }
        on press hit { emit press }
    }

    //  Four arcs that fill with the strength, 0..1
    component Bars(level: number, tone: color = ink_c) {
        size: 28, 24
        repeat a in 1..5 {
            arc { at: 14, 20; radius: 2 + a * 3.6; span: 110deg; width: 1.8; color: tone; opacity: 20% + 80% * if(level > (a - 1) * 0.25, 1, 0) }
        }
        ellipse { at: 14, 21; radius: 1.8; color: tone }
    }

    //  One slider card: the same for Display and Sound, only the icon (kind 0 sun, 1 speaker) and
    //  what it controls differ. The fill never gets narrower than the icon.
    component LevelSlider(title: text, level: number, pct: text, kind: number, set: event, more: event) {
        size: 328, 54
        box { from: 0, 0; size: 328, 54; corner: 16; color: card_fill; opacity: card_fill_op }
        box { from: 0, 0; size: 328, 54; corner: 16; stroke: 1; color: card_stroke; opacity: card_stroke_op }
        text title { at: 14, 14; anchor: left center; size: 11; weight: 600; color: ink_sub }
        text pct { at: 314, 14; anchor: right center; size: 10.5; color: ink_sub }
        zone box more_hit { from: 230, 2; size: 96, 24; corner: 10; cursor: pointer; active: kind == 1 }
        group {
            move: 14, 25
            size: 300, 20
            box { from: 0, 0; size: 300, 20; corner: 10; color: slider_bg; opacity: slider_bg_op }
            box { from: 0, 0; size: max(22, 300 * clamp(level, 0, 1)), 20; corner: 10; color: slider_bar; opacity: slider_bar_op }
            //  sun
            group {
                show: kind == 0
                ellipse { at: 12, 10; radius: 3.4; color: slider_icon }
                repeat k in 0..8 { line { from: 12 + 5.6 * cos(k * 45), 10 + 5.6 * sin(k * 45); to: 12 + 7.6 * cos(k * 45), 10 + 7.6 * sin(k * 45); width: 1.4; color: slider_icon } }
            }
            //  speaker
            group {
                show: kind == 1
                path { at: 5, 4; color: slider_icon; move 0, 4; line 4, 4; line 9, 0; line 9, 12; line 4, 8; line 0, 8; close }
                arc { at: 15.5, 10; radius: 4.2; span: 110deg; rotate: -55deg; width: 1.6; color: slider_icon }
            }
            zone box hit { from: 0, 0; size: 300, 20; cursor: pointer }
            on press hit { emit set(clamp(local.x / 300, 0.02, 1)) }
            on drag hit { emit set(clamp(local.x / 300, 0.02, 1)) }
        }
        on press more_hit { emit more }
    }


    // Dismiss click zone for outside
    on press dismiss { open = false; page = 0 }

    //  The glass behind this is drawn by the frame (topbar.plm), so it can melt out of the right island:
    //  this scene only draws the content, placed where the card is.
    group {
        show: mp_here
        move: 74, -2
        opacity: mp_fade
        clip box { from: -60, -20; size: mp_sw + 120, mp_rh + 20 }

        // ==========================================================
        // PAGE 0: MAIN CONTROL CENTER OVERVIEW
        // ==========================================================
        group {
            show: page == 0

            // ── Wi-Fi: a wide pill. The disc toggles the radio, the rest opens the page ──
            group {
                move: 16, 16
                size: 158, 60
                box { from: 0, 0; size: 158, 60; corner: 30; color: card_fill; opacity: card_fill_op }
                box { from: 0, 0; size: 158, 60; corner: 30; color: accent_c; opacity: if(net.online, 100%, 0%) }
                box { from: 0, 0; size: 158, 60; corner: 30; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                ellipse { at: 30, 30; radius: 20; color: if(net.online, #ffffff, item_solid) }
                repeat a in 1..4 {
                    arc { at: 30, 37; radius: a * 4.8; span: 100deg; width: 2.2; color: if(net.online, accent_c, ink_c) }
                }
                ellipse { at: 30, 37.5; radius: 1.9; color: if(net.online, accent_c, ink_c) }
                text "Wi-Fi" { at: 58, 22; anchor: left center; size: 12; weight: 600; color: if(net.online, #ffffff, ink_c) }
                text if(net.online, net.name, "Off") { at: 58, 38; anchor: left center; size: 10; color: if(net.online, #ffffff, ink_sub); opacity: if(net.online, 80%, 100%); width: 80; lines: 1 }
                zone box wifi_chevron_hit { from: 52, 0; size: 106, 60; corner: 30; cursor: pointer }
                zone box wifi_icon_hit { at: 30, 30; size: 40, 40; corner: 20; cursor: pointer }
            }

            // ── Bluetooth ──
            group {
                move: 16, 88
                size: 158, 60
                box { from: 0, 0; size: 158, 60; corner: 30; color: card_fill; opacity: card_fill_op }
                box { from: 0, 0; size: 158, 60; corner: 30; color: accent_c; opacity: if(bt_on, 100%, 0%) }
                box { from: 0, 0; size: 158, 60; corner: 30; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                ellipse { at: 30, 30; radius: 20; color: if(bt_on, #ffffff, item_solid) }
                path { at: 25.5, 20; color: if(bt_on, accent_c, ink_c); stroke: 2; move 0, 6; line 9, 15; line 4.5, 20; line 4.5, 0; line 9, 5; line 0, 14 }
                text "Bluetooth" { at: 58, 22; anchor: left center; size: 12; weight: 600; color: if(bt_on, #ffffff, ink_c) }
                text bt_sub { at: 58, 38; anchor: left center; size: 10; color: if(bt_on, #ffffff, ink_sub); opacity: if(bt_on, 80%, 100%); width: 80; lines: 1 }
                zone box bt_chevron_hit { from: 52, 0; size: 106, 60; corner: 30; cursor: pointer }
                zone box bt_icon_hit { at: 30, 30; size: 40, 40; corner: 20; cursor: pointer }
            }

            // ── Now Playing: a tile on the right, as tall as the two pills ──
            group {
                move: 186, 16
                size: 158, 132
                box { from: 0, 0; size: 158, 132; corner: 26; color: card_fill; opacity: card_fill_op }
                box { from: 0, 0; size: 158, 132; corner: 26; stroke: 1; color: card_stroke; opacity: card_stroke_op }

                group {
                    show: not has_player
                    ellipse { at: 79, 48; radius: 22; color: item_solid }
                    path { at: 71, 37; color: ink_sub; move 0, 0; line 17, 11; line 0, 22; close }
                    text "Not Playing" { at: 79, 96; anchor: center; size: 12; weight: 600; color: ink_sub }
                }

                group {
                    show: has_player
                    body {
                        gradient: 0, 0 to 46, 46, #e8a048, #7f52ff
                        box { from: 14, 14; size: 46, 46; corner: 11 }
                    }
                    image cover { at: 14, 14; size: 46, 46; show: has_art }
                    text track_title { at: 14, 74; anchor: left center; size: 12; weight: 600; color: ink_c; width: 132; lines: 1 }
                    text track_artist { at: 14, 90; anchor: left center; size: 10.5; color: ink_sub; width: 132; lines: 1 }

                    //  progress
                    box { from: 14, 102; size: 130, 3; corner: 1.5; color: slider_bg; opacity: slider_bg_op }
                    box { from: 14, 102; size: max(3, 130 * clamp(track_pos / max(track_len, 1), 0, 1)), 3; corner: 1.5; color: slider_bar; opacity: slider_bar_op; show: track_len > 0 }
                    zone box seek_hit { from: 14, 96; size: 130, 14; cursor: pointer; active: track_len > 0 }

                    //  previous · play/pause · next
                    path { at: 38, 112; color: ink_c; move 9, 0; line 9, 11; line 0, 5.5; close }
                    box { from: 36, 112; size: 2, 11; corner: 1; color: ink_c }
                    group {
                        show: is_playing
                        box { from: 74, 111; size: 3, 13; corner: 1.5; color: ink_c }
                        box { from: 81, 111; size: 3, 13; corner: 1.5; color: ink_c }
                    }
                    path { at: 74, 111; color: ink_c; show: not is_playing; move 0, 0; line 11, 6.5; line 0, 13; close }
                    path { at: 112, 112; color: ink_c; move 0, 0; line 9, 5.5; line 0, 11; close }
                    box { from: 122, 112; size: 2, 11; corner: 1; color: ink_c }
                    zone box prev_hit { at: 43, 117.5; size: 26, 22; corner: 11; cursor: pointer }
                    zone box play_hit { at: 79, 117.5; size: 30, 22; corner: 11; cursor: pointer }
                    zone box next_hit { at: 117, 117.5; size: 26, 22; corner: 11; cursor: pointer }
                }
            }

            // ── Do Not Disturb: a wide pill with a moon ──
            group {
                move: 16, 160
                size: 158, 60
                box { from: 0, 0; size: 158, 60; corner: 30; color: card_fill; opacity: card_fill_op }
                box { from: 0, 0; size: 158, 60; corner: 30; color: focus_c; opacity: if(dnd, 100%, 0%) }
                box { from: 0, 0; size: 158, 60; corner: 30; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                ellipse { at: 30, 30; radius: 20; color: if(dnd, #ffffff, item_solid) }
                //  the moon: a disc with a bite out of it, the bite in the disc's own colour
                ellipse { at: 29, 31; radius: 9; color: if(dnd, focus_c, ink_c) }
                ellipse { at: 34, 27; radius: 8; color: if(dnd, #ffffff, item_solid) }
                text "Do Not" { at: 58, 24; anchor: left center; size: 12; weight: 600; color: if(dnd, #ffffff, ink_c) }
                text "Disturb" { at: 58, 38; anchor: left center; size: 12; weight: 600; color: if(dnd, #ffffff, ink_c) }
                zone box dnd_hit { from: 0, 0; size: 158, 60; corner: 30; cursor: pointer }
            }

            // ── Dark Mode: a square that is a sun or a moon ──
            group {
                move: 186, 160
                size: 73, 60
                box { from: 0, 0; size: 73, 60; corner: 22; color: card_fill; opacity: card_fill_op }
                box { from: 0, 0; size: 73, 60; corner: 22; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                ellipse { at: 36.5, 30; radius: 19; color: if(dark_mode, focus_c, warn_c) }
                group {
                    show: dark_mode
                    ellipse { at: 35.5, 31; radius: 9; color: #ffffff }
                    ellipse { at: 40, 27; radius: 8; color: focus_c }
                }
                group {
                    show: not dark_mode
                    ellipse { at: 36.5, 30; radius: 5.5; color: #ffffff }
                    repeat k in 0..8 { line { from: 36.5 + 9 * cos(k * 45), 30 + 9 * sin(k * 45); to: 36.5 + 12 * cos(k * 45), 30 + 12 * sin(k * 45); width: 2; color: #ffffff } }
                }
                zone box dm_tile_hit { from: 0, 0; size: 73, 60; corner: 22; cursor: pointer }
            }

            // ── Settings: a square with three sliders ──
            group {
                move: 271, 160
                size: 73, 60
                box { from: 0, 0; size: 73, 60; corner: 22; color: card_fill; opacity: card_fill_op }
                box { from: 0, 0; size: 73, 60; corner: 22; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                ellipse { at: 36.5, 30; radius: 19; color: item_solid }
                line { from: 26, 23; to: 47, 23; width: 1.8; color: ink_c }
                line { from: 26, 30; to: 47, 30; width: 1.8; color: ink_c }
                line { from: 26, 37; to: 47, 37; width: 1.8; color: ink_c }
                ellipse { at: 32, 23; radius: 3; color: ink_c }
                ellipse { at: 42, 30; radius: 3; color: ink_c }
                ellipse { at: 35, 37; radius: 3; color: ink_c }
                zone box settings_tile_hit { from: 0, 0; size: 73, 60; corner: 22; cursor: pointer }
            }

            // Sliders Section
            column {
                at: 16, 232
                gap: 10
                LevelSlider("Display", display.level, "{display.level * 100, 0}%", 0, brightness_set, open_nothing)
                LevelSlider("Sound", sound.volume, "{sound.volume * 100, 0}% ›", 1, volume_set, open_sound)
            }

            // ── four round shortcuts ──
            group {
                move: 16, 362
                //  Search
                ellipse { at: 28, 28; radius: 28; color: card_fill; opacity: card_fill_op }
                ellipse { at: 28, 28; radius: 28; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                ellipse { at: 26, 26; radius: 8; stroke: 2.2; color: ink_c }
                line { from: 32, 32; to: 38, 38; width: 2.4; color: ink_c }
                zone box sc_search_hit { at: 28, 28; size: 56, 56; corner: 28; cursor: pointer }

                //  Clipboard
                ellipse { at: 118.7, 28; radius: 28; color: card_fill; opacity: card_fill_op }
                ellipse { at: 118.7, 28; radius: 28; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                box { from: 108.7, 18; size: 20, 24; corner: 4; stroke: 2.2; color: ink_c }
                box { from: 113.7, 15; size: 10, 6; corner: 2; color: ink_c }
                zone box sc_clip_hit { at: 118.7, 28; size: 56, 56; corner: 28; cursor: pointer }

                //  Screenshot: a viewfinder
                ellipse { at: 209.3, 28; radius: 28; color: card_fill; opacity: card_fill_op }
                ellipse { at: 209.3, 28; radius: 28; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                path { at: 198.3, 17; color: ink_c; stroke: 2.2; move 0, 6; line 0, 0; line 6, 0 }
                path { at: 214.3, 17; color: ink_c; stroke: 2.2; move 0, 0; line 6, 0; line 6, 6 }
                path { at: 198.3, 33; color: ink_c; stroke: 2.2; move 0, 0; line 0, 6; line 6, 6 }
                path { at: 214.3, 33; color: ink_c; stroke: 2.2; move 6, 0; line 6, 6; line 0, 6 }
                ellipse { at: 209.3, 28; radius: 3; color: ink_c }
                zone box sc_shot_hit { at: 209.3, 28; size: 56, 56; corner: 28; cursor: pointer }

                //  Lock
                ellipse { at: 300, 28; radius: 28; color: card_fill; opacity: card_fill_op }
                ellipse { at: 300, 28; radius: 28; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                box { from: 290, 27; size: 20, 15; corner: 4; color: ink_c }
                arc { at: 300, 27; radius: 6; span: 180deg; width: 2.2; color: ink_c }
                zone box sc_lock_hit { at: 300, 28; size: 56, 56; corner: 28; cursor: pointer }
            }
        }

        // ==========================================================
        // PAGE 1: WI-FI
        // ==========================================================
        group {
            show: page == 1

            group {
                move: 16, 20
                size: 100, 32
                row {
                    gap: 8
                    align: center
                    text "󰅁" { size: 18; color: ink_c; opacity: 70% }
                    text "Wi-Fi" { size: 16; weight: 600; color: ink_c }
                }
                zone box wifi_back_hit { from: 0, 0; size: 100, 32; cursor: pointer }
            }
            //  Radio switch
            box { from: 306, 25; size: 38, 22; corner: 11; color: if(wifi_state != 0, ok_c, item_bg); opacity: if(wifi_state != 0, 100%, item_bg_op) }
            ellipse { at: if(wifi_state != 0, 335, 316), 36; radius: 9; color: #ffffff }
            zone box wifi_switch_hit { from: 306, 25; size: 38, 22; corner: 11; cursor: pointer }

            // ── the connection in use, or why there is none ──
            group {
                show: not asking
                move: 16, 62
                box { from: 0, 0; size: 328, 64; corner: 14; color: card_fill; opacity: card_fill_op }
                box { from: 0, 0; size: 328, 64; corner: 14; color: accent_c; opacity: if(wifi_state == 2 or wifi_state == 3, 100%, 0%) }
                box { from: 0, 0; size: 328, 64; corner: 14; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                group {
                    move: 12, 20
                    opacity: if(wifi_state == 0, 35%, 100%)
                    Bars(if(wifi_state >= 2, wifi_signal, 0), if(wifi_state >= 2, #ffffff, ink_c))
                }
                text wifi_title { at: 52, 24; anchor: left center; size: 13.5; weight: 600; color: if(wifi_state == 2 or wifi_state == 3, #ffffff, ink_c); width: 150; lines: 1 }
                text wifi_status { at: 52, 42; anchor: left center; size: 10.5; color: if(wifi_state == 2 or wifi_state == 3, #ffffff, ink_sub); opacity: if(wifi_state == 2 or wifi_state == 3, 80%, 100%); width: 150; lines: 1 }
                row {
                    at: 316, 32
                    anchor: right middle
                    show: wifi_state == 2
                    Pill("Disconnect", wifi_disconnect, 92, false, false, true)
                }
                row {
                    at: 316, 32
                    anchor: right middle
                    show: wifi_state == 0
                    Pill("Turn On", wifi_power, 84, true)
                }
                row {
                    at: 316, 32
                    anchor: right middle
                    show: wifi_state == 4
                    Pill("Cancel", wifi_disconnect, 76)
                }
            }

            // ── networks in range ──
            group {
                show: wifi_state != 0 and not asking
                text "NEARBY" { at: 20, 144; anchor: left center; size: 9.5; weight: 700; color: ink_sub }
                text "Look again" { at: 344, 144; anchor: right center; size: 10.5; color: ink_sub }
                zone box wifi_rescan_hit { from: 270, 134; size: 74, 20; corner: 10; cursor: pointer }
                column {
                    at: 16, 158
                    gap: 4
                    for n in wifi_rows {
                        group {
                            size: 328, 36
                            box { from: 0, 0; size: 328, 36; corner: 10; color: card_fill; opacity: card_fill_op }
                            box { from: 0, 0; size: 328, 36; corner: 10; color: accent_c; opacity: if(n.active, 100%, 0%) }
                            box { from: 0, 0; size: 328, 36; corner: 10; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                            group {
                                move: 10, 6
                                Bars(n.signal, if(n.active, #ffffff, ink_c))
                            }
                            text n.name { at: 46, 18; anchor: left center; size: 12.5; weight: if(n.active, 600, 400); color: if(n.active, #ffffff, ink_c); width: 190; lines: 1 }
                            text "Joining…" { at: 300, 18; anchor: right center; size: 10.5; color: ink_sub; show: n.joining }
                            text "Connected" { at: 300, 18; anchor: right center; size: 10.5; color: #ffffff; opacity: 85%; show: n.active and not n.joining }
                            text "Saved" { at: 300, 18; anchor: right center; size: 10.5; color: ink_sub; show: n.known and not n.active and not n.joining }
                            group {
                                show: n.secure and not n.known and not n.active
                                box { from: 310, 20; size: 9, 7; corner: 2; color: ink_sub }
                                arc { at: 314.5, 20; radius: 3; span: 180deg; width: 1.4; color: ink_sub }
                            }
                            zone box wifi_row_hit { from: 0, 0; size: 328, 36; corner: 10; cursor: pointer }
                            on press wifi_row_hit { emit pick_network(n.index) }
                        }
                    }
                }
                text "Looking for networks…" { at: 180, 230; anchor: center; size: 12; color: ink_sub; show: wifi_rows.count < 1 }
            }
            text "Turn Wi-Fi on to see the networks around you." { at: 180, 200; anchor: center; size: 12; color: ink_sub; show: wifi_state == 0 and not asking }

            // ── its password, asked for in the list's place ──
            group {
                show: asking
                move: 16, 62
                box { from: 0, 0; size: 328, 150; corner: 14; color: card_fill; opacity: card_fill_op }
                box { from: 0, 0; size: 328, 150; corner: 14; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                text "Join" { at: 164, 24; anchor: center; size: 10.5; color: ink_sub }
                text ask_name { at: 164, 44; anchor: center; size: 15; weight: 600; color: ink_c; width: 290; lines: 1; tight: true }
                box { from: 18, 66; size: 292, 34; corner: 9; color: slider_bg; opacity: slider_bg_op }
                input wifi_pw {
                    at: 30, 74
                    width: 270
                    size: 13
                    color: ink_c
                    secret: true
                    placeholder: "Password"
                    selection: accent_c
                }
                text ask_error { at: 164, 114; anchor: center; size: 10.5; color: danger_c }
                row {
                    at: 164, 132
                    anchor: center middle
                    gap: 10
                    Pill("Cancel", wifi_cancel, 90)
                    Pill("Join", wifi_join, 90, true)
                }
            }
        }

        // ==========================================================
        // PAGE 2: BLUETOOTH DEVICES SUB-PAGE
        // ==========================================================
        group {
            show: page == 2

            group {
                move: 16, 20
                size: 130, 32
                row {
                    gap: 8
                    align: center
                    text "󰅁" { size: 18; color: ink_c; opacity: 70% }
                    text "Bluetooth" { size: 16; weight: 600; color: ink_c }
                }
                zone box bt_back_hit { from: 0, 0; size: 130, 32; cursor: pointer }
            }

            //  Power switch, and the search button beside it
            box { from: 306, 25; size: 38, 22; corner: 11; color: if(bt_on, ok_c, item_bg); opacity: if(bt_on, 100%, item_bg_op) }
            ellipse { at: if(bt_on, 335, 316), 36; radius: 9; color: #ffffff }
            zone box bt_power_hit { from: 306, 25; size: 38, 22; corner: 11; cursor: pointer; active: bt_present }
            text if(bt_scanning, "Searching…", "Search") { at: 292, 36; anchor: right center; size: 11.5; weight: 500; color: if(bt_scanning, accent_c, ink_sub); show: bt_on }
            zone box bt_scan_hit { from: 200, 24; size: 94, 24; corner: 12; cursor: pointer; active: bt_on }

            column {
                at: 16, 62
                gap: 6
                for g in bt_rows {
                    group {
                        size: 328, 46
                        box { from: 0, 0; size: 328, 46; corner: 12; color: card_fill; opacity: card_fill_op }
                        box { from: 0, 0; size: 328, 46; corner: 12; color: accent_c; opacity: if(g.state == 1, 100%, 0%) }
                        box { from: 0, 0; size: 328, 46; corner: 12; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                        ellipse { at: 24, 23; radius: 15; color: if(g.state == 1, #ffffff, item_bg); opacity: if(g.state == 1, 100%, item_bg_op) }
                        text pick(g.kind, "󰂯", "󰋋", "󰍽", "󰌌", "󰏲", "󰟀", "󰊴", "󰓃") { at: 24, 23; anchor: center; size: 14; color: if(g.state == 1, accent_c, ink_c) }
                        text g.name { at: 48, 17; anchor: left center; size: 13; weight: if(g.state == 1, 600, 500); color: if(g.state == 1, #ffffff, ink_c); width: 150; lines: 1 }
                        text g.status { at: 48, 32; anchor: left center; size: 10.5; color: if(g.state == 1, #ffffff, ink_sub); opacity: if(g.state == 1, 85%, 100%); width: 150; lines: 1 }
                        text if(g.battery >= 0, "{g.battery * 100, 0}%", "") { at: 208, 23; anchor: right center; size: 10.5; color: if(g.state == 1, #ffffff, ink_sub) }
                        box { from: 246, 9; size: 72, 28; corner: 9; color: if(g.state == 0 or g.state == 3, accent_c, if(g.state == 1, #ffffff, item_bg)); opacity: if(g.state == 0 or g.state == 3, 100%, if(g.state == 1, 24%, item_bg_op)) }
                        text pick(g.state, "Connect", "Disconnect", "…", "Pair") { at: 282, 23; anchor: center; size: 10.5; weight: 600; color: if(g.state == 0 or g.state == 3 or g.state == 1, #ffffff, ink_c) }
                        zone box bt_row_hit { from: 246, 9; size: 72, 28; corner: 9; cursor: pointer }
                        on press bt_row_hit { emit bt_action(g.index) }
                    }
                }
            }
            group {
                show: bt_rows.count < 1
                text "Looking around…" { at: 180, 200; anchor: center; size: 12; color: ink_sub; show: bt_on and bt_scanning }
                text "No paired devices. Press Search." { at: 180, 200; anchor: center; size: 12; color: ink_sub; show: bt_on and not bt_scanning }
                text "Bluetooth is off. Use the switch to turn it on." { at: 180, 200; anchor: center; size: 12; color: ink_sub; show: bt_present and not bt_on }
                text "No Bluetooth adapter found" { at: 180, 200; anchor: center; size: 12; color: ink_sub; show: not bt_present }
            }
        }

        // ==========================================================
        // PAGE 3: SOUND  (output, then each app's own volume)
        // ==========================================================
        group {
            show: page == 3

            group {
                move: 16, 20
                size: 150, 32
                row {
                    gap: 8
                    align: center
                    text "󰅁" { size: 18; color: ink_c; opacity: 70% }
                    text "Sound" { size: 16; weight: 600; color: ink_c }
                }
                zone box snd_back_hit { from: 0, 0; size: 150, 32; cursor: pointer }
            }

            text "OUTPUT" { at: 20, 62; anchor: left center; size: 9.5; weight: 700; color: ink_sub }
            column outs_list {
                at: 16, 74
                gap: 4
                for o in outs {
                    group {
                        size: 328, 36
                        box { from: 0, 0; size: 328, 36; corner: 10; color: card_fill; opacity: card_fill_op }
                        box { from: 0, 0; size: 328, 36; corner: 10; color: accent_c; opacity: if(o.default, 100%, 0%) }
                        box { from: 0, 0; size: 328, 36; corner: 10; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                        ellipse { at: 22, 18; radius: 12; color: if(o.default, #ffffff, item_bg); opacity: if(o.default, 100%, item_bg_op) }
                        path { at: 16.5, 12.5; color: if(o.default, accent_c, ink_c); move 0, 3.5; line 3, 3.5; line 7, 0; line 7, 11; line 3, 7.5; line 0, 7.5; close }
                        text o.name { at: 44, 18; anchor: left center; size: 12.5; weight: if(o.default, 600, 400); color: if(o.default, #ffffff, ink_c); width: 250; lines: 1 }
                        text if(o.default, "✓", "") { at: 310, 18; anchor: center; size: 14; color: #ffffff }
                        zone box out_row_hit { from: 0, 0; size: 328, 36; corner: 10; cursor: pointer }
                        on press out_row_hit { emit pick_output(o.id) }
                    }
                }
            }

            //  Below the outputs: what is making sound, each with its own slider.
            group {
                move: 0, 74 + outs_list.height + 12
                text "APPS" { at: 20, 0; anchor: left center; size: 9.5; weight: 700; color: ink_sub; show: app_rows.count > 0 }
                column {
                    at: 16, 12
                    gap: 6
                    for a in app_rows {
                        group {
                            size: 328, 50
                            box { from: 0, 0; size: 328, 50; corner: 12; color: card_fill; opacity: card_fill_op }
                            box { from: 0, 0; size: 328, 50; corner: 12; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                            text a.name { at: 14, 14; anchor: left center; size: 11.5; weight: 600; color: ink_c; width: 220; lines: 1 }
                            text "{a.volume * 100, 0}%" { at: 314, 14; anchor: right center; size: 10.5; color: ink_sub }
                            group {
                                move: 14, 28
                                box { from: 0, 0; size: 300, 14; corner: 7; color: slider_bg; opacity: slider_bg_op }
                                box { from: 0, 0; size: max(14, 300 * a.volume), 14; corner: 7; color: slider_bar; opacity: if(a.muted, 35%, slider_bar_op) }
                                zone box app_vol_hit { from: 0, 0; size: 300, 14; cursor: pointer }
                                on press app_vol_hit { emit app_volume(a.index + clamp(local.x / 300, 0, 0.999)) }
                                on drag app_vol_hit { emit app_volume(a.index + clamp(local.x / 300, 0, 0.999)) }
                            }
                        }
                    }
                }
                text "Nothing is playing right now" { at: 180, 40; anchor: center; size: 11.5; color: ink_sub; show: app_rows.count < 1 }
            }
        }
    }

    // Sliders & Media Actions
    on press play_hit { emit play_pause }
    on open_sound { page = 3 }
    on press prev_hit { emit previous }
    on press next_hit { emit next }
    on press seek_hit { emit seek(clamp(local.x / 130, 0, 1)) }
    on press dnd_hit { emit toggle_dnd }
    on press sc_search_hit { emit sc_search; open = false; page = 0 }
    on press sc_clip_hit   { emit sc_clip; open = false; page = 0 }
    on press sc_shot_hit   { emit sc_shot; open = false; page = 0 }
    on press sc_lock_hit   { emit sc_lock; open = false; page = 0 }
    on press settings_tile_hit { emit open_settings; open = false; page = 0 }
    on press bt_power_hit { emit bt_power }
    on press bt_scan_hit  { emit bt_scan }

    // Navigation Transitions
    on press wifi_chevron_hit { page = 1 }
    on press wifi_back_hit    { page = 0 }
    on press wifi_icon_hit    { emit toggle_wifi }
    on press wifi_switch_hit  { emit toggle_wifi }
    on press wifi_rescan_hit  { emit wifi_rescan }
    on submit wifi_pw         { emit wifi_join }
    on change asking          { focus wifi_pw }

    on press bt_chevron_hit   { page = 2 }
    on press bt_back_hit      { page = 0 }
    on press bt_icon_hit      { emit toggle_bt }

    on press snd_back_hit     { page = 0 }

    // Theme Actions
    on press dm_tile_hit   { emit toggle_dark }

    // Window Lifecycle
    on toggle     { toggle open; page = 0 }
    on key Escape { open = false; page = 0 }
    on blur while askhold < 0.2 { open = false; page = 0 }
}
