// macOS Control Center for Wayland Compositors
import "common/palette.plm"

scene MacControlCenter {
    surface {
        size: 440, 520
        anchor: top_right
        margin: 0, 4, 0, 0
        level: overlay
        keyboard: exclusive while asking
    }

    permissions {
        services: "audio", "audio.*", "brightness", "brightness.*", "media", "media.*", "network", "network.*", "bluetooth", "bluetooth.*", "say:topbar", "say:dock", "say:settings", "say:spotlight", "say:apple_menu", "say:notifications", "say:dashboard", "say:osd"
    }

    // ── Built-in System Models ────────────────────────────────────
    model nets max 8 { ssid: text; strength: number; secure: bool; known: bool; active: bool }
    //  One row per Bluetooth device, painted by control_center.luau. kind: 0 any · 1 headphones · 2 mouse ·
    //  3 keyboard · 4 phone · 5 computer · 6 gamepad · 7 speaker. state: 0 paired · 1 connected · 2 working · 3 new.
    model bt_rows max 8 { name: text; status: text; kind: number; state: number; battery: number = -1 }
    model outs max 6 { id: number; name: text; default: bool }
    //  Painted by control_center.luau. Wi-Fi rows: signal 0..1.  App volumes: one row per stream playing.
    model wifi_rows max 6 { name: text; signal: number; secure: bool; known: bool; active: bool; joining: bool }
    model app_rows max 4 { name: text; volume: number; muted: bool }

    // ── System Services & Lists ───────────────────────────────────
    service audio as sound { volume: number; muted: bool; outputs: outs }
    service brightness as display { present: bool; level: number }
    service network as net { online: bool; name: text; networks: nets }

    // ── Navigation & Theme Facts ──────────────────────────────────
    // Navigation: 0 = Main, 1 = Wi-Fi, 2 = Bluetooth, 3 = Sound
    fact page = 0

    //  Wi-Fi, from control_center.luau. state: 0 off · 1 not connected · 2 connected · 3 cable · 4 joining
    fact wifi_state = 1
    fact wifi_signal = 0
    fact asking = false          // the password sheet is open
    text wifi_title = ""
    text wifi_status = ""
    text ask_name = ""
    text ask_error = ""
    text wifi_pw = ""

    //  Reported by control_center.luau: Bluetooth, and what is playing
    fact bt_on = false
    fact bt_present = true
    fact bt_scanning = false
    text bt_sub = "Off"
    fact has_player = false
    fact is_playing = false
    fact has_art = false
    fact track_len = 0
    fact track_pos = 0
    text track_title = ""
    text track_artist = ""
    text cover_art = ""
    text time_pos = "0:00"
    text time_len = "0:00"
    image cover = from cover_art, 52, 52
    fact open = false
    fact dark_mode = true
    fact skin = 0

    let bg_color = if(dark_mode, if(skin == 2, #1e2026, if(skin == 1, #181a20, #14161d)), if(skin == 2, #f2f3f7, if(skin == 1, #f0f2f6, #f8f9fc)))
    let glass_amt = if(skin == 2, 0%, if(skin == 1, 45%, 70%))
    let tint_amt = if(skin == 2, 0%, if(dark_mode, 35%, 20%))
    let rim_amt = if(skin == 2, 0%, 12%)
    let shadow_amt = if(dark_mode, 35%, 15%)
    let card_fill = if(skin == 2, if(dark_mode, #242732, #f0f2f7), if(dark_mode, #ffffff, #ffffff))
    let card_fill_op = if(skin == 2, 100%, if(dark_mode, 10%, 65%))
    let card_stroke = if(dark_mode, #ffffff, #000000)
    let card_stroke_op = if(skin == 2, if(dark_mode, 12%, 8%), if(dark_mode, 8%, 6%))
    let ink_c = if(dark_mode, #f5f7f5, #1d1d1f)
    let ink_sub = if(dark_mode, #9a9ea7, #6e6e73)
    let item_bg = if(skin == 2, if(dark_mode, #343740, #e2e4ea), if(dark_mode, #ffffff, #000000))
    let item_bg_op = if(skin == 2, 100%, if(dark_mode, 14%, 8%))
    let slider_bg = if(dark_mode, #000000, #000000)
    let slider_bg_op = if(dark_mode, 25%, 8%)
    let slider_bar = if(dark_mode, #ffffff, #007aff)
    let slider_bar_op = if(dark_mode, 92%, 92%)
    let slider_icon = if(dark_mode, #16181d, #ffffff)

    event toggle
    event toggle_dark ->
    event set_dark_mode ->
    event choose_skin ->

    event volume_set ->
    event brightness_set ->
    event play_pause ->
    event pick_network ->
    event wifi_power ->
    event wifi_disconnect ->
    event wifi_rescan ->
    event wifi_join ->
    event wifi_cancel ->
    event app_volume ->
    event bt_action ->
    event bt_power ->
    event bt_scan ->
    event open_settings ->
    event previous ->
    event next ->
    event seek ->
    event pick_output ->
    event toggle_wifi ->
    event toggle_bt ->

    prop seen = 0 ~quick
    //  Closing the password sheet hands the keyboard back, which is a `blur`: this stays above zero
    //  for a moment after it so that blur does not close the whole panel.
    prop askhold = 0 ~calm
    follow askhold = if(asking, 1, 0)
    //  The card is shorter on the overview than on the pickers, and grows when one opens.
    prop ch = 430 ~calm
    follow ch = if(page == 0, 430,
                if(page == 1, if(asking, 240, max(230, 176 + wifi_rows.count * 40)),
                if(page == 2, max(200, 78 + bt_rows.count * 52),
                max(190, 100 + outs.count * 40 + app_rows.count * 56 + if(app_rows.count > 0, 12, 40)))))
    prop scale = 0.9 ~quick

    //  A small button with a word.
    component Pill(label: text, press: event, w: number = 96, strong: bool = false, warn: bool = false) {
        size: w, 28
        prop glow = 0 ~quick
        box { from: 0, 0; size: w, 28; corner: 9; color: if(strong, #007aff, if(warn, #ff453a, item_bg)); opacity: if(strong, 100%, if(warn, 20%, item_bg_op)) + glow * 12% }
        text label { at: w / 2, 14; anchor: center; size: 11; weight: 600; color: if(strong, #ffffff, if(warn, #ff6961, ink_c)) }
        zone box hit { from: 0, 0; size: w, 28; corner: 9; cursor: pointer }
        on enter hit { glow: 1 }
        on leave hit { glow: 0 }
        on press hit { emit press }
    }

    //  Four arcs that fill with the strength, 0..1
    component Bars(level: number, tone: color = ink_c) {
        size: 28, 24
        repeat a in 1..5 {
            arc { at: 14, 20; radius: 2 + a * 3.6; span: 110deg; width: 1.8; color: tone; opacity: 20% + 80% * if(level > (a - 1) * 0.25, 1, 0) }
        }
        ellipse { at: 14, 21; radius: 1.8; color: tone }
    }

    layer panel ~quick {
        shown while open { seen: 1 ~quick; scale: 1 ~quick }
        gone             { seen: 0 ~quick; scale: 0.9 ~quick }
    }

    // Dismiss click zone for outside
    zone box dismiss { from: 0, 0; size: 440, 520; active: open }
    on press dismiss { open = false; page = 0 }
    on press right dismiss { }

    group {
        move: 40, 8
        pivot: 340, 0
        scale: scale
        opacity: seen

        // ── Window Frame ──────────────────────────────────────────
        body {
            color: bg_color
            glass: glass_amt
            lens: false
            frost: 100%
            dispersion: 35%
            refraction: 75%
            shine: pointer
            tint: tint_amt
            rim: rim_amt
            shadow: 0, 14, 30, shadow_amt
            // The card tucks right under the right island (the bar's strip is 42 px) and grows
            // out of it: it scales from its top-right corner, so it reads as the island opening.
            box { from: 0, 0; size: 360, ch; corner: 22 }
        }

        // ==========================================================
        // PAGE 0: MAIN CONTROL CENTER OVERVIEW
        // ==========================================================
        group {
            show: page == 0

            // Top Row: Connectivity & Controls
            row {
                at: 16, 16
                gap: 12

                // Connectivity 2x2 Card
                group {
                    size: 158, 134
                    box { from: 0, 0; size: 158, 134; corner: 16; color: card_fill; opacity: card_fill_op }
                    box { from: 0, 0; size: 158, 134; corner: 16; stroke: 1; color: card_stroke; opacity: card_stroke_op }

                    // Wi-Fi Row
                    group {
                        size: 34, 34
                        move: 12, 14
                        ellipse { at: 17, 17; radius: 17; color: if(net.online, #007aff, item_bg); opacity: if(net.online, 100%, item_bg_op) }
                        text "󰤨" { at: 17, 17; anchor: center; size: 15; color: if(net.online, #ffffff, ink_c) }
                        zone box wifi_icon_hit { from: 0, 0; size: 34, 34; cursor: pointer }
                    }
                    text "Wi-Fi" { at: 54, 22; anchor: left center; size: 12.5; weight: 600; color: ink_c }
                    text if(net.online, net.name, "Off") { at: 54, 36; anchor: left center; size: 10.5; color: ink_sub; width: 80; lines: 1 }
                    text "󰅂" { at: 142, 28; anchor: center; size: 14; color: ink_sub }
                    zone box wifi_chevron_hit { at: 142, 28; size: 24, 24; corner: 12; cursor: pointer }

                    // Bluetooth Row
                    group {
                        size: 34, 34
                        move: 12, 72
                        ellipse { at: 17, 17; radius: 17; color: if(bt_on, #007aff, item_bg); opacity: if(bt_on, 100%, item_bg_op) }
                        text "󰂯" { at: 17, 17; anchor: center; size: 15; color: if(bt_on, #ffffff, ink_c) }
                        zone box bt_icon_hit { from: 0, 0; size: 34, 34; cursor: pointer }
                    }
                    text "Bluetooth" { at: 54, 80; anchor: left center; size: 12.5; weight: 600; color: ink_c }
                    text bt_sub { at: 54, 94; anchor: left center; size: 10.5; color: ink_sub; width: 80; lines: 1 }
                    text "󰅂" { at: 142, 86; anchor: center; size: 14; color: ink_sub }
                    zone box bt_chevron_hit { at: 142, 86; size: 24, 24; corner: 12; cursor: pointer }
                }

                // Focus & Dark Mode Right Column
                column {
                    gap: 12

                    // Dark Mode Toggle Card
                    group {
                        size: 158, 61
                        box { from: 0, 0; size: 158, 61; corner: 16; color: card_fill; opacity: card_fill_op }
                        box { from: 0, 0; size: 158, 61; corner: 16; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                        ellipse { at: 24, 30; radius: 15; color: if(dark_mode, #007aff, item_bg); opacity: if(dark_mode, 100%, item_bg_op) }
                        text if(dark_mode, "󰔎", "󰖨") { at: 24, 30; anchor: center; size: 15; color: if(dark_mode, #ffffff, ink_c) }
                        text "Dark Mode" { at: 48, 22; anchor: left center; size: 12.5; weight: 600; color: ink_c }
                        text if(dark_mode, "On", "Off") { at: 48, 38; anchor: left center; size: 10.5; color: ink_sub }
                        zone box dm_tile_hit { from: 0, 0; size: 158, 61; corner: 16; cursor: pointer }
                    }

                    // Settings shortcut
                    group {
                        size: 158, 61
                        box { from: 0, 0; size: 158, 61; corner: 16; color: card_fill; opacity: card_fill_op }
                        box { from: 0, 0; size: 158, 61; corner: 16; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                        ellipse { at: 24, 30; radius: 15; color: item_bg; opacity: item_bg_op }
                        text "󰒓" { at: 24, 30; anchor: center; size: 15; color: ink_c }
                        text "Settings" { at: 48, 22; anchor: left center; size: 12.5; weight: 600; color: ink_c }
                        text "All preferences" { at: 48, 38; anchor: left center; size: 10.5; color: ink_sub }
                        zone box settings_tile_hit { from: 0, 0; size: 158, 61; corner: 16; cursor: pointer }
                    }
                }
            }

            // Sliders Section
            column {
                at: 16, 160
                gap: 10

                // Display Brightness Card
                group {
                    size: 328, 54
                    box { from: 0, 0; size: 328, 54; corner: 16; color: card_fill; opacity: card_fill_op }
                    box { from: 0, 0; size: 328, 54; corner: 16; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                    text "Display" { at: 14, 14; anchor: left center; size: 11; weight: 600; color: ink_sub }
                    text "{display.level * 100, 0}%" { at: 314, 14; anchor: right center; size: 10.5; color: ink_sub }
                    group {
                        move: 14, 25
                        size: 300, 20
                        box { from: 0, 0; size: 300, 20; corner: 10; color: slider_bg; opacity: slider_bg_op }
                        box { from: 0, 0; size: 300 * max(display.level, 0.12), 20; corner: 10; color: slider_bar; opacity: slider_bar_op }
                        ellipse { at: 14, 10; radius: 3.3; color: slider_icon }
                        repeat k in 0..8 { line { from: 14 + 5.6 * cos(k * 45), 10 + 5.6 * sin(k * 45); to: 14 + 7.4 * cos(k * 45), 10 + 7.4 * sin(k * 45); width: 1.3; color: slider_icon } }
                        zone box br_hit { from: 0, 0; size: 300, 20; cursor: pointer }
                    }
                }

                // Sound Volume Card
                group {
                    size: 328, 54
                    box { from: 0, 0; size: 328, 54; corner: 16; color: card_fill; opacity: card_fill_op }
                    box { from: 0, 0; size: 328, 54; corner: 16; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                    text "Sound" { at: 14, 14; anchor: left center; size: 11; weight: 600; color: ink_sub }
                    text "{sound.volume * 100, 0}%" { at: 294, 14; anchor: right center; size: 10.5; color: ink_sub }
                    text "󰅂" { at: 312, 14; anchor: center; size: 12; color: ink_sub }
                    zone box snd_chevron_hit { at: 310, 14; size: 28, 22; corner: 10; cursor: pointer }

                    group {
                        move: 14, 25
                        size: 300, 20
                        box { from: 0, 0; size: 300, 20; corner: 10; color: slider_bg; opacity: slider_bg_op }
                        box { from: 0, 0; size: 300 * sound.volume, 20; corner: 10; color: slider_bar; opacity: slider_bar_op }
                        path { at: 7, 4; color: slider_icon; move 0, 4; line 4, 4; line 9, 0; line 9, 12; line 4, 8; line 0, 8; close }
                        arc { at: 17, 10; radius: 4.2; span: 110deg; rotate: -55deg; width: 1.5; color: slider_icon }
                        zone box vol_hit { from: 0, 0; size: 300, 20; cursor: pointer }
                    }
                }
            }

            // Now Playing / Media Card
            group {
                move: 16, 286
                size: 328, 128
                box { from: 0, 0; size: 328, 128; corner: 16; color: card_fill; opacity: card_fill_op }
                box { from: 0, 0; size: 328, 128; corner: 16; stroke: 1; color: card_stroke; opacity: card_stroke_op }

                //  Nothing is playing
                group {
                    show: not has_player
                    ellipse { at: 164, 48; radius: 22; color: item_bg; opacity: item_bg_op }
                    path { at: 155, 36; color: ink_sub; move 0, 0; line 20, 12; line 0, 24; close }
                    text "Nothing playing" { at: 164, 90; anchor: center; size: 12; weight: 500; color: ink_sub }
                    text "Start a song in any player" { at: 164, 106; anchor: center; size: 10; color: ink_sub; opacity: 70% }
                }

                //  A player has something
                group {
                    show: has_player

                    //  Cover: a soft gradient, and the real artwork over it when the player has one
                    body {
                        gradient: 0, 0 to 52, 52, #e8a048, #7f52ff
                        box { from: 14, 12; size: 52, 52; corner: 11 }
                    }
                    image cover { at: 14, 12; size: 52, 52; show: has_art }
                    text track_title { at: 78, 28; anchor: left center; size: 13; weight: 600; color: ink_c; width: 236; lines: 1 }
                    text track_artist { at: 78, 46; anchor: left center; size: 11; color: ink_sub; width: 236; lines: 1 }

                    //  Progress; a click on the bar seeks
                    box { from: 14, 74; size: 300, 4; corner: 2; color: slider_bg; opacity: slider_bg_op }
                    box { from: 14, 74; size: max(4, 300 * clamp(track_pos / max(track_len, 1), 0, 1)), 4; corner: 2; color: slider_bar; opacity: slider_bar_op; show: track_len > 0 }
                    text time_pos { at: 14, 88; anchor: left center; size: 9.5; color: ink_sub }
                    text time_len { at: 314, 88; anchor: right center; size: 9.5; color: ink_sub; show: track_len > 0 }
                    zone box seek_hit { from: 14, 68; size: 300, 16; cursor: pointer; active: track_len > 0 }

                    //  Previous · play/pause · next, drawn
                    path { at: 112, 99; color: ink_c; move 11, 0; line 11, 14; line 0, 7; close }
                    box { from: 109, 99; size: 2.6, 14; corner: 1.3; color: ink_c }
                    ellipse { at: 164, 106; radius: 16; color: item_bg; opacity: item_bg_op }
                    group {
                        show: is_playing
                        box { from: 158, 99; size: 3.6, 14; corner: 1.8; color: ink_c }
                        box { from: 166.5, 99; size: 3.6, 14; corner: 1.8; color: ink_c }
                    }
                    path { at: 160, 98.5; color: ink_c; show: not is_playing; move 0, 0; line 13, 7.5; line 0, 15; close }
                    path { at: 205, 99; color: ink_c; move 0, 0; line 11, 7; line 0, 14; close }
                    box { from: 216, 99; size: 2.6, 14; corner: 1.3; color: ink_c }
                    zone box prev_hit { at: 118, 106; size: 34, 34; corner: 17; cursor: pointer }
                    zone box play_hit { at: 164, 106; size: 38, 38; corner: 19; cursor: pointer }
                    zone box next_hit { at: 211, 106; size: 34, 34; corner: 17; cursor: pointer }
                }
            }
        }

        // ==========================================================
        // PAGE 1: WI-FI
        // ==========================================================
        group {
            show: page == 1

            group {
                move: 16, 20
                size: 100, 32
                row {
                    gap: 8
                    align: center
                    text "󰅁" { size: 18; color: ink_c; opacity: 70% }
                    text "Wi-Fi" { size: 16; weight: 600; color: ink_c }
                }
                zone box wifi_back_hit { from: 0, 0; size: 100, 32; cursor: pointer }
            }
            //  Radio switch
            box { from: 306, 25; size: 38, 22; corner: 11; color: if(wifi_state != 0, #34c759, item_bg); opacity: if(wifi_state != 0, 100%, item_bg_op) }
            ellipse { at: if(wifi_state != 0, 335, 316), 36; radius: 9; color: #ffffff }
            zone box wifi_switch_hit { from: 306, 25; size: 38, 22; corner: 11; cursor: pointer }

            // ── the connection in use, or why there is none ──
            group {
                show: not asking
                move: 16, 62
                box { from: 0, 0; size: 328, 64; corner: 14; color: card_fill; opacity: card_fill_op }
                box { from: 0, 0; size: 328, 64; corner: 14; color: #007aff; opacity: if(wifi_state == 2 or wifi_state == 3, 18%, 0%) }
                box { from: 0, 0; size: 328, 64; corner: 14; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                group {
                    move: 12, 20
                    opacity: if(wifi_state == 0, 35%, 100%)
                    Bars(if(wifi_state >= 2, wifi_signal, 0), if(wifi_state >= 2, #007aff, ink_c))
                }
                text wifi_title { at: 52, 24; anchor: left center; size: 13.5; weight: 600; color: ink_c; width: 150; lines: 1 }
                text wifi_status { at: 52, 42; anchor: left center; size: 10.5; color: ink_sub; width: 150; lines: 1 }
                row {
                    at: 316, 32
                    anchor: right middle
                    show: wifi_state == 2
                    Pill("Disconnect", wifi_disconnect, 92, false, true)
                }
                row {
                    at: 316, 32
                    anchor: right middle
                    show: wifi_state == 0
                    Pill("Turn On", wifi_power, 84, true)
                }
                row {
                    at: 316, 32
                    anchor: right middle
                    show: wifi_state == 4
                    Pill("Cancel", wifi_disconnect, 76)
                }
            }

            // ── networks in range ──
            group {
                show: wifi_state != 0 and not asking
                text "NEARBY" { at: 20, 144; anchor: left center; size: 9.5; weight: 700; color: ink_sub }
                text "Look again" { at: 344, 144; anchor: right center; size: 10.5; color: ink_sub }
                zone box wifi_rescan_hit { from: 270, 134; size: 74, 20; corner: 10; cursor: pointer }
                column {
                    at: 16, 158
                    gap: 4
                    for n in wifi_rows {
                        group {
                            size: 328, 36
                            box { from: 0, 0; size: 328, 36; corner: 10; color: card_fill; opacity: card_fill_op }
                            box { from: 0, 0; size: 328, 36; corner: 10; color: #007aff; opacity: if(n.active, 22%, 0%) }
                            box { from: 0, 0; size: 328, 36; corner: 10; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                            group {
                                move: 10, 6
                                Bars(n.signal, if(n.active, #007aff, ink_c))
                            }
                            text n.name { at: 46, 18; anchor: left center; size: 12.5; weight: if(n.active, 600, 400); color: ink_c; width: 190; lines: 1 }
                            text "Joining…" { at: 300, 18; anchor: right center; size: 10.5; color: ink_sub; show: n.joining }
                            text "Connected" { at: 300, 18; anchor: right center; size: 10.5; color: mint; show: n.active and not n.joining }
                            text "Saved" { at: 300, 18; anchor: right center; size: 10.5; color: ink_sub; show: n.known and not n.active and not n.joining }
                            group {
                                show: n.secure and not n.known and not n.active
                                box { from: 310, 20; size: 9, 7; corner: 2; color: ink_sub }
                                arc { at: 314.5, 20; radius: 3; span: 180deg; width: 1.4; color: ink_sub }
                            }
                            zone box wifi_row_hit { from: 0, 0; size: 328, 36; corner: 10; cursor: pointer }
                            on press wifi_row_hit { emit pick_network(n.index) }
                        }
                    }
                }
                text "Looking for networks…" { at: 180, 230; anchor: center; size: 12; color: ink_sub; show: wifi_rows.count < 1 }
            }
            text "Turn Wi-Fi on to see the networks around you." { at: 180, 200; anchor: center; size: 12; color: ink_sub; show: wifi_state == 0 and not asking }

            // ── its password, asked for in the list's place ──
            group {
                show: asking
                move: 16, 62
                box { from: 0, 0; size: 328, 150; corner: 14; color: card_fill; opacity: card_fill_op }
                box { from: 0, 0; size: 328, 150; corner: 14; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                text "Join" { at: 164, 24; anchor: center; size: 10.5; color: ink_sub }
                text ask_name { at: 164, 44; anchor: center; size: 15; weight: 600; color: ink_c; width: 290; lines: 1; tight: true }
                box { from: 18, 66; size: 292, 34; corner: 9; color: slider_bg; opacity: slider_bg_op }
                input wifi_pw {
                    at: 30, 74
                    width: 270
                    size: 13
                    color: ink_c
                    secret: true
                    placeholder: "Password"
                    selection: #007aff
                }
                text ask_error { at: 164, 114; anchor: center; size: 10.5; color: #ff6961 }
                row {
                    at: 164, 132
                    anchor: center middle
                    gap: 10
                    Pill("Cancel", wifi_cancel, 90)
                    Pill("Join", wifi_join, 90, true)
                }
            }
        }

        // ==========================================================
        // PAGE 2: BLUETOOTH DEVICES SUB-PAGE
        // ==========================================================
        group {
            show: page == 2

            group {
                move: 16, 20
                size: 130, 32
                row {
                    gap: 8
                    align: center
                    text "󰅁" { size: 18; color: ink_c; opacity: 70% }
                    text "Bluetooth" { size: 16; weight: 600; color: ink_c }
                }
                zone box bt_back_hit { from: 0, 0; size: 130, 32; cursor: pointer }
            }

            //  Power switch, and the search button beside it
            box { from: 306, 25; size: 38, 22; corner: 11; color: if(bt_on, #34c759, item_bg); opacity: if(bt_on, 100%, item_bg_op) }
            ellipse { at: if(bt_on, 335, 316), 36; radius: 9; color: #ffffff }
            zone box bt_power_hit { from: 306, 25; size: 38, 22; corner: 11; cursor: pointer; active: bt_present }
            text if(bt_scanning, "Searching…", "Search") { at: 292, 36; anchor: right center; size: 11.5; weight: 500; color: if(bt_scanning, #007aff, ink_sub); show: bt_on }
            zone box bt_scan_hit { from: 200, 24; size: 94, 24; corner: 12; cursor: pointer; active: bt_on }

            column {
                at: 16, 62
                gap: 6
                for g in bt_rows {
                    group {
                        size: 328, 46
                        box { from: 0, 0; size: 328, 46; corner: 12; color: card_fill; opacity: card_fill_op }
                        box { from: 0, 0; size: 328, 46; corner: 12; color: #007aff; opacity: if(g.state == 1, 22%, 0%) }
                        box { from: 0, 0; size: 328, 46; corner: 12; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                        ellipse { at: 24, 23; radius: 15; color: if(g.state == 1, #007aff, item_bg); opacity: if(g.state == 1, 100%, item_bg_op) }
                        text pick(g.kind, "󰂯", "󰋋", "󰍽", "󰌌", "󰏲", "󰟀", "󰊴", "󰓃") { at: 24, 23; anchor: center; size: 14; color: if(g.state == 1, #ffffff, ink_c) }
                        text g.name { at: 48, 17; anchor: left center; size: 13; weight: if(g.state == 1, 600, 500); color: ink_c; width: 150; lines: 1 }
                        text g.status { at: 48, 32; anchor: left center; size: 10.5; color: if(g.state == 1, mint, ink_sub); width: 150; lines: 1 }
                        text if(g.battery >= 0, "{g.battery * 100, 0}%", "") { at: 208, 23; anchor: right center; size: 10.5; color: ink_sub }
                        box { from: 246, 9; size: 72, 28; corner: 9; color: if(g.state == 0 or g.state == 3, #007aff, item_bg); opacity: if(g.state == 0 or g.state == 3, 100%, item_bg_op) }
                        text pick(g.state, "Connect", "Disconnect", "…", "Pair") { at: 282, 23; anchor: center; size: 10.5; weight: 600; color: if(g.state == 0 or g.state == 3, #ffffff, ink_c) }
                        zone box bt_row_hit { from: 246, 9; size: 72, 28; corner: 9; cursor: pointer }
                        on press bt_row_hit { emit bt_action(g.index) }
                    }
                }
            }
            group {
                show: bt_rows.count < 1
                text "Looking around…" { at: 180, 200; anchor: center; size: 12; color: ink_sub; show: bt_on and bt_scanning }
                text "No paired devices. Press Search." { at: 180, 200; anchor: center; size: 12; color: ink_sub; show: bt_on and not bt_scanning }
                text "Bluetooth is off. Use the switch to turn it on." { at: 180, 200; anchor: center; size: 12; color: ink_sub; show: bt_present and not bt_on }
                text "No Bluetooth adapter found" { at: 180, 200; anchor: center; size: 12; color: ink_sub; show: not bt_present }
            }
        }

        // ==========================================================
        // PAGE 3: SOUND  (output, then each app's own volume)
        // ==========================================================
        group {
            show: page == 3

            group {
                move: 16, 20
                size: 150, 32
                row {
                    gap: 8
                    align: center
                    text "󰅁" { size: 18; color: ink_c; opacity: 70% }
                    text "Sound" { size: 16; weight: 600; color: ink_c }
                }
                zone box snd_back_hit { from: 0, 0; size: 150, 32; cursor: pointer }
            }

            text "OUTPUT" { at: 20, 62; anchor: left center; size: 9.5; weight: 700; color: ink_sub }
            column outs_list {
                at: 16, 74
                gap: 4
                for o in outs {
                    group {
                        size: 328, 36
                        box { from: 0, 0; size: 328, 36; corner: 10; color: card_fill; opacity: card_fill_op }
                        box { from: 0, 0; size: 328, 36; corner: 10; color: #007aff; opacity: if(o.default, 22%, 0%) }
                        box { from: 0, 0; size: 328, 36; corner: 10; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                        ellipse { at: 22, 18; radius: 12; color: if(o.default, #007aff, item_bg); opacity: if(o.default, 100%, item_bg_op) }
                        path { at: 16.5, 12.5; color: if(o.default, #ffffff, ink_c); move 0, 3.5; line 3, 3.5; line 7, 0; line 7, 11; line 3, 7.5; line 0, 7.5; close }
                        text o.name { at: 44, 18; anchor: left center; size: 12.5; weight: if(o.default, 600, 400); color: ink_c; width: 250; lines: 1 }
                        text if(o.default, "✓", "") { at: 310, 18; anchor: center; size: 14; color: #007aff }
                        zone box out_row_hit { from: 0, 0; size: 328, 36; corner: 10; cursor: pointer }
                        on press out_row_hit { emit pick_output(o.id) }
                    }
                }
            }

            //  Below the outputs: what is making sound, each with its own slider.
            group {
                move: 0, 74 + outs_list.height + 12
                text "APPS" { at: 20, 0; anchor: left center; size: 9.5; weight: 700; color: ink_sub; show: app_rows.count > 0 }
                column {
                    at: 16, 12
                    gap: 6
                    for a in app_rows {
                        group {
                            size: 328, 50
                            box { from: 0, 0; size: 328, 50; corner: 12; color: card_fill; opacity: card_fill_op }
                            box { from: 0, 0; size: 328, 50; corner: 12; stroke: 1; color: card_stroke; opacity: card_stroke_op }
                            text a.name { at: 14, 14; anchor: left center; size: 11.5; weight: 600; color: ink_c; width: 220; lines: 1 }
                            text "{a.volume * 100, 0}%" { at: 314, 14; anchor: right center; size: 10.5; color: ink_sub }
                            group {
                                move: 14, 28
                                box { from: 0, 0; size: 300, 14; corner: 7; color: slider_bg; opacity: slider_bg_op }
                                box { from: 0, 0; size: max(14, 300 * a.volume), 14; corner: 7; color: slider_bar; opacity: if(a.muted, 35%, slider_bar_op) }
                                zone box app_vol_hit { from: 0, 0; size: 300, 14; cursor: pointer }
                                on press app_vol_hit { emit app_volume(a.index + clamp(local.x / 300, 0, 0.999)) }
                                on drag app_vol_hit { emit app_volume(a.index + clamp(local.x / 300, 0, 0.999)) }
                            }
                        }
                    }
                }
                text "Nothing is playing right now" { at: 180, 40; anchor: center; size: 11.5; color: ink_sub; show: app_rows.count < 1 }
            }
        }
    }

    // Sliders & Media Actions
    on press br_hit   { emit brightness_set(clamp(local.x / 300, 0.1, 1)) }
    on drag br_hit    { emit brightness_set(clamp(local.x / 300, 0.1, 1)) }
    on press vol_hit  { emit volume_set(clamp(local.x / 300, 0, 1)) }
    on drag vol_hit   { emit volume_set(clamp(local.x / 300, 0, 1)) }
    on press play_hit { emit play_pause }
    on press prev_hit { emit previous }
    on press next_hit { emit next }
    on press seek_hit { emit seek(clamp(local.x / 300, 0, 1)) }
    on press settings_tile_hit { emit open_settings; open = false; page = 0 }
    on press bt_power_hit { emit bt_power }
    on press bt_scan_hit  { emit bt_scan }

    // Navigation Transitions
    on press wifi_chevron_hit { page = 1 }
    on press wifi_back_hit    { page = 0 }
    on press wifi_icon_hit    { emit toggle_wifi }
    on press wifi_switch_hit  { emit toggle_wifi }
    on press wifi_rescan_hit  { emit wifi_rescan }
    on submit wifi_pw         { emit wifi_join }
    on change asking          { focus wifi_pw }

    on press bt_chevron_hit   { page = 2 }
    on press bt_back_hit      { page = 0 }
    on press bt_icon_hit      { emit toggle_bt }

    on press snd_chevron_hit  { page = 3 }
    on press snd_back_hit     { page = 0 }

    // Theme Actions
    on press dm_tile_hit   { emit toggle_dark }

    // Window Lifecycle
    on toggle     { toggle open; page = 0 }
    on key Escape { open = false; page = 0 }
    on blur while askhold < 0.2 { open = false; page = 0 }
}
