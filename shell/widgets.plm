// macOS Notification Center & Widgets Sidebar
import "common/palette.plm"

scene MacWidgets {
    surface {
        size: 380, 720
        anchor: top_right
        margin: 34, 12, 0, 0
        level: overlay
    }

    permissions {
        services: "clock", "notifications", "notification_history"
        run: "sh"
    }

    service clock as now { time: text = "--:--"; date: text }
    model notices max 6 { id: number; app: text; title: text; body: text }
    service notifications { list: notices }

    fact open = false
    fact dark_mode = true
    fact skin = 0
    fact cpu_pct = 18
    fact mem_pct = 44
    fact disk_pct = 52
    text weather_temp = "24°C"
    text weather_cond = "Partly Cloudy"
    text weather_city = "Cupertino"
    text cal_month = "NOVEMBER"
    text cal_day = "6"
    text cal_dow = "Friday"
    text cal_event = "No Upcoming Events"

    let bg_color = if(dark_mode, if(skin == 2, #1e2026, if(skin == 1, #1c1e28, #161820)), if(skin == 2, #f2f3f7, if(skin == 1, #eaecf2, #f8f9fc)))
    let glass_amt = if(skin == 2, 0%, if(skin == 1, 55%, 85%))
    let tint_amt = if(skin == 2, 0%, if(dark_mode, 40%, 25%))
    let rim_amt = if(skin == 2, 0%, 14%)
    let shadow_amt = if(dark_mode, 35%, 15%)
    let card_fill = if(dark_mode, #232630, #ffffff)
    let card_fill_op = if(dark_mode, 78%, 88%)
    let card_stroke = if(dark_mode, #ffffff, #000000)
    let card_stroke_op = if(dark_mode, 6%, 8%)
    let ink_c = if(dark_mode, #f5f7f5, #1d1d1f)
    let ink_sub = if(dark_mode, #8e8e93, #6e6e73)
    let item_bg = if(dark_mode, #343740, #e2e4ea)
    let bar_track = if(dark_mode, #343740, #e2e4ea)

    event toggle
    event clear_notices ->
    event refresh_stats ->

    prop seen = 0 ~quick
    prop scale = 0.96 ~quick

    layer panel ~quick {
        shown while open { seen: 1 ~quick; scale: 1 ~quick }
        gone             { seen: 0 ~quick; scale: 0.96 ~quick }
    }

    zone box dismiss { from: 0, 0; size: 380, 720; active: open }
    on press dismiss { open = false }
    on press right dismiss { }

    group {
        move: 16, 12
        pivot: 340, 20
        scale: scale
        opacity: seen

        // Main Glass Body
        body {
            color: bg_color
            glass: glass_amt
            lens: false
            frost: 100%
            dispersion: 0
            refraction: 0
            tint: tint_amt
            rim: rim_amt
            shadow: 0, 14, 28, shadow_amt
            box { from: 0, 0; size: 348, 690; corner: 22 }
        }

        // ── Top Header ────────────────────────────────────────────
        row {
            at: 16, 16
            gap: 8
            align: center
            text "󰒎" { size: 16; color: #007aff }
            text "Widgets" { size: 15; weight: 600; color: ink_c }
        }

        // ── Row 1: Calendar & Weather 2x Side-by-Side Widgets ─────
        row {
            at: 14, 46
            gap: 12

            // Calendar Widget
            group {
                size: 154, 134
                box { from: 0, 0; size: 154, 134; corner: 16; color: card_fill; opacity: card_fill_op }
                box { from: 0, 0; size: 154, 134; corner: 16; stroke: 1; color: card_stroke; opacity: card_stroke_op }

                // Red Accent Header
                text cal_month { at: 16, 14; size: 11; weight: 700; color: #ff3b30 }
                text cal_day { at: 16, 32; size: 36; weight: 700; color: ink_c }
                text cal_dow { at: 16, 74; size: 13; weight: 600; color: ink_c }
                text cal_event { at: 16, 96; size: 10.5; color: ink_sub; width: 122; lines: 2 }
            }

            // Weather Widget
            group {
                size: 154, 134
                box { from: 0, 0; size: 154, 134; corner: 16; color: card_fill; opacity: card_fill_op }
                box { from: 0, 0; size: 154, 134; corner: 16; stroke: 1; color: card_stroke; opacity: card_stroke_op }

                text weather_city { at: 14, 14; size: 13; weight: 600; color: ink_c; width: 126; lines: 1 }
                text weather_temp { at: 14, 34; size: 34; weight: 600; color: ink_c }
                text "󰖐" { at: 122, 42; anchor: center; size: 28; color: #ff9500 }
                text weather_cond { at: 14, 82; size: 11.5; weight: 500; color: ink_c; width: 126; lines: 1 }
                text "H: 28° · L: 19°" { at: 14, 102; size: 10.5; color: ink_sub }
            }
        }

        // ── Row 2: System Activity Monitor Widget ─────────────────
        group {
            move: 14, 192
            size: 320, 116
            box { from: 0, 0; size: 320, 116; corner: 16; color: card_fill; opacity: card_fill_op }
            box { from: 0, 0; size: 320, 116; corner: 16; stroke: 1; color: card_stroke; opacity: card_stroke_op }

            // Header
            text "󰍹" { at: 16, 16; size: 14; color: #007aff }
            text "Activity & Resources" { at: 36, 16; size: 12; weight: 600; color: ink_c }

            // CPU Metric
            text "CPU" { at: 16, 38; size: 11; weight: 600; color: ink_c }
            text "{cpu_pct}%" { at: 304, 38; anchor: right center; size: 11; weight: 600; color: #007aff }
            box { from: 16, 52; size: 288, 6; corner: 3; color: bar_track }
            box { from: 16, 52; size: max(288 * (cpu_pct / 100), 8), 6; corner: 3; color: #007aff }

            // Memory Metric
            text "Memory" { at: 16, 64; size: 11; weight: 600; color: ink_c }
            text "{mem_pct}%" { at: 304, 64; anchor: right center; size: 11; weight: 600; color: mint }
            box { from: 16, 78; size: 288, 6; corner: 3; color: bar_track }
            box { from: 16, 78; size: max(288 * (mem_pct / 100), 8), 6; corner: 3; color: mint }

            // Disk Metric
            text "Storage Disk" { at: 16, 90; size: 11; weight: 600; color: ink_c }
            text "{disk_pct}%" { at: 304, 90; anchor: right center; size: 11; weight: 600; color: purple }
            box { from: 16, 104; size: 288, 6; corner: 3; color: bar_track }
            box { from: 16, 104; size: max(288 * (disk_pct / 100), 8), 6; corner: 3; color: purple }
        }

        // ── Row 3: World Clock Widget ─────────────────────────────
        group {
            move: 14, 320
            size: 320, 84
            box { from: 0, 0; size: 320, 84; corner: 16; color: card_fill; opacity: card_fill_op }
            box { from: 0, 0; size: 320, 84; corner: 16; stroke: 1; color: card_stroke; opacity: card_stroke_op }

            row {
                at: 16, 14
                gap: 32

                column {
                    gap: 3
                    text "Local" { size: 11; color: ink_sub }
                    text now.time { size: 16; weight: 600; color: ink_c }
                    text "Today" { size: 10.5; color: ink_sub }
                }

                column {
                    gap: 3
                    text "Cupertino" { size: 11; color: ink_sub }
                    text "PST" { size: 16; weight: 600; color: ink_c }
                    text "-12.5 hrs" { size: 10.5; color: ink_sub }
                }

                column {
                    gap: 3
                    text "UTC / London" { size: 11; color: ink_sub }
                    text "GMT" { size: 16; weight: 600; color: ink_c }
                    text "-4.5 hrs" { size: 10.5; color: ink_sub }
                }
            }
        }

        // ── Section 4: Notifications Stream ───────────────────────
        group {
            move: 14, 416
            size: 320, 260

            row {
                at: 4, 0
                gap: 160
                align: center
                text "NOTIFICATIONS" { size: 11; weight: 600; color: ink_sub }
                text "Clear All" { size: 11; weight: 600; color: #007aff; show: notices.count > 0 }
            }
            zone box clear_hit { at: 290, 6; size: 50, 20; cursor: pointer; show: notices.count > 0 }
            on press clear_hit { emit clear_notices }

            // Empty State
            group {
                show: notices.count < 1
                ellipse { at: 160, 90; radius: 24; color: item_bg }
                text "󰂚" { at: 160, 90; anchor: center; size: 24; color: ink_sub }
                text "No New Notifications" { at: 160, 126; anchor: center; size: 13; weight: 600; color: ink_c }
                text "Notifications will appear here as they arrive" { at: 160, 144; anchor: center; size: 11; color: ink_sub; width: 260 }
            }

            // Notification Cards List
            column {
                at: 0, 24
                gap: 8
                show: notices.count > 0

                for n in notices {
                    group {
                        size: 320, 64
                        box { from: 0, 0; size: 320, 64; corner: 14; color: card_fill; opacity: card_fill_op }
                        box { from: 0, 0; size: 320, 64; corner: 14; stroke: 1; color: card_stroke; opacity: card_stroke_op }

                        // App badge
                        text "󰂚" { at: 14, 18; size: 14; color: #007aff }
                        text n.app { at: 34, 18; size: 11.5; weight: 600; color: ink_c; width: 200; lines: 1 }
                        text n.title { at: 14, 34; size: 12.5; weight: 600; color: ink_c; width: 290; lines: 1 }
                        text n.body { at: 14, 49; size: 11; color: ink_sub; width: 290; lines: 1 }
                    }
                }
            }
        }
    }

    on toggle     { toggle open }
    on key Escape { open = false }
    on blur       { open = false }
}
