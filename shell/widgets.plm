// Desktop widgets: glass cards that sit on the wallpaper (under every window), like iNiR's iRiS desktop.
//
//   · ONE scene, one background-level surface per monitor; only the cards catch the mouse, the rest is click-through
//   · `model ws` holds the cards on the desktop (kind, size class, position, monitor); widgets.luau owns it,
//     loads and saves it (~/.config/beskar/widgets.json) and feeds every face
//   · a card is a `component` that draws the glass plate and ONE face chosen by its kind. No fixed slot pool:
//     a card exists only while its record does, so an empty desktop costs nothing
//   · Edit mode (`editing`): the surface rises above windows, the desktop dims, cards can be dragged (snapped to a grid),
//     resized (small / medium / large), removed, and new ones added from the toolbar. Nothing here is done
//     with the desktop's own right-click (the desktop is click-through): use the Apple menu, Spotlight or Super+Shift+W
//
// Stacks (C4c): cards that share one footprint; the shown member is the only one in `ws` (see widget_stacks.luau)
// Kinds: 1 clock · 2 date · 3 weather · 4 battery · 5 system · 6 media · 7 month calendar
import "common/palette.plm"
import "common/icons.plm"
import "common/buttons.plm"
import "common/ui.plm"
import "common/calendar.plm"

scene Widgets {
    include "common/theme_facts.plm"
    include "common/theme.plm"
    permissions {
        services: "say:activities", "say:weather", "env", "say:personal", "clock", "battery", "media", "media.*", "audio", "audio.*", "brightness", "brightness.*", "say:topbar", "say:settings", "say:panels", "say:infopanels", "say:dockpanels", "say:dialogs", "say:windows", "say:controlcenter", "say:notifications"
        run: "sh", "cat", "niri msg"
    }

    surface {
        size: full, full
        anchor: top_left
        level: bottom, top while editing
        screens: each
        keyboard: none
    }

    service battery as bat { present: bool; percent: number; charging: bool }
    service audio as sound { volume: number; muted: bool }
    service brightness as display { present: bool; level: number }

    // ── what the logic reports ──
    // `sn` / `si` are the stack (C4c) the card is the shown face of: its member count and this face's page (0 / 0 = not
    // stacked); the logic puts only the shown member of a stack in this model, so hidden members cost nothing here.
    // `locked` is the card's position lock (1/0). tm / ap / dl / dd / sec are only filled for clock cards: its own time,
    // am/pm mark, date line, "date line shown" and "seconds shown" (card options, see widget_options.luau).
    model ws max 16 { id: number; scr: number; kind: number; sz: number; x: number; y: number; locked: number; sn: number; si: number; tm: text; ap: text; dl: text; dd: number; sec: number }
    fact editing = false
    fact widgets_on = true
    fact nscreens = 1
    fact can_undo = false
    fact drag_id = 0
    fact drag_dx = 0
    fact drag_dy = 0
    fact snap_on = true
    // Card options (C4b). `sel_id` is the card selected while arranging (0 = none); the widget bar reads the compact snapshot
    // in `card_options` (also pushed to the bar's `wb_card_options`). `clock_seconds` is the shell's default for seconds
    // on widget clocks (cards set to Automatic follow it); nothing pushes it yet, so the default is off.
    fact sel_id = 0
    fact clock_seconds = false
    text card_options = "{}"

    text w_time = ""
    text w_ampm = ""
    text w_dow = ""
    text w_month = ""
    text w_day = ""
    text w_datelong = ""
    text weather_temp = "--°C"
    text weather_cond = ""
    text weather_icon = "󰅟"
    text weather_city = ""
    text weather_range = ""
    text weather_status = "Loading weather…"
    fact weather_cached = false
    event weather_changed ->
    fact day_pct = 0
    text day_left = ""
    fact cpu_pct = 0
    fact mem_pct = 0
    fact disk_pct = 0
    text up_text = ""
    fact has_player = false
    fact is_playing = false
    text track_title = ""
    text track_artist = ""
    text cover_art = ""
    image cover = from cover_art, 171, 96
    text cal_title = ""
    model cal_month max 1 { list cells max 42 { d: text; kind: number } }

    text personal_note = "Loading notes…"
    text personal_count = "Loading to-dos…"
    model personal_tasks max 4 { id: number; title: text }
    event personal_changed ->
    event personal_toggle ->
    fact tw_ready = false
    fact tw_state = 0
    fact tw_progress = 0
    text tw_time = "25:00"
    text tw_status = "Loading timer…"
    event timer_changed ->
    event tw_primary ->
    event tw_cancel ->

    event w_drop ->
    event w_add ->
    event w_remove ->
    event w_resize ->
    event edit_toggle ->
    event edit_done ->
    event w_bar_open ->
    event w_undo ->
    event w_play ->
    event w_next ->
    event w_prev ->
    event w_open ->
    event weather_reload ->
    event w_grid ->
    event w_tidy ->
    event w_vol ->
    event w_bri ->
    event w_reset ->
    event w_preset ->
    event w_configure ->
    event w_opt ->
    event w_opt_next ->
    event w_opt_reset ->
    event w_stack ->
    event w_page_next ->
    event w_page_prev ->
    event w_unstack ->
    event w_eject ->

    // Saved desktops (C4a): the owner is widgets.luau / widget_layouts.luau. Name in `wl_name` (consumed per call), ids as the
    // event's number; the snapshot (compact JSON, bounded) and the last status are read with `--say widgets "get wl_snapshot"`.
    text wl_name = ""
    text wl_snapshot = "{}"
    text wl_status = ""
    text wl_detail = "{}"
    fact wl_rev = 0
    fact wl_count = 0
    fact wl_ready = false
    fact wl_error = false
    event wl_save ->
    event wl_update ->
    event wl_load ->
    event wl_rename ->
    event wl_duplicate ->
    event wl_delete ->
    event wl_list ->
    event wl_get ->

    // ── the glass, as in the frame ──
    let bar_glass = if(skin == 2, 0%, if(skin == 1, 45%, 55%)) * glass_k
    let bar_tint  = if(skin == 2, 0%, if(dark_mode, 60%, 45%))
    let bar_rim   = if(skin == 2, 0%, 16%)
    let bar_smoke = if(dark_mode, 75%, 0%)
    let bar_milk  = if(dark_mode, 0%, 70%)
    let unit = 160
    let gap  = 16

    prop dim = 0 ~calm
    follow dim = if(editing, 1, 0)

    component GridCells() {
        repeat j in 0..7 {
            repeat i in 0..11 {
                box { from: 48 + i * 176, 72 + j * 176; size: 160, 160; corner: r_xl; stroke: 1; color: on_accent; opacity: 14% }
            }
        }
    }

    component Desk() {
        // the dimming veil in edit mode
        box { from: 0, 0; size: screen.width, screen.height; color: scrim_c; opacity: dim * 38%; show: dim > 0.01 }
        group {
            show: editing
            zone box veil { from: 0, 0; size: screen.width, screen.height }
            on press right veil { }
            on press veil { emit w_configure(0) }
        }

        //  the grid cells, while arranging with the grid on: cards snap into these. They are drawn in three clipped
        //  pieces (above the widget bar, left of it, right of it) so the lines stop at the bar's edge, as if the bar
        //  were in front: this surface is above the bar's glass, and with the solid skin lines over it looked see-through.
        group {
            show: editing and snap_on
            opacity: dim
            group {
                clip box { from: 0, 0; size: screen.width, screen.height - 180 }
                GridCells()
            }
            group {
                clip box { from: 0, screen.height - 180; size: screen.width / 2 - 400, 180 }
                GridCells()
            }
            group {
                clip box { from: screen.width / 2 + 400, screen.height - 180; size: screen.width / 2 - 400, 180 }
                GridCells()
            }
        }
        for w in ws { WCard(w) }
    }

    // ── a card ──
    component WCard(w: record) {
        prop px = 0 ~calm
        prop py = 0 ~calm
        prop appear = 0 ~calm
        prop hot = 0 ~quick
        follow px = w.x + if(drag_id == w.id, drag_dx, 0)
        follow py = w.y + if(drag_id == w.id, drag_dy, 0)
        follow appear = 1
        let cw = pick(w.sz, 160, 336, 336)
        let ch = pick(w.sz, 160, 160, 336)
        group {
            show: w.scr == screen.index and (widgets_on or editing)
            move: px, py
            opacity: appear
            pivot: cw / 2, ch / 2
            scale: 0.94 + appear * 0.06 + if(drag_id == w.id, 0.025, 0)

            body {
                color: bar_color
                glass: bar_glass
                lens: false
                frost: 100%
                tint: bar_tint
                smoke: bar_smoke
                milk: bar_milk
                rim: bar_rim
                refraction: 50%
                box { from: 0, 0; size: cw, ch; corner: radius_window }
            }
            box { from: 0, 0; size: cw, ch; corner: radius_window; stroke: 1; color: card_stroke; opacity: 14% }

            //  ── faces ──
            group { show: w.kind == 1; ClockFace(cw, ch, w.sz, w) }
            group { show: w.kind == 2; DateFace(cw, ch, w.sz) }
            group { show: w.kind == 3; WeatherFace(cw, ch, w.sz) }
            group { show: w.kind == 4; BatteryFace(cw, ch, w.sz) }
            group { show: w.kind == 5; SystemFace(cw, ch, w.sz) }
            group { show: w.kind == 6; MediaFace(cw, ch, w.sz) }
            group { show: w.kind == 7; CalFace(cw, ch, w.sz) }
            group { show: w.kind == 8; DayFace(cw, ch, w.sz) }
            group { show: w.kind == 9; ControlsFace(cw, ch, w.sz) }
            group { show: w.kind == 10; NoteFace(cw, ch) }
            group { show: w.kind == 11; TasksFace(cw, ch) }
            group { show: w.kind == 12; TimerFace(cw, ch) }

            //  ── what a click does when not arranging ──
            zone box body_hit { from: 0, 0; size: cw, ch; corner: radius_window; cursor: pointer; label: "widget" }
            on press body_hit while not editing { emit w_open(screen.index * 100 + w.kind) }
            on press right body_hit { }
            on press body_hit while editing { emit w_configure(w.id) }
            on drag body_hit while editing and w.locked == 0 { drag_id = w.id; drag_dx = drag.dx; drag_dy = drag.dy }
            on release body_hit while editing { emit w_drop(w.id) }

            // Stack pager (C4c): previous / next member of the stack this card is the face of. It straddles the bottom
            // edge, works while arranging too, and exists only while the card is a stack face. ONE zone (left half =
            // previous, right half = next): a stack costs two zones per card in the compiled scene, not four.
            group {
                show: w.sn > 1
                move: cw / 2 - 44, ch - 10
                box { from: 0, 0; size: 88, 20; corner: control_r_large; color: item_solid }
                box { from: 0, 0; size: 88, 20; corner: control_r_large; stroke: 1; color: card_stroke; opacity: 14% }
                text "󰅁" { family: "JetBrainsMono Nerd Font Mono"; at: 13, 10; anchor: center center; size: 14; color: ink_c }
                text "󰅂" { family: "JetBrainsMono Nerd Font Mono"; at: 75, 10; anchor: center center; size: 14; color: ink_c }
                text "{w.si} / {w.sn}" { at: 44, 10; anchor: center center; size: t_cap; weight: 600; color: ink_c }
                zone box pg_hit { from: 0, 0; size: 88, 20; corner: control_r_large; cursor: pointer; label: "Page through the stack" }
                on press pg_hit while local.x < 44 { emit w_page_prev(w.id) }
                on press pg_hit while local.x >= 44 { emit w_page_next(w.id) }
            }

            // Personal controls sit above the card's general open target.
            group {
                show: w.kind == 11 and not editing
                for t in personal_tasks {
                    zone box personal_check { from: 12, 48 + t.index * 24; size: 28, 24; cursor: pointer; label: t.title }
                    on press personal_check { emit personal_toggle(t.id) }
                    on press right personal_check { }
                }
            }

            // Timer controls are above the general open target, as are task checkboxes.
            group {
                show: w.kind == 12
                group { move: inset_panel, 112; Pill(pick(tw_state, "Start", "Pause", "Resume", "Start again"), 154, tw_primary, 1, control_h, false, not editing and tw_ready, ui_accent_c: accent_c, ui_danger_c: danger_c, ui_ink_c: ink_c, ui_item_bg: item_bg, ui_on_accent: on_accent) }
                group { move: 190, 112; Pill(if(tw_state == 3, "Dismiss", "Cancel"), 126, tw_cancel, 0, control_h, false, not editing and tw_ready and tw_state > 0, ui_accent_c: accent_c, ui_danger_c: danger_c, ui_ink_c: ink_c, ui_item_bg: item_bg, ui_on_accent: on_accent) }
            }

            //  ── edit chrome ──
            group {
                show: editing
                box { from: 0, 0; size: cw, ch; corner: radius_window; stroke: 2; color: accent_c; opacity: 85% }
                //  selected: the card whose options the widget bar shows
                box { from: -3, -3; size: cw + 6, ch + 6; corner: radius_window + 3; stroke: 3; color: accent_c; show: sel_id == w.id }
                //  position lock
                group {
                    show: w.locked == 1
                    ellipse { at: cw - 4, 4; radius: 12; color: warn_c }
                    Sym("󰌾", cw - 4, 4, 13, on_accent)
                }
                //  remove
                ellipse { at: 4, 4; radius: 12; color: danger_c }
                Sym("󰅖", 4, 4, 13, on_accent)
                zone box rm_hit { from: -10, -10; size: 28, 28; corner: radius_card; cursor: pointer }
                on press rm_hit { emit w_remove(w.id) }
                on press right rm_hit { }
                //  unstack (stack faces only): breaks the whole stack apart
                group {
                    show: w.sn > 1 and w.locked == 0
                    ellipse { at: 4, ch - 4; radius: 12; color: accent_c }
                    Sym("󰌨", 4, ch - 4, 13, on_accent)
                    zone box un_hit { from: -10, ch - 18; size: 28, 28; corner: radius_card; cursor: pointer; label: "Unstack" }
                    on press un_hit { emit w_unstack(w.id) }
                }
                //  size
                ellipse { at: cw - 4, ch - 4; radius: 13; color: accent_c }
                Sym("󰩨", cw - 4, ch - 4, 14, on_accent)
                zone box rs_hit { from: cw - 20, ch - 20; size: 32, 32; corner: radius_card; cursor: pointer }
                on press rs_hit { emit w_resize(w.id) }
                on press right rs_hit { }
            }
        }
    }

    component NoteFace(cw: number, ch: number) {
        Sym("󰎞", 24, 26, 20, accent_c)
        text "Notes" { at: 44, 26; anchor: left center; size: ts_body; weight: 600; color: ink_c }
        text personal_note { at: inset_panel, 50; width: cw - inset_panel * 2; lines: if(ch > 160, 12, 4); size: ts_body; color: ink_c }
    }
    component TasksFace(cw: number, ch: number) {
        Sym("󰄱", 24, 26, 20, accent_c)
        text "To-dos" { at: 44, 26; anchor: left center; size: ts_body; weight: 600; color: ink_c }
        text personal_count { at: cw - 20, 26; anchor: right center; size: ts_cap; color: ink_sub }
        for t in personal_tasks {
            Sym("󰄱", 26, 60 + t.index * 24, 17, ink_sub)
            text t.title { at: 44, 60 + t.index * 24; anchor: left center; width: cw - 64; lines: 1; size: ts_sub; color: ink_c }
        }
        text "Click to open your checklist" { at: inset_panel, 64; width: cw - inset_panel * 2; size: ts_sub; color: ink_sub; show: personal_tasks.count == 0 }
    }

    // ── faces: each draws inside a cw × ch card ──
    component ClockFace(cw: number, ch: number, sz: number, c: record) {
        //  c.tm / c.ap / c.dl / c.dd / c.sec: THIS card's time, mark, date line and options (seconds shrink the digits to fit)
        text c.tm { at: cw / 2, ch / 2 - pick(sz, 6, 10, 34); anchor: center center; size: pick(sz, 31, 58, 76) - c.sec * pick(sz, 5, 8, 14); weight: 300; color: ink_c }
        text c.ap { at: cw / 2, ch / 2 + pick(sz, 22, 30, 38); anchor: center center; size: pick(sz, 12, 15, 18); weight: 600; color: accent_c }
        group {
            show: c.dd == 1
            text c.dl { at: cw / 2, ch / 2 + pick(sz, 40, 52, 78); anchor: center center; size: pick(sz, 11, 14, 16); color: ink_sub }
        }
    }

    component DateFace(cw: number, ch: number, sz: number) {
        text w_month { at: inset_panel, 22; anchor: left center; size: ts_body; weight: 700; color: danger_c }
        text w_day { at: inset_panel, ch / 2 + 10; anchor: left center; size: 74; weight: 300; color: ink_c }
        text w_dow { at: 22, ch - 20; anchor: left center; size: 14; weight: 500; color: ink_sub }
    }

    component WeatherFace(cw: number, ch: number, sz: number) {
        text weather_icon { family: "JetBrainsMono Nerd Font Mono"; at: 22, 40; anchor: left center; size: pick(sz, 30, 36, 44); color: warn_c }
        text weather_temp { at: 22, ch - 52; anchor: left center; size: pick(sz, 34, 38, 52); weight: 300; color: ink_c }
        text weather_cond { at: 22, ch - 24; width: cw - 44; lines: 1; anchor: left center; size: ts_body; weight: 500; color: ink_c }
        text "Cached" { at: cw - 22, if(sz > 0, 76, 26); anchor: right center; size: ts_cap; color: ink_sub; show: weather_cached }
        group {
            show: sz > 0
            text weather_city { at: cw - 22, 26; anchor: right center; size: ts_sub; weight: 600; color: ink_sub }
            text weather_range { at: cw - 22, 52; anchor: right center; size: ts_sub; color: ink_sub }
        }
    }

    component BatteryFace(cw: number, ch: number, sz: number) {
        let c = if(bat.charging, ok_c, if(bat.percent < 20, danger_c, accent_c))
        let cx = if(sz == 0, cw / 2, 80)
        let cy = ch / 2
        group {
            show: bat.present
            ellipse { at: cx, cy; radius: 52; stroke: 9; color: ink_c; opacity: 12% }
            arc { at: cx, cy; radius: 52; span: bat.percent * 3.6deg; rotate: bat.percent * 1.8deg; width: 9; color: c }
            text "{bat.percent}%" { at: cx, cy - 2; anchor: center center; size: 24; weight: 600; color: ink_c }
            text if(bat.charging, "󱐋", "") { family: "JetBrainsMono Nerd Font Mono"; at: cx, cy + 22; anchor: center center; size: 14; color: ok_c }
        }
        group {
            show: not bat.present
            Sym("󰂄", cw / 2, ch / 2 - 10, 38, ink_sub)
            text "AC power" { at: cw / 2, ch / 2 + 26; anchor: center center; size: ts_body; color: ink_sub }
        }
        group {
            show: sz > 0 and bat.present
            text "Battery" { at: 160, cy - 14; anchor: left center; size: 16; weight: 600; color: ink_c }
            text if(bat.charging, "Charging", "On battery") { at: 160, cy + 10; anchor: left center; size: ts_body; color: ink_sub }
        }
    }

    component SystemFace(cw: number, ch: number, sz: number) {
        text "󰍹  System" { family: "JetBrainsMono Nerd Font Mono"; at: inset_panel, 24; anchor: left center; size: font_body; weight: 600; color: ink_sub }
        group {
            move: 0, 0
            text "CPU" { at: inset_panel, 54; anchor: left center; size: ts_cap; weight: 600; color: ink_c }
            text "{cpu_pct}%" { at: cw - 20, 54; anchor: right center; size: t_cap; weight: 600; color: accent_c }
            box { from: inset_panel, 66; size: cw - inset_panel * 2, 6; corner: 3; color: item_solid }
            box { from: inset_panel, 66; size: max((cw - inset_panel * 2) * cpu_pct / 100, 6), 6; corner: 3; color: accent_c }
            text "Memory" { at: inset_panel, 90; anchor: left center; size: ts_cap; weight: 600; color: ink_c }
            text "{mem_pct}%" { at: cw - 20, 90; anchor: right center; size: t_cap; weight: 600; color: ok_c }
            box { from: inset_panel, 102; size: cw - inset_panel * 2, 6; corner: 3; color: item_solid }
            box { from: inset_panel, 102; size: max((cw - inset_panel * 2) * mem_pct / 100, 6), 6; corner: 3; color: ok_c }
        }
        group {
            show: sz > 0 or ch > 150
            text "Disk" { at: inset_panel, 126; anchor: left center; size: ts_cap; weight: 600; color: ink_c }
            text "{disk_pct}%" { at: cw - 20, 126; anchor: right center; size: t_cap; weight: 600; color: focus_c }
            box { from: inset_panel, 138; size: cw - inset_panel * 2, 6; corner: 3; color: item_solid }
            box { from: inset_panel, 138; size: max((cw - inset_panel * 2) * disk_pct / 100, 6), 6; corner: 3; color: focus_c }
        }
        group {
            show: sz == 2
            text "Uptime" { at: inset_panel, 190; anchor: left center; size: ts_sub; color: ink_sub }
            text up_text { at: cw - 20, 190; anchor: right center; size: ts_sub; weight: 600; color: ink_c }
        }
    }

    component MediaFace(cw: number, ch: number, sz: number) {
        group {
            show: has_player
            clip box { from: 18, 18; size: 96, 96; corner: r_l }
            image cover { at: -20.5, 17; size: 173, 98 }
            text track_title { at: 130, 44; anchor: left center; size: ts_title; weight: 600; color: ink_c; width: cw - 150 }
            text track_artist { at: 130, 66; anchor: left center; size: ts_sub; color: ink_sub; width: cw - 150 }
            group { move: 134, 96; IconButton("󰒮", "Previous track", w_prev, ink_c, item_solid, icon_button_large, icon_button_large, 20, control_r_large, 0, enabled: not editing) }
            group { move: 182, 94; IconButton(if(is_playing, "󰏤", "󰐊"), "Play or pause", w_play, ink_c, item_solid, icon_button_large, icon_button_large, 26, control_r_large, 0, enabled: not editing) }
            group { move: 234, 96; IconButton("󰒭", "Next track", w_next, ink_c, item_solid, icon_button_large, icon_button_large, 20, control_r_large, 0, enabled: not editing) }
        }
        group {
            show: not has_player
            Sym("󰎆", cw / 2, ch / 2 - 10, 38, ink_sub)
            text "Nothing playing" { at: cw / 2, ch / 2 + 26; anchor: center center; size: ts_body; color: ink_sub }
        }
    }

    component DayFace(cw: number, ch: number, sz: number) {
        text "󰔟  Today" { family: "JetBrainsMono Nerd Font Mono"; at: inset_panel, 24; anchor: left center; size: font_body; weight: 600; color: ink_sub }
        text "{day_pct}%" { at: inset_panel, ch / 2 + 2; anchor: left center; size: pick(sz, 40, 54, 54); weight: 300; color: ink_c }
        text day_left { at: inset_panel, ch - 46; anchor: left center; size: ts_sub; color: ink_sub }
        box { from: inset_panel, ch - 26; size: cw - inset_panel * 2, 8; corner: 4; color: item_solid }
        box { from: inset_panel, ch - 26; size: max((cw - inset_panel * 2) * day_pct / 100, 8), 8; corner: 4; color: warn_c }
    }

    component ControlsFace(cw: number, ch: number, sz: number) {
        Sym("󰕾", control_h, 54, icon_size, ink_c)
        group {
            move: 52, 49
            Slider(cw - 76, if(sound.muted, 0, sound.volume), w_vol, accent_c, 10, 0, ui_slider_bg: item_solid, enabled: not editing, ui_track_op: 1)
        }
        Sym("󰃟", control_h, 108, icon_size, ink_c)
        group {
            move: 52, 103
            Slider(cw - 76, display.level, w_bri, warn_c, 10, 0.05, ui_slider_bg: item_solid, enabled: not editing, ui_track_op: 1)
        }
    }

    component TimerFace(cw: number, ch: number) {
        text "󰔛  Timer" { family: "JetBrainsMono Nerd Font Mono"; at: inset_panel, 24; anchor: left center; size: font_body; weight: 600; color: ink_sub }
        // Large countdown is intentional widget feature geometry.
        text tw_time { at: inset_panel, 66; anchor: left center; size: 36; weight: 300; color: ink_c }
        text tw_status { at: cw - inset_panel, 64; anchor: right center; size: ts_cap; color: ink_sub; width: 112; align: right; lines: 2 }
        box { from: inset_panel, 96; size: cw - inset_panel * 2, 4; corner: 2; color: item_solid }
        box { from: inset_panel, 96; size: (cw - inset_panel * 2) * tw_progress, 4; corner: 2; color: accent_c }
    }

    component CalFace(cw: number, ch: number, sz: number) {
        text cal_title { at: 24, 30; anchor: left center; size: 17; weight: 700; color: ink_c }
        group {
            move: 6.3, 58
            for month in cal_month { MonthGrid(month, 303.8, 38, ink_c, ink_sub, accent_c, on_accent, true, t_body, t_cap) }
        }
    }

    Desk()
}
