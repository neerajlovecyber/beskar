// iNiR Floating Bottom Glass Dock
import "common/palette.plm"

scene MacDock {
    surface {
        size: 460, 64
        anchor: bottom
        margin: 0, 0, 16, 0
        screens: each
    }

    permissions {
        services: "say:settings"
        run: "nautilus", "thunar", "dolphin", "firefox", "chromium", "kitty", "alacritty", "foot", "code", "zed", "gnome-control-center", "discord", "telegram-desktop"
    }

    fact dark_mode = true
    fact skin = 0

    let dock_color = if(dark_mode, #121018, #f5f3fa)
    let dock_glass = 75%
    let dock_tint = 35%
    let stroke_c = if(dark_mode, #9d7cd8, #7f52ff)
    let stroke_op = if(dark_mode, 65%, 45%)
    let dot_color = if(dark_mode, #f5f7f5, #1d1d1f)

    event launch ->

    image icon_term     = icon "utilities-terminal", 36, 36
    image icon_files    = icon "system-file-manager", 36, 36
    image icon_code     = icon "code", 36, 36
    image icon_steam    = icon "steam", 36, 36
    image icon_obsidian = icon "obsidian", 36, 36
    image icon_browser  = icon "firefox", 36, 36
    image icon_discord  = icon "discord", 36, 36
    image icon_telegram = icon "telegram", 36, 36

    // Floating Glass Pill Body
    body {
        color: dock_color
        glass: dock_glass
        lens: false
        frost: 100%
        tint: dock_tint
        shadow: 0, 8, 24, 30%
        rim: 0%

        box dock_pill {
            from: 10, 4
            size: 440, 56
            corner: 28
        }
    }

    // Specular Perimeter Stroke
    box {
        from: 10, 4
        size: 440, 56
        corner: 28
        stroke: 1.5
        color: stroke_c
        opacity: stroke_op
    }

    // Centered Dock Icons Row
    row {
        at: 230, 32
        anchor: center
        gap: 12
        align: center

        // 1. Terminal
        group {
            size: 38, 44
            image icon_term { at: 1, 2; size: 36, 36 }
            ellipse { at: 19, 42; radius: 1.5; color: stroke_c; opacity: 90% }
            zone box hit1 { from: 0, 0; size: 38, 44; cursor: pointer }
            on press hit1 { emit launch(1) }
        }

        // 2. Files
        group {
            size: 38, 44
            image icon_files { at: 1, 2; size: 36, 36 }
            ellipse { at: 19, 42; radius: 1.5; color: dot_color; opacity: 80% }
            zone box hit2 { from: 0, 0; size: 38, 44; cursor: pointer }
            on press hit2 { emit launch(2) }
        }

        // 3. Code Editor
        group {
            size: 38, 44
            image icon_code { at: 1, 2; size: 36, 36 }
            ellipse { at: 19, 42; radius: 1.5; color: dot_color; opacity: 80% }
            zone box hit3 { from: 0, 0; size: 38, 44; cursor: pointer }
            on press hit3 { emit launch(3) }
        }

        // 4. Steam
        group {
            size: 38, 44
            image icon_steam { at: 1, 2; size: 36, 36 }
            zone box hit4 { from: 0, 0; size: 38, 44; cursor: pointer }
            on press hit4 { emit launch(4) }
        }

        // 5. Obsidian / Notes
        group {
            size: 38, 44
            image icon_obsidian { at: 1, 2; size: 36, 36 }
            zone box hit5 { from: 0, 0; size: 38, 44; cursor: pointer }
            on press hit5 { emit launch(5) }
        }

        // 6. Browser
        group {
            size: 38, 44
            image icon_browser { at: 1, 2; size: 36, 36 }
            ellipse { at: 19, 42; radius: 1.5; color: dot_color; opacity: 80% }
            zone box hit6 { from: 0, 0; size: 38, 44; cursor: pointer }
            on press hit6 { emit launch(6) }
        }

        // 7. Discord
        group {
            size: 38, 44
            image icon_discord { at: 1, 2; size: 36, 36 }
            zone box hit7 { from: 0, 0; size: 38, 44; cursor: pointer }
            on press hit7 { emit launch(7) }
        }

        // 8. Telegram
        group {
            size: 38, 44
            image icon_telegram { at: 1, 2; size: 36, 36 }
            zone box hit8 { from: 0, 0; size: 38, 44; cursor: pointer }
            on press hit8 { emit launch(8) }
        }
    }
}
