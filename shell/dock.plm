// macOS Bottom Dock for Wayland Compositors
import "common/palette.plm"

scene MacDock {
    surface {
        size: 560, 80
        anchor: bottom
        margin: 0
        screens: each
    }

    permissions {
        services: "say:settings"
        run: "nautilus", "thunar", "dolphin", "firefox", "chromium", "kitty", "alacritty", "foot", "code", "zed", "gnome-control-center"
    }

    fact dark_mode = true
    fact skin = 0

    let dock_color = if(dark_mode, if(skin == 2, #1e2026, if(skin == 1, #1c1e28, #161820)), if(skin == 2, #f2f3f7, if(skin == 1, #eaecf2, #f8f9fc)))
    let dock_glass = if(skin == 2, 0%, if(skin == 1, 55%, 75%))
    let dock_tint = if(skin == 2, 0%, if(dark_mode, 35%, 20%))
    let dock_rim = if(skin == 2, 0%, 14%)
    let dock_shadow = if(dark_mode, 35%, 15%)
    let stroke_c = if(dark_mode, #b4a8ff, #7f52ff)
    let stroke_op = if(dark_mode, 25%, 15%)
    let dot_color = if(dark_mode, #f5f7f5, #1d1d1f)
    let div_color = if(dark_mode, #ffffff, #000000)
    let div_op = if(dark_mode, 16%, 12%)

    event launch ->

    image icon_files    = icon "system-file-manager", 44, 44
    image icon_browser  = icon "firefox", 44, 44
    image icon_terminal = icon "utilities-terminal", 44, 44
    image icon_editor   = icon "code", 44, 44
    image icon_music    = icon "org.gnome.Music", 44, 44
    image icon_settings = icon "preferences-system", 44, 44
    image icon_trash    = icon "user-trash", 44, 44

    // Safe Background Zone (absorbs right-clicks)
    zone box dock_bg { from: 40, 8; size: 480, 72 }
    on press right dock_bg { }

    // Flared Concave Dock Silhouette (iNiR bottom bar)
    body {
        color: dock_color
        glass: dock_glass
        lens: false
        frost: 100%
        dispersion: 0
        refraction: 0
        tint: dock_tint
        shadow: 0, -4, 20, dock_shadow
        rim: dock_rim

        // Base bottom anchor strip extending to screen edge
        box base_strip { from: 0, 74; size: 560, 16 }

        // Protruding Center Dock with smooth blend into the base strip
        box center_dock {
            from: 45, 12
            size: 470, 68
            corner: 20
            blend: 16
        }
    }
    box { from: 60, 12; size: 440, 1; color: stroke_c; opacity: stroke_op }

    // Dock Items
    row {
        at: 54, 22
        gap: 10
        align: center

        // 1. Files / Finder
        group {
            size: 50, 56
            prop hot1 = 0 ~quick
            prop scale1 = 1.0 ~quick
            follow scale1 = 1.0 + hot1 * 0.28
            group {
                pivot: 25, 25; scale: scale1
                image icon_files { at: 3, 3; size: 44, 44 }
            }
            ellipse { at: 25, 52; radius: 2; color: dot_color; opacity: 75% }
            zone box hit1 { from: 0, 0; size: 50, 56; cursor: pointer }
            on enter hit1 { hot1: 1 }
            on leave hit1 { hot1: 0 }
            on press hit1 { emit launch(1) }
        }

        // 2. Browser
        group {
            size: 50, 56
            prop hot2 = 0 ~quick
            prop scale2 = 1.0 ~quick
            follow scale2 = 1.0 + hot2 * 0.28
            group {
                pivot: 25, 25; scale: scale2
                image icon_browser { at: 3, 3; size: 44, 44 }
            }
            ellipse { at: 25, 52; radius: 2; color: dot_color; opacity: 75% }
            zone box hit2 { from: 0, 0; size: 50, 56; cursor: pointer }
            on enter hit2 { hot2: 1 }
            on leave hit2 { hot2: 0 }
            on press hit2 { emit launch(2) }
        }

        // 3. Terminal
        group {
            size: 50, 56
            prop hot3 = 0 ~quick
            prop scale3 = 1.0 ~quick
            follow scale3 = 1.0 + hot3 * 0.28
            group {
                pivot: 25, 25; scale: scale3
                image icon_terminal { at: 3, 3; size: 44, 44 }
            }
            ellipse { at: 25, 52; radius: 2; color: dot_color; opacity: 75% }
            zone box hit3 { from: 0, 0; size: 50, 56; cursor: pointer }
            on enter hit3 { hot3: 1 }
            on leave hit3 { hot3: 0 }
            on press hit3 { emit launch(3) }
        }

        // 4. Code Editor
        group {
            size: 50, 56
            prop hot4 = 0 ~quick
            prop scale4 = 1.0 ~quick
            follow scale4 = 1.0 + hot4 * 0.28
            group {
                pivot: 25, 25; scale: scale4
                image icon_editor { at: 3, 3; size: 44, 44 }
            }
            zone box hit4 { from: 0, 0; size: 50, 56; cursor: pointer }
            on enter hit4 { hot4: 1 }
            on leave hit4 { hot4: 0 }
            on press hit4 { emit launch(4) }
        }

        // 5. Music
        group {
            size: 50, 56
            prop hot5 = 0 ~quick
            prop scale5 = 1.0 ~quick
            follow scale5 = 1.0 + hot5 * 0.28
            group {
                pivot: 25, 25; scale: scale5
                image icon_music { at: 3, 3; size: 44, 44 }
            }
            zone box hit5 { from: 0, 0; size: 50, 56; cursor: pointer }
            on enter hit5 { hot5: 1 }
            on leave hit5 { hot5: 0 }
            on press hit5 { emit launch(5) }
        }

        // 6. System Settings
        group {
            size: 50, 56
            prop hot6 = 0 ~quick
            prop scale6 = 1.0 ~quick
            follow scale6 = 1.0 + hot6 * 0.28
            group {
                pivot: 25, 25; scale: scale6
                image icon_settings { at: 3, 3; size: 44, 44 }
            }
            zone box hit6 { from: 0, 0; size: 50, 56; cursor: pointer }
            on enter hit6 { hot6: 1 }
            on leave hit6 { hot6: 0 }
            on press hit6 { emit launch(6) }
        }

        // Dock Divider
        box { size: 1, 38; color: div_color; opacity: div_op }

        // 7. Trash
        group {
            size: 50, 56
            prop hot7 = 0 ~quick
            prop scale7 = 1.0 ~quick
            follow scale7 = 1.0 + hot7 * 0.28
            group {
                pivot: 25, 25; scale: scale7
                image icon_trash { at: 3, 3; size: 44, 44 }
            }
            zone box hit7 { from: 0, 0; size: 50, 56; cursor: pointer }
            on enter hit7 { hot7: 1 }
            on leave hit7 { hot7: 0 }
            on press hit7 { emit launch(7) }
        }
    }
}
