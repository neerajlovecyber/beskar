// macOS Spotlight Search for Wayland Compositors
import "common/palette.plm"

scene MacSpotlight {
    let mp_sw = 680
    let mp_sh = 520
    include "common/theme.plm"
    include "common/morph_core.plm"
    surface sheet {
        size: 680, 520
        anchor: bottom
        margin: 0, 0, 0, 0
        level: overlay
        keyboard: exclusive while open
        screens: each
        open: (open or seen > 0.02) and open_screen == screen.index

    zone box dismiss { from: 0, 0; size: 680, 520; active: open }

    group {
        move: 20, 520 - ph
        opacity: mp_fade

        // Results List
        column list ~quick {
            at: 32, 14
            gap: 2
            for h in hits { Row(h) }
        }

        // Separator Line
        box { from: 28, ph - 74; size: 584, 1; color: line_color; opacity: line_op }

        // Spotlight Magnifying Glass & Search Field
        text "󰍉" { at: 46, ph - 38; anchor: center; size: 19; color: ink_c; opacity: 60% }
        input query {
            at: 68, ph - 50
            width: 530
            size: 19
            color: ink_c
            placeholder: "Spotlight Search"
            selection: accent_c
        }
    }
        on press dismiss { open = false }
    }

    permissions {
        services: "apps", "apps.launch", "say:clipboard", "say:music", "say:control_center", "say:notifications", "say:dashboard", "say:settings", "say:wallpapers", "say:topbar"
    }

    let line_color = card_stroke
    let line_op = card_stroke_op

    model hits max 7 { name: text; icon: image 26, 26 }
    fact sel   = 0
    text query = ""
    event toggle
    event launch ->

    //  The glass is drawn by the frame: the dock island grows UP into it (topbar.plm). This scene only draws the
    //  content, anchored to the bottom: the results above, the search field at the bottom where the dock was.


    component Row(h: record) {
        size: 576, 42
        prop on = 0 ~quick
        follow on = if(sel == h.index, 1, 0)

        box hit {
            from: 0, 0
            size: 576, 42
            corner: 12
            color: accent_c
            opacity: on * 22%
            cursor: pointer
        }

        // Blue selection pill bar on left
        box { from: 0, 11; size: 3, 20; corner: 1.5; color: accent_c; opacity: on }

        image h.icon { at: 16, 8; size: 26, 26 }
        text h.name {
            at: 54, 21
            anchor: left center
            size: 15
            width: 500
            lines: 1
            color: ink_c
            opacity: 65% + on * 35%
        }

        on enter hit { sel = h.index }
        on press hit { emit launch(h.index) }
    }

    on toggle          { toggle open; focus query }
    on key Escape      { open = false }
    on blur            { open = false }
    on key Down        { sel = min(sel + 1, max(hits.count - 1, 0)) }
    on key Up          { sel = max(sel - 1, 0) }
    on submit query    { emit launch(sel) }
}
