// macOS Spotlight Search for Wayland Compositors
import "common/palette.plm"

scene MacSpotlight {
    let mp_sw = 680
    let mp_sh = 520
    include "common/theme.plm"
    include "common/ui.plm"
    include "common/morph_core.plm"
    surface sheet {
        size: 680, 520
        anchor: bottom
        margin: 0, 0, 0, 0
        level: overlay
        keyboard: exclusive while open
        screens: each
        open: (open or seen > 0.02) and open_screen == screen.index

    zone box dismiss { from: 0, 0; size: 680, 520; active: open }

    PanelBody(20, 520, 1) {

        // Results List
        //  seven rows are seen; more results scroll (wheel, or the arrow keys carry the selection)
        group {
            clip box { from: 20, 10; size: 600, 314; corner: 8 }     // ends with this group: the search field below is not clipped
            column list {
                at: 32, 14 - sc
                gap: 2
                for h in hits { Row(h) }
            }
        }
        zone box list_wheel { from: 20, 10; size: 600, 314; active: hits.count > 7 }
        on scroll list_wheel { sc_t = clamp(sc_t - wheel * 44, 0, max(0, hits.count * 44 - 308)) }
        group { move: 614, 14; ScrollBar(sc, hits.count * 44 - 2, 306) }

        PanelSearch(640, ph)
        input query {
            at: 68, ph - 50
            width: 530
            size: 19
            color: ink_c
            placeholder: "Spotlight Search"
            selection: accent_c
        }
    }
        on press dismiss { open = false }
    }

    permissions {
        run: "xdg-open", "wl-copy", "systemctl suspend"
        services: "apps", "apps.launch", "say:lock", "say:session", "say:capture", "say:clipboard", "say:music", "say:control_center", "say:notifications", "say:dashboard", "say:settings", "say:wallpapers", "say:widget_bar", "say:widgets", "say:topbar"
    }

    let line_color = card_stroke
    let line_op = card_stroke_op

    //  the logos of the web searches (Google, YouTube, GitHub, Wikipedia, DuckDuckGo, Maps), picked by `site` 1..6
    image logo_g = file "../assets/icons/web/google.svg", 26, 26
    image logo_yt = file "../assets/icons/web/youtube.svg", 26, 26
    image logo_gh = file "../assets/icons/web/github.svg", 26, 26
    image logo_w = file "../assets/icons/web/wikipedia.svg", 26, 26
    image logo_ddg = file "../assets/icons/web/duckduckgo.svg", 26, 26
    image logo_maps = file "../assets/icons/web/maps.svg", 26, 26

    model hits max 24 { name: text; sub: text; kind: number; site: number; glyph: text; icon: image 26, 26 }
    fact sel   = 0
    fact sc_t  = 0                 // where the result list is scrolled to (px)
    prop sc = 0 ~quick
    follow sc = sc_t
    text query = ""
    event toggle
    event launch ->

    //  The glass is drawn by the frame: the dock island grows UP into it (topbar.plm). This scene only draws the
    //  content, anchored to the bottom: the results above, the search field at the bottom where the dock was.


    component Row(h: record) {
        size: 576, 42
        prop on = 0 ~quick
        follow on = if(sel == h.index, 1, 0)

        box hit {
            from: 0, 0
            size: 576, 42
            corner: 12
            color: accent_c
            opacity: on * 22%
            cursor: pointer
        }

        // Blue selection pill bar on left
        box { from: 0, 11; size: 3, 20; corner: 1.5; color: accent_c; opacity: on }

        image h.icon { at: 16, 8; size: 26, 26; show: h.kind == 0 }
        group {
            show: h.kind == 2 and h.site > 0
            image logo_g { at: 16, 8; size: 26, 26; show: h.site == 1 }
            image logo_yt { at: 16, 8; size: 26, 26; show: h.site == 2 }
            image logo_gh { at: 16, 8; size: 26, 26; show: h.site == 3 }
            image logo_w { at: 16, 8; size: 26, 26; show: h.site == 4 }
            image logo_ddg { at: 16, 8; size: 26, 26; show: h.site == 5 }
            image logo_maps { at: 16, 8; size: 26, 26; show: h.site == 6 }
        }
        group {
            show: h.kind != 0 and not (h.kind == 2 and h.site > 0)
            ellipse { at: 29, 21; radius: 13; color: accent_c; opacity: 85% }
            text h.glyph { family: "JetBrainsMono Nerd Font Mono"; at: 29, 21; anchor: center; size: 14; color: #ffffff }
        }
        text h.sub { at: 560, 21; anchor: right center; size: 11.5; color: ink_sub; width: 200; lines: 1; align: right }
        text h.name {
            at: 54, 21
            anchor: left center
            size: if(h.kind == 1, 19, 15)
            weight: if(h.kind == 1, 700, 400)
            width: 360
            lines: 1
            color: ink_c
            opacity: 65% + on * 35%
        }

        on enter hit { sel = h.index }
        on press hit { emit launch(h.index) }
    }

    on toggle          { toggle open; focus query }
    on key Escape      { open = false }
    on blur            { open = false }
    on key Down        { sel = min(sel + 1, max(hits.count - 1, 0)); sc_t = clamp(sc_t, (min(sel + 1, max(hits.count - 1, 0)) - 6) * 44, min(sel + 1, max(hits.count - 1, 0)) * 44) }
    on key Up          { sel = max(sel - 1, 0); sc_t = clamp(sc_t, (max(sel - 1, 0) - 6) * 44, max(sel - 1, 0) * 44) }
    on change sel while sel == 0 { sc_t = 0 }
    on submit query    { emit launch(sel) }
}
