// macOS Spotlight Search for Wayland Compositors
import "common/palette.plm"

scene MacSpotlight {
    include "common/theme.plm"
    surface {
        size: 680, 500
        anchor: center
        level: overlay
        keyboard: exclusive while open
    }

    permissions {
        services: "apps", "apps.launch", "say:clipboard", "say:control_center", "say:notifications", "say:dashboard", "say:settings", "say:wallpapers", "say:topbar"
    }

    fact open  = false

    let spot_color = bg_color
    let spot_glass = glass_amt
    let spot_tint = tint_amt
    let spot_rim = rim_amt
    let spot_shadow = 0%
    let line_color = card_stroke
    let line_op = card_stroke_op

    model hits max 7 { name: text; icon: image 26, 26 }
    fact sel   = 0
    text query = ""
    event toggle
    event launch ->

    prop seen  = 0 ~quick
    prop scale = 0.95 ~lively
    prop tall  = 76 ~quick
    follow tall = 76 + list.height

    layer panel ~quick {
        shown while open { seen: 1 ~quick; scale: 1 ~lively }
        gone             { seen: 0 ~quick; scale: 0.95 ~quick }
    }

    // Click outside to dismiss
    zone box dismiss { from: 0, 0; size: 680, 500; active: open }
    on press dismiss { open = false }
    on press right dismiss { }

    group {
        pivot: 340, 40
        scale: scale
        opacity: seen

        // Window Frame
        body {
            color: spot_color
            glass: spot_glass
            lens: false
            frost: 100%
            dispersion: 35%
            refraction: 75%
            shine: pointer
            tint: spot_tint
            rim: spot_rim
            box { from: 40, 24; size: 600, tall; corner: 22 }
        }

        // Spotlight Magnifying Glass & Search Field
        text "󰍉" { at: 62, 52; anchor: center; size: 19; color: ink_c; opacity: 60% }
        input query {
            at: 84, 42
            width: 530
            size: 19
            color: ink_c
            placeholder: "Spotlight Search"
            selection: accent_c
        }

        // Separator Line
        box { from: 60, 80; size: 560, 1; color: line_color; opacity: line_op }

        // Results List
        column list ~quick {
            at: 52, 90
            gap: 2
            for h in hits { Row(h) }
        }
    }

    component Row(h: record) {
        size: 576, 42
        prop on = 0 ~quick
        follow on = if(sel == h.index, 1, 0)

        box hit {
            from: 0, 0
            size: 576, 42
            corner: 12
            color: accent_c
            opacity: on * 22%
            cursor: pointer
        }

        // Blue selection pill bar on left
        box { from: 0, 11; size: 3, 20; corner: 1.5; color: accent_c; opacity: on }

        image h.icon { at: 16, 8; size: 26, 26 }
        text h.name {
            at: 54, 21
            anchor: left center
            size: 15
            width: 500
            lines: 1
            color: ink_c
            opacity: 65% + on * 35%
        }

        on enter hit { sel = h.index }
        on press hit { emit launch(h.index) }
    }

    on toggle          { toggle open; focus query }
    on key Escape      { open = false }
    on blur            { open = false }
    on key Down        { sel = min(sel + 1, max(hits.count - 1, 0)) }
    on key Up          { sel = max(sel - 1, 0) }
    on submit query    { emit launch(sel) }
}
