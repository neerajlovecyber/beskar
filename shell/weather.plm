// Weather panel: grows out of the centre island (click the weather in the clock pill). The frame draws the glass; this
// scene draws only the content: the place, now, details, the next hours, the next days; and a second view to choose
// the place (from your IP, or by searching a city). Data: Open-Meteo (no key); logic in weather.luau.
import "common/palette.plm"

scene MacWeather {
    let mp_sw = 420
    let mp_sh = 610
    include "common/theme.plm"
    include "common/icons.plm"
    include "common/ui.plm"
    include "common/morph.plm"

    surface {
        size: 420, 610
        anchor: top
        margin: 0, 0, 0, 0
        level: overlay
        keyboard: on_demand
        screens: each
    }

    permissions {
        run: "curl", "sh"
        services: "say:topbar", "say:control_center", "say:notifications", "say:dashboard", "say:settings", "say:wallpapers", "say:widget_bar", "say:spotlight", "say:clipboard", "say:music", "say:widgets"
    }

    fact view = 0              // 0 the forecast · 1 choose a place
    fact loaded = false
    fact loading = false
    fact searching = false
    fact q_has = false         // the search field has text (set by weather.luau from its text)
    fact wk_lo = 0
    fact wk_hi = 1
    text weather_city = ""
    text w_cond = ""
    text w_temp = "--°"
    text w_feels = ""
    text w_range = ""
    text w_icon = "󰅟"
    text w_hum = "--"
    text w_wind = "--"
    text w_uv = "--"
    text w_press = "--"
    text w_sunrise = "--"
    text w_sunset = "--"
    text w_source = ""
    text wq = ""

    model hours max 8 { t: text; icon: text; temp: text }
    model days max 5 { day: text; icon: text; lo: text; hi: text; lo_n: number; hi_n: number }
    model places max 5 { name: text; sub: text }

    event toggle
    event loc_change ->
    event loc_back ->
    event loc_ip ->
    event loc_pick ->
    event weather_reload ->

    on press dismiss { open = false }

    PanelBody(16, -2) {

        //  clicks on the card itself do not close it
        zone box inside { from: 0, 0; size: 388, 600 }
        on press right inside { }

        // ═══ view 0: the forecast ═══════════════════════════════════
        group {
            show: view == 0

            //  place and its button
            Sym("󰍎", 10, 22, 15, accent_c)
            text weather_city { at: 26, 22; anchor: left center; size: t_title; weight: 700; color: ink_c; width: 250; lines: 1 }
            group { move: 300, 9; Pill("Change", 88, loc_change, 0, 26, true) }
            text w_cond { at: 4, 52; anchor: left center; size: t_sub; color: ink_sub; width: 380; lines: 1 }

            //  now
            text w_temp { at: 4, 100; anchor: left center; size: 56; weight: 700; color: ink_c }
            Sym(w_icon, 340, 92, 54, accent_c)
            text w_feels { at: 4, 140; anchor: left center; size: t_sub; color: ink_sub }
            text w_range { at: 384, 140; anchor: right center; size: t_sub; weight: 600; color: ink_c }

            //  details
            group {
                move: 0, 160
                CardBg(388, 58, r_m)
                Stat(14, "Humidity", w_hum)
                Stat(112, "Wind", w_wind)
                Stat(210, "UV index", w_uv)
                Stat(300, "Pressure", w_press)
            }
            group {
                move: 0, 226
                CardBg(388, 42, r_m)
                Sym("󰖜", 22, 21, 16, warn_c)
                text "Sunrise" { at: 40, 21; anchor: left center; size: t_cap; color: ink_sub }
                text w_sunrise { at: 92, 21; anchor: left center; size: t_sub; weight: 600; color: ink_c }
                Sym("󰖛", 220, 21, 16, accent_c)
                text "Sunset" { at: 238, 21; anchor: left center; size: t_cap; color: ink_sub }
                text w_sunset { at: 288, 21; anchor: left center; size: t_sub; weight: 600; color: ink_c }
            }

            //  next hours
            SectionLabel(4, 288, "NEXT HOURS")
            group {
                move: 0, 300
                CardBg(388, 96, r_m)
                row {
                    at: 2, 0
                    for h in hours {
                        group {
                            size: 48.5, 96
                            text h.t { at: 24, 16; anchor: center center; size: t_micro; color: ink_sub }
                            Sym(h.icon, 24, 48, 20, accent_c)
                            text h.temp { at: 24, 78; anchor: center center; size: t_sub; weight: 600; color: ink_c }
                        }
                    }
                }
            }

            //  next days
            SectionLabel(4, 414, "NEXT DAYS")
            group {
                move: 0, 426
                CardBg(388, 176, r_m)
                column {
                    at: 0, 4
                    for d in days {
                        group {
                            size: 388, 34
                            text d.day { at: 16, 17; anchor: left center; size: t_body; weight: 600; color: ink_c }
                            Sym(d.icon, 100, 17, 17, accent_c)
                            text d.lo { at: 146, 17; anchor: right center; size: t_sub; color: ink_sub }
                            box { from: 158, 15; size: 168, 4; corner: 2; color: ink_c; opacity: 12% }
                            box { from: 158 + 168 * (d.lo_n - wk_lo) / max(1, wk_hi - wk_lo), 15; size: max(8, 168 * (d.hi_n - d.lo_n) / max(1, wk_hi - wk_lo)), 4; corner: 2; color: accent_c }
                            text d.hi { at: 372, 17; anchor: right center; size: t_sub; weight: 600; color: ink_c }
                        }
                    }
                }
            }

            //  nothing yet
            group { show: not loaded; EmptyState(194, 300, "󰅟", "Loading the forecast", "Needs a network connection") }
        }

        // ═══ view 1: choose a place ═════════════════════════════════
        group {
            show: view == 1

            text "Choose a location" { at: 4, 22; anchor: left center; size: t_title; weight: 700; color: ink_c }
            group { move: 300, 9; Pill("Back", 88, loc_back, 0, 26, true) }

            //  your IP
            group { move: 0, 46; Pill("󰩟  Use my location (from my IP address)", 388, loc_ip, 1, 34, true) }

            //  search
            group {
                move: 0, 94
                CardBg(388, 40, r_m, true)
                Sym("󰍉", 22, 20, 16, ink_sub)
                input wq {
                    at: 44, 10
                    width: 330
                    size: 15
                    color: ink_c
                    placeholder: "Search a city"
                    selection: accent_c
                }
            }

            //  results
            column {
                at: 0, 146
                gap: 4
                for p in places {
                    group {
                        size: 388, 44
                        prop on = 0 ~quick
                        RowFrame(388, 44, on)
                        text p.name { at: 16, 15; anchor: left center; size: t_body; weight: 600; color: ink_c; width: 350; lines: 1 }
                        text p.sub { at: 16, 32; anchor: left center; size: t_cap; color: ink_sub; width: 350; lines: 1 }
                        zone box pick_hit { from: 0, 0; size: 388, 44; corner: r_m; cursor: pointer }
                        on enter pick_hit { on: 1 }
                        on leave pick_hit { on: 0 }
                        on press pick_hit { emit loc_pick(p.index) }
                        on press right pick_hit { }
                    }
                }
            }
            group { show: places.count < 1 and not q_has; text "Type a city name, or use your IP address" { at: 194, 190; anchor: center center; size: t_sub; color: ink_sub } }
            group { show: places.count < 1 and q_has and not searching; EmptyState(194, 200, "󰍉", "No place found") }
            text w_source { at: 4, 360; anchor: left center; size: t_cap; color: ink_sub; show: places.count < 1 }
        }
    }

    //  one labelled number of the details card
    component Stat(x: number, label: text, value: text) {
        text label { at: x, 17; anchor: left center; size: t_micro; color: ink_sub }
        text value { at: x, 38; anchor: left center; size: t_body; weight: 700; color: ink_c }
    }

    on toggle     { toggle open }
    on key Escape { open = false }
}
