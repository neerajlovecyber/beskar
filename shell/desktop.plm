// The whole shell in ONE process (pleamar 0.8 `import scene`): every scene keeps its own file, logic, permissions and
// `--say` name (`--say topbar …` still reaches Topbar). Started by start.sh instead of one process per scene.
// The WALLPAPER is its own process on purpose: brought in beside the frame, pleamar treats the picture as scene content
// under the glass and repaints it (and the frame) whenever a panel morphs: 44-68 slow frames per 8 panel opens, 0 without.
// Widgets and the wallpaper are their OWN processes for the same reason: brought in beside the frame, their cards / picture count as
// scene content under the glass and are repainted with every panel morph (widgets in: 189 slow frames per 8 opens, 0 without).
// The lock screen and the on-demand capture picker stay their own processes too.
import scene "system.plm" as System       // the system services, held once
import scene "panels.plm" as Panels       // owns the shared panel state
import scene "topbar.plm" as Topbar
import scene "infopanels.plm" as Infopanels
import scene "dockpanels.plm" as Dockpanels
import scene "dialogs.plm" as Dialogs
import scene "windows.plm" as Windows
import scene "controlcenter.plm" as Controlcenter
import scene "notifications.plm" as Notifications
import scene "settings.plm" as Settings

scene Desktop { }
