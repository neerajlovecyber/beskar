                    row { at: 236, 7; gap: space_6
                        Seg("Immediate", 0, dock_show_delay, dock_show_delay_pick, 96, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
