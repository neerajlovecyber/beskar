                        gap: space_6
                        Seg("Warm", 0, nl_temp_i, nl_temp_pick, 80, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                        Seg("Warmer", 1, nl_temp_i, nl_temp_pick, 80, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                        Seg("Candle", 2, nl_temp_i, nl_temp_pick, 80, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                    }
                }
                Card(104) {
                    text "Power mode" { at: 18, 22; anchor: left center; size: ts_body; weight: 600; color: ink_c }
                    text pick(if(pp_ok, 0, 1), "Saver stretches the battery; Performance gives the processor more room", "No power-profiles-daemon here: install and start it to choose a mode") { at: 18, 42; anchor: left center; size: ts_micro; color: ink_sub; width: 520 }
                    row {
                        at: 18, 62
                        gap: space_6
                        Seg("Saver", 0, pp_i, pp_pick, 100, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                        Seg("Balanced", 1, pp_i, pp_pick, 110, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                        Seg("Performance", 2, pp_i, pp_pick, 130, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                    }
                    text pp_note { at: 400, 76; anchor: left center; size: ts_micro; color: danger_c; width: 140 }
                }
            }
            group { move: 566, 0; ScrollBar(tcol_8.scroll, tcol_8.content, 500, ui_ink_c: ink_c) }
        }

        group {
            show: not preferences_loaded
            zone box loading_block { from: 0, 0; size: 840, 580 }
            on press right loading_block { }
        }
        group {
            show: reset_review
            zone box reset_block { from: 0, 0; size: 840, 580 }
            on press right reset_block { }
            group {
                move: 254, 390
                box { from: 0, 0; size: 556, 166; corner: radius_card; color: bg_color }
                CardBg(556, 166, radius_card, true, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
                text "Restore Appearance defaults?" { at: inset_card, inset_card; size: font_title; weight: 600; color: ink_c }
                text "Dark, Liquid Glass, Blue, Tonal, no wallpaper/custom accent; standard text, full glass and system motion. Your wallpaper and app theming stay as chosen." { at: inset_card, 44; size: font_body; color: ink_sub; width: 524; lines: 3 }
                box { from: 314, 116; size: 100, control_h + space_4; corner: control_r_large; stroke: 2; color: focus_c; show: reset_sel == 0 }
                box { from: 422, 116; size: 116, control_h + space_4; corner: control_r_large; stroke: 2; color: focus_c; show: reset_sel == 1 }
                row {
                    at: 316, 118
                    gap: space_12
                    Btn("Cancel", 96, reset_appearance_cancel, false, 0, 0, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                    Btn("Restore", 112, reset_appearance_apply, true, 0, 0, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                }
            }
        }

        group {
            show: display_pending
            zone box display_block { from: 0, 0; size: 840, 580 }
            on press right display_block { }
            group {
                move: 254, 390
                box { from: 0, 0; size: 556, 166; corner: radius_card; color: bg_color }
                CardBg(556, 166, radius_card, true, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
                text "Keep this display setting?" { at: inset_card, inset_card; size: font_title; weight: 600; color: ink_c }
                text display_status { at: inset_card, 50; size: font_body; color: ink_sub; width: 524; lines: 2 }
                box { from: 302, 116; size: 112, control_h + space_4; corner: control_r_large; stroke: 2; color: focus_c; show: display_sel == 0 }
                box { from: 422, 116; size: 116, control_h + space_4; corner: control_r_large; stroke: 2; color: focus_c; show: display_sel == 1 }
                row { at: 304, 118; gap: space_12
                    Btn("Revert", 108, display_revert, false, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill, enabled: not display_busy)
                    Btn("Keep", 112, display_keep, true, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill, enabled: not display_busy)
                }
            }
        }
    }
        on press dismiss { open = false }
    on press right dismiss { }
    }

    permissions {
        services: "clock", "audio", "audio.*", "brightness", "brightness.*", "network", "network.*", "bluetooth", "bluetooth.*", "say:topbar", "say:spotlight", "say:control_center", "say:notifications", "say:dashboard", "say:clipboard", "say:music", "say:weather", "say:capture", "say:updates", "say:wallpapers", "say:widget_bar", "say:lock", "say:session", "say:appswitcher", "say:widgets", "say:wallpaper", "say:panels", "say:infopanels", "say:dockpanels", "say:dialogs", "say:windows", "say:controlcenter"
        run: "matugen", "powerprofilesctl", "magick", "gsettings", "systemctl", "loginctl", "kitty", "pacman", "yay", "paru", "sh", "niri msg"
    }


    fact open = false
    text user_name = ""
    text avatar_initial = ""
    text avatar_path = ""
    image avatar_img = from avatar_path, 36, 36
    fact has_avatar = false
    text pane_title = "Appearance"
    fact tab = 0
    fact settings_search = false
    fact settings_search_sel = 0
    fact setting_target = 0
    fact setting_reveal = 0
    fact setting_y = 0
    fact setting_h = 0
    fact reset_review = false
    fact reset_sel = 0
    fact reset_undo = false
    fact preferences_loaded = false
    fact preference_can_restore = false
    fact preference_problem = false
    text preference_status = ""
    model setting_matches max 8 { name: text; sub: text; idx: number }
    fact appearance = 1          // 0 light · 1 dark · 2 auto (by the time of day)
    fact custom_accent = -1
    text custom_accent_edit = ""
    text custom_accent_current = "Preset colour"
    text custom_accent_status = ""
    event custom_accent_apply ->
    event custom_accent_clear ->
    event style_text_pick ->
    event style_glass_pick ->
    event toggle_reduce_motion ->
    on submit custom_accent_edit { emit custom_accent_apply }

    //  the sidebar's list (filtered by the search), displays, shortcuts, sound outputs, updates
    model cats max 8 { idx: number; icon: text; tint: number; name: text; dx: number }
    model disps max 4 { name: text; title: text; mode: text; sel: bool }
    model reslist max 4 { label: text; cur: bool }
    model hzlist max 5 { label: text; cur: bool }
    model outs max 4 { name: text; def: bool }
    model binds max 9 { keys: text; what: text; origin: text }
    text about_host = "…"
    text about_up = "…"
    fact disp_scale_i = 0
    text bind_count = ""
    text side_q = ""
    text bind_q = ""

    fact in_level = 0
    fact banners = true
    fact group_apps = false
    fact lock_i = 0              // 0 never · 1 3 min · 2 5 · 3 10 · 4 15 (off until you have tried the lock screen)
    fact banner_i = 1
    fact pref_seconds = false
    fact pref_weather = true
    fact pref_tray = true
    fact pal_style = 0
    text pal_src = ""
    fact pref_widgets = true
    fact pref_apps = true
    fact nl_mode_i = 0
    fact nl_temp_i = 1
    fact pp_i = 1
    fact pp_ok = true
    text pp_note = ""
    fact pref_workspaces = true
    fact pref_bar_apps = true
    fact pref_updates = true
    fact dock_size_i = 1
    fact bar_left_order = 0
    fact bar_right_order = 0
    fact module_output_policy = 0
    fact dock_output_policy = 0
    fact dock_show_delay = 0
    text frame_output_name = ""
    text frame_output_edit = ""
    text frame_output_status = ""
    event bar_left_order_pick ->
    event bar_right_order_pick ->
    event module_output_pick ->
    event dock_output_pick ->
    event dock_show_delay_pick ->
    event frame_output_save ->
    fact dock_delay_i = 1
    fact wallpaper_fx = 0
    fact display_pending = false
    fact display_busy = false
    fact display_sel = 0
    text display_status = ""
    event display_keep ->
    event display_revert ->
    event display_activate ->
    fact shortcut_open = false
    fact shortcut_busy = false
    fact shortcut_editable = false
    fact shortcut_conflict = false
    text shortcut_status = ""
    text shortcut_key = ""
    text shortcut_route = ""
    event shortcut_open ->
    event shortcut_close ->
    event shortcut_route_next ->
    event shortcut_save ->
    fact look_open = false
    fact look_selected = 0
    fact look_writable = false
    fact look_ready = false
    fact look_preview = false
    text look_name = ""
    text look_document = ""
    text look_status = ""
    text look_range = ""
    text look_changes = ""
    model look_rows max 5 { id: number; name: text; sub: text; sel: bool; tag: text }
    event look_open ->
    event look_close ->
    event look_pick ->
    event look_step ->
    event look_save ->
    event look_update ->
    event look_rename ->
    event look_delete ->
    event look_load ->
    event look_preview ->
    event look_apply ->
    event look_export ->
    event look_retry ->
    fact quiet_enabled = false
    fact quiet_start = 1320
    fact quiet_end = 420
    text quiet_from = "22:00"
    text quiet_to = "07:00"
    text quiet_edit_status = ""
    event quiet_toggle ->
    event quiet_hours_save ->
    event quiet_mode ->
    event quiet_app_cycle ->
    fact quiet_edit = false
    text quiet_app_range = ""
    event quiet_open ->
    event quiet_close ->
    event quiet_app_step ->
    model quiet_app_rows max 5 { app: text; mode: number; idx: number; sel: bool }
    fact pin_edit = false
    fact pin_sel = 0
    model dock_pins max 12 { name: text; idx: number; mvl: bool; mvr: bool }
    fact pref_dock_auto = true
    fact bar_style = 0



    //  About this PC: filled in by settings.luau from the machine itself
    text about_os = "Linux"
    text about_cpu = "…"
    text about_gpu = "…"
    text about_mem = "…"
    text about_kernel = "…"
    text about_disk = "…"

    prop seen = 0 ~quick
    prop scale = 0.96 ~lively

    layer panel ~quick {
        shown while open { seen: 1 ~quick; scale: 1 ~lively }
        gone             { seen: 0 ~quick; scale: 0.96 ~quick }
    }

    let sidebar_bg = if(dark_mode, if(skin == 2, #13151a, if(skin == 1, #11131c, #0d0f14)), if(skin == 2, #ebecee, if(skin == 1, #e4e6ee, #f0f2f7)))
    let c_border = card_stroke
    let c_border_op = card_stroke_op
    let stroke_c = card_stroke
    let stroke_op = card_stroke_op

    event toggle
    event show               // open the window (a rule: `open` changes in the scene, so `exclusive` hears it)
    event close              // close it (the same)
    event set_screen(s) ->   // the monitor it opens on (index)
    event reveal_setting(id) ->
    event settings_search_step ->
    event settings_search_pick ->
    event settings_search_submit ->
    event settings_search_clear ->
    event preference_retry ->
    event set_dock_pins ->
    event pin_open ->
    event pin_close ->
    event pin_left ->
    event pin_right ->
    event pin_step ->
    event reset_appearance_review ->
    event reset_appearance_apply ->
    event reset_appearance_cancel ->
    event reset_appearance_undo ->
    event reset_appearance_activate ->
    event set_tab(n) ->      // the tab to show
    event set_pal_src(path) -> // the wallpaper to take the palette from (the picker says it)
    event set_mode ->
    event set_dark_mode ->
    event choose_skin ->
    event choose_accent ->
    event toggle_accent_auto ->
    event toggle_hour12 ->
    event toggle_seconds ->
    event toggle_weather ->
    event toggle_tray ->
    event toggle_widgets ->
    event toggle_apps ->
    event nl_mode_pick ->
    event nl_temp_pick ->
    event pp_pick ->
    event pal_style_pick ->
    event widgets_edit ->
    event widgets_reset ->
    event toggle_dock_auto ->
    event toggle_workspaces ->
    event toggle_bar_apps ->
    event toggle_updates ->
    event dock_size_pick ->
    event dock_delay_pick ->
    event wallpaper_fx_pick ->
    event bar_style_pick ->
    event auto_accent ->
    event volume_set ->
    event input_set ->
    event toggle_mute ->
    event pick_out ->
    event brightness_set ->
    event disp_pick ->
    event disp_scale ->
    event disp_res ->
    event disp_hz ->
    event theme_sync ->
    event toggle_dnd ->
    event toggle_banners ->
    event toggle_group ->
    event lock_pick ->
    event banner_secs_pick ->
    event clear_notif_history ->
    event bind_scroll ->
    event pick_cat ->
    event session_lock ->
    event session_restart ->
    event session_off ->

    // ==============================================================
    // COMPONENTS
    // ==============================================================

    //  A rounded card, 556 wide; what goes between its braces is drawn inside.
    component Card(h: number = row_detail_h) {
        size: 556, h
        CardBg(556, h, radius_card, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
        box { from: 0, 0; size: 556, h; corner: radius_card; stroke: 1; color: c_border; opacity: c_border_op }
        children
    }

    component QuietAppRow(a: record) {
        size: 556, control_h_large
        RowFrame(556, control_h_large, if(a.sel, 1, 0), ui_accent_c: accent_c)
        text a.app { at: inset_compact, control_h_large / 2; anchor: left center; size: font_body; color: ink_c; width: 330; lines: 1 }
        group { move: 360, 2
            Chip(pick(a.mode, "Normal", "No banner", "Muted"), a.mode > 0, quiet_app_cycle, a.idx, 184, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
        }
    }

    component LookRow(r: record) {
        size: 556, control_h_large
        RowFrame(556, control_h_large, if(r.sel, 1, 0), ui_accent_c: accent_c)
        zone box hit { from: 0, 0; size: 556, control_h_large; cursor: pointer; label: r.name }
        on press hit { emit look_pick(r.id) }
        on press right hit { }
        text r.name { at: inset_compact, control_h_large / 2; anchor: left center; size: font_body; weight: 600; color: ink_c; width: 180; lines: 1 }
        text r.sub { at: 200, control_h_large / 2; anchor: left center; size: font_caption; color: ink_sub; width: 264; lines: 1 }
        text r.tag { at: 544, control_h_large / 2; anchor: right center; size: font_caption; color: accent_c; width: 72; lines: 1; align: right }
    }

    //  A row with a button on its right.
    component ActionRow(title: text, sub: text, label: text, tap: event) {
        size: 556, row_detail_h
        CardBg(556, row_detail_h, radius_card, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
        box { from: 0, 0; size: 556, row_detail_h; corner: radius_card; stroke: 1; color: c_border; opacity: c_border_op }
        text title { at: inset_card, space_20; anchor: left center; size: ts_body; weight: 600; color: ink_c; width: 400; lines: 1 }
        text sub { at: inset_card, row_detail_h - space_16; anchor: left center; size: ts_micro; color: ink_sub; width: 400; lines: 1 }
        group {
            move: 556 - inset_card - 88, (row_detail_h - control_h) / 2
            Btn(label, 88, tap, false, 0, 0, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
        }
    }

    //  A slider you can drag.
    component SliderRow(title: text, level: number, set: event, kind: number, live: bool) {
        size: 556, row_slider_h
        CardBg(556, row_slider_h, radius_card, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
        box { from: 0, 0; size: 556, row_slider_h; corner: radius_card; stroke: 1; color: c_border; opacity: c_border_op }
        text title { at: inset_card, space_20; anchor: left center; size: ts_body; weight: 600; color: ink_c }
        text "{clamp(level, 0, 1) * 100, 0}%" { at: 556 - inset_card, space_20; anchor: right center; size: t_cap; color: ink_sub }
        group { move: inset_card, row_slider_h - space_24; Slider(556 - inset_card * 2, level, set, if(live, accent_c, ink_sub), 10, 0, ui_slider_bg: slider_bg) }
    }

    //  Light / Dark / Auto thumbnail.
    component ModeThumb(n: number, label: text, base: color, panel_c: color, bar: color) {
        size: 100, 78
        box { from: 0, 0; size: 100, 60; corner: r_s; color: base }
        group {
            show: n == 2
            box { from: 0, 0; size: 50, 60; corner: r_s; color: #f2f3f7 }
        }
        group {
            show: n != 2
            box { from: 6, 6; size: 88, 8; corner: 2; color: bar }
            box { from: 6, 18; size: 26, 36; corner: 2; color: panel_c }
            box { from: 36, 18; size: 58, 36; corner: 2; color: panel_c }
        }
        box { from: 0, 0; size: 100, 60; corner: r_s; stroke: if(appearance == n, 2.5, 1); color: if(appearance == n, accent_c, c_border) }
        text label { at: 50, 72; anchor: center center; size: ts_sub; weight: if(appearance == n, 600, 400); color: if(appearance == n, accent_c, ink_c) }
        zone box hit { from: 0, 0; size: 100, 78; cursor: pointer }
        on press hit { emit set_mode(n) }
        on press right hit { }
    }

    component AccentCircle(idx: number, col: color) {
        size: 28, 28
        ellipse { at: 14, 14; radius: 11; color: col }
        ellipse { at: 14, 14; radius: 13.5; stroke: 2; color: ink_c; opacity: if(accent == idx and not accent_auto and custom_accent < 0, 90%, 0%) }
        zone box hit { from: 0, 0; size: 28, 28; corner: radius_card; cursor: pointer }
        on press hit { emit choose_accent(idx) }
        on press right hit { }
    }

    //  A display: pick it to change its scale and mode.
    component DispTile(d: record) {
        size: 270, 78
        CardBg(270, 78, r_m, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
        box { from: 0, 0; size: 270, 78; corner: r_m; stroke: if(d.sel, 2, 1); color: if(d.sel, accent_c, c_border); opacity: if(d.sel, 100%, c_border_op) }
        Sym("󰍹", 34, 39, 30, if(d.sel, accent_c, ink_sub))
        text d.title { at: 66, 28; anchor: left center; size: ts_sub; weight: 600; color: ink_c; width: 190; lines: 1 }
        text d.mode { at: 66, 48; anchor: left center; size: ts_micro; color: ink_sub; width: 190; lines: 1 }
        text d.name { at: 66, 62; anchor: left center; size: ts_micro; color: ink_sub; width: 190; lines: 1 }
        zone box hit { from: 0, 0; size: 270, 78; corner: r_m; cursor: pointer }
        on press hit { emit disp_pick(d.index) }
        on press right hit { }
    }

    component OutRow(o: record) {
        size: 556, 44
        box { from: 0, 0; size: 556, 44; corner: r_m; color: if(o.def, sel_bg, card_fill); opacity: if(o.def, 100%, card_fill_op) }
        box { from: 0, 0; size: 556, 44; corner: r_m; stroke: if(o.def, 2, 1); color: if(o.def, accent_c, c_border); opacity: if(o.def, 100%, c_border_op) }
        Sym("󰓃", 26, 22, 16, if(o.def, accent_c, ink_sub))
        text o.name { at: 48, 22; anchor: left center; size: ts_sub; color: ink_c; width: 440; lines: 1 }
        text "󰄬" { family: "JetBrainsMono Nerd Font Mono"; at: 530, 22; anchor: center center; size: font_title; color: accent_c; show: o.def }
        zone box hit { from: 0, 0; size: 556, 44; corner: r_m; cursor: pointer }
        on press hit { emit pick_out(o.index) }
        on press right hit { }
    }

    component BindRow(b: record) {
        size: 556, 40
        box { from: 0, 0; size: 556, 40; corner: r_s; color: card_fill; opacity: card_fill_op * 70% }
        text b.what { at: 16, 12; anchor: left center; size: ts_sub; color: ink_c; width: 280; lines: 1 }
        text b.origin { at: 16, 30; anchor: left center; size: font_micro; color: ink_sub; width: 360; lines: 1 }
        text b.keys { at: 540, 20; anchor: right center; size: ts_sub; weight: 600; color: accent_c; width: 240; lines: 1; align: right }
    }

    //  A wallpaper thumbnail: click to apply.
    component SpecRow(label_t: text, val_t: text) {
        size: 520, 22
        text label_t { at: 0, 11; anchor: left center; size: ts_sub; weight: 600; color: ink_sub; width: 110 }
        text val_t { at: 120, 11; anchor: left center; size: ts_sub; color: ink_c; width: 390; lines: 1 }
    }

    //  A category in the sidebar; `c.tint` picks the icon colour.
    component PinOrderRow(p: record) {
        size: 556, 44
        RowFrame(556, 44, pin_sel == p.idx, ui_accent_c: accent_c)
        text p.name { at: inset_card, 22; anchor: left center; size: font_body; color: ink_c; width: 400; lines: 1 }
        zone box hit { from: 0, 0; size: 462, 44; cursor: pointer }
        on press hit { pin_sel = p.idx }
        on press right hit { }
        row { at: 476, 8; gap: space_8
            IconButton("󰁍", "Move left", pin_left, ink_c, ink_c, value: p.idx, enabled: p.mvl)
            IconButton("󰁔", "Move right", pin_right, ink_c, ink_c, value: p.idx, enabled: p.mvr)
        }
    }

    component SettingsSearchRow(r: record) {
        size: 206, 44
        RowFrame(206, 44, settings_search_sel == r.idx, ui_accent_c: accent_c)
        text r.name { at: inset_compact, 8; size: font_secondary; color: ink_c; width: 182; lines: 1 }
        text r.sub { at: inset_compact, 25; size: font_micro; color: ink_sub; width: 182; lines: 1 }
        zone box hit { from: 0, 0; size: 206, 44; cursor: pointer }
        on press hit { emit settings_search_pick(r.idx) }
        on press right hit { }
    }

    component SidebarItem(c: record) {
        size: 206, 30
        prop hot = 0 ~quick
        box { from: 0, 0; size: 206, 30; corner: r_s; color: ink_c; opacity: if(tab == c.idx, 0%, hot * 7%) }
        box hit {
            from: 0, 0
            size: 206, 30
            corner: radius_small
            color: accent_c
            opacity: if(tab == c.idx, 95%, 0%)
            cursor: pointer
        }
        group {
            move: 6, 4
            box { from: 0, 0; size: 22, 22; corner: control_r; color: pick(c.tint, #5856d6, #0a84ff, #ff2d55, #ff453a, #8e8e93, #ff9f0a, #8e8e93, #30d158) }
            Sym(c.icon, 11 - c.dx, 11, 15, tile_fg)
        }
        text c.name { at: 36, 15; anchor: left center; size: ts_body; weight: if(tab == c.idx, 600, 400); color: if(tab == c.idx, on_accent, ink_c) }
        on enter hit { hot: 1 }
        on leave hit { hot: 0 }
        on press hit { emit pick_cat(c.idx) }
        on press right hit { }
    }

    on toggle     { toggle open }
    on show       { open = true; focus side_q }
    on close      { open = false }
    on change reset_review while reset_review { blur }
    on change shortcut_open while shortcut_open { focus shortcut_key }
    on key Alt+Left while shortcut_open { emit shortcut_route_next(-1) }
    on key Alt+Right while shortcut_open { emit shortcut_route_next(1) }
    on key Escape while shortcut_open { emit shortcut_close }
    on submit shortcut_key { emit shortcut_save }
    on change quiet_edit while quiet_edit { blur }
    on key Ctrl+Up while quiet_edit { emit quiet_app_step(-1) }
    on key Ctrl+Down while quiet_edit { emit quiet_app_step(1) }
    on key Ctrl+Right while quiet_edit { emit quiet_app_cycle }
    on key Ctrl+Left while quiet_edit { emit quiet_app_cycle }
    on key Escape while quiet_edit { emit quiet_close }
    on submit frame_output_edit { emit frame_output_save }
    on submit quiet_from { emit quiet_hours_save }
    on submit quiet_to { emit quiet_hours_save }
    on change look_open while look_open { focus look_name }
    on change look_open while not look_open { blur }
    on key Up while look_open { emit look_step(-1) }
    on key Down while look_open { emit look_step(1) }
    on key Escape while look_open { emit look_close }
    on submit look_name { emit look_save }
    on submit look_document { emit look_preview }
    on key Ctrl+Return while look_open and look_preview { emit look_apply }
    on key Ctrl+KP_Enter while look_open and look_preview { emit look_apply }
    on change display_pending while display_pending { blur }
    on key Left while display_pending { display_sel = 1 - display_sel }
    on key Right while display_pending { display_sel = 1 - display_sel }
    on key Tab while display_pending { display_sel = 1 - display_sel }
    on key Shift+Tab while display_pending { display_sel = 1 - display_sel }
    on keyup Return while display_pending { emit display_activate }
    on keyup KP_Enter while display_pending { emit display_activate }
    on key Escape while display_pending { emit display_revert }
    on change pin_edit while pin_edit { blur }
    on key Up while pin_edit { emit pin_step(-1) }
    on key Down while pin_edit { emit pin_step(1) }
    on key Left while pin_edit { emit pin_left(-1) }
    on key Right while pin_edit { emit pin_right(-1) }
    on key Escape while pin_edit { emit pin_close }
    on key Left while reset_review { reset_sel = 1 - reset_sel }
    on key Right while reset_review { reset_sel = 1 - reset_sel }
    on key Tab while reset_review { reset_sel = 1 - reset_sel }
    on key Shift+Tab while reset_review { reset_sel = 1 - reset_sel }
    on keyup Return while reset_review { emit reset_appearance_activate }
    on keyup KP_Enter while reset_review { emit reset_appearance_activate }
    on keyup space while reset_review { emit reset_appearance_activate }
    on key Down while settings_search { emit settings_search_step(1) }
    on key Up while settings_search { emit settings_search_step(-1) }
    on key Tab while settings_search { emit settings_search_step(1); focus side_q }
    on key Shift+Tab while settings_search { emit settings_search_step(-1); focus side_q }
    on key Escape while settings_search { emit settings_search_clear }
    on key Escape while not settings_search and not reset_review and not pin_edit and not display_pending and not look_open and not quiet_edit and not shortcut_open { open = false }
    on key Escape while reset_review { emit reset_appearance_cancel }
    //  Up / Down walk the sidebar (one tab at a time, stopping at the ends); the search field and every sub-flow keep their own keys
    on key Down while open and not settings_search and not reset_review and not pin_edit and not display_pending and not look_open and not quiet_edit and not shortcut_open and tab < 7 { emit pick_cat(tab + 1) }
    on key Up while open and not settings_search and not reset_review and not pin_edit and not display_pending and not look_open and not quiet_edit and not shortcut_open and tab > 0 { emit pick_cat(tab - 1) }
}
