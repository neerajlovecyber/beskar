        // 5 ── Shortcuts ────────────────────────────────────────
        group tab_5 {
            show: tab == 5 and not shortcut_open
            move: 254, 60
            CardBg(556, 34, radius_small, ui_card_fill: card_fill, ui_card_stroke: card_stroke)
            box { from: 0, 0; size: 556, 34; corner: radius_small; stroke: 1; color: c_border; opacity: c_border_op }
            Sym("󰍉", 18, 17, 13, ink_sub)
            input bind_q {
                at: 34, 8
                width: 440
                size: font_body
                color: ink_c
                placeholder: "Search shortcuts"
                selection: accent_c
            }
            text bind_count { at: 538, 17; anchor: right center; size: ts_micro; color: ink_sub }
            group { move: 0, 454; Btn("Edit owned shortcuts…", 224, shortcut_open, false, 0, 0, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill) }
            text shortcut_status { at: 0, 494; size: font_caption; color: ink_sub; width: 556; lines: 2 }
            zone box bind_wheel { from: 0, 44; size: 556, 410 }
            on scroll bind_wheel { emit bind_scroll(wheel) }
            column {
                at: 0, 44
                gap: space_4
                for b in binds { BindRow(b) }
            }
            text "No shortcuts match" { at: 278, 200; anchor: center center; size: ts_sub; color: ink_sub; show: binds.count < 1 }
        }

        group {
            show: tab == 5 and shortcut_open
            move: 254, 60
            text "Owned shortcuts" { at: 0, 8; size: font_title; weight: 600; color: ink_c }
            group { move: 456, 0; Btn("Back", 100, shortcut_close, false, 0, 0, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill) }
            text "Choose an action with Alt+← →, then type a niri key combination." { at: 0, 54; size: font_body; color: ink_sub; width: 556; lines: 2 }
            text shortcut_route { at: 0, 110; size: font_title; weight: 600; color: ink_c; width: 556; lines: 1 }
            row { at: 0, 146; gap: space_12
                Chip("Previous action", false, shortcut_route_next, -1, 168, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                Chip("Next action", false, shortcut_route_next, 1, 144, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
