                        Seg("Off", 0, nl_mode_i, nl_mode_pick, 90, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                        Seg("Always on", 1, nl_mode_i, nl_mode_pick, 110, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                        Seg("Sunset to sunrise", 2, nl_mode_i, nl_mode_pick, 150, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                    }
                    text "Warmth" { at: 18, 108; anchor: left center; size: ts_cap; weight: 600; color: if(nl_mode_i > 0, ink_c, ink_sub) }
                    row {
