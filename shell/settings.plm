                    input frame_output_edit { at: 28, 48; width: 276; size: font_secondary; color: ink_c; selection: accent_c; placeholder: "HDMI-A-1 · empty follows focus" }
                    group { move: 340, 42; Btn("Save output", 144, frame_output_save, false, 0, 0, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill) }
                }
                group {
