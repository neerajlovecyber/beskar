            input shortcut_key { at: 12, 208; width: 532; size: font_body; color: ink_c; selection: accent_c; placeholder: "For example Mod+Shift+K" }
            group { move: 0, 254
                Btn(if(shortcut_conflict, "Override existing binding", "Save shortcut"), 260, shortcut_save, false, 0, 0, enabled: shortcut_editable and not shortcut_busy, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
            }
            text shortcut_status { at: 0, 312; size: font_body; color: ink_sub; width: 556; lines: 5 }
        }

