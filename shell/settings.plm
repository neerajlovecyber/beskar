// System Settings: a sidebar of categories (with search) and a pane of real controls. Every switch, slider and
// button here does something: the logic is settings.luau. Window 840 × 580, centred on the monitor with the focus.
//
//   0 Appearance · 1 Displays · 2 Sound · 3 Notifications · 4 Menu Bar & Dock · 5 Shortcuts · 6 General
import "common/palette.plm"

scene MacSettings {
    include "common/theme.plm"
    include "common/icons.plm"
    include "common/ui.plm"
    include "common/here.plm"
    surface sheet {
        size: 900, 620
        anchor: center
        level: overlay
        keyboard: on_demand
        screens: each
        open: (open or seen > 0.02) and open_screen == screen.index

    zone box dismiss { from: 0, 0; size: 900, 620; active: open }

    group {
        move: 30, 20
        pivot: 420, 290
        scale: scale
        opacity: seen

        // ── window glass ─────────────────────────────────────────
        body {
            color: bg_color
            glass: glass_amt
            lens: false
            frost: 100%
            dispersion: 0
            refraction: 0
            tint: tint_amt
            rim: rim_amt
            box { from: 0, 0; size: 840, 580; corner: r_l }
        }
        box { from: 0, 0; size: 840, 580; corner: r_l; stroke: 1; color: stroke_c; opacity: stroke_op }
        box { from: 0, 0; size: 230, 580; corner: r_l; color: sidebar_bg; opacity: 85% }
        box { from: 230, 0; size: 1, 580; color: stroke_c; opacity: stroke_op }

        //  clicks on the window itself do not close it
        zone box inside { from: 0, 0; size: 840, 580 }
        on press right inside { }

        // ── sidebar ──────────────────────────────────────────────
        group {
            move: 18, 18
            ellipse { at: 6, 6; radius: 6; color: #ff5f56 }
            zone box btn_close { from: 0, 0; size: 14, 14; cursor: pointer }
            on press btn_close { open = false }
            ellipse { at: 26, 6; radius: 6; color: #ffbd2e }
            zone box btn_min { from: 20, 0; size: 14, 14; cursor: pointer }
            on press btn_min { open = false }
            ellipse { at: 46, 6; radius: 6; color: #27c93f }
        }

        //  who is logged in
        group {
            move: 14, 46
            box { from: 0, 0; size: 202, 54; corner: r_s; color: card_fill; opacity: card_fill_op * 50% }
            box { from: 0, 0; size: 202, 54; corner: r_s; stroke: 1; color: c_border; opacity: c_border_op }
            //  your picture if there is one (~/.face or the account's icon), else a gradient disc with your initial
            group {
                show: not has_avatar
                body {
                    gradient: 8, 9 to 44, 45, accent_c, focus_c
                    box { from: 8, 9; size: 36, 36; corner: r_l }
                }
            }
            text avatar_initial { at: 26, 27; anchor: center center; size: 18; weight: 700; color: on_accent; show: not has_avatar }
            group {
                show: has_avatar
                clip box { from: 8, 9; size: 36, 36; corner: r_l }
                image avatar_img { at: 8, 9; size: 36, 36 }
            }
            column {
                at: 52, 17
                gap: 2
                text user_name { size: t_body; weight: 600; color: ink_c; width: 140; lines: 1 }
                text "This computer" { size: t_micro; color: ink_sub }
            }
        }

        //  search: filters the list below
        group {
            move: 14, 108
            box { from: 0, 0; size: 202, 28; corner: 7; color: if(dark_mode, #242730, #e8eaf0) }
            Sym("󰍉", 18, 14, 13, ink_sub)
            input side_q {
                at: 32, 5
                width: 160
                size: 12
                color: ink_c
                placeholder: "Search"
                selection: accent_c
            }
        }

        column cat_list {
            at: 12, 144
            gap: 2
            for c in cats { SidebarItem(c) }
        }
        group { show: cats.count < 1; EmptyState(115, 190, "󰍉", "No matches") }

        // ── the pane ─────────────────────────────────────────────
        text pane_title { at: 254, 34; anchor: left center; size: 20; weight: 700; color: ink_c }

        // 0 ── Appearance ───────────────────────────────────────
        group tab_0 {
            show: tab == 0
            move: 254, 60
            column tcol_0 {
                view: 560, 500
                step: 56
                gap: 12
                Card(138) {
                    text "Appearance" { at: 18, 16; size: t_body; weight: 600; color: ink_c }
                    row {
                        at: 40, 42
                        gap: 28
                        ModeThumb(0, "Light", #f2f3f7, on_accent, #e5e7eb)
                        ModeThumb(1, "Dark", #1e2026, #252830, #2d3139)
                        ModeThumb(2, "Auto", #1e2026, #f2f3f7, #8e8e93)
                    }
                    text "Auto switches to dark at 7 pm and back to light at 7 am" { at: 380, 70; anchor: left center; size: t_micro; color: ink_sub; width: 160; lines: 3; show: appearance == 2 }
                }
                Card(88) {
                    text "Window glass" { at: 18, 16; size: t_body; weight: 600; color: ink_c }
                    row {
                        at: 18, 36
                        gap: 10
                        SkinPill(0, "Liquid Glass", "Dynamic blur and reflection")
                        SkinPill(1, "Light Acrylic", "Smooth frosted acrylic")
                        SkinPill(2, "Classic Solid", "Opaque, high contrast")
                    }
                }
                ToggleRow("Colours from the wallpaper", "Accent, highlights and glass tint follow the picture (matugen)", accent_auto, toggle_accent_auto)
                ToggleRow("Theme other apps", "Terminals, Files (Nautilus) and other GTK / Qt apps wear the same colours", pref_apps, toggle_apps)
                Card(112) {
                    text "Accent colour" { at: 18, 16; size: t_body; weight: 600; color: ink_c }
                    text "Palette from the wallpaper" { at: 18, 82; anchor: left center; size: t_cap; weight: 600; color: if(accent_auto, ink_c, ink_sub) }
                    row {
                        at: 262, 68
                        gap: 6
                        Seg("Tonal", 0, pal_style, pal_style_pick, 66)
                        Seg("Vibrant", 1, pal_style, pal_style_pick, 70)
                        Seg("Neutral", 2, pal_style, pal_style_pick, 70)
                        Seg("Soft", 3, pal_style, pal_style_pick, 60)
                    }
                    row {
                        at: 18, 38
                        gap: 14
                        AccentCircle(0, #007aff)
                        AccentCircle(1, #af52de)
                        AccentCircle(2, #ff2d55)
                        AccentCircle(3, #ff3b30)
                        AccentCircle(4, #ff9500)
                        AccentCircle(5, #34c759)
                        AccentCircle(6, #8e8e93)
                    }
                }
            }
            group { move: 566, 0; ScrollBar(tcol_0.scroll, tcol_0.content, 500) }
        }

        // 1 ── Displays ─────────────────────────────────────────
        group tab_1 {
            show: tab == 1
            move: 254, 60
            column tcol_1 {
                view: 560, 500
                step: 56
                gap: 12
                row {
                    gap: 10
                    for d in disps { DispTile(d) }
                }
                Card(70) {
                    text "Scale" { at: 18, 22; anchor: left center; size: t_body; weight: 600; color: ink_c }
                    text "Applies now. To keep it after a restart, set it in niri's config." { at: 18, 50; anchor: left center; size: t_micro; color: ink_sub; width: 330 }
                    row {
                        at: 290, 14
                        gap: 6
                        Seg("100%", 0, disp_scale_i, disp_scale, 62)
                        Seg("125%", 1, disp_scale_i, disp_scale, 62)
                        Seg("150%", 2, disp_scale_i, disp_scale, 62)
                        Seg("200%", 3, disp_scale_i, disp_scale, 62)
                    }
                }
                Card(56) {
                    text "Resolution" { at: 18, 28; anchor: left center; size: t_body; weight: 600; color: ink_c }
                    row {
                        at: 150, 14
                        gap: 6
                        for r in reslist { Chip(r.label, r.cur, disp_res, r.index, 92) }
                    }
                }
                Card(56) {
                    text "Refresh rate" { at: 18, 28; anchor: left center; size: t_body; weight: 600; color: ink_c }
                    row {
                        at: 160, 14
                        gap: 6
                        for r in hzlist { Chip(r.label, r.cur, disp_hz, r.index, 80) }
                    }
                }
                SliderRow("Brightness", bright.level, brightness_set, 0, true)
            }
            group { move: 566, 0; ScrollBar(tcol_1.scroll, tcol_1.content, 500) }
        }

        // 2 ── Sound ────────────────────────────────────────────
        group tab_2 {
            show: tab == 2
            move: 254, 60
            column tcol_2 {
                view: 560, 500
                step: 56
                gap: 12
                SliderRow("Output volume", sound.volume, volume_set, 1, not sound.muted)
                ToggleRow("Mute", "Silences the output", sound.muted, toggle_mute)
                SliderRow("Input volume", in_level, input_set, 2, true)
                text "Output device" { size: t_body; weight: 600; color: ink_c }
                column {
                    gap: 6
                    for o in outs { OutRow(o) }
                }
            }
            group { move: 566, 0; ScrollBar(tcol_2.scroll, tcol_2.content, 500) }
        }

        // 3 ── Notifications ────────────────────────────────────
        group tab_3 {
            show: tab == 3
            move: 254, 60
            column tcol_3 {
                view: 560, 500
                step: 56
                gap: 12
                ToggleRow("Do Not Disturb", "Notifications still arrive, silently, in the centre", dnd, toggle_dnd)
                ToggleRow("Group by app", "Stack several notifications from one app into a pile", group_apps, toggle_group)
                ToggleRow("Show banners", "A new notification drops into the clock pill", banners, toggle_banners)
                Card(64) {
                    text "Banner stays for" { at: 18, 22; anchor: left center; size: t_body; weight: 600; color: ink_c }
                    row {
                        at: 270, 14
                        gap: 6
                        Seg("3 s", 0, banner_i, banner_secs_pick, 62)
                        Seg("5 s", 1, banner_i, banner_secs_pick, 62)
                        Seg("8 s", 2, banner_i, banner_secs_pick, 62)
                        Seg("12 s", 3, banner_i, banner_secs_pick, 62)
                    }
                    text "Hovering a banner keeps it open" { at: 18, 46; anchor: left center; size: t_micro; color: ink_sub }
                }
                ActionRow("History", "Forget the notifications listed under Earlier", "Clear", clear_notif_history)
            }
            group { move: 566, 0; ScrollBar(tcol_3.scroll, tcol_3.content, 500) }
        }

        // 4 ── Menu Bar & Dock ──────────────────────────────────
        group tab_4 {
            show: tab == 4
            move: 254, 60
            column tcol_4 {
                view: 560, 500
                step: 56
                gap: 12
                Card(54) {
                    text "Top bar style" { at: 18, 27; anchor: left center; size: t_body; weight: 600; color: ink_c }
                    row {
                        at: 360, 13
                        gap: 6
                        Seg("Notch", 0, bar_style, bar_style_pick, 86)
                        Seg("Strip", 1, bar_style, bar_style_pick, 86)
                    }
                }
                ToggleRow("24-hour clock", "Shows 14:05 instead of 2:05 PM", not hour12, toggle_hour12)
                ToggleRow("Show seconds", "2:05:09 PM", pref_seconds, toggle_seconds)
                ToggleRow("Show weather", "Temperature next to the clock", pref_weather, toggle_weather)
                ToggleRow("Show system tray", "Icons of running applications in the top right", pref_tray, toggle_tray)
                ToggleRow("Hide the dock automatically", "It rises when the pointer reaches the bottom edge", pref_dock_auto, toggle_dock_auto)
                ToggleRow("Desktop widgets", "Clock, weather, system and more on the wallpaper", pref_widgets, toggle_widgets)
                Card(64) {
                    text "Arrange widgets" { at: 18, 22; anchor: left center; size: t_body; weight: 600; color: ink_c }
                    text "Drag, resize, add or remove them (Super + Shift + W)" { at: 18, 42; anchor: left center; size: t_micro; color: ink_sub }
                    row {
                        at: 332, 18
                        gap: 8
                        Btn("Edit", 90, widgets_edit, true, 0, 0)
                        Btn("Reset layout", 112, widgets_reset, false, 0, 0)
                    }
                }
            }
            group { move: 566, 0; ScrollBar(tcol_4.scroll, tcol_4.content, 500) }
        }

        // 5 ── Shortcuts ────────────────────────────────────────
        group tab_5 {
            show: tab == 5
            move: 254, 60
            CardBg(556, 34, 10)
            box { from: 0, 0; size: 556, 34; corner: 10; stroke: 1; color: c_border; opacity: c_border_op }
            Sym("󰍉", 18, 17, 13, ink_sub)
            input bind_q {
                at: 34, 8
                width: 440
                size: 13
                color: ink_c
                placeholder: "Search shortcuts"
                selection: accent_c
            }
            text bind_count { at: 538, 17; anchor: right center; size: t_micro; color: ink_sub }
            zone box bind_wheel { from: 0, 44; size: 556, 410 }
            on scroll bind_wheel { emit bind_scroll(wheel) }
            column {
                at: 0, 44
                gap: 4
                for b in binds { BindRow(b) }
            }
            text "No shortcuts match" { at: 278, 200; anchor: center center; size: t_sub; color: ink_sub; show: binds.count < 1 }
        }

        // 6 ── General ──────────────────────────────────────────
        group tab_6 {
            show: tab == 6
            move: 254, 60
            column tcol_6 {
                view: 560, 500
                step: 56
                gap: 12
                Card(100) {
                    body {
                        gradient: 18, 18 to 78, 78, accent_c, focus_c
                        box { from: 18, 18; size: 64, 64; corner: r_l }
                    }
                    text "B" { at: 50, 50; anchor: center center; size: 32; weight: 800; color: on_accent }
                    column {
                        at: 100, 22
                        gap: 3
                        text "About This PC" { size: 20; weight: 700; color: ink_c }
                        text about_os { size: t_sub; color: ink_sub }
                        text "Beskar shell · niri · Pleamar" { size: t_sub; weight: 500; color: ink_c }
                    }
                }
                Card(218) {
                    text "Hardware Overview" { at: 18, 16; size: t_body; weight: 600; color: ink_c }
                    column {
                        at: 18, 40
                        gap: 4
                        SpecRow("Computer", about_host)
                        SpecRow("Processor", about_cpu)
                        SpecRow("Graphics", about_gpu)
                        SpecRow("Memory", about_mem)
                        SpecRow("Kernel", about_kernel)
                        SpecRow("Storage", about_disk)
                        SpecRow("Uptime", about_up)
                    }
                }
                Card(64) {
                    text "Session" { at: 18, 22; anchor: left center; size: t_body; weight: 600; color: ink_c }
                    text "Lock, restart or shut down this computer" { at: 18, 42; anchor: left center; size: t_micro; color: ink_sub }
                    row {
                        at: 268, 18
                        gap: 8
                        Btn("Lock", 76, session_lock, false, 0, 0)
                        Btn("Restart", 84, session_restart, false, 0, 0)
                        Btn("Shut Down", 90, session_off, false, 0, 0)
                    }
                }
                Card(64) {
                    text "Lock when away" { at: 18, 22; anchor: left center; size: t_body; weight: 600; color: ink_c }
                    text "Locks after this long without using the computer, and always before sleep" { at: 18, 44; anchor: left center; size: t_micro; color: ink_sub; width: 300; lines: 2 }
                    row {
                        at: 322, 18
                        gap: 5
                        Seg("Never", 0, lock_i, lock_pick, 46)
                        Seg("3", 1, lock_i, lock_pick, 34)
                        Seg("5", 2, lock_i, lock_pick, 34)
                        Seg("10", 3, lock_i, lock_pick, 34)
                        Seg("15 min", 4, lock_i, lock_pick, 56)
                    }
                }
            }
            group { move: 566, 0; ScrollBar(tcol_6.scroll, tcol_6.content, 500) }
        }

        // 8 ── Night Light & Power ─────────────────────────────
        group tab_8 {
            show: tab == 8
            move: 254, 60
            column tcol_8 {
                view: 560, 500
                step: 56
                gap: 12
                Card(130) {
                    text "Night Light" { at: 18, 22; anchor: left center; size: t_body; weight: 600; color: ink_c }
                    text "Warms the screen so it is easier on the eyes in the evening" { at: 18, 42; anchor: left center; size: t_micro; color: ink_sub; width: 520 }
                    row {
                        at: 18, 62
                        gap: 6
                        Seg("Off", 0, nl_mode_i, nl_mode_pick, 90)
                        Seg("Always on", 1, nl_mode_i, nl_mode_pick, 110)
                        Seg("Sunset to sunrise", 2, nl_mode_i, nl_mode_pick, 150)
                    }
                    text "Warmth" { at: 18, 108; anchor: left center; size: t_cap; weight: 600; color: if(nl_mode_i > 0, ink_c, ink_sub) }
                    row {
                        at: 150, 94
                        gap: 6
                        Seg("Warm", 0, nl_temp_i, nl_temp_pick, 80)
                        Seg("Warmer", 1, nl_temp_i, nl_temp_pick, 80)
                        Seg("Candle", 2, nl_temp_i, nl_temp_pick, 80)
                    }
                }
                Card(104) {
                    text "Power mode" { at: 18, 22; anchor: left center; size: t_body; weight: 600; color: ink_c }
                    text pick(if(pp_ok, 0, 1), "Saver stretches the battery; Performance gives the processor more room", "No power-profiles-daemon here: install and start it to choose a mode") { at: 18, 42; anchor: left center; size: t_micro; color: ink_sub; width: 520 }
                    row {
                        at: 18, 62
                        gap: 6
                        Seg("Saver", 0, pp_i, pp_pick, 100)
                        Seg("Balanced", 1, pp_i, pp_pick, 110)
                        Seg("Performance", 2, pp_i, pp_pick, 130)
                    }
                    text pp_note { at: 400, 76; anchor: left center; size: t_micro; color: danger_c; width: 140 }
                }
            }
            group { move: 566, 0; ScrollBar(tcol_8.scroll, tcol_8.content, 500) }
        }

    }
        on press dismiss { open = false }
    on press right dismiss { }
    }

    permissions {
        services: "clock", "audio", "audio.*", "brightness", "brightness.*", "network", "network.*", "bluetooth", "bluetooth.*", "say:topbar", "say:spotlight", "say:control_center", "say:notifications", "say:dashboard", "say:clipboard", "say:music", "say:weather", "say:overlays", "say:overlays", "say:updates", "say:wallpapers", "say:widget_bar", "say:lock", "say:session", "say:overlays", "say:appswitcher", "say:widgets"
        run: "matugen", "powerprofilesctl", "magick", "gsettings", "systemctl", "loginctl", "kitty", "pacman", "yay", "paru", "sh", "niri msg"
    }

    service audio as sound { volume: number; muted: bool }
    service brightness as bright { level: number }

    fact open = false
    text user_name = ""
    text avatar_initial = ""
    text avatar_path = ""
    image avatar_img = from avatar_path, 36, 36
    fact has_avatar = false
    text pane_title = "Appearance"
    fact tab = 0
    fact appearance = 1          // 0 light · 1 dark · 2 auto (by the time of day)

    //  the sidebar's list (filtered by the search), displays, shortcuts, sound outputs, updates
    model cats max 8 { idx: number; icon: text; tint: number; name: text; dx: number }
    model disps max 4 { name: text; title: text; mode: text; sel: bool }
    model reslist max 4 { label: text; cur: bool }
    model hzlist max 5 { label: text; cur: bool }
    model outs max 4 { name: text; def: bool }
    model binds max 9 { keys: text; what: text }
    text about_host = "…"
    text about_up = "…"
    fact disp_scale_i = 0
    text bind_count = ""
    text side_q = ""
    text bind_q = ""

    fact in_level = 0
    fact banners = true
    fact group_apps = false
    fact lock_i = 0              // 0 never · 1 3 min · 2 5 · 3 10 · 4 15 (off until you have tried the lock screen)
    fact banner_i = 1
    fact dnd = false
    fact pref_seconds = false
    fact pref_weather = true
    fact pref_tray = true
    fact pal_style = 0
    text pal_src = ""
    fact pref_widgets = true
    fact pref_apps = true
    fact nl_mode_i = 0
    fact nl_temp_i = 1
    fact pp_i = 1
    fact pp_ok = true
    text pp_note = ""
    fact pref_dock_auto = true
    fact bar_style = 0



    //  About this PC: filled in by settings.luau from the machine itself
    text about_os = "Linux"
    text about_cpu = "…"
    text about_gpu = "…"
    text about_mem = "…"
    text about_kernel = "…"
    text about_disk = "…"

    prop seen = 0 ~quick
    prop scale = 0.96 ~lively

    layer panel ~quick {
        shown while open { seen: 1 ~quick; scale: 1 ~lively }
        gone             { seen: 0 ~quick; scale: 0.96 ~quick }
    }

    let sidebar_bg = if(dark_mode, if(skin == 2, #13151a, if(skin == 1, #11131c, #0d0f14)), if(skin == 2, #ebecee, if(skin == 1, #e4e6ee, #f0f2f7)))
    let c_border = card_stroke
    let c_border_op = card_stroke_op
    let stroke_c = card_stroke
    let stroke_op = card_stroke_op

    event toggle
    event set_mode ->
    event set_dark_mode ->
    event choose_skin ->
    event choose_accent ->
    event toggle_accent_auto ->
    event toggle_hour12 ->
    event toggle_seconds ->
    event toggle_weather ->
    event toggle_tray ->
    event toggle_widgets ->
    event toggle_apps ->
    event nl_mode_pick ->
    event nl_temp_pick ->
    event pp_pick ->
    event pal_style_pick ->
    event widgets_edit ->
    event widgets_reset ->
    event toggle_dock_auto ->
    event bar_style_pick ->
    event auto_accent ->
    event volume_set ->
    event input_set ->
    event toggle_mute ->
    event pick_out ->
    event brightness_set ->
    event disp_pick ->
    event disp_scale ->
    event disp_res ->
    event disp_hz ->
    event toggle_dnd ->
    event toggle_banners ->
    event toggle_group ->
    event lock_pick ->
    event banner_secs_pick ->
    event clear_notif_history ->
    event bind_scroll ->
    event pick_cat ->
    event session_lock ->
    event session_restart ->
    event session_off ->

    // ==============================================================
    // COMPONENTS
    // ==============================================================

    //  A rounded card, 556 wide; what goes between its braces is drawn inside.
    component Card(h: number = 56) {
        size: 556, h
        CardBg(556, h, 14)
        box { from: 0, 0; size: 556, h; corner: 14; stroke: 1; color: c_border; opacity: c_border_op }
        children
    }

    //  A row with a button on its right.
    component ActionRow(title: text, sub: text, label: text, tap: event) {
        size: 556, 56
        CardBg(556, 56, r_m)
        box { from: 0, 0; size: 556, 56; corner: r_m; stroke: 1; color: c_border; opacity: c_border_op }
        text title { at: 18, 20; anchor: left center; size: t_body; weight: 600; color: ink_c; width: 400; lines: 1 }
        text sub { at: 18, 38; anchor: left center; size: t_micro; color: ink_sub; width: 400; lines: 1 }
        group {
            move: 450, 14
            Btn(label, 88, tap, false, 0, 0)
        }
    }

    //  A slider you can drag.
    component SliderRow(title: text, level: number, set: event, kind: number, live: bool) {
        size: 556, 64
        CardBg(556, 64, r_m)
        box { from: 0, 0; size: 556, 64; corner: r_m; stroke: 1; color: c_border; opacity: c_border_op }
        text title { at: 18, 20; anchor: left center; size: t_body; weight: 600; color: ink_c }
        text "{clamp(level, 0, 1) * 100, 0}%" { at: 538, 20; anchor: right center; size: t_cap; color: ink_sub }
        group { move: 18, 38; Slider(520, level, set, if(live, accent_c, ink_sub), 10, 0) }
    }

    //  Light / Dark / Auto thumbnail.
    component ModeThumb(n: number, label: text, base: color, panel_c: color, bar: color) {
        size: 100, 78
        box { from: 0, 0; size: 100, 60; corner: r_s; color: base }
        group {
            show: n == 2
            box { from: 0, 0; size: 50, 60; corner: r_s; color: #f2f3f7 }
        }
        group {
            show: n != 2
            box { from: 6, 6; size: 88, 8; corner: 2; color: bar }
            box { from: 6, 18; size: 26, 36; corner: 2; color: panel_c }
            box { from: 36, 18; size: 58, 36; corner: 2; color: panel_c }
        }
        box { from: 0, 0; size: 100, 60; corner: r_s; stroke: if(appearance == n, 2.5, 1); color: if(appearance == n, accent_c, c_border) }
        text label { at: 50, 72; anchor: center center; size: t_sub; weight: if(appearance == n, 600, 400); color: if(appearance == n, accent_c, ink_c) }
        zone box hit { from: 0, 0; size: 100, 78; cursor: pointer }
        on press hit { emit set_mode(n) }
        on press right hit { }
    }

    component SkinPill(idx: number, title_t: text, desc_t: text) {
        size: 166, 40
        box { from: 0, 0; size: 166, 40; corner: r_s; color: if(skin == idx, sel_bg, field_bg) }
        box { from: 0, 0; size: 166, 40; corner: r_s; stroke: if(skin == idx, 2, 1); color: if(skin == idx, accent_c, c_border) }
        text title_t { at: 12, 14; anchor: left center; size: t_sub; weight: 600; color: if(skin == idx, accent_c, ink_c) }
        text desc_t { at: 12, 29; anchor: left center; size: t_micro; color: ink_sub; width: 146; lines: 1 }
        zone box hit { from: 0, 0; size: 166, 40; corner: r_s; cursor: pointer }
        on press hit { emit choose_skin(idx) }
        on press right hit { }
    }

    component AccentCircle(idx: number, col: color) {
        size: 28, 28
        ellipse { at: 14, 14; radius: 11; color: col }
        ellipse { at: 14, 14; radius: 13.5; stroke: 2; color: ink_c; opacity: if(accent == idx and not accent_auto, 90%, 0%) }
        zone box hit { from: 0, 0; size: 28, 28; corner: 14; cursor: pointer }
        on press hit { emit choose_accent(idx) }
        on press right hit { }
    }

    //  A display: pick it to change its scale and mode.
    component DispTile(d: record) {
        size: 270, 78
        CardBg(270, 78, r_m)
        box { from: 0, 0; size: 270, 78; corner: r_m; stroke: if(d.sel, 2, 1); color: if(d.sel, accent_c, c_border); opacity: if(d.sel, 100%, c_border_op) }
        Sym("󰍹", 34, 39, 30, if(d.sel, accent_c, ink_sub))
        text d.title { at: 66, 28; anchor: left center; size: t_sub; weight: 600; color: ink_c; width: 190; lines: 1 }
        text d.mode { at: 66, 48; anchor: left center; size: t_micro; color: ink_sub; width: 190; lines: 1 }
        text d.name { at: 66, 62; anchor: left center; size: t_micro; color: ink_sub; width: 190; lines: 1 }
        zone box hit { from: 0, 0; size: 270, 78; corner: r_m; cursor: pointer }
        on press hit { emit disp_pick(d.index) }
        on press right hit { }
    }

    component OutRow(o: record) {
        size: 556, 44
        box { from: 0, 0; size: 556, 44; corner: r_m; color: if(o.def, sel_bg, card_fill); opacity: if(o.def, 100%, card_fill_op) }
        box { from: 0, 0; size: 556, 44; corner: r_m; stroke: if(o.def, 2, 1); color: if(o.def, accent_c, c_border); opacity: if(o.def, 100%, c_border_op) }
        Sym("󰓃", 26, 22, 16, if(o.def, accent_c, ink_sub))
        text o.name { at: 48, 22; anchor: left center; size: t_sub; color: ink_c; width: 440; lines: 1 }
        text "󰄬" { family: "JetBrainsMono Nerd Font Mono"; at: 530, 22; anchor: center center; size: 15; color: accent_c; show: o.def }
        zone box hit { from: 0, 0; size: 556, 44; corner: r_m; cursor: pointer }
        on press hit { emit pick_out(o.index) }
        on press right hit { }
    }

    component BindRow(b: record) {
        size: 556, 40
        box { from: 0, 0; size: 556, 40; corner: r_s; color: card_fill; opacity: card_fill_op * 70% }
        text b.what { at: 16, 20; anchor: left center; size: t_sub; color: ink_c; width: 280; lines: 1 }
        text b.keys { at: 540, 20; anchor: right center; size: t_sub; weight: 600; color: accent_c; width: 240; lines: 1; align: right }
    }

    //  A wallpaper thumbnail: click to apply.
    component SpecRow(label_t: text, val_t: text) {
        size: 520, 22
        text label_t { at: 0, 11; anchor: left center; size: t_sub; weight: 600; color: ink_sub; width: 110 }
        text val_t { at: 120, 11; anchor: left center; size: t_sub; color: ink_c; width: 390; lines: 1 }
    }

    //  A category in the sidebar; `c.tint` picks the icon colour.
    component SidebarItem(c: record) {
        size: 206, 30
        prop hot = 0 ~quick
        box { from: 0, 0; size: 206, 30; corner: r_s; color: ink_c; opacity: if(tab == c.idx, 0%, hot * 7%) }
        box hit {
            from: 0, 0
            size: 206, 30
            corner: 8
            color: accent_c
            opacity: if(tab == c.idx, 95%, 0%)
            cursor: pointer
        }
        group {
            move: 6, 4
            box { from: 0, 0; size: 22, 22; corner: 5; color: pick(c.tint, #5856d6, #0a84ff, #ff2d55, #ff453a, #8e8e93, #ff9f0a, #8e8e93, #30d158) }
            Sym(c.icon, 11 - c.dx, 10.5, 13, on_accent)
        }
        text c.name { at: 36, 15; anchor: left center; size: t_body; weight: if(tab == c.idx, 600, 400); color: if(tab == c.idx, on_accent, ink_c) }
        on enter hit { hot: 1 }
        on leave hit { hot: 0 }
        on press hit { emit pick_cat(c.idx) }
        on press right hit { }
    }

    on toggle     { toggle open }
    on key Escape { open = false }
}
