            box { from: 44, 176; size: 100, search_h_compact; corner: control_r; color: field_bg }
            input quiet_from { at: 56, 182; width: 76; size: font_secondary; color: ink_c; selection: accent_c }
            text "To" { at: 164, 190; anchor: left center; size: font_secondary; color: ink_sub }
            box { from: 192, 176; size: 100, search_h_compact; corner: control_r; color: field_bg }
            input quiet_to { at: 204, 182; width: 76; size: font_secondary; color: ink_c; selection: accent_c }
            group { move: 312, 176; Btn("Save hours", 128, quiet_hours_save, false, 0, 0, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill) }

            text quiet_edit_status { at: 0, 218; size: font_caption; color: ink_sub; width: 556; lines: 1 }
            text "App delivery" { at: 0, 250; size: font_body; weight: 600; color: ink_c }
            column { at: 0, 274; gap: space_4; for a in quiet_app_rows { QuietAppRow(a) } }
            text quiet_app_range { at: 0, 462; size: font_caption; color: ink_sub; width: 556; lines: 1 }
            text Notifications.rules_status { at: 0, 482; size: font_caption; color: danger_c; width: 556; lines: 1 }
