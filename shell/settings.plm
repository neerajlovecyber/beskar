                    step: 48
                    gap: space_4
                    for p in dock_pins { PinOrderRow(p) }
                }
                text "No available pinned apps" { at: 278, 120; anchor: center center; size: font_body; color: ink_sub; show: dock_pins.count == 0 }
                on change pin_sel { pin_list.scroll: clamp(pin_sel * 48 - 336, 0, max(0, pin_list.content - 448)) }
            }
