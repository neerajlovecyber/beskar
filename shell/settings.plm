// System Settings: a sidebar of categories (with search) and a pane of real controls. Every switch, slider and
// button here does something: the logic is settings.luau. Window 840 × 580, centred on the monitor with the focus.
//
//   0 Appearance · 1 Displays · 2 Sound · 3 Notifications · 4 Menu Bar & Dock · 5 Shortcuts · 6 General
import "common/palette.plm"
uses scene "notifications.plm" as Notifications
uses scene "topbar.plm" as Topbar
uses scene "activities.plm" as Activities
uses scene "system.plm" as System        // battery, network, audio, brightness: declared ONCE there
uses scene "panels.plm" as Panels
import "common/icons.plm"
import "common/ui.plm"
import "common/buttons.plm"

scene MacSettings {
    include "common/theme_facts.plm"
    include "common/theme.plm"
    include "common/here.plm"
    surface sheet {
        size: 900, 620
        anchor: center
        level: overlay
        keyboard: exclusive while open
        screens: Panels.panel_mon   // the monitor text of the whole desktop, owned by the Panels scene
        open: (open or seen > 0.02)

    zone box dismiss { from: 0, 0; size: 900, 620; active: open }

    group {
        move: 30, 20
        pivot: 420, 290
        scale: scale
        opacity: seen

        // ── window glass ─────────────────────────────────────────
        body {
            color: bg_color
            glass: glass_amt
            lens: false
            frost: 100%
            dispersion: 0
            refraction: 0
            tint: tint_amt
            rim: rim_amt
            box { from: 0, 0; size: 840, 580; corner: radius_window }
        }
        box { from: 0, 0; size: 840, 580; corner: radius_window; stroke: 1; color: stroke_c; opacity: stroke_op }
        //  the sidebar: rounded on the window's own (left) corners only. Its right corners are cut by the clip, or they curve
        //  in and show the window's glass and border as a line along the bottom and top of the divider.
        group {
            clip box { from: 0, 0; size: 230, 580 }
            box { from: 0, 0; size: 230 + radius_window * 2, 580; corner: radius_window; color: sidebar_bg; opacity: 85% }
        }
        box { from: 230, 0; size: 1, 580; color: stroke_c; opacity: stroke_op }

        //  clicks on the window itself do not close it
        zone box inside { from: 0, 0; size: 840, 580 }
        on press right inside { }

        // ── sidebar ──────────────────────────────────────────────
        group {
            move: 18, 18
            ellipse { at: 6, 6; radius: 6; color: #ff5f56 }
            zone box btn_close { from: 0, 0; size: 14, 14; cursor: pointer }
            on press btn_close { open = false }
            ellipse { at: 26, 6; radius: 6; color: #ffbd2e }
            zone box btn_min { from: 20, 0; size: 14, 14; cursor: pointer }
            on press btn_min { open = false }
            ellipse { at: 46, 6; radius: 6; color: #27c93f }
        }

        //  who is logged in
        group {
            move: 14, 46
            box { from: 0, 0; size: 202, 54; corner: r_s; color: card_fill; opacity: card_fill_op * 50% }
            box { from: 0, 0; size: 202, 54; corner: r_s; stroke: 1; color: c_border; opacity: c_border_op }
            //  your picture if there is one (~/.face or the account's icon), else a gradient disc with your initial
            group {
                show: not has_avatar
                body {
                    gradient: 8, 9 to 44, 45, accent_c, focus_c
                    box { from: 8, 9; size: 36, 36; corner: r_l }
                }
            }
            text avatar_initial { at: 26, 27; anchor: center center; size: 18; weight: 700; color: on_accent; show: not has_avatar }
            group {
                show: has_avatar
                clip box { from: 8, 9; size: 36, 36; corner: r_l }
                image avatar_img { at: 8, 9; size: 36, 36 }
            }
            column {
                at: 52, 17
                gap: space_2
                text user_name { size: ts_body; weight: 600; color: ink_c; width: 140; lines: 1 }
                text "This computer" { size: ts_micro; color: ink_sub }
            }
        }

        //  search: filters the list below
        group {
            move: 14, 108
            box { from: 0, 0; size: 202, search_h_compact; corner: control_r; color: field_bg }
            Sym("󰍉", 18, 14, 13, ink_sub)
            input side_q {
                at: space_32, space_6
                width: 160
                size: font_secondary
                color: ink_c
                placeholder: "Search"
                selection: accent_c
            }
            on submit side_q { emit settings_search_submit }
        }

        group {
            show: not settings_search
        column cat_list {
            at: 12, 144
            gap: space_2
            for c in cats { SidebarItem(c) }
        }
        }
        column {
            at: 12, 144
            gap: space_4
            show: settings_search
            for r in setting_matches { SettingsSearchRow(r) }
        }
        group { show: settings_search and setting_matches.count < 1; EmptyState(115, 190, "󰍉", "No matches", ui_ink_sub: ink_sub) }

        // ── the pane ─────────────────────────────────────────────
        text pane_title { at: 254, 34; anchor: left center; size: 20; weight: 700; color: ink_c }

        group {
            move: 616, 20
            show: tab == 0 and not look_open
            Btn("Restore defaults…", 194, reset_appearance_review, false, 0, 0, enabled: preference_can_restore, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
        }
        text preference_status { at: 254, 570; anchor: left center; size: font_micro; color: ink_sub; width: 350; lines: 1 }
        group {
            move: 616, 560
            show: reset_undo
            Btn("Undo appearance", 152, reset_appearance_undo, false, 0, 0, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
        }
        group {
            move: 730, 560
            show: preference_problem
            Btn("Retry", 80, preference_retry, false, 0, 0, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
        }

        // 0 ── Appearance ───────────────────────────────────────
        group tab_0 {
            show: tab == 0 and not look_open
            move: 254, 60
            column tcol_0 {
                view: 560, 500
                step: 56
                gap: space_12
                ActionRow("Saved looks & sharing", "Save this appearance or review a portable appearance document", "Open…", look_open)
                Card(138) {
                    text "Appearance" { at: 18, 16; size: ts_body; weight: 600; color: ink_c }
                    row {
                        at: 40, 42
                        gap: space_24
                        ModeThumb(0, "Light", #f2f3f7, on_accent, #e5e7eb)
                        ModeThumb(1, "Dark", #1e2026, #252830, #2d3139)
                        ModeThumb(2, "Auto", #1e2026, #f2f3f7, #8e8e93)
                    }
                    text "Auto switches to dark at 7 pm and back to light at 7 am" { at: 380, 70; anchor: left center; size: ts_micro; color: ink_sub; width: 160; lines: 3; show: appearance == 2 }
                }
                Card(72) {
                    text "Window glass" { at: inset_card, 18; size: ts_body; weight: 600; color: ink_c }
                    text "Liquid blurs and reflects, Acrylic is frosted, Solid is opaque" { at: inset_card, 48; size: ts_micro; color: ink_sub; width: 290; lines: 1 }
                    row { at: 310, 14; gap: space_6
                        Seg("Liquid", 0, skin, choose_skin, 74, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                        Seg("Acrylic", 1, skin, choose_skin, 78, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                        Seg("Solid", 2, skin, choose_skin, 64, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                    }
                }
                group {
                    size: 556, row_detail_h
                ToggleRow("Colours from the wallpaper", "Accent, highlights and glass tint follow the picture (matugen)", accent_auto, toggle_accent_auto, ui_ink_c: ink_c, ui_ink_sub: ink_sub, ui_card_fill: card_fill, ui_card_stroke: card_stroke, ui_accent_c: accent_c, ui_on_accent: on_accent, ui_switch_off: switch_off)
                }
                group {
                    size: 556, row_detail_h
                ToggleRow("Theme other apps", "Terminals, Files (Nautilus) and other GTK / Qt apps wear the same colours", pref_apps, toggle_apps, ui_ink_c: ink_c, ui_ink_sub: ink_sub, ui_card_fill: card_fill, ui_card_stroke: card_stroke, ui_accent_c: accent_c, ui_on_accent: on_accent, ui_switch_off: switch_off)
                }
                Card(72) {
                    text "Accent colour" { at: inset_card, 18; size: ts_body; weight: 600; color: ink_c }
                    text "Presets; the wallpaper option overrides them" { at: inset_card, 48; size: ts_micro; color: ink_sub; width: 280; lines: 1 }
                    row {
                        at: 306, 14
                        gap: space_6
                        AccentCircle(0, #007aff)
                        AccentCircle(1, #af52de)
                        AccentCircle(2, #ff2d55)
                        AccentCircle(3, #ff3b30)
                        AccentCircle(4, #ff9500)
                        AccentCircle(5, #34c759)
                        AccentCircle(6, #8e8e93)
                    }
                }
                Card(72) {
                    text "Wallpaper palette" { at: inset_card, 18; size: ts_body; weight: 600; color: if(accent_auto, ink_c, ink_sub) }
                    text "How the colours taken from the picture are built" { at: inset_card, 48; size: ts_micro; color: ink_sub; width: 240; lines: 1 }
                    row {
                        at: 262, 14
                        gap: space_6
                        Seg("Tonal", 0, pal_style, pal_style_pick, 62, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                        Seg("Vibrant", 1, pal_style, pal_style_pick, 70, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                        Seg("Neutral", 2, pal_style, pal_style_pick, 70, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                        Seg("Soft", 3, pal_style, pal_style_pick, 56, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                    }
                }
                Card(112) {
                    text "Custom accent" { at: inset_card, 18; size: ts_body; weight: 600; color: ink_c }
                    box { from: inset_card, 40; size: 148, search_h_compact; corner: control_r; color: field_bg }
                    input custom_accent_edit { at: 28, 46; width: 124; size: font_secondary; color: ink_c; selection: accent_c; placeholder: "#RRGGBB" }
                    group { move: 176, 40; Btn("Apply", 100, custom_accent_apply, true, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill) }
                    group { move: 288, 40; Btn("Use preset", 132, custom_accent_clear, false, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill) }
                    text custom_accent_current { at: inset_card, 86; size: ts_cap; color: ink_c; width: 148; lines: 1 }
                    text custom_accent_status { at: 176, 86; size: ts_cap; color: ink_sub; width: 364; lines: 1 }
                }
                Card(72) {
                    text "Panel text size" { at: inset_card, 18; size: ts_body; weight: 600; color: ink_c }
                    text "Titles and descriptions; fields and icons keep their sizes" { at: inset_card, 48; size: ts_micro; color: ink_sub; width: 524; lines: 1 }
                    row { at: 310, 14; gap: space_6
                        Seg("Small", 0, style_text, style_text_pick, 72, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                        Seg("Standard", 1, style_text, style_text_pick, 82, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                        Seg("Large", 2, style_text, style_text_pick, 64, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                    }
                }
                Card(72) {
                    text "Glass strength" { at: inset_card, 18; size: ts_body; weight: 600; color: ink_c }
                    text "Lower amounts make translucent panels easier to read" { at: inset_card, 48; size: ts_micro; color: ink_sub; width: 524; lines: 1 }
                    row { at: 310, 14; gap: space_6; show: skin != 2
                        Seg("Minimal", 0, style_glass, style_glass_pick, 82, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                        Seg("Soft", 1, style_glass, style_glass_pick, 72, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                        Seg("Full", 2, style_glass, style_glass_pick, 64, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                    }
                    text "Classic Solid is opaque" { at: 310, 28; anchor: left center; size: ts_cap; color: ink_sub; show: skin == 2 }
                }
                ToggleRow("Reduce motion", "Settle transitions immediately; keeps the system preference when off", reduce_motion, toggle_reduce_motion, ui_ink_c: ink_c, ui_ink_sub: ink_sub, ui_card_fill: card_fill, ui_card_stroke: card_stroke, ui_accent_c: accent_c, ui_on_accent: on_accent, ui_switch_off: switch_off)
            }
            on change setting_reveal while tab == 0 { tcol_0.scroll: clamp(setting_y - space_12, 0, max(0, tcol_0.content - 500)) }
            group {
                show: (setting_target > 0 and setting_target <= 6) or (setting_target >= 32 and setting_target <= 35)
                clip box { from: 0, 0; size: 560, 500 }
                box { from: 0, setting_y - tcol_0.scroll; size: 556, setting_h; corner: radius_card; stroke: 2; color: focus_c }
            }
            group { move: 566, 0; ScrollBar(tcol_0.scroll, tcol_0.content, 500, ui_ink_c: ink_c) }
        }

        group {
            show: tab == 0 and look_open
            move: 254, 60
            text "Saved looks" { at: 0, 8; size: font_title; weight: 600; color: ink_c }
            group { move: 456, 0; Btn("Back", 100, look_close, false, 0, 0, enabled: true, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill) }

            box { from: 0, 40; size: 300, search_h_compact; corner: control_r; color: field_bg }
            input look_name { at: 12, 46; width: 276; size: font_secondary; color: ink_c; selection: accent_c; placeholder: "Name this appearance" }
            group { move: 312, 40; Btn("Save new", 112, look_save, false, 0, 0, enabled: look_writable and look_ready, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill) }
            group { move: 436, 40; Btn("Retry", 120, look_retry, false, 0, 0, enabled: true, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill) }

            column { at: 0, 84; gap: space_4; for r in look_rows { LookRow(r) } }
            text look_range { at: 0, 258; size: font_caption; color: ink_sub }
            group { move: 0, 282; Btn("Load", 96, look_load, true, 0, 0, enabled: look_selected > 0 and look_ready, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill) }
            group { move: 108, 282; Btn("Update", 100, look_update, false, 0, 0, enabled: look_selected > 0 and look_writable, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill) }
            group { move: 220, 282; Btn("Rename", 106, look_rename, false, 0, 0, enabled: look_selected > 0 and look_writable, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill) }
            group { move: 338, 282; Btn("Delete", 100, look_delete, false, 0, 0, enabled: look_selected > 0 and look_writable, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill) }

            text "Share appearance" { at: 0, 330; size: font_body; weight: 600; color: ink_c }
            box { from: 0, 354; size: 556, search_h_compact; corner: control_r; color: field_bg }
            input look_document { at: 12, 360; width: 532; size: font_secondary; color: ink_c; selection: accent_c; placeholder: "Paste an appearance document to review" }
            group { move: 0, 394; Btn("Copy current", 136, look_export, false, 0, 0, enabled: look_ready, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill) }
            group { move: 148, 394; Btn("Review import", 148, look_preview, false, 0, 0, enabled: look_ready, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill) }
            group { move: 308, 394; Btn("Apply import", 136, look_apply, true, 0, 0, enabled: look_preview and look_ready, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill) }

            text look_changes { at: 0, 434; size: font_caption; color: ink_c; width: 556; lines: 2; show: look_preview }
            text look_status { at: 0, 472; size: font_caption; color: ink_sub; width: 556; lines: 2 }
        }

        // 1 ── Displays ─────────────────────────────────────────
        group tab_1 {
            show: tab == 1
            move: 254, 60
            column tcol_1 {
                view: 560, 500
                step: 56
                gap: space_12
                row {
                    gap: space_12
                    for d in disps { DispTile(d) }
                }
                Card(70) {
                    text "Scale" { at: 18, 22; anchor: left center; size: ts_body; weight: 600; color: ink_c }
                    text "Applies now; press Keep and it is restored at every login." { at: 18, 50; anchor: left center; size: ts_micro; color: ink_sub; width: 330 }
                    row {
                        at: 290, 14
                        gap: space_6
                        Seg("100%", 0, disp_scale_i, disp_scale, 62, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                        Seg("125%", 1, disp_scale_i, disp_scale, 62, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                        Seg("150%", 2, disp_scale_i, disp_scale, 62, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                        Seg("200%", 3, disp_scale_i, disp_scale, 62, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                    }
                }
                Card(56) {
                    text "Resolution" { at: 18, 28; anchor: left center; size: ts_body; weight: 600; color: ink_c }
                    row {
                        at: 150, 14
                        gap: space_6
                        for r in reslist { Chip(r.label, r.cur, disp_res, r.index, 92, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill) }
                    }
                }
                Card(56) {
                    text "Refresh rate" { at: 18, 28; anchor: left center; size: ts_body; weight: 600; color: ink_c }
                    row {
                        at: 160, 14
                        gap: space_6
                        for r in hzlist { Chip(r.label, r.cur, disp_hz, r.index, 80, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill) }
                    }
                }
                SliderRow("Brightness", System.display.level, brightness_set, 0, true)
                text display_status { size: font_secondary; color: ink_sub; width: 548; lines: 3 }
            }
            group { move: 566, 0; ScrollBar(tcol_1.scroll, tcol_1.content, 500, ui_ink_c: ink_c) }
        }

        // 2 ── Sound ────────────────────────────────────────────
        group tab_2 {
            show: tab == 2
            move: 254, 60
            column tcol_2 {
                view: 560, 500
                step: 56
                gap: space_12
                SliderRow("Output volume", System.sound.volume, volume_set, 1, not System.sound.muted)
                ToggleRow("Mute", "Silences the output", System.sound.muted, toggle_mute, ui_ink_c: ink_c, ui_ink_sub: ink_sub, ui_card_fill: card_fill, ui_card_stroke: card_stroke, ui_accent_c: accent_c, ui_on_accent: on_accent, ui_switch_off: switch_off)
                SliderRow("Input volume", in_level, input_set, 2, true)
                text "Output device" { size: ts_body; weight: 600; color: ink_c }
                column {
                    gap: space_6
                    for o in outs { OutRow(o) }
                }
            }
            group { move: 566, 0; ScrollBar(tcol_2.scroll, tcol_2.content, 500, ui_ink_c: ink_c) }
        }

        // 3 ── Notifications ────────────────────────────────────
        group tab_3 {
            show: tab == 3 and not quiet_edit
            move: 254, 60
            column tcol_3 {
                view: 560, 500
                step: 56
                gap: space_12
                ActionRow("Quiet modes & app delivery", "Focus, Presentation, Game, quiet hours and per-app controls", "Open…", quiet_open)
                ToggleRow("Do Not Disturb", "Notifications still arrive, silently, in the centre", Notifications.dnd, toggle_dnd, ui_ink_c: ink_c, ui_ink_sub: ink_sub, ui_card_fill: card_fill, ui_card_stroke: card_stroke, ui_accent_c: accent_c, ui_on_accent: on_accent, ui_switch_off: switch_off)
                ToggleRow("Group by app", "Stack several notifications from one app into a pile", group_apps, toggle_group, ui_ink_c: ink_c, ui_ink_sub: ink_sub, ui_card_fill: card_fill, ui_card_stroke: card_stroke, ui_accent_c: accent_c, ui_on_accent: on_accent, ui_switch_off: switch_off)
                ToggleRow("Show banners", "A new notification drops into the clock pill", banners, toggle_banners, ui_ink_c: ink_c, ui_ink_sub: ink_sub, ui_card_fill: card_fill, ui_card_stroke: card_stroke, ui_accent_c: accent_c, ui_on_accent: on_accent, ui_switch_off: switch_off)
                Card(64) {
                    text "Banner stays for" { at: 18, 22; anchor: left center; size: ts_body; weight: 600; color: ink_c }
                    row {
                        at: 270, 14
                        gap: space_6
                        Seg("3 s", 0, banner_i, banner_secs_pick, 62, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                        Seg("5 s", 1, banner_i, banner_secs_pick, 62, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                        Seg("8 s", 2, banner_i, banner_secs_pick, 62, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                        Seg("12 s", 3, banner_i, banner_secs_pick, 62, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                    }
                    text "Hovering a banner keeps it open" { at: 18, 46; anchor: left center; size: ts_micro; color: ink_sub }
                }
                ActionRow("History", "Forget the notifications listed under Earlier", "Clear", clear_notif_history)
            }
            group { move: 566, 0; ScrollBar(tcol_3.scroll, tcol_3.content, 500, ui_ink_c: ink_c) }
            on change setting_reveal while tab == 3 { tcol_3.scroll: clamp(setting_y - space_12, 0, max(0, tcol_3.content - 500)) }
            group {
                show: setting_target >= 7 and setting_target <= 11
                clip box { from: 0, 0; size: 560, 500 }
                box { from: 0, setting_y - tcol_3.scroll; size: 556, setting_h; corner: radius_card; stroke: 2; color: focus_c }
            }
        }

        group {
