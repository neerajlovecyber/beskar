                    row { at: 286, 7; gap: space_6
                        Seg("Short", 0, dock_delay_i, dock_delay_pick, 82, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                        Seg("Normal", 1, dock_delay_i, dock_delay_pick, 82, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
