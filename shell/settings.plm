                Chip("Presentation", Activities.quiet_presentation, quiet_mode, 2, 152, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
                Chip("Game", Activities.quiet_game, quiet_mode, 3, 120, ui_accent_c: accent_c, ui_ink_c: ink_c, ui_on_accent: on_accent, ui_btn_fill: btn_fill)
            }
