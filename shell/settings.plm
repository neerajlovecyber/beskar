                    text frame_output_status { at: inset_card, 4; size: font_caption; color: ink_sub; width: 524; lines: 2 }
                    text "Core controls and the ring stay on every output. Crowded tray rows scroll." { at: inset_card, 36; size: font_caption; color: ink_sub; width: 524; lines: 1 }
