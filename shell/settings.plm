// System Settings: the OWNER of the look and the preferences (facts, models, texts, events, the saved files; the logic is
// settings.luau). It has NO surface: the window is panel 30 of the frame (common/settings_panel.plm, drawn in topbar.plm's `Shell`),
// which reads these by name and asks with the typed events below, like the notification centre. Its text fields are the Keys
// scene's (keys.plm).
//
//   0 Appearance · 1 Displays · 2 Sound · 3 Notifications · 4 Menu Bar & Dock · 5 Shortcuts · 6 General · 8 Night Light & Power
import "common/palette.plm"
uses scene "notifications.plm" as Notifications
uses scene "topbar.plm" as Topbar
uses scene "activities.plm" as Activities
uses scene "system.plm" as System        // battery, network, audio, brightness: declared ONCE there
uses scene "panels.plm" as Panels
uses scene "keys.plm" as Keys            // the text fields (side_q, look_name, …) live there

scene MacSettings {
    include "common/theme_facts.plm"
    permissions {
        services: "clock", "audio", "audio.*", "brightness", "brightness.*", "network", "network.*", "bluetooth", "bluetooth.*", "say:topbar", "say:spotlight", "say:control_center", "say:notifications", "say:dashboard", "say:clipboard", "say:music", "say:weather", "say:capture", "say:updates", "say:wallpapers", "say:widget_bar", "say:lock", "say:session", "say:appswitcher", "say:widgets", "say:wallpaper", "say:panels", "say:infopanels", "say:dockpanels", "say:dialogs", "say:windows", "say:controlcenter"
        run: "matugen", "powerprofilesctl", "magick", "gsettings", "systemctl", "loginctl", "kitty", "pacman", "yay", "paru", "sh", "niri msg"
    }


    fact open = false        // the window is up: a mirror of the Panels owner (panel 30), set by settings.luau
    text user_name = ""
    text avatar_initial = ""
    text avatar_path = ""
    fact has_avatar = false
    text pane_title = "Appearance"
    fact tab = 0
    fact settings_search = false
    fact settings_search_sel = 0
    fact setting_target = 0
    fact setting_reveal = 0
    fact setting_y = 0
    fact setting_h = 0
    fact reset_review = false
    fact reset_sel = 0
    fact reset_undo = false
    fact preferences_loaded = false
    fact preference_can_restore = false
    fact preference_problem = false
    text preference_status = ""
    model setting_matches max 8 { name: text; sub: text; idx: number }
    fact appearance = 1          // 0 light · 1 dark · 2 auto (by the time of day)
    fact custom_accent = -1
    text custom_accent_current = "Preset colour"
    text custom_accent_status = ""
    event custom_accent_apply ->
    event custom_accent_clear ->
    event style_text_pick ->
    event style_glass_pick ->
    event toggle_reduce_motion ->

    //  the sidebar's list (filtered by the search), displays, shortcuts, sound outputs, updates
    model cats max 8 { idx: number; icon: text; tint: number; name: text; dx: number }
    model disps max 4 { name: text; title: text; mode: text; sel: bool }
    model reslist max 4 { label: text; cur: bool }
    model hzlist max 5 { label: text; cur: bool }
    model outs max 4 { name: text; def: bool }
    model binds max 9 { keys: text; what: text; origin: text }
    text about_host = "…"
    text about_up = "…"
    fact disp_scale_i = 0
    text bind_count = ""

    fact in_level = 0
    fact banners = true
    fact group_apps = false
    fact lock_i = 0              // 0 never · 1 3 min · 2 5 · 3 10 · 4 15 (off until you have tried the lock screen)
    fact banner_i = 1
    fact pref_seconds = false
    fact pref_weather = true
    fact pref_tray = true
    fact pal_style = 0
    text pal_src = ""
    fact pref_widgets = true
    fact pref_apps = true
    fact nl_mode_i = 0
    fact nl_temp_i = 1
    fact pp_i = 1
    fact pp_ok = true
    text pp_note = ""
    fact pref_workspaces = true
    fact pref_bar_apps = true
    fact pref_updates = true
    fact dock_size_i = 1
    fact bar_left_order = 0
    fact bar_right_order = 0
    fact module_output_policy = 0
    fact dock_output_policy = 0
    fact dock_show_delay = 0
    text frame_output_name = ""
    text frame_output_status = ""
    event bar_left_order_pick ->
    event bar_right_order_pick ->
    event module_output_pick ->
    event dock_output_pick ->
    event dock_show_delay_pick ->
    event frame_output_save ->
    fact dock_delay_i = 1
    fact wallpaper_fx = 0
    fact display_pending = false
    fact display_busy = false
    fact display_sel = 0
    text display_status = ""
    event display_keep ->
    event display_revert ->
    event display_activate ->
    fact shortcut_open = false
    fact shortcut_busy = false
    fact shortcut_editable = false
    fact shortcut_conflict = false
    text shortcut_status = ""
    text shortcut_route = ""
    event shortcut_open ->
    event shortcut_close ->
    event shortcut_route_next ->
    event shortcut_save ->
    fact look_open = false
    fact look_selected = 0
    fact look_writable = false
    fact look_ready = false
    fact look_preview = false
    text look_status = ""
    text look_range = ""
    text look_changes = ""
    model look_rows max 5 { id: number; name: text; sub: text; sel: bool; tag: text }
    event look_open ->
    event look_close ->
    event look_pick ->
    event look_step ->
    event look_save ->
    event look_update ->
    event look_rename ->
    event look_delete ->
    event look_load ->
    event look_preview ->
    event look_apply ->
    event look_export ->
    event look_retry ->
    fact quiet_enabled = false
    fact quiet_start = 1320
    fact quiet_end = 420
    text quiet_edit_status = ""
    event quiet_toggle ->
    event quiet_hours_save ->
    event quiet_mode ->
    event quiet_app_cycle ->
    fact quiet_edit = false
    text quiet_app_range = ""
    event quiet_open ->
    event quiet_close ->
    event quiet_app_step ->
    model quiet_app_rows max 5 { app: text; mode: number; idx: number; sel: bool }
    fact pin_edit = false
    fact pin_sel = 0
    model dock_pins max 12 { name: text; idx: number; mvl: bool; mvr: bool }
    fact pref_dock_auto = true
    fact bar_style = 0



    //  About this PC: filled in by settings.luau from the machine itself
    text about_os = "Linux"
    text about_cpu = "…"
    text about_gpu = "…"
    text about_mem = "…"
    text about_kernel = "…"
    text about_disk = "…"




    event reveal_setting(id) ->
    event settings_search_step ->
    event settings_search_pick ->
    event settings_search_submit ->
    event settings_search_clear ->
    event preference_retry ->
    event set_dock_pins ->
    event pin_open ->
    event pin_close ->
    event pin_left ->
    event pin_right ->
    event pin_step ->
    event reset_appearance_review ->
    event reset_appearance_apply ->
    event reset_appearance_cancel ->
    event reset_appearance_undo ->
    event reset_appearance_activate ->
    event set_tab(n) ->      // the tab to show
    event set_pal_src(path) -> // the wallpaper to take the palette from (the picker says it)
    event set_mode ->
    event set_dark_mode ->
    event choose_skin ->
    event choose_accent ->
    event toggle_accent_auto ->
    event toggle_hour12 ->
    event toggle_seconds ->
    event toggle_weather ->
    event toggle_tray ->
    event toggle_widgets ->
    event toggle_apps ->
    event nl_mode_pick ->
    event nl_temp_pick ->
    event pp_pick ->
    event pal_style_pick ->
    event widgets_edit ->
    event widgets_reset ->
    event toggle_dock_auto ->
    event toggle_workspaces ->
    event toggle_bar_apps ->
    event toggle_updates ->
    event dock_size_pick ->
    event dock_delay_pick ->
    event wallpaper_fx_pick ->
    event bar_style_pick ->
    event auto_accent ->
    event volume_set ->
    event input_set ->
    event toggle_mute ->
    event pick_out ->
    event brightness_set ->
    event disp_pick ->
    event disp_scale ->
    event disp_res ->
    event disp_hz ->
    event theme_sync ->
    event toggle_dnd ->
    event toggle_banners ->
    event toggle_group ->
    event lock_pick ->
    event banner_secs_pick ->
    event clear_notif_history ->
    event bind_scroll ->
    event pick_cat ->
    event session_lock ->
    event session_restart ->
    event session_off ->

    event pin_select ->        // a pin of the dock order was clicked (the window cannot write this fact)
    event reset_sel_flip ->    // Left / Right / Tab in the reset review
    event display_sel_flip ->  // the same in the display Keep / Revert prompt
}
