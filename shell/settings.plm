                ToggleRow("Hide the dock automatically", "It rises when the pointer reaches the bottom edge", pref_dock_auto, toggle_dock_auto, ui_ink_c: ink_c, ui_ink_sub: ink_sub, ui_card_fill: card_fill, ui_card_stroke: card_stroke, ui_accent_c: accent_c, ui_on_accent: on_accent, ui_switch_off: switch_off)
